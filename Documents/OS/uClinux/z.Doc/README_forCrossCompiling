2. Install

	1) Install toolchain
		uClinux make config & make dep
		- tar zxvf uClinux-dist-20040408.tar.gz
		- cd uClinux-dist
		- make config
		ex) vendor/product -> Samsung/4510B
		    kernal version = linux-2.4.x
		    libc version = uClibc
		    default all settings = y
		    customize kernel settings = n
		    customize vendor/user settings = n
		    update default vendor settings = n
		- make dep	

	2) Edit build-uclinux-tools.sh script
		KERNEL macro	-> modify
		 ex) $BASEDIR/uClinux-dist/linux-2.4.x

		PREFIX macro	-> valid and modify
		 ex) /home/tjsruddl/local

		PATH macro -> valid

		stage8()	-> Add the line
	         rm -rf elf2flt
	         extract elf2flt-*

	3) Edit toolchain source
		gcc-2.95.3
		- gcc-2.95.3/gcc/config/arm/arm.h
			#define arm_prog_mode ((enum attr_prog_mode) arm_prg_mode)
		     ->	#define arm_prog_mode (arm_prg_mode)

		uClibc
		- uClibc/libc/sysdeps/linux/arm/ioperm.c
			init_iosys()
			+#if LINUX_VERSION_CODE > 131328
				static int ...
				...
				io.initdone = 1;
				return 0;
				}
			+#endif

	4) ./build-uclinux-tools.sh
