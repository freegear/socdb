END VIA4

LAYER M5
    TYPE ROUTING ;
    WIDTH 0.420 ;
    AREA 0.565 ;
    PITCH 0.84 ; 
    OFFSET 0.42 ;
    DIRECTION HORIZONTAL ; 
    SPACINGTABLE 
    PARALLELRUNLENGTH 0.00 1.50 4.50
    WIDTH 0.00        0.42 0.42 0.42        
    WIDTH 1.50        0.42 0.50 0.50   
    WIDTH 4.50        0.42 0.50 1.50 ;
    MINENCLOSEDAREA 0.565 ;
    MINIMUMCUT 2 WIDTH 1.80 ;
    MINIMUMCUT 2 WIDTH 3.00 LENGTH 10 WITHIN 5 ;
    MAXWIDTH 12.00 ;
    ANTENNAAREARATIO 495 ;
    ANTENNACUMAREARATIO 4950 ;
    ANTENNACUMDIFFAREARATIO PWL ( ( 0 4950 ) ( 0.059 4950 ) ( 0.06 42597 ) ( 1 43021 ) ) ;
    MINIMUMDENSITY 20 ;
    MAXIMUMDENSITY 80 ;
    DENSITYCHECKWINDOW 100 100 ;
    DENSITYCHECKSTEP 50 ;
    FILLACTIVESPACING 1.17 ;
      # (Worst case resistance model for M5 = 0.0806 ohm/sq) = 8.0600e-02
    RESISTANCE RPERSQ      8.0600e-02 ;
      # CAP = (CAP1 + CAP2) * 0.001 pF/fF
      # M6-M5-M4:0.14:0.42: CAP1 = (Cb_a * M4 ratio + Ct_a * M6 ratio) / M5 width = 0.109054646164021
      # M6-M5-M4:0.14:0.42: CAP1 = (1.73e-02 * 0.544642857142857 + 1.73e-02 * 0.544642857142857) / 0.1728 = 0.109054646164021
      # M5-M3:0.14:0.42: CAP2 = Ca * M3 ratio / M5 width = 0.0144143725198413
      # M5-M3:0.14:0.42: CAP2 = 5.47e-03 * 0.455357142857143 / 0.1728 = 0.0144143725198413
      # CAP = (0.109054646164021 + 0.0144143725198413) * 0.001 pF/fF = 1.2347e-04
    CAPACITANCE CPERSQDIST 1.2347e-04 ;
      # ECAP = (ECAP1 + ECAP2 + Cc) * 0.001 pF/fF
      # M6-M5-M4:0.14:0.42: ECAP1 = Cfb * M4 ratio + Cft * M6 ratio = 0.0161758928571429
      # M6-M5-M4:0.14:0.42: ECAP1 = 1.43e-02 * 0.544642857142857 + 1.54e-02 * 0.544642857142857 = 0.0161758928571429
      # M5-M3:0.14:0.42: ECAP2 = Cf * M3 ratio = 0.00371571428571429
      # M5-M3:0.14:0.42: ECAP2 = 8.16e-03 * 0.455357142857143 = 0.00371571428571429
      # M5-M3:0.14:0.42: Cc = 3.58e-02
      # ECAP = (0.0161758928571429 + 0.00371571428571429 + 3.58e-02) * 0.001 pF/fF = 5.5692e-05
    EDGECAPACITANCE        5.5692e-05 ;
END M5

LAYER VIA5
    TYPE CUT ;
    SPACING 0.34 ;
    SPACING 0.54 ADJACENTCUTS 3 WITHIN 0.56 ;
    ANTENNAAREARATIO 19 ;
