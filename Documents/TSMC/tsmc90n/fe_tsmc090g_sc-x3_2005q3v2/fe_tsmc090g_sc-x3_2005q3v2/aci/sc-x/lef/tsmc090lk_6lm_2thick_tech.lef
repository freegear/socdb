LAYER M6
    TYPE ROUTING ;
    WIDTH 0.420 ;
    AREA 0.565 ;
    PITCH 0.84 ; 
    OFFSET 0.42 ;
    DIRECTION VERTICAL ;
    SPACINGTABLE 
    PARALLELRUNLENGTH 0.00 1.50 4.50
    WIDTH 0.00        0.42 0.42 0.42        
    WIDTH 1.50        0.42 0.50 0.50   
    WIDTH 4.50        0.42 0.50 1.50 ;
    MINENCLOSEDAREA 0.565 ;
    MINIMUMCUT 2 WIDTH 1.80 ;
    MINIMUMCUT 2 WIDTH 3.00 LENGTH 10 WITHIN 5 ;
    MAXWIDTH 12.00 ;
    ANTENNAAREARATIO 495 ;
    ANTENNACUMAREARATIO 4950 ;
    ANTENNACUMDIFFAREARATIO PWL ( ( 0 4950 ) ( 0.059 49967 ) ( 0.06 49975 ) ( 1 57420 ) ) ;
    MINIMUMDENSITY 20 ;
    MAXIMUMDENSITY 80 ;
    DENSITYCHECKWINDOW 100 100 ;
    DENSITYCHECKSTEP 50 ;
    FILLACTIVESPACING 1.17 ;
      # (Worst case resistance model for M6 = 0.0275 ohm/sq) = 2.7500e-02
    RESISTANCE RPERSQ      2.7500e-02 ;
      # CAP = (CAP1 + CAP2) * 0.001 pF/fF
      # M9-M8:0.42:0.42: CAP1 = Ca * M5 ratio / M6 width = 0.01232037470726
      # M9-M8:0.42:0.42: CAP1 = 2.74e-02 * 0.205714285714286 / 0.4575 = 0.01232037470726
      # M9-M7:0.42:0.42: CAP2 = Ca * M7 ratio / M9 width = 0.0147745823575332
      # M9-M7:0.42:0.42: CAP2 = 8.51e-03 * 0.794285714285714 / 0.4575 = 0.0147745823575332
      # CAP = (0.01232037470726 + 0.0147745823575332) * 0.001 pF/fF = 2.7095e-05
    CAPACITANCE CPERSQDIST 2.7095e-05 ;
      # ECAP = (ECAP1 + ECAP2 + Cc) * 0.001 pF/fF
      # M9-M8:0.42:0.42: ECAP1 = Cf * M5 ratio = 0.00255085714285714
      # M9-M8:0.42:0.42: ECAP1 = 1.24e-02 * 0.205714285714286 = 0.00255085714285714
      # M9-M7:0.42:0.42: ECAP2 = Cf * M7 ratio = 0.00442417142857143
      # M9-M7:0.42:0.42: ECAP2 = 5.57e-03 * 0.794285714285714 = 0.00442417142857143
      # M9-M7:0.42:0.42: Cc = 1.22e-01
      # ECAP = (0.00255085714285714 + 0.00442417142857143 + 1.22e-01) * 0.001 pF/fF = 1.2898e-04
    EDGECAPACITANCE        1.2898e-04 ;
END M6

LAYER OVERLAP
    TYPE OVERLAP ;
END OVERLAP

VIA VIA1_H DEFAULT
      # (Worst case resistance model for VIA1 = 2.4 ohm/ct) = 2.4000e+00
    RESISTANCE 2.4000e+00 ;
    LAYER M1 ;
        RECT -0.115 -0.07 0.115 0.07 ;
    LAYER VIA1 ;
        RECT -0.065 -0.065 0.065 0.065 ;
    LAYER M2 ;
        RECT -0.115 -0.07 0.115 0.07 ;
END VIA1_H

