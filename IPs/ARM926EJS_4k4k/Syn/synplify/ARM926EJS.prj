#implementation: "rev_1"
impl -add rev_1

#device options
set_option -technology VIRTEX4
set_option -part XC4VLX200
set_option -package FF1513
set_option -speed_grade -10

#compilation/mapping options
set_option -default_enum_encoding default
set_option -symbolic_fsm_compiler 0
set_option -resource_sharing 0
set_option -use_fsm_explorer 0
set_option -top_module "ARM926EJS"

#map options
set_option -frequency auto
set_option -run_prop_extract 0
set_option -fanout_limit 10000
set_option -disable_io_insertion 0
set_option -pipe 0
set_option -update_models_cp 0
set_option -verification_mode 0
set_option -fixgatedclocks 0
set_option -modular 0
set_option -retiming 0
set_option -no_sequential_opt 0

#simulation options
set_option -write_verilog 0
set_option -write_vhdl 0

#VIF options
set_option -write_vif 1

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "rev_1/ARM926EJS.edf"

#
#implementation attributes

set_option -vlog_std v2001
set_option -synthesis_onoff_pragma 0
set_option -dup 0
set_option -include_path "../fromARM/verilog/MAIN_ARM926EJS;../fromARM/verilog/a926dffs/;../fromARM/verilog/ARM926EJS/;../fromARM/verilog/ARM9EJS/;../fromARM/verilog/BIU/;../fromARM/verilog/Cache/;../fromARM/verilog/CP15/;../fromARM/verilog/DExt/;../fromARM/verilog/ETM9/;../fromARM/verilog/ETMIF/;../fromARM/verilog/IExt/;../fromARM/verilog/MMU/;../fromARM/verilog/TCM/;../fromARM/verilog/tbench/"
impl -active "rev_1"
