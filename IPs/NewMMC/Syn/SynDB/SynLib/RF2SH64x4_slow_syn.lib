	pin(CLKB) {
		direction : input;
		capacitance : 0.030
		clock	 : true;
		min_pulse_width_low	 : 0.434;
		min_pulse_width_high	 : 0.089;
		min_period		 : 1.766;
                max_transition           : 1.500;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.014, 0.014")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("2.187, 2.187")
			}	
			fall_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.880")
			}
		}
	}
   	pin(CLKA) {
		direction : input;
		capacitance : 0.036
		clock	 : true;
		min_pulse_width_low	 : 0.470;
		min_pulse_width_high	 : 0.090;
