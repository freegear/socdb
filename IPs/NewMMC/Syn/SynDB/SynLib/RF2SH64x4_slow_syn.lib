                max_transition           : 1.500;
	        internal_power(){
	    		when : "CENA";
			power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.014, 0.014")
			}
		}
	        internal_power(){
	    		when : "!CENA";
			rise_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("3.213, 3.213")
			}
			fall_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}
		}
		timing() {
			related_pin : "CLKB" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.880")
			}
		}	}
	bus(QA) {
                bus_type : RF2SH64x4_DATA;
        	direction : output;
                memory_read() {
			address : AA;
		}
