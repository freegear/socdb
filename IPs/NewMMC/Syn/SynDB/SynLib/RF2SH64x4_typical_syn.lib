	pin(CLKB) {
		direction : input;
		capacitance : 0.031
		clock	 : true;
		min_pulse_width_low	 : 0.257;
		min_pulse_width_high	 : 0.057;
		min_period		 : 1.116;
                max_transition           : 1.000;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.017, 0.017")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("2.783, 2.783")
			}	
			fall_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.550")
			}
		}
	}
   	pin(CLKA) {
		direction : input;
