	pin(CLKB) {
		direction : input;
		capacitance : 0.163
		clock	: true;
		min_pulse_width_low	: 0.284;
		min_pulse_width_high	: 0.104;
		min_period		: 2.213;
		max_transition		: 1.500;
		timing() {
			related_pin	: "CLKA" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("1.467")
		}	}
		internal_power(){
			when : "!CENB & WENB";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("64.555, 64.555")
        		}
        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENB & !WENB";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("81.249, 81.249")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
