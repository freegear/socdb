			  "2.430, 2.451, 2.472, 2.514, 2.637, 2.843, 3.045" \
			)
			}
			rise_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.178, 0.224, 0.270, 0.362, 0.627, 1.075, 1.512")
			}
			cell_fall(RA2SH2048x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ( \
			  "2.229, 2.244, 2.259, 2.288, 2.373, 2.518, 2.659", \
			  "2.235, 2.250, 2.265, 2.295, 2.380, 2.525, 2.665", \
			  "2.244, 2.258, 2.273, 2.303, 2.388, 2.533, 2.674", \
			  "2.260, 2.275, 2.290, 2.319, 2.404, 2.549, 2.690", \
			  "2.309, 2.324, 2.339, 2.368, 2.453, 2.598, 2.739", \
			  "2.391, 2.405, 2.420, 2.450, 2.535, 2.680, 2.821", \
			  "2.472, 2.487, 2.502, 2.532, 2.617, 2.761, 2.902" \
			)
			}
			fall_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.062, 0.093, 0.123, 0.184, 0.358, 0.653, 0.941")
		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.163
		clock	: true;
		min_pulse_width_low	: 0.284;
		min_pulse_width_high	: 0.104;
		min_period		: 2.213;
		max_transition		: 1.500;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("1.467")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("64.555, 64.555")
        		}
        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("81.249, 81.249")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH2048x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.031, 0.031")
                 }
         }
	}

