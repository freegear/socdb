	memory() {
		type : ram;
		address_width : 11;
		word_width : 8;
	}
	bus(Q)	 {
		bus_type : RA1SH2048x8_DATA;
		direction : output;
		max_capacitance : 0.495;
                memory_read() {
			address : A;
		}
		timing() {
			related_pin :	"CLK" ;
			timing_type : rising_edge;
			timing_sense : non_unate;
			cell_rise(RA1SH2048x8_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.800");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.978, 0.983, 0.993, 1.007, 1.054, 1.130, 1.214", \
			  "0.978, 0.982, 0.992, 1.006, 1.054, 1.130, 1.213", \
