			  "1.562, 1.566, 1.573, 1.583, 1.617, 1.671, 1.731", \
			  "1.575, 1.579, 1.585, 1.596, 1.630, 1.684, 1.743", \
			  "1.597, 1.600, 1.607, 1.617, 1.651, 1.705, 1.765", \
			  "1.618, 1.622, 1.628, 1.639, 1.673, 1.727, 1.786" \
			)
			}
			fall_transition(RA1SH512x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.140, 0.146, 0.157, 0.173, 0.228, 0.315, 0.411")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.083
		clock	: true;
		min_pulse_width_low	: 0.887;
		min_pulse_width_high	: 0.139;
		min_period		: 1.626;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH512x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("31.764, 31.764")
        		}
        		fall_power(RA1SH512x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH512x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("33.068, 33.068")
			}	
			fall_power(RA1SH512x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x24_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.165, 0.165")
                 }
         }
	}

