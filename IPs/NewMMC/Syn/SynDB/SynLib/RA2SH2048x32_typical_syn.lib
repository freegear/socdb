			values ("0.037, 0.071, 0.104, 0.171, 0.365, 0.692, 1.011")
			}
			cell_fall(RA2SH2048x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ( \
			  "1.384, 1.393, 1.403, 1.422, 1.476, 1.568, 1.657", \
			  "1.388, 1.397, 1.407, 1.426, 1.480, 1.572, 1.661", \
