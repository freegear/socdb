			  "1.460, 1.470, 1.479, 1.498, 1.552, 1.644, 1.733", \
			  "1.480, 1.489, 1.498, 1.517, 1.571, 1.663, 1.753" \
			)
			}
			fall_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.050, 0.070, 0.090, 0.131, 0.248, 0.447, 0.640")
		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.168
		clock	: true;
		min_pulse_width_low	: 0.171;
		min_pulse_width_high	: 0.062;
		min_period		: 1.374;
		max_transition		: 1.000;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.917")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("82.415, 82.415")
        		}
        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("103.497, 103.497")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH2048x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.040, 0.040")
                 }
         }
	}

