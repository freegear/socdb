		max_transition		: 1.000;
		timing() {
			related_pin	: "CLKA" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.917")
		}	}
		internal_power(){
			when : "!CENB & WENB";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("82.415, 82.415")
