			  "1.004, 1.006, 1.010, 1.017, 1.039, 1.074, 1.112" \
			)
			}
			fall_transition(RA1SH2048x16_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.048, 0.052, 0.059, 0.069, 0.104, 0.159, 0.219")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.086
		clock	: true;
		min_pulse_width_low	: 0.525;
		min_pulse_width_high	: 0.083;
		min_period		: 1.061;
		max_transition		: 0.800;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("35.771, 35.771")
        		}
        		fall_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("38.053, 38.053")
			}	
			fall_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH2048x16_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.201, 0.201")
                 }
         }
	}

