#add_file options
add_file -verilog "../../RTL/PermitCtl.v"
add_file -verilog "../../RTL/ReqInterBuff.v"
add_file -verilog "../../RTL/ReadChannelmi.v"
add_file -verilog "../../RTL/ReadChannelsi.v"
add_file -verilog "../../RTL/WriteChannelmi.v"
add_file -verilog "../../RTL/WriteChannelsi.v"
add_file -verilog "../../RTL/TOP_WriteCH/WriteChannel.v"
add_file -verilog "../../RTL/TOP_ReadCH/ReadChannel.v"
add_file -verilog "../../RTL/TOP/SBUS.v"


#implementation: "rev_1"
impl -add rev_1

#device options
set_option -technology VIRTEX2
set_option -part XC2V8000
set_option -package FF1517
set_option -speed_grade -4

#compilation/mapping options
set_option -default_enum_encoding default
set_option -symbolic_fsm_compiler 0
set_option -resource_sharing 1
set_option -use_fsm_explorer 0
set_option -top_module "SBUS"

#map options
set_option -frequency 60.000
set_option -run_prop_extract 0
set_option -fanout_limit 10000
set_option -disable_io_insertion 0
set_option -pipe 0
set_option -update_models_cp 0
set_option -verification_mode 0
set_option -fixgatedclocks 0
set_option -modular 0
set_option -retiming 0
set_option -no_sequential_opt 0

#simulation options
set_option -write_verilog 1
set_option -write_vhdl 0

#VIF options
set_option -write_vif 1

#automatic place and route (vendor) options
set_option -write_apr_constraint 0

#set result format/file last
project -result_file "rev_1/SBUS.edf"

#
#implementation attributes

set_option -synthesis_onoff_pragma 1
set_option -dup 0
set_option -compiler_compatible 1
set_option -project_relative_includes 1
impl -active "rev_1"
