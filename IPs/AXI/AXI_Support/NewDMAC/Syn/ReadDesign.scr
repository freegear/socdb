#/* Enable Verilog HDL preprocessor */
set hdlin_enable_vpp true

set RTL_PATH "../rtl"
set search_path [concat $search_path $RTL_PATH]

read_verilog DmacFifo.v
read_verilog DmacControl.v
read_verilog DmacEngine.v
read_verilog DmacChReg.v
read_verilog DmacRegFile2Ch.v
read_verilog DmacReqAck2Ch.v
read_verilog Dmac2Ch.v

set current_design Dmac2Ch

