	pin(CLK) {
		direction : input;
		capacitance : 0.264
		clock	: true;
		min_pulse_width_low	: 0.112;
		min_pulse_width_high	: 0.083;
		min_period		: 0.954;
		max_transition		: 2.000;
		internal_power(){
			when : "(!CEN \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("292.338, 292.338")
        		}
			fall_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("372.677, 372.677")
        		}
