	pin(CLK) {
		direction : input;
		capacitance : 0.229
		clock	: true;
		min_pulse_width_low	: 0.281;
		min_pulse_width_high	: 0.183;
		min_period		: 2.262;
		max_transition		: 4.000;
		internal_power(){
			when : "(!CEN \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("176.606, 176.606")
        		}
			fall_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("228.561, 228.561")
        		}
        		fall_power(RA1SH6144x32_8_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
	}

