/* setup the Setup...Defaults menu */

designer = "East"
company  = "SMT"

search_path = { . \
		./db \
		/tools/synopsys/syn/libraries/syn \
		/tools/synopsys/syn/dw/sim_ver \
		./SynDB ./SymDB }
 
synlib_wait_for_deisgn_license = {"DesignWare-Foundation"}
hdlin_translate_off_skip_text = TRUE
define_design_lib WORK -path /home/sdiv5/Syn/work

link_library= {"*" slow.db fast.db \
				   tpz973gwc.db tpz973gbc.db \
				   tpz973g_analogwc.db tpz973g_analogbc.db \
				   sfd64kx32m64p4_010a.db \
				   phv018_010a.db \
				   ARM7TDMI_CL018G_ff1_min.db ARM7TDMI_CL018G_ff1_max.db\
				   ARM7TDMI_CL018G_ff2_min.db ARM7TDMI_CL018G_ff2_max.db\
				   ARM7TDMI_CL018G_ss_min.db ARM7TDMI_CL018G_ss_max.db\
				   RA1SH6144x32_8_fast_syn.db \
				   RA1SH6144x32_8_slow_syn.db \
		           dw_foundation.sldb dw01.sldb dw02.sldb \
}

target_library= {  slow.db fast.db \
				   tpz973gwc.db tpz973gbc.db \
				   tpz973g_analogwc.db tpz973g_analogbc.db \
				   sfd64kx32m64p4_010a.db \
				   ARM7TDMI_CL018G_ss_min.db ARM7TDMI_CL018G_ss_max.db\
				   phv018_010a.db \
				   RA1SH6144x32_8_fast_syn.db \
				   RA1SH6144x32_8_slow_syn.db \
}

symbol_library= { tsmc18.sdb }
synthetic_library = { dw_foundation.sldb dw01.sldb dw02.sldb }

define_design_lib DW01 -path synopsys_root + "/dw/dw01/lib"
define_design_lib DW02 -path synopsys_root + "/dw/dw02/lib"

/*default_schematic_options = "-size infinite"*/

dont_use {slow/RF*, slow/TIE*, slow/CLK*}
dont_use {fast/RF*, fast/TIE*, fast/CLK*}

/* Site Specific Variables */
synthetic_library = {}
command_log_file = "./command.log"
view_command_log_file = "./view_command.log"
plot_command = "lpr -Plw"
text_print_command = "lpr -Plw"

/* Bus Inference */
bus_dimension_separator_style = "{][}"
bus_extraction_style = "{%s[%d:%d]}"
bus_inference_descending_sort = "{true}"
/*bus_naming_style = "{%s[%d]}"*/
bus_range_separator_style = "{:}"

/* Internal bus Inference */
hdlout_internal_busses = "{false}"
bus_inference_style  = "{%s[%d]}"

/* enable Text Viewer feature */
hdlin_source_to_gates_mode = "high"

/* Synopsys to Compass EDIF interface */
edifin_ground_name = "VSS"
edifin_ground_net_name = "VSS"
edifin_ground_net_property_name = "global"
edifin_ground_net_property_value = "VSS"
edifin_ground_pin_name = "VSS"
edifin_ground_port_name = "VSS"
edifin_netlist_only = "true"
edifin_power_name = "VDD"
edifin_power_net_name = "VDD"
edifin_power_net_property_name = "global"
edifin_power_net_property_value = "VDD"
edifin_power_pin_name = "VDD"
edifin_power_port_name = "VDD"
edifin_power_and_ground_representation = "net"
edifout_ground_name = "VSS"
edifout_ground_net_name = "VSS"
edifout_ground_net_property_name = "global"
edifout_ground_net_property_value = "VSS"
edifout_ground_pin_name = "VSS"
edifout_ground_port_name = "VSS"
edifout_netlist_only = "true"
edifout_no_array = "true"
edifout_power_name = "VDD"
edifout_power_net_name = "VDD"
edifout_power_net_property_name = "global"
edifout_power_net_property_value = "VDD"
edifout_power_pin_name = "VDD"
edifout_power_port_name = "VDD"
edifout_power_and_ground_representation = "net"
write_name_nets_same_as_ports = "true"
compile_fix_multiple_port_nets = "true"
/*include ./TSMC_naming_rule.script*/

/*************************************************************/
/*                                                           */
/*  VERILOG-HDL default varibales:                           */
/*  These variables are for controlling hdl reading, writing,*/
/*  and optimizing.                                          */
/*                                                           */
/*************************************************************/

hdl_keep_licenses = "false" ;

hdlin_enable_vpp = false ;
hdlin_preserve_vpp_files = false ;
hdlin_ff_always_async_set_reset = "true" ;
hdlin_latch_always_async_set_reset = "true" ;
hdlin_ff_always_sync_set_reset = "false" ;
hdlin_keep_feedback = "false" ;
hdlin_keep_inv_feedback = "true" ;
hdlin_check_no_latch = "true" ;
hdlin_report_inferred_modules = "true" ;
hdlin_dont_infer_mux_for_resource_sharing = "true" ;
hdlin_mux_size_limit = "32" ;
hdlin_replace_synthetic = "false" ;

verilogout_equation = "false" ;
verilogout_single_bit = "false" ;
verilogout_higher_designs_first = "true" ;
verilogout_no_tri = "true" ;
verilogout_show_unconnected_pins = "false" ;

define_name_rules willisn -type net -allow {a-z A-Z 0-9 _} -first_restrict {_ 0-9}
define_name_rules willisn -type port -allow {a-z A-Z 0-9 _ [ ]} -first_restrict {_ 0-9}
define_name_rules willisn -type cell -allow {a-z A-Z 0-9 _ } -first_restrict {_ 0-9}
define_name_rules willisn -reserved [list always and assign begin buf bufif0 bufif1 case casex casez cmos deassign default defparam disable edge else end endattribute endcase endfunction endmodule endprimitive endspecify endtable endtask event for force forever fork function highz0 highz1 if initial inout input integer join large macromodule medium module nand negedge nmos nor not notif0 notif1 or output parameter pmos posedge primitive pull0 pull1 pullup pulldown rcmos reg release repeat rnmos rpmos rtran rtranif0 rtranif1 scalared small specify specparam strength strong0 strong1 supply0 supply1 table task time tran tranif0 tranif1 tri tri0 tri1 triand trior trireg use vectored wait wand weak0 weak1 while wire wor xor xnor] -collapse_name_space -case_insensitive -map {{{"[?*]?*$", ""}}}

/******************************* VERILOG **************************************/
 When auto getup to command window. */
view_command_win = true ;

/*************************************************************/
/*                                                           */
/*  Compile Variables:                                       */
/*                                                           */
/*************************************************************/

compile_instance_name_prefix = "U" ;
compile_instance_name_suffix = "" ;
compile_use_low_timing_effort = "false" ;
compile_create_mux_op_hierarchy = "false" ;
compile_preserve_subdesign_interfaces = "false" ;
compile_delete_unloaded_sequential_cells = "true" ;
compile_assume_fully_decoded_three_state_busses = "false" ;
compile_mux_no_boundary_optimization = "false" ;
compile_disable_hierarchical_inverter_opt = "false" ;
enable_recovery_removal_arcs = "false" ;
compile_sequential_area_recovery = "true" ;

/*************************************************************/
/*                                                           */
/*  Test Compiler default variables.                         */
/*                                                           */
/*************************************************************/

atpg_test_asynchronous_pins = "false" ;
test_default_bidir_delay = 55 ;
test_default_delay = 5 ;
test_default_min_fault_coverage = 95 ;
test_default_strobe = 95 ;
test_default_period = 100 ;
test_disable_find_best_scan_out = "true" ;
insert_test_design_naming_style = "%s_test_%d" ;
test_clock_port_naming_style = "XTCK%s" ;
test_scan_clock_a_port_naming_style = "XACK%s" ;
test_scan_clock_b_port_naming_style = "XBCK%s" ;
test_scan_clock_port_naming_style = "test_sc%s" ;
test_scan_enable_inverted_port_naming_style = "test_sei%s" ;
test_scan_enable_port_naming_style = "XSM%s" ;
test_scan_in_port_naming_style = "SDI%s" ;
test_scan_out_port_naming_style = "SDO%s" ;

/****************************** MISCELLANEOUS ********************************/
/* Create schematic */
default_schematic_options = "-hierarchy -sge -no_type_mapper -rip_same_width"

/* Command to use name rules */
alias change_names "change_names -hierarchy -rules willisn"
