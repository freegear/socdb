
/* CTS clock/reset */
set_dont_touch {DTSDI002Top/crst/pll_s}

set_dont_touch {DTSDI002Top/crst/HIFBUF}
set_dont_touch {DTSDI002Top/crst/SYSBUF1}
set_dont_touch {DTSDI002Top/crst/SYSBUF2}

set_dont_touch {DTSDI002Top/crst/SYSRBUF}
set_dont_touch {DTSDI002Top/crst/HIFRBUF}

set_dont_touch_network DTSDI002Top/crst/SYSRBUF/Z
set_dont_touch_network DTSDI002Top/crst/HIFRBUF/Z

