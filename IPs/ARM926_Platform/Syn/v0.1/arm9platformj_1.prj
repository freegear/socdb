#implementation: "rev_3"
impl -add rev_3 -type fpga

#device options
set_option -technology STRATIXII
set_option -part EP2S180
set_option -package FC1508
set_option -speed_grade -4
set_option -part_companion HC240FC1508

#compilation/mapping options
set_option -default_enum_encoding onehot
set_option -symbolic_fsm_compiler 1
set_option -resource_sharing 1
set_option -use_fsm_explorer 0
set_option -top_module "TestPlatformFPGA"

#map options
set_option -frequency 200.000
set_option -run_prop_extract 1
set_option -fanout_limit 50
set_option -disable_io_insertion 0
set_option -pipe 0
set_option -update_models_cp 0
set_option -retiming 0
set_option -fixgatedclocks 0
set_option -verification_mode 0
set_option -no_sequential_opt 0
set_option -quartus_version 6.0

#simulation options
set_option -write_verilog 1
set_option -write_vhdl 0

#VIF options
set_option -write_vif 1

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "rev_3/TestPlatformFPGA.vqm"

#
#implementation attributes

set_option -vlog_std v2001
set_option -synthesis_onoff_pragma 0
set_option -dup 0
set_option -compiler_compatible 1
set_option -include_path "D:/Project/ARM926EJS_4k4k/RTL/v0.1/ARM926EJS/;D:/Docs/cpu/ARM926EJS/verilog/ARM9EJS/;D:/Docs/cpu/ARM926EJS/verilog/tbench/;D:/Project/ARM926_Platform/RTL/v0.1/Top/;D:/Project/ARM926EJS_4k4k/RTL/v0.1/4funcsim/"


#implementation: "rev_1"
impl -add rev_1 -type fpga

#device options
set_option -technology SPARTAN3
set_option -part XC3S5000
set_option -package FG900
set_option -speed_grade -4

#compilation/mapping options
set_option -default_enum_encoding onehot
set_option -symbolic_fsm_compiler 1
set_option -resource_sharing 1
set_option -use_fsm_explorer 0
set_option -top_module "TestPlatformFPGA"

#map options
set_option -frequency 30.000
set_option -run_prop_extract 1
set_option -fanout_limit 10000
set_option -disable_io_insertion 0
set_option -pipe 1
set_option -retiming 0
set_option -modular 0
set_option -update_models_cp 0
set_option -fixgatedclocks 0
set_option -verification_mode 0
set_option -no_sequential_opt 0

#simulation options
set_option -write_verilog 1
set_option -write_vhdl 0

#VIF options
set_option -write_vif 1

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "rev_1/TestPlatformFPGA.edf"

#
#implementation attributes

set_option -vlog_std v2001
set_option -synthesis_onoff_pragma 0
set_option -dup 0
set_option -compiler_compatible 1
set_option -include_path "D:/Project/ARM926EJS_4k4k/RTL/v0.1/ARM926EJS/;D:/Docs/cpu/ARM926EJS/verilog/ARM9EJS/;D:/Docs/cpu/ARM926EJS/verilog/tbench/;D:/Project/ARM926_Platform/RTL/v0.1/Top/;D:/Project/ARM926EJS_4k4k/RTL/v0.1/4funcsim/"

#par_1 attributes
set_option -job par_1 -add par
set_option -job par_1 -option run_backannotation 0
impl -active "rev_1"
