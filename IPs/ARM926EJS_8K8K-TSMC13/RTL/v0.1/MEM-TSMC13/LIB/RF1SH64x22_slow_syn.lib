			  "2.298, 2.317, 2.355, 2.393, 2.544, 2.770, 3.053" \
			)
			}
			rise_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.078, 0.118, 0.198, 0.278, 0.597, 1.076, 1.675")
			}
			cell_fall(RF1SH64x22_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.607, 1.618, 1.639, 1.660, 1.743, 1.868, 2.025", \
			  "1.628, 1.638, 1.659, 1.680, 1.763, 1.889, 2.045", \
			  "1.653, 1.663, 1.684, 1.705, 1.788, 1.914, 2.070", \
			  "1.703, 1.714, 1.734, 1.755, 1.839, 1.964, 2.121", \
			  "1.854, 1.865, 1.886, 1.907, 1.990, 2.116, 2.272", \
			  "2.107, 2.117, 2.138, 2.159, 2.242, 2.368, 2.524", \
			  "2.359, 2.369, 2.390, 2.411, 2.494, 2.620, 2.776" \
			)
			}
			fall_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.131, 0.150, 0.189, 0.227, 0.381, 0.612, 0.901")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.058
		clock	: true;
		min_pulse_width_low	: 0.370;
		min_pulse_width_high	: 0.102;
		min_period		: 2.139;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("8.415, 8.415")
        		}
        		fall_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("8.788, 8.788")
			}	
			fall_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH64x22_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.022, 0.022")
                 }
         }
	}

