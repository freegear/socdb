			  "2.274, 2.293, 2.331, 2.369, 2.520, 2.746, 3.029" \
			)
			}
			rise_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.078, 0.118, 0.198, 0.278, 0.597, 1.076, 1.675")
			}
			cell_fall(RF1SH32x30_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.583, 1.593, 1.614, 1.635, 1.719, 1.844, 2.001", \
			  "1.603, 1.614, 1.634, 1.655, 1.739, 1.864, 2.021", \
			  "1.628, 1.639, 1.660, 1.681, 1.764, 1.889, 2.046", \
			  "1.679, 1.689, 1.710, 1.731, 1.815, 1.940, 2.097", \
			  "1.830, 1.840, 1.861, 1.882, 1.966, 2.091, 2.248", \
			  "2.082, 2.093, 2.113, 2.134, 2.218, 2.343, 2.500", \
			  "2.334, 2.345, 2.366, 2.386, 2.470, 2.595, 2.752" \
			)
			}
			fall_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.131, 0.150, 0.189, 0.227, 0.381, 0.612, 0.901")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.058
		clock	: true;
		min_pulse_width_low	: 0.370;
		min_pulse_width_high	: 0.102;
		min_period		: 2.121;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("10.285, 10.285")
        		}
        		fall_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("10.677, 10.677")
			}	
			fall_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x30_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.028, 0.028")
                 }
         }
	}

