			  "0.845, 0.854, 0.871, 0.889, 0.946, 1.004, 1.077", \
			  "0.924, 0.933, 0.950, 0.968, 1.025, 1.083, 1.156", \
			  "1.003, 1.012, 1.029, 1.047, 1.104, 1.162, 1.235", \
			  "1.062, 1.071, 1.089, 1.106, 1.163, 1.221, 1.294" \
			)
			}
			rise_transition(RF1SH32x128_on_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.051, 0.070, 0.108, 0.146, 0.298, 0.525, 0.810")
			}
			cell_fall(RF1SH32x128_on_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.770, 0.779, 0.796, 0.814, 0.871, 0.929, 1.002", \
			  "0.786, 0.795, 0.812, 0.830, 0.887, 0.945, 1.017", \
