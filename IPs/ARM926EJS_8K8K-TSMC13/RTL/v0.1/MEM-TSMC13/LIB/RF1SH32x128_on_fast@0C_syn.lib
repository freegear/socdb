			  "1.003, 1.012, 1.029, 1.047, 1.104, 1.162, 1.235", \
			  "1.062, 1.071, 1.089, 1.106, 1.163, 1.221, 1.294" \
			)
			}
			fall_transition(RF1SH32x128_on_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.039, 0.048, 0.066, 0.083, 0.154, 0.259, 0.391")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.053
		clock	: true;
		min_pulse_width_low	: 0.144;
		min_pulse_width_high	: 0.044;
		min_period		: 1.155;
		max_transition		: 0.750;
		internal_power(){
			when : "(!CEN \
                                 & WEN[15] \
                                 & WEN[14] \
                                 & WEN[13] \
                                 & WEN[12] \
                                 & WEN[11] \
                                 & WEN[10] \
                                 & WEN[9] \
                                 & WEN[8] \
                                 & WEN[7] \
                                 & WEN[6] \
                                 & WEN[5] \
                                 & WEN[4] \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("43.364, 43.364")
        		}
			fall_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[15] & \
                            	WEN[14] & \
                            	WEN[13] & \
                            	WEN[12] & \
                            	WEN[11] & \
                            	WEN[10] & \
                            	WEN[9] & \
                            	WEN[8] & \
                            	WEN[7] & \
                            	WEN[6] & \
                            	WEN[5] & \
                            	WEN[4] & \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("49.999, 49.999")
        		}
        		fall_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x128_on_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.001, 0.001")
                 }
         }
	}

