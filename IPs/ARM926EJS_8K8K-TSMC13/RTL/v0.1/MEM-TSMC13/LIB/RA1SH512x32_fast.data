A[8:0] : CAP(0.022);
CEN : CAP(0.004);
CLK : CAP(0.090), MAXTRANS(0.500);
D[31:0] : CAP(0.001);
WEN : CAP(0.007);
ENDPORTDATA

TIMINGDATA
GLOBAL
        lu_table_template(RA1SH512x32_delay_template) {
           variable_1 : input_net_transition;
           variable_2 : total_output_net_capacitance;
