			  "0.899, 0.908, 0.925, 0.943, 0.988, 1.046, 1.118", \
			  "0.958, 0.967, 0.985, 1.002, 1.048, 1.105, 1.177" \
			)
			}
			rise_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.029, 0.048, 0.087, 0.125, 0.277, 0.506, 0.791")
			}
			cell_fall(RF1SH64x22_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.666, 0.675, 0.693, 0.710, 0.756, 0.813, 0.885", \
			  "0.682, 0.691, 0.708, 0.726, 0.771, 0.829, 0.901", \
			  "0.702, 0.711, 0.728, 0.746, 0.791, 0.849, 0.920", \
			  "0.741, 0.750, 0.768, 0.785, 0.831, 0.888, 0.960", \
			  "0.820, 0.829, 0.847, 0.864, 0.910, 0.967, 1.039", \
			  "0.899, 0.908, 0.925, 0.943, 0.988, 1.046, 1.118", \
			  "0.958, 0.967, 0.985, 1.002, 1.048, 1.105, 1.177" \
			)
			}
			fall_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.043, 0.052, 0.069, 0.087, 0.157, 0.263, 0.395")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.130;
		min_pulse_width_high	: 0.048;
		min_period		: 0.953;
		max_transition		: 0.750;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("14.397, 14.397")
        		}
        		fall_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("14.887, 14.887")
			}	
			fall_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH64x22_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.050, 0.050")
                 }
         }
	}

