			  "1.470, 1.484, 1.498, 1.527, 1.605, 1.733, 1.897" \
			)
			}
			rise_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.051, 0.082, 0.112, 0.172, 0.338, 0.610, 0.958")
			}
			cell_fall(RA1SH512x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ( \
			  "1.316, 1.326, 1.336, 1.357, 1.413, 1.506, 1.624", \
			  "1.324, 1.334, 1.344, 1.365, 1.421, 1.514, 1.632", \
			  "1.334, 1.344, 1.354, 1.375, 1.431, 1.524, 1.642", \
			  "1.354, 1.365, 1.375, 1.395, 1.452, 1.544, 1.662", \
			  "1.395, 1.405, 1.416, 1.436, 1.493, 1.585, 1.703", \
			  "1.476, 1.487, 1.497, 1.517, 1.574, 1.666, 1.784", \
			  "1.517, 1.527, 1.538, 1.558, 1.615, 1.707, 1.825" \
			)
			}
			fall_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.077, 0.093, 0.109, 0.142, 0.232, 0.378, 0.566")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.156
		clock	: true;
		min_pulse_width_low	: 0.170;
		min_pulse_width_high	: 0.058;
		min_period		: 1.398;
		max_transition		: 1.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("43.818, 43.818")
        		}
        		fall_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("53.778, 53.778")
			}	
			fall_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.021, 0.021")
                 }
         }
	}

