			}
			rise_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.079, 0.105, 0.157, 0.209, 0.415, 0.725, 1.113")
			}
			cell_fall(RF1SH64x22_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.006, 1.012, 1.025, 1.039, 1.091, 1.169, 1.267", \
			  "1.024, 1.030, 1.043, 1.057, 1.109, 1.187, 1.285", \
			  "1.046, 1.053, 1.066, 1.079, 1.131, 1.210, 1.308", \
			  "1.092, 1.098, 1.111, 1.124, 1.176, 1.255, 1.353", \
			  "1.182, 1.188, 1.201, 1.214, 1.267, 1.345, 1.443", \
			  "1.362, 1.369, 1.382, 1.395, 1.447, 1.525, 1.623", \
			  "1.452, 1.459, 1.472, 1.485, 1.537, 1.615, 1.713" \
			)
			}
			fall_transition(RF1SH64x22_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.054, 0.066, 0.090, 0.114, 0.209, 0.352, 0.531")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.204;
		min_pulse_width_high	: 0.065;
		min_period		: 1.343;
		max_transition		: 1.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("11.117, 11.117")
        		}
        		fall_power(RF1SH64x22_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("11.505, 11.505")
			}	
			fall_power(RF1SH64x22_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH64x22_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.035, 0.035")
                 }
         }
	}

