			  "2.009, 2.028, 2.066, 2.104, 2.255, 2.481, 2.764", \
			  "2.262, 2.280, 2.318, 2.356, 2.507, 2.733, 3.016" \
			)
			}
			rise_transition(RF1SH32x26_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.078, 0.118, 0.198, 0.278, 0.597, 1.076, 1.675")
			}
			cell_fall(RF1SH32x26_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.570, 1.581, 1.601, 1.622, 1.706, 1.831, 1.988", \
			  "1.590, 1.601, 1.622, 1.642, 1.726, 1.851, 2.008", \
			  "1.615, 1.626, 1.647, 1.668, 1.751, 1.877, 2.033", \
			  "1.666, 1.676, 1.697, 1.718, 1.802, 1.927, 2.084", \
			  "1.817, 1.828, 1.848, 1.869, 1.953, 2.078, 2.235", \
			  "2.069, 2.080, 2.101, 2.121, 2.205, 2.330, 2.487", \
			  "2.321, 2.332, 2.353, 2.374, 2.457, 2.582, 2.739" \
			)
			}
			fall_transition(RF1SH32x26_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.131, 0.150, 0.189, 0.227, 0.381, 0.612, 0.901")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.058
		clock	: true;
		min_pulse_width_low	: 0.370;
		min_pulse_width_high	: 0.102;
		min_period		: 2.105;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH32x26_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("9.187, 9.187")
        		}
        		fall_power(RF1SH32x26_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH32x26_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("9.532, 9.532")
			}	
			fall_power(RF1SH32x26_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x26_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.025, 0.025")
                 }
         }
	}

