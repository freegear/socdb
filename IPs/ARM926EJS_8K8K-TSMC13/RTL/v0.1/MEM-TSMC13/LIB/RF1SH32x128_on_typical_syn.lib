			  "1.518, 1.525, 1.538, 1.551, 1.603, 1.682, 1.780", \
			  "1.608, 1.615, 1.628, 1.641, 1.693, 1.772, 1.870" \
			)
			}
			fall_transition(RF1SH32x128_on_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.060, 0.072, 0.096, 0.120, 0.216, 0.361, 0.541")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.051
		clock	: true;
		min_pulse_width_low	: 0.228;
		min_pulse_width_high	: 0.060;
		min_period		: 1.578;
		max_transition		: 1.000;
		internal_power(){
			when : "(!CEN \
                                 & WEN[15] \
                                 & WEN[14] \
                                 & WEN[13] \
                                 & WEN[12] \
                                 & WEN[11] \
                                 & WEN[10] \
                                 & WEN[9] \
                                 & WEN[8] \
                                 & WEN[7] \
                                 & WEN[6] \
                                 & WEN[5] \
                                 & WEN[4] \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("32.778, 32.778")
        		}
			fall_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[15] & \
                            	WEN[14] & \
                            	WEN[13] & \
                            	WEN[12] & \
                            	WEN[11] & \
                            	WEN[10] & \
                            	WEN[9] & \
                            	WEN[8] & \
                            	WEN[7] & \
                            	WEN[6] & \
                            	WEN[5] & \
                            	WEN[4] & \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("37.842, 37.842")
        		}
        		fall_power(RF1SH32x128_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x128_on_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.002, 0.002")
                 }
         }
	}

