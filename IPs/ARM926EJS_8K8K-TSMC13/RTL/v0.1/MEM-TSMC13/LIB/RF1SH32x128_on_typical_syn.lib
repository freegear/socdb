			  "1.550, 1.563, 1.587, 1.612, 1.711, 1.859, 2.044" \
			)
			}
			rise_transition(RF1SH32x128_on_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.056, 0.082, 0.135, 0.187, 0.396, 0.710, 1.103")
			}
			cell_fall(RF1SH32x128_on_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.162, 1.169, 1.182, 1.195, 1.247, 1.326, 1.424", \
			  "1.180, 1.187, 1.200, 1.213, 1.265, 1.344, 1.442", \
			  "1.203, 1.209, 1.222, 1.235, 1.288, 1.366, 1.465", \
			  "1.248, 1.254, 1.267, 1.280, 1.333, 1.411, 1.510", \
