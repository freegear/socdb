			  "0.872, 0.881, 0.899, 0.916, 0.962, 1.019, 1.091", \
			  "0.931, 0.940, 0.958, 0.975, 1.021, 1.078, 1.150" \
			)
			}
			rise_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.029, 0.048, 0.087, 0.125, 0.277, 0.506, 0.791")
			}
			cell_fall(RF1SH16x24_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.639, 0.648, 0.666, 0.684, 0.729, 0.786, 0.858", \
			  "0.655, 0.664, 0.682, 0.699, 0.745, 0.802, 0.874", \
			  "0.675, 0.684, 0.701, 0.719, 0.764, 0.822, 0.894", \
			  "0.714, 0.723, 0.741, 0.758, 0.804, 0.861, 0.933", \
			  "0.793, 0.802, 0.820, 0.837, 0.883, 0.940, 1.012", \
			  "0.872, 0.881, 0.899, 0.916, 0.962, 1.019, 1.091", \
			  "0.931, 0.940, 0.958, 0.975, 1.021, 1.078, 1.150" \
			)
			}
			fall_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.043, 0.052, 0.069, 0.087, 0.157, 0.263, 0.395")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.130;
		min_pulse_width_high	: 0.048;
		min_period		: 0.926;
		max_transition		: 0.750;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("14.487, 14.487")
        		}
        		fall_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("14.835, 14.835")
			}	
			fall_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH16x24_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.053, 0.053")
                 }
         }
	}

