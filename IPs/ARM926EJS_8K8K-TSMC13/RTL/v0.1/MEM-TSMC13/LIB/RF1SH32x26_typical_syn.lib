			  "1.389, 1.402, 1.426, 1.451, 1.549, 1.697, 1.881" \
			)
			}
			rise_transition(RF1SH32x26_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.079, 0.105, 0.157, 0.209, 0.415, 0.725, 1.113")
			}
			cell_fall(RF1SH32x26_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.984, 0.991, 1.004, 1.017, 1.069, 1.147, 1.245", \
			  "1.002, 1.009, 1.022, 1.035, 1.087, 1.165, 1.263", \
			  "1.025, 1.031, 1.044, 1.057, 1.110, 1.188, 1.286", \
			  "1.070, 1.076, 1.089, 1.102, 1.155, 1.233, 1.331", \
			  "1.160, 1.167, 1.180, 1.193, 1.245, 1.323, 1.421", \
			  "1.340, 1.347, 1.360, 1.373, 1.425, 1.504, 1.602", \
			  "1.431, 1.437, 1.450, 1.463, 1.515, 1.594, 1.692" \
			)
			}
			fall_transition(RF1SH32x26_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.054, 0.066, 0.090, 0.114, 0.209, 0.352, 0.531")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.204;
		min_pulse_width_high	: 0.065;
		min_period		: 1.323;
		max_transition		: 1.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH32x26_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("12.158, 12.158")
        		}
        		fall_power(RF1SH32x26_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH32x26_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("12.497, 12.497")
			}	
			fall_power(RF1SH32x26_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x26_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.039, 0.039")
                 }
         }
	}

