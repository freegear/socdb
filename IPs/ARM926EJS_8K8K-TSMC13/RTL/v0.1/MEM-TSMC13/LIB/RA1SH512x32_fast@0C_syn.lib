			  "0.825, 0.836, 0.846, 0.868, 0.927, 1.013, 1.103", \
			  "0.858, 0.868, 0.879, 0.901, 0.960, 1.046, 1.135", \
			  "0.890, 0.901, 0.912, 0.933, 0.993, 1.078, 1.168", \
			  "0.915, 0.926, 0.937, 0.958, 1.017, 1.103, 1.193" \
			)
			}
			fall_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.047, 0.059, 0.071, 0.095, 0.160, 0.266, 0.403")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.176
		clock	: true;
		min_pulse_width_low	: 0.112;
		min_pulse_width_high	: 0.042;
		min_period		: 0.967;
		max_transition		: 0.750;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("58.257, 58.257")
        		}
        		fall_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("70.420, 70.420")
			}	
			fall_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.029, 0.029")
                 }
         }
	}

