			  "0.950, 0.959, 0.977, 0.995, 1.040, 1.097, 1.169" \
			)
			}
			rise_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.029, 0.048, 0.087, 0.125, 0.277, 0.506, 0.791")
			}
			cell_fall(RF1SH32x30_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.659, 0.667, 0.685, 0.703, 0.748, 0.805, 0.877", \
			  "0.674, 0.683, 0.701, 0.718, 0.764, 0.821, 0.893", \
			  "0.694, 0.703, 0.720, 0.738, 0.783, 0.841, 0.913", \
			  "0.733, 0.742, 0.760, 0.778, 0.823, 0.880, 0.952", \
			  "0.812, 0.821, 0.839, 0.857, 0.902, 0.959, 1.031", \
			  "0.891, 0.900, 0.918, 0.935, 0.981, 1.038, 1.110", \
			  "0.950, 0.959, 0.977, 0.995, 1.040, 1.097, 1.169" \
			)
			}
			fall_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.043, 0.052, 0.069, 0.087, 0.157, 0.263, 0.395")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.130;
		min_pulse_width_high	: 0.048;
		min_period		: 0.948;
		max_transition		: 0.750;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("17.716, 17.716")
        		}
        		fall_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("18.198, 18.198")
			}	
			fall_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x30_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.061, 0.061")
                 }
         }
	}

