			  "1.398, 1.410, 1.435, 1.460, 1.558, 1.706, 1.890" \
			)
			}
			rise_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.079, 0.105, 0.157, 0.209, 0.415, 0.725, 1.113")
			}
			cell_fall(RF1SH32x30_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.993, 0.999, 1.013, 1.026, 1.078, 1.156, 1.254", \
			  "1.011, 1.017, 1.031, 1.044, 1.096, 1.174, 1.272", \
			  "1.033, 1.040, 1.053, 1.066, 1.118, 1.197, 1.295", \
			  "1.079, 1.085, 1.098, 1.111, 1.163, 1.242, 1.340", \
			  "1.169, 1.175, 1.188, 1.201, 1.254, 1.332, 1.430", \
			  "1.349, 1.356, 1.369, 1.382, 1.434, 1.512, 1.610", \
			  "1.439, 1.446, 1.459, 1.472, 1.524, 1.603, 1.700" \
			)
			}
			fall_transition(RF1SH32x30_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.054, 0.066, 0.090, 0.114, 0.209, 0.352, 0.531")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.204;
		min_pulse_width_high	: 0.065;
		min_period		: 1.334;
		max_transition		: 1.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("13.642, 13.642")
        		}
        		fall_power(RF1SH32x30_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("14.020, 14.020")
			}	
			fall_power(RF1SH32x30_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH32x30_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.043, 0.043")
                 }
         }
	}

