			  "2.230, 2.249, 2.287, 2.324, 2.475, 2.701, 2.984" \
			)
			}
			rise_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.078, 0.118, 0.198, 0.278, 0.597, 1.076, 1.675")
			}
			cell_fall(RF1SH16x24_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "1.539, 1.549, 1.570, 1.591, 1.674, 1.800, 1.956", \
			  "1.559, 1.569, 1.590, 1.611, 1.695, 1.820, 1.977", \
			  "1.584, 1.594, 1.615, 1.636, 1.720, 1.845, 2.002", \
			  "1.634, 1.645, 1.666, 1.687, 1.770, 1.896, 2.052", \
			  "1.786, 1.796, 1.817, 1.838, 1.921, 2.047, 2.203", \
			  "2.038, 2.048, 2.069, 2.090, 2.174, 2.299, 2.456", \
			  "2.290, 2.300, 2.321, 2.342, 2.426, 2.551, 2.708" \
			)
			}
			fall_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.131, 0.150, 0.189, 0.227, 0.381, 0.612, 0.901")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.058
		clock	: true;
		min_pulse_width_low	: 0.370;
		min_pulse_width_high	: 0.102;
		min_period		: 2.073;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("8.448, 8.448")
        		}
        		fall_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("8.727, 8.727")
			}	
			fall_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH16x24_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.024, 0.024")
                 }
         }
	}

