		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.083
		clock	: true;
		min_pulse_width_low	: 0.888;
		min_pulse_width_high	: 0.140;
		min_period		: 1.628;
		max_transition		: 1.500;
		internal_power(){
			when : "(!CEN \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("34.562, 34.562")
        		}
			fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("39.084, 39.084")
        		}
        		fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_on_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.175, 0.175")
                 }
         }
	}

