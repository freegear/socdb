		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.086
		clock	: true;
		min_pulse_width_low	: 0.525;
		min_pulse_width_high	: 0.083;
		min_period		: 1.006;
		max_transition		: 0.800;
		internal_power(){
			when : "(!CEN \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("46.753, 46.753")
        		}
			fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("52.171, 52.171")
        		}
        		fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_on_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.203, 0.203")
                 }
         }
	}

