//      name:			SRAM-SP-HS-HC SRAM Generator
//           			TSMC CL013G Process
//      version:		2004Q2V1
//      comment:		
//      configuration:	 -instname "RA1SH512x32_on" -words 512 -bits 32 -frequency 100 -ring_width 4 -mux 8 -drive 6 -write_mask on -wp_size 8 -redundancy off -redundancy_bits 1 -top_layer met6 -power_type rings -horiz met3 -vert met2 -cust_comment "" -left_bus_delim "[" -right_bus_delim "]" -pwr_gnd_rename "VDD:VDD,GND:VSS" -prefix "" -pin_space 0.0 -name_case upper -check_instname on -diodes on -inside_ring_type GND -fuse_encoding encoded -insert_fuse yes -fusebox_name FUSE -rtl_style mux
//
//      Tetramax model for Synchronous Single-Port Ram
//
//      Instance Name:  RA1SH512x32_on
//      Words:          512
//      Word Width:     32
//      Pipeline:       No
//
//      Creation Date:  2006-12-19 02:09:00Z
//      Verified With: TetraMax 2002.05
//
//      Modeling Assumptions: This model is for use by only TetraMax ATPG tool.
//      It is not intended to be used by any Verilog Simulator.
//
//      Modeling Limitations: These models have limited functionality and x
//      handling as defined by the TetraMax modelling guidelines. These models are
//      developed on Verilog syntax but they don't fully represent the 
//      functionality of the memory models as they are restricted by 
//      the ATPG tool.  During the read/write  contention the 
//      memory location is written with correct data but
//      the outputs are set to "X". During the write/write 
//      contention the memory location is written with "X" data and
//      the outputs are set to "X". The tetramax 2001.08 will generate wrong ATPG
//      vectors for dual port RAM if full sequential ATPG engine is used. We have used
//      fast sequential ATPG engine for verification of all the memories on
//      recommendation from Synopsys Tetramax expert. The models have been tested 
//      by generating the ATPG vectors and simulating them as well as running functional 
//      vectors through tetramax logical simulation engine.
//
//      Known Bugs: None.
//
//      Known Work Arounds: N/A
//
`timescale 1 ns/1 ps
module data_switch (q, s1, s2, d2, d3, clk);
  output q;
  input s1,s2,d2,d3,clk;
  _MUX m2 (s2, d3, d2, n2);
  _MUX m1 (s1, n2, q, n1);
  _DFF r1 (1'b0, 1'b0, clk, n1, q);
endmodule
`celldefine
`define read_write new

module RA1SH512x32_on (
   Q,
   CLK,
   CEN,
   WEN,
   A,
   D
);
   parameter		   BITS = 32;
   parameter		   word_depth = 512;
   parameter		   addr_width = 9;
   parameter               mask_width = 4 ;
   parameter               wp_size    = 8 ;
//PORT_NAMES
   output [31:0] Q;
   reg [31:0] Q;
   input CLK;
   input CEN;
   input [3:0] WEN;
   input [8:0] A;
   input [31:0] D;
   reg [7:0]	   mem0 [word_depth-1:0];
   reg [15:8]	   mem1 [word_depth-1:0];
   reg [23:16]	   mem2 [word_depth-1:0];
   reg [31:24]	   mem3 [word_depth-1:0];
   reg [31:0] iQ;

event write_event;
supply1 vdd;

   not (NOT_CEN, CEN);
   not (NOT_WEN0, WEN[0]);
   and (RW_BOTH0,NOT_WEN0, NOT_CEN);
   always @ ( posedge CLK ) if ( RW_BOTH0 ) begin mem0[A]=D[7:0]; #0; ->write_event; end
   always @ ( vdd or A or write_event ) iQ[7:0]=mem0[A];
   data_switch (.q(Q[0]), .s1(CEN), .s2(RW_BOTH0), .d2(D[0]), .d3(iQ[0]), .clk(CLK)); 
   data_switch (.q(Q[1]), .s1(CEN), .s2(RW_BOTH0), .d2(D[1]), .d3(iQ[1]), .clk(CLK)); 
   data_switch (.q(Q[2]), .s1(CEN), .s2(RW_BOTH0), .d2(D[2]), .d3(iQ[2]), .clk(CLK)); 
   data_switch (.q(Q[3]), .s1(CEN), .s2(RW_BOTH0), .d2(D[3]), .d3(iQ[3]), .clk(CLK)); 
   data_switch (.q(Q[4]), .s1(CEN), .s2(RW_BOTH0), .d2(D[4]), .d3(iQ[4]), .clk(CLK)); 
   data_switch (.q(Q[5]), .s1(CEN), .s2(RW_BOTH0), .d2(D[5]), .d3(iQ[5]), .clk(CLK)); 
   data_switch (.q(Q[6]), .s1(CEN), .s2(RW_BOTH0), .d2(D[6]), .d3(iQ[6]), .clk(CLK)); 
   data_switch (.q(Q[7]), .s1(CEN), .s2(RW_BOTH0), .d2(D[7]), .d3(iQ[7]), .clk(CLK)); 
   not (NOT_WEN1, WEN[1]);
   and (RW_BOTH1,NOT_WEN1, NOT_CEN);
   always @ ( posedge CLK ) if ( RW_BOTH1 ) begin mem1[A]=D[15:8]; #0; ->write_event; end
   always @ ( vdd or A or write_event ) iQ[15:8]=mem1[A];
   data_switch (.q(Q[8]), .s1(CEN), .s2(RW_BOTH1), .d2(D[8]), .d3(iQ[8]), .clk(CLK)); 
   data_switch (.q(Q[9]), .s1(CEN), .s2(RW_BOTH1), .d2(D[9]), .d3(iQ[9]), .clk(CLK)); 
   data_switch (.q(Q[10]), .s1(CEN), .s2(RW_BOTH1), .d2(D[10]), .d3(iQ[10]), .clk(CLK)); 
   data_switch (.q(Q[11]), .s1(CEN), .s2(RW_BOTH1), .d2(D[11]), .d3(iQ[11]), .clk(CLK)); 
   data_switch (.q(Q[12]), .s1(CEN), .s2(RW_BOTH1), .d2(D[12]), .d3(iQ[12]), .clk(CLK)); 
   data_switch (.q(Q[13]), .s1(CEN), .s2(RW_BOTH1), .d2(D[13]), .d3(iQ[13]), .clk(CLK)); 
   data_switch (.q(Q[14]), .s1(CEN), .s2(RW_BOTH1), .d2(D[14]), .d3(iQ[14]), .clk(CLK)); 
   data_switch (.q(Q[15]), .s1(CEN), .s2(RW_BOTH1), .d2(D[15]), .d3(iQ[15]), .clk(CLK)); 
   not (NOT_WEN2, WEN[2]);
   and (RW_BOTH2,NOT_WEN2, NOT_CEN);
   always @ ( posedge CLK ) if ( RW_BOTH2 ) begin mem2[A]=D[23:16]; #0; ->write_event; end
   always @ ( vdd or A or write_event ) iQ[23:16]=mem2[A];
   data_switch (.q(Q[16]), .s1(CEN), .s2(RW_BOTH2), .d2(D[16]), .d3(iQ[16]), .clk(CLK)); 
   data_switch (.q(Q[17]), .s1(CEN), .s2(RW_BOTH2), .d2(D[17]), .d3(iQ[17]), .clk(CLK)); 
   data_switch (.q(Q[18]), .s1(CEN), .s2(RW_BOTH2), .d2(D[18]), .d3(iQ[18]), .clk(CLK)); 
   data_switch (.q(Q[19]), .s1(CEN), .s2(RW_BOTH2), .d2(D[19]), .d3(iQ[19]), .clk(CLK)); 
   data_switch (.q(Q[20]), .s1(CEN), .s2(RW_BOTH2), .d2(D[20]), .d3(iQ[20]), .clk(CLK)); 
   data_switch (.q(Q[21]), .s1(CEN), .s2(RW_BOTH2), .d2(D[21]), .d3(iQ[21]), .clk(CLK)); 
   data_switch (.q(Q[22]), .s1(CEN), .s2(RW_BOTH2), .d2(D[22]), .d3(iQ[22]), .clk(CLK)); 
   data_switch (.q(Q[23]), .s1(CEN), .s2(RW_BOTH2), .d2(D[23]), .d3(iQ[23]), .clk(CLK)); 
   not (NOT_WEN3, WEN[3]);
   and (RW_BOTH3,NOT_WEN3, NOT_CEN);
   always @ ( posedge CLK ) if ( RW_BOTH3 ) begin mem3[A]=D[31:24]; #0; ->write_event; end
   always @ ( vdd or A or write_event ) iQ[31:24]=mem3[A];
   data_switch (.q(Q[24]), .s1(CEN), .s2(RW_BOTH3), .d2(D[24]), .d3(iQ[24]), .clk(CLK)); 
   data_switch (.q(Q[25]), .s1(CEN), .s2(RW_BOTH3), .d2(D[25]), .d3(iQ[25]), .clk(CLK)); 
   data_switch (.q(Q[26]), .s1(CEN), .s2(RW_BOTH3), .d2(D[26]), .d3(iQ[26]), .clk(CLK)); 
   data_switch (.q(Q[27]), .s1(CEN), .s2(RW_BOTH3), .d2(D[27]), .d3(iQ[27]), .clk(CLK)); 
   data_switch (.q(Q[28]), .s1(CEN), .s2(RW_BOTH3), .d2(D[28]), .d3(iQ[28]), .clk(CLK)); 
   data_switch (.q(Q[29]), .s1(CEN), .s2(RW_BOTH3), .d2(D[29]), .d3(iQ[29]), .clk(CLK)); 
   data_switch (.q(Q[30]), .s1(CEN), .s2(RW_BOTH3), .d2(D[30]), .d3(iQ[30]), .clk(CLK)); 
   data_switch (.q(Q[31]), .s1(CEN), .s2(RW_BOTH3), .d2(D[31]), .d3(iQ[31]), .clk(CLK)); 
endmodule
`endcelldefine
`undef read_write
