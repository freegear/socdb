			  "0.837, 0.847, 0.858, 0.879, 0.936, 1.011, 1.095", \
			  "0.860, 0.870, 0.880, 0.901, 0.958, 1.033, 1.117" \
			)
			}
			rise_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.031, 0.053, 0.076, 0.121, 0.245, 0.448, 0.707")
			}
			cell_fall(RA1SH512x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ( \
			  "0.748, 0.758, 0.769, 0.789, 0.847, 0.922, 1.005", \
			  "0.754, 0.764, 0.775, 0.795, 0.853, 0.928, 1.011", \
