			  "0.776, 0.787, 0.797, 0.818, 0.875, 0.950, 1.034", \
			  "0.807, 0.817, 0.827, 0.848, 0.906, 0.981, 1.064", \
			  "0.837, 0.847, 0.858, 0.879, 0.936, 1.011, 1.095", \
			  "0.860, 0.870, 0.880, 0.901, 0.958, 1.033, 1.117" \
			)
			}
			fall_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.042, 0.053, 0.065, 0.088, 0.151, 0.255, 0.387")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.171
		clock	: true;
		min_pulse_width_low	: 0.106;
		min_pulse_width_high	: 0.037;
		min_period		: 0.905;
		max_transition		: 0.750;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("56.872, 56.872")
        		}
        		fall_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("69.340, 69.340")
			}	
			fall_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.026, 0.026")
                 }
         }
	}

