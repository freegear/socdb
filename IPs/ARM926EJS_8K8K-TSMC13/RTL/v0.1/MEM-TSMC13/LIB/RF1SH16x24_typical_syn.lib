			}
			rise_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.079, 0.105, 0.157, 0.209, 0.415, 0.725, 1.113")
			}
			cell_fall(RF1SH16x24_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
			index_2 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ( \
			  "0.965, 0.971, 0.984, 0.997, 1.049, 1.128, 1.226", \
			  "0.983, 0.989, 1.002, 1.015, 1.068, 1.146, 1.244", \
			  "1.005, 1.012, 1.025, 1.038, 1.090, 1.168, 1.266", \
			  "1.050, 1.057, 1.070, 1.083, 1.135, 1.214, 1.311", \
			  "1.140, 1.147, 1.160, 1.173, 1.225, 1.304, 1.402", \
			  "1.321, 1.327, 1.340, 1.353, 1.406, 1.484, 1.582", \
			  "1.411, 1.417, 1.431, 1.444, 1.496, 1.574, 1.672" \
			)
			}
			fall_transition(RF1SH16x24_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.050, 0.130, 0.250, 0.400");
			values ("0.054, 0.066, 0.090, 0.114, 0.209, 0.352, 0.531")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.061
		clock	: true;
		min_pulse_width_low	: 0.204;
		min_pulse_width_high	: 0.065;
		min_period		: 1.303;
		max_transition		: 1.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("11.163, 11.163")
        		}
        		fall_power(RF1SH16x24_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("11.432, 11.432")
			}	
			fall_power(RF1SH16x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RF1SH16x24_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.037, 0.037")
                 }
         }
	}

