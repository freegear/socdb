			values ("0.035, 0.037, 0.042, 0.050, 0.075, 0.114, 0.158")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.090
		clock	: true;
		min_pulse_width_low	: 0.339;
		min_pulse_width_high	: 0.055;
		min_period		: 0.667;
		max_transition		: 0.500;
		internal_power(){
			when : "(!CEN \
                                 & WEN[3] \
                                 & WEN[2] \
                                 & WEN[1] \
                                 & WEN[0] \
                        	)";
			rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("59.437, 59.437")
        		}
			fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
            		when : "(!CEN & !( \
                            	WEN[3] & \
                            	WEN[2] & \
                            	WEN[1] & \
                            	WEN[0]))";
        		rise_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("66.587, 66.587")
        		}
        		fall_power(RA1SH512x32_on_passive_energy_template_1x2) {
            			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_on_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.251, 0.251")
                 }
         }
	}

