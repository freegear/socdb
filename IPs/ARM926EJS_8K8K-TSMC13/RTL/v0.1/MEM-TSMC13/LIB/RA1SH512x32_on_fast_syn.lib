		max_capacitance : 0.495;
                memory_read() {
			address : A;
		}
		timing() {
			related_pin :	"CLK" ;
			timing_type : rising_edge;
			timing_sense : non_unate;
			cell_rise(RA1SH512x32_on_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.450, 0.500");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.290, 0.292, 0.295, 0.300, 0.316, 0.342, 0.370", \
			  "0.287, 0.290, 0.293, 0.298, 0.314, 0.339, 0.367", \
