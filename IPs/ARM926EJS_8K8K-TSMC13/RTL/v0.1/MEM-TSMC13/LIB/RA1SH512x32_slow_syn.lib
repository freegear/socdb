			  "2.371, 2.392, 2.414, 2.456, 2.573, 2.763, 3.007", \
			  "2.497, 2.518, 2.539, 2.581, 2.698, 2.889, 3.132" \
			)
			}
			rise_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.071, 0.114, 0.158, 0.245, 0.484, 0.876, 1.376")
			}
			cell_fall(RA1SH512x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ( \
			  "2.222, 2.238, 2.254, 2.285, 2.372, 2.515, 2.697", \
			  "2.232, 2.248, 2.264, 2.295, 2.383, 2.525, 2.707", \
			  "2.244, 2.260, 2.276, 2.308, 2.395, 2.538, 2.720", \
			  "2.270, 2.285, 2.301, 2.333, 2.420, 2.563, 2.745", \
			  "2.345, 2.361, 2.377, 2.408, 2.495, 2.638, 2.820", \
			  "2.470, 2.486, 2.502, 2.534, 2.621, 2.763, 2.946", \
			  "2.596, 2.612, 2.627, 2.659, 2.746, 2.889, 3.071" \
			)
			}
			fall_transition(RA1SH512x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.190, 0.370, 0.600");
			values ("0.080, 0.107, 0.133, 0.186, 0.332, 0.571, 0.876")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.151
		clock	: true;
		min_pulse_width_low	: 0.289;
		min_pulse_width_high	: 0.097;
		min_period		: 2.270;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("32.492, 32.492")
        		}
        		fall_power(RA1SH512x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("40.996, 40.996")
			}	
			fall_power(RA1SH512x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH512x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.028, 0.028")
                 }
         }
	}

