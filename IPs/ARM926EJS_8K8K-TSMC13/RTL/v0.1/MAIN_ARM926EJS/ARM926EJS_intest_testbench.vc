//
// Example .vc file for the intest testbench. Modify to reflect your
// libraries and the locations of your ARM926EJS and intest netlists.

+libext+.v

// Cell Library:
//-v /arm/chips/arm926ej-s/artisan/clock_gating_cell/aci/sc/verilog/tsmc18_cg.v
+v /eda/design_kits/avanti/tsmc18/v1.0/verilog/tsmc18os120/zero/mtb_verilog.v
-y /eda/design_kits/avanti/tsmc18/v1.0/verilog/tsmc18os120/zero

// Ram Library:
-y /chips/arm926ej-s/artisan/926_ramviews

+v ../ARM926EJS/dummy_buffer.v

//*** Note: the top level module of the INTEST netlist 'ARM926EJS-intest.v' 
//*** must be re-named to 'ARM926EJS_intest' (from 'ARM926EJS') for use
//*** in the INTEST testbench.

//+v intest_netlist.v
+v ../../synopsys/build_dir/synthesis/data/ARM926EJS-intest.v
//+v ARM926EJS_netlist.v
+v ../../synopsys/build_dir/synthesis/data/ARM926EJS.v

+v ARM926EJS_intest_testbench.v
