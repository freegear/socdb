// File:     libraries.vc
//
// Purpose : Defines the location of site specific libraries or source files
//           required for compilation, such as the location of RAM libraries
//           or DesignWare components.
//
//
// -------------------------------------------------------------------------

// Note: If your libraries contain include files then you will need to add
//       a line pointing to their location, e.g:
// +incdir+/eda/tools/synopsys/default/dw/dw/dw01/src_ver

// site-specific synopsys supplied library dirs
-y /eda/tools/synopsys/default/dw/dw01/src_ver
-y /eda/tools/synopsys/default/dw/dw04/src_ver

// site-specific synopsys supplied source files
-y /eda/tools/synopsys/default/packages/gtech/src_ver
-v /eda/tools/synopsys/default/packages/gtech/src_ver/gtech_lib.v

// other site specific libraries

-y verilog/RAM

-y /chips/arm926ej-s/artisan/926_ramviews


