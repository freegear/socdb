[hdl]
LCDController_lib = $HDS_PROJECT_DIR\LCDController_lib\hdl
[hds]
LCDController_lib = $HDS_PROJECT_DIR\LCDController_lib\hds
[hds_settings]
default_library = LCDController_lib
design_root = LCDController_lib.lcdctr_top(lcdctr_top)lcdctr_top/struct.bd
version = 1
[library_type]
LCDController_lib = regular
[shared]
others = $HDS_TEAM_HOME/shared.hdp
