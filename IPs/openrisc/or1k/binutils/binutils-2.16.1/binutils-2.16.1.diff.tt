   ns32k-*-*n*bsd*)			fmt=aout em=nbsd532 ;;
 
-  openrisc-*-*)				fmt=elf ;;
+  or32-*-*linux*)				fmt=elf ;;
 
   or32-*-rtems*)			fmt=elf ;;
   or32-*-coff)				fmt=coff ;;
