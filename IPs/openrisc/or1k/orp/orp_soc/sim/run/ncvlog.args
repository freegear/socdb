// Defines.
-DEFINE DBG_IF_MODEL
-DEFINE SRAM_GENERIC_REGISTERED


-ERRORMAX 2

// Turn on informative messages.
-MESSAGES
// -NOCOPYRIGHT

// Uncomment the following line to generate a named log file
// -LOGFILE ncvlog.log

// Comment the following line to force recompilation.
-UPDATE

