//
// ncelab.args: Arguments passed to the NC-Verilog elaborator.
// Created by ncprep on Tue Aug 22 14:20:25 2006

// Define ACCESSes.
-ACCESS +wr


-ERRORMAX 2

// Turn on informative messages.
-MESSAGES
// -NOCOPYRIGHT

// Uncomment the following line to generate a named log file
// -LOGFILE ncelab.log


// User Plus Options.
+mess



// Translated Options.
+tcl+sim.tcl
+max_err_count+2


// Top level module(s)
xess_top
or1200_monitor
glbl
audio_codec_if
audio_wb_if
fifo_4095_16
fifo_empty_16
dbg_top
dbg_trace
or1200_sb_fifo
or1200_dpram_32x32
or1200_spram_2048x8
or1200_spram_256x21
or1200_spram_1024x8
or1200_spram_1024x32
or1200_spram_1024x32_bw
eq_compare_v2
and_a_b_notc_v2
and_a_b_c_notd_v2
or_fd_v2
almost_reg_v2
xor_gate_bit_v2
RAMB4_S16
RAMB4_S8
RAMB4_S4
RAMB4_S2
RAM32X1D
BUFG
CLKDLL
lpm_constant
lpm_inv
lpm_and
lpm_or
lpm_xor
lpm_bustri
lpm_mux
lpm_decode
lpm_clshift
lpm_add_sub
lpm_compare
lpm_mult
lpm_divide
lpm_abs
lpm_counter
lpm_latch
lpm_ff
lpm_shiftreg
lpm_ram_dq
lpm_ram_dp
lpm_ram_io
lpm_rom
lpm_fifo
lpm_fifo_dc
lpm_inpad
lpm_outpad
lpm_bipad

// Design snapshot name
-SNAPSHOT worklib.xess_top:v

