//
// ncsim.args: Arguments passed to the NC-Verilog simulator.
// Created by ncprep on Tue Aug 22 14:20:25 2006

// Input file for TCL.
-INPUT sim.tcl


-ERRORMAX 2

// Turn on informative messages.
-MESSAGES
// -NOCOPYRIGHT

// Uncomment the following line to generate a named log file
// -LOGFILE ncsim.log


// User Plus Options.
+mess



// Translated Options.
+tcl+sim.tcl
+max_err_count+2


// Design snapshot name
worklib.xess_top:v

