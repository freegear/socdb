+static int or32_emit_int_cmove (rtx dest, rtx op, rtx true_cond,
+				rtx false_cond);
+int or32_emit_cmove (rtx dest, rtx op, rtx true_cond, rtx false_cond);
+const char *output_cmov (rtx * operands);
+const char *output_bf (rtx * operands);
