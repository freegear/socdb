+
+(define_expand "sibcall"
+  [(parallel [(call (match_operand 0 "" "")
+                    (match_operand 1 "" ""))
+              (use (match_operand 2 "" ""))     ;; next_arg_reg
+              (use (match_operand 3 "" ""))])]  ;; struct_value_size_rtx
+  "TARGET_SIBCALL"
+  "
+{
+  or32_expand_sibcall (0, XEXP (operands[0], 0), operands[1]); 
+  DONE;
