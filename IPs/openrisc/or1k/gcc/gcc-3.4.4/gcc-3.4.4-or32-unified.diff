+          && REG_OK_FOR_BASE_P (XEXP (X, 0))                            \
+          && GET_CODE (XEXP (X, 1)) == CONST_INT)                       \
+        goto ADDR;                                                      \
+      if (GET_CODE (XEXP (X, 1)) == REG                                 \
+          && REG_OK_FOR_BASE_P (XEXP (X, 0))                            \
+          && GET_CODE (XEXP (X, 0)) == CONST_INT)                       \
+        goto ADDR;                                                      \
+    }                                                                   \
+ }
