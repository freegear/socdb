        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENB & !WENB";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("130.564, 130.564")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
