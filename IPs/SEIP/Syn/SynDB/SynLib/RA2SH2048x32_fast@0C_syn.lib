			  "0.895, 0.906, 0.917, 0.939, 0.994, 1.063, 1.130" \
			)
			}
			rise_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.028, 0.054, 0.079, 0.131, 0.279, 0.529, 0.773")
			}
			cell_fall(RA2SH2048x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ( \
			  "0.879, 0.890, 0.901, 0.922, 0.977, 1.046, 1.114", \
			  "0.880, 0.891, 0.902, 0.923, 0.978, 1.047, 1.114", \
			  "0.881, 0.892, 0.903, 0.924, 0.979, 1.048, 1.116", \
			  "0.883, 0.894, 0.905, 0.926, 0.981, 1.051, 1.118", \
			  "0.888, 0.899, 0.909, 0.931, 0.986, 1.055, 1.122", \
			  "0.892, 0.903, 0.914, 0.935, 0.990, 1.059, 1.127", \
			  "0.895, 0.906, 0.917, 0.939, 0.994, 1.063, 1.130" \
			)
			}
			fall_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.029, 0.043, 0.057, 0.085, 0.164, 0.300, 0.431")
		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.180
		clock	: true;
		min_pulse_width_low	: 0.115;
		min_pulse_width_high	: 0.044;
		min_period		: 0.966;
		max_transition		: 0.750;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.652")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("103.704, 103.704")
        		}
        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("130.564, 130.564")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH2048x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.059, 0.059")
                 }
         }
	}

