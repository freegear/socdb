	pin(CLKB) {
		direction : input;
		capacitance : 0.029
		clock	 : true;
		min_pulse_width_low	 : 0.256;
		min_pulse_width_high	 : 0.055;
		min_period		 : 1.122;
                max_transition           : 1.000;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH32x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.018, 0.018")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH32x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("3.930, 3.930")
			}	
			fall_power(RF2SH32x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.564")
			}
		}
	}
   	pin(CLKA) {
		direction : input;
