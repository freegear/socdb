			values ("0.050, 0.070, 0.090, 0.131, 0.248, 0.447, 0.640")
		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.168
		clock	: true;
		min_pulse_width_low	: 0.171;
		min_pulse_width_high	: 0.062;
		min_period		: 1.134;
		max_transition		: 1.000;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.773")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("46.768, 46.768")
        		}
        		fall_power(RA2SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("57.783, 57.783")
			}	
			fall_power(RA2SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH2048x16_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.033, 0.033")
                 }
         }
	}

