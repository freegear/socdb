			  "0.280, 0.282, 0.286, 0.290, 0.307, 0.332, 0.360", \
			  "0.267, 0.270, 0.273, 0.278, 0.294, 0.320, 0.348", \
			  "0.264, 0.267, 0.270, 0.275, 0.291, 0.316, 0.344", \
			  "0.261, 0.263, 0.267, 0.272, 0.288, 0.313, 0.341" \
			)
			}
			fall_transition(RA1SH2048x16_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.035, 0.037, 0.042, 0.050, 0.075, 0.114, 0.158")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.090
		clock	: true;
		min_pulse_width_low	: 0.338;
		min_pulse_width_high	: 0.055;
		min_period		: 0.695;
		max_transition		: 0.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("45.427, 45.427")
        		}
        		fall_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("48.591, 48.591")
			}	
			fall_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH2048x16_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.251, 0.251")
                 }
         }
	}

