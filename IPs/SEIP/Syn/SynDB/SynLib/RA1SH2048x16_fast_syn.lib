			  "0.261, 0.263, 0.267, 0.272, 0.288, 0.313, 0.341" \
			)
			}
			rise_transition(RA1SH2048x16_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.035, 0.042, 0.056, 0.077, 0.148, 0.262, 0.387")
			}
			cell_fall(RA1SH2048x16_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.450, 0.500");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.292, 0.294, 0.298, 0.303, 0.319, 0.344, 0.372", \
			  "0.289, 0.292, 0.295, 0.300, 0.316, 0.342, 0.370", \
