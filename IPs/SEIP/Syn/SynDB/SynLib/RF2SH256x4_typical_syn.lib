		timing() {
			related_pin : "CLKB" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.646")
			}
		}	}
	bus(QA) {
                bus_type : RF2SH256x4_DATA;
        	direction : output;
                memory_read() {
			address : AA;
		}
		timing() {
			related_pin :	"CLKA";
			timing_type : rising_edge;
			timing_sense : non_unate;

			cell_rise(RF2SH256x4_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.800, 1.000");
