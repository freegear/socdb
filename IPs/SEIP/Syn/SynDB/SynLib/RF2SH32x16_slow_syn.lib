		}
		timing() {
			related_pin : "CLKB" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.883")
			}
		}	}
	bus(QA) {
                bus_type : RF2SH32x16_DATA;
        	direction : output;
                memory_read() {
			address : AA;
