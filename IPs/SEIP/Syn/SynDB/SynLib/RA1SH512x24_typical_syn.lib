	memory() {
		type : ram;
		address_width : 9;
		word_width : 24;
	}
	bus(Q)	 {
		bus_type : RA1SH512x24_DATA;
		direction : output;
		max_capacitance : 0.495;
                memory_read() {
			address : A;
		}
		timing() {
			related_pin :	"CLK" ;
			timing_type : rising_edge;
			timing_sense : non_unate;
			cell_rise(RA1SH512x24_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.800");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.968, 0.973, 0.982, 0.996, 1.044, 1.120, 1.203", \
			  "0.967, 0.972, 0.981, 0.996, 1.043, 1.119, 1.203", \
