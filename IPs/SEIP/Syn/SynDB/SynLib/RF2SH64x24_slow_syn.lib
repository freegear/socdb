	pin(CLKB) {
		direction : input;
		capacitance : 0.028
		clock	 : true;
		min_pulse_width_low	 : 0.431;
		min_pulse_width_high	 : 0.086;
		min_period		 : 1.938;
                max_transition           : 1.500;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.015, 0.015")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("5.178, 5.178")
			}	
			fall_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.949")
			}
		}
	}
