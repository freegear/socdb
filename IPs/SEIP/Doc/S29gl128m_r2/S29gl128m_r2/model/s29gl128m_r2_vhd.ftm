<TIMESCALE>1ns</TIMESCALE>
<MODEL>s29gl128m_r2
<FMFTIME>
S29GL128M90TAIR2<SOURCE>AMD S29GLxxxM_00 Rev A + 5 April.30, 2004</SOURCE>
S29GL128M90FAIR2<SOURCE>AMD S29GLxxxM_00 Rev A + 5 April.30, 2004</SOURCE>
<COMMENT> </COMMENT>
<TIMING>
  (DELAY (ABSOLUTE
    (IOPATH A0 DQ0 (30:60:90) (30:60:90))
    (IOPATH A0 DQ1 (8:15:25) (8:15:25))
    (IOPATH CENeg DQ0 (30:60:90) (30:60:90) (4:10:16) (30:60:90) (4:10:16) (30:60:90))
    (IOPATH OENeg DQ0 (8:15:25) (8:15:25) (4:10:16) (8:15:25) (4:10:16) (8:15:25))
    (IOPATH RESETNeg DQ0 () () (0:0:0) () (0:0:0) ())
    (IOPATH CENeg RY (0) (90))
    (IOPATH WENeg RY (0) (90))
  ))
  (TIMINGCHECK
    (SETUP A0 CENeg (0))
    (SETUP A0 OENeg (15))
    (SETUP DQ0 CENeg (45))
    (HOLD CENeg RESETNeg (50))
    (HOLD OENeg WENeg (0))
    (HOLD A0 CENeg (45))
    (HOLD A0 OENeg (0))
    (HOLD DQ0 CENeg (0))
    (HOLD WENeg OENeg (0))
    (WIDTH (negedge RESETNeg) (500))
    (WIDTH (posedge OENeg) (20))
    (WIDTH (negedge WENeg) (35))
    (WIDTH (posedge WENeg) (30))
    (WIDTH (negedge CENeg) (35))
    (WIDTH (posedge CENeg) (25))
    (WIDTH (negedge A0) (90))
  ))
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/WBPB) (DELAY (ABSOLUTE (DEVICE(5000:7500:10000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/POB) (DELAY (ABSOLUTE (DEVICE(15000:30000:45000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/SEO) (DELAY (ABSOLUTE (DEVICE(250000000:500000000:750000000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/HANG) (DELAY (ABSOLUTE (DEVICE(400000000:400000000:400000000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/START_T1) (DELAY (ABSOLUTE (DEVICE(5000:5000:20000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/CTMOUT) (DELAY (ABSOLUTE (DEVICE(50000:50000:50000) ) ) ) )
  (CELL (CELLTYPE "VITALbuf")
    (INSTANCE %LABEL%/READY) (DELAY (ABSOLUTE (DEVICE(20000:20000:20000) ) ) )
</TIMING></FMFTIME>
