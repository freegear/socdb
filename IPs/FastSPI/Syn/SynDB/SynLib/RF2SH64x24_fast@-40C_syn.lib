	pin(CLKB) {
		direction : input;
		capacitance : 0.031
		clock	 : true;
		min_pulse_width_low	 : 0.157;
		min_pulse_width_high	 : 0.039;
		min_period		 : 0.830;
                max_transition           : 0.750;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.025, 0.025")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("8.044, 8.044")
			}	
			fall_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.397")
			}
		}
	}
