			  "0.254, 0.257, 0.260, 0.265, 0.281, 0.307, 0.335" \
			)
			}
			fall_transition(RA1SH2048x8_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.035, 0.037, 0.042, 0.050, 0.075, 0.114, 0.158")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.090
		clock	: true;
		min_pulse_width_low	: 0.338;
		min_pulse_width_high	: 0.055;
		min_period		: 0.671;
		max_transition		: 0.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH2048x8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("29.743, 29.743")
        		}
        		fall_power(RA1SH2048x8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH2048x8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("31.215, 31.215")
			}	
			fall_power(RA1SH2048x8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH2048x8_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.252, 0.252")
                 }
         }
	}

