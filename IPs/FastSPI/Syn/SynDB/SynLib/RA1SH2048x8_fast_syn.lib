	memory() {
		type : ram;
		address_width : 11;
		word_width : 8;
	}
	bus(Q)	 {
		bus_type : RA1SH2048x8_DATA;
		direction : output;
		max_capacitance : 0.495;
                memory_read() {
			address : A;
		}
		timing() {
			related_pin :	"CLK" ;
			timing_type : rising_edge;
			timing_sense : non_unate;
			cell_rise(RA1SH2048x8_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.450, 0.500");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.285, 0.288, 0.291, 0.296, 0.312, 0.338, 0.366", \
			  "0.283, 0.286, 0.289, 0.294, 0.310, 0.335, 0.363", \
