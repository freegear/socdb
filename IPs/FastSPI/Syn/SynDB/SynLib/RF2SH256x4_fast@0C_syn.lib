	pin(CLKB) {
		direction : input;
		capacitance : 0.033
		clock	 : true;
		min_pulse_width_low	 : 0.170;
		min_pulse_width_high	 : 0.043;
		min_period		 : 0.984;
                max_transition           : 0.750;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH256x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.024, 0.024")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH256x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("5.872, 5.872")
			}	
			fall_power(RF2SH256x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.460")
			}
		}
	}
   	pin(CLKA) {
