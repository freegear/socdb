	memory() {
		type : ram;
		address_width : 11;
		word_width : 16;
	}
	bus(QA)	 {
		bus_type : RA2SH2048x16_DATA;
		direction : output;
		max_capacitance : 0.580;
                memory_read() {
			address : AA;
		}
		timing() {
			related_pin :	"CLKA" ;
			timing_type : rising_edge;
			timing_sense : non_unate;
			cell_rise(RA2SH2048x16_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.500, 1.000, 1.500");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ( \
			  "1.986, 2.008, 2.029, 2.071, 2.193, 2.400, 2.602", \
