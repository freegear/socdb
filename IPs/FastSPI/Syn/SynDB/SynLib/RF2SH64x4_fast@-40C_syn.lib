	pin(CLKB) {
		direction : input;
		capacitance : 0.032
		clock	 : true;
		min_pulse_width_low	 : 0.158;
		min_pulse_width_high	 : 0.040;
		min_period		 : 0.752;
                max_transition           : 0.750;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.023, 0.023")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("3.451, 3.451")
			}	
			fall_power(RF2SH64x4_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.368")
			}
		}
	}
   	pin(CLKA) {
		direction : input;
