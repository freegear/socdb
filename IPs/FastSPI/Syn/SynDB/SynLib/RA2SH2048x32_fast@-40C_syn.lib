			  "0.858, 0.868, 0.879, 0.899, 0.951, 1.017, 1.081" \
			)
			}
			rise_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.023, 0.048, 0.073, 0.123, 0.266, 0.508, 0.744")
			}
			cell_fall(RA2SH2048x32_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.750");
			index_2 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ( \
			  "0.836, 0.846, 0.857, 0.877, 0.929, 0.995, 1.059", \
			  "0.837, 0.847, 0.858, 0.879, 0.931, 0.996, 1.060", \
			  "0.838, 0.849, 0.859, 0.880, 0.932, 0.998, 1.062", \
			  "0.841, 0.852, 0.862, 0.883, 0.935, 1.001, 1.065", \
			  "0.847, 0.858, 0.868, 0.889, 0.941, 1.007, 1.071", \
			  "0.853, 0.864, 0.874, 0.895, 0.947, 1.013, 1.077", \
			  "0.858, 0.868, 0.879, 0.899, 0.951, 1.017, 1.081" \
			)
			}
			fall_transition(RA2SH2048x32_load_template) {
			index_1 ("0.000, 0.020, 0.040, 0.080, 0.195, 0.390, 0.580");
			values ("0.028, 0.041, 0.054, 0.080, 0.155, 0.283, 0.407")
		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.178
		clock	: true;
		min_pulse_width_low	: 0.108;
		min_pulse_width_high	: 0.041;
		min_period		: 0.907;
		max_transition		: 0.750;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.616")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("103.207, 103.207")
        		}
        		fall_power(RA2SH2048x32_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("128.961, 128.961")
			}	
			fall_power(RA2SH2048x32_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH2048x32_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.039, 0.039")
                 }
         }
	}

