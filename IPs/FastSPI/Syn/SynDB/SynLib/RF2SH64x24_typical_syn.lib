	pin(CLKB) {
		direction : input;
		capacitance : 0.029
		clock	 : true;
		min_pulse_width_low	 : 0.256;
		min_pulse_width_high	 : 0.055;
		min_period		 : 1.229;
                max_transition           : 1.000;
	        internal_power(){
	    		when : "CENB";
			power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.019, 0.019")
			}
		}
	        internal_power(){
			when : "!CENB";
			rise_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("6.554, 6.554")
			}	
			fall_power(RF2SH64x24_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("0.0, 0.0")
			}	
		}	
		timing() {
			related_pin : "CLKA" ;
			timing_type : setup_rising ;
			rise_constraint(scalar) {
				values ("0.606")
			}
		}
	}
