			  "1.715, 1.718, 1.725, 1.735, 1.769, 1.823, 1.883" \
			)
			}
			fall_transition(RA1SH2048x16_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.140, 0.146, 0.157, 0.173, 0.228, 0.315, 0.411")
		}	}
        }

	pin(CLK) {
		direction : input;
		capacitance : 0.083
		clock	: true;
		min_pulse_width_low	: 0.887;
		min_pulse_width_high	: 0.139;
		min_period		: 1.723;
		max_transition		: 1.500;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("25.954, 25.954")
        		}
        		fall_power(RA1SH2048x16_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("27.462, 27.462")
			}	
			fall_power(RA1SH2048x16_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CEN";
                 power(RA1SH2048x16_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.166, 0.166")
                 }
         }
	}

