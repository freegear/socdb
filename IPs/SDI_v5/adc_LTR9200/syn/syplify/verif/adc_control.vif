vif_set_equiv -translated ADC_STATE_Z[5] ADC_STATE_fast_Z[5]
vif_set_equiv -translated CLK_ADCCLK_1d_Z CLK_ADCCLK_1d_fast_Z
vif_set_equiv -translated rADCCON_Z[2] rADCCON_fast_Z[2]

