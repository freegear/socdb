set_location_assignment PIN_AA27 -to sm_addr_dummy
set_location_assignment PIN_Y29 -to sm_clr_counter
set_location_assignment PIN_AA25 -to sm_get_data
set_location_assignment PIN_Y28 -to sm_data_dummy
