#-- Synplicity, Inc.
#-- Version Synplify Pro 8.1
#-- Project file D:\data\timer_pwm\syn\syplify\proj_1.prj
#-- Written on Sat Feb 25 11:50:53 2006


#add_file options
add_file -verilog "D:/data/timer_pwm/rtl/timer_pwm.v"


#implementation: "syplify"
impl -add syplify

#device options
set_option -technology VIRTEX2
set_option -part XC2V8000
set_option -package FF1517
set_option -speed_grade -4

#compilation/mapping options
set_option -default_enum_encoding default
set_option -symbolic_fsm_compiler 1
set_option -resource_sharing 1
set_option -use_fsm_explorer 0
set_option -top_module "timer_pwm"

#map options
set_option -frequency auto
set_option -run_prop_extract 0
set_option -fanout_limit 10000
set_option -disable_io_insertion 0
set_option -pipe 0
set_option -update_models_cp 0
set_option -verification_mode 0
set_option -fixgatedclocks 0
set_option -modular 0
set_option -retiming 0
set_option -no_sequential_opt 0

#simulation options
set_option -write_verilog 0
set_option -write_vhdl 0

#VIF options
set_option -write_vif 1

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "./timer_pwm.edf"

#
#implementation attributes

set_option -vlog_std v2001
set_option -dup 0
set_option -project_relative_includes 1

#par_1 attributes
set_option -job par_1 -add par
set_option -job par_1 -option run_backannotation 0
impl -active "syplify"
