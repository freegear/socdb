#/* Enable Verilog HDL preprocessor */
set hdlin_enable_vpp true

set RTL_PATH "../rtl/256Ecc"
set search_path [concat $search_path $RTL_PATH]

read_verilog NFAPBIF.v
read_verilog NFBoot.v
read_verilog NFCmdQ.v
read_verilog NFDFIFO.v
read_verilog NFCtrl.v
read_verilog NFEcc.v
read_verilog NFMainEcc8.v
read_verilog NFMainEcc16.v
read_verilog NFSpareEcc8.v
read_verilog NFSpareEcc16.v
read_verilog NFRnBFilter.v
read_verilog NFTop.v

set current_design NFTop

