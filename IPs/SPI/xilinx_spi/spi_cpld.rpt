    s_instcode<5>.CE = pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;
    s_instcode<5>.AR = !fpga_init * !fpga_done;

s_instcode<4> := s_instcode<3>;
   s_instcode<4>.CLK  =  !fpga_cclk;	// GCK
    s_instcode<4>.CE = pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;
    s_instcode<4>.AR = !fpga_init * !fpga_done;

s_instcode<3> := s_instcode<2>;
   s_instcode<3>.CLK  =  !fpga_cclk;	// GCK
    s_instcode<3>.CE = pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;
    s_instcode<3>.AP = !fpga_init * !fpga_done;

s_instcode<2> := s_instcode<1>;
   s_instcode<2>.CLK  =  !fpga_cclk;	// GCK
    s_instcode<2>.CE = pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;
    s_instcode<2>.AR = !fpga_init * !fpga_done;

s_instcode<1> := s_instcode<0>;
   s_instcode<1>.CLK  =  !fpga_cclk;	// GCK
    s_instcode<1>.CE = pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;
    s_instcode<1>.AP = !fpga_init * !fpga_done;

s_instcode<0>.T := pres_state_FFD1 * !pres_state_FFD3 * 
