!spi_holdn = fpga_done * !ext_spi * !fpga_io_holdn;

!spi_sn = fpga_done * !fpga_io_sn
	# !fpga_done * !s_spi_sn;
   spi_sn.OE  =  !ext_spi;	// GTS

!s_spi_sn := pres_state_FFD1 * !pres_state_FFD3
	# pres_state_FFD1 * pres_state_FFD2;
   s_spi_sn.CLK  =  !fpga_cclk;	// GCK
