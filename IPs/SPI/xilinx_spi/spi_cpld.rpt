; Implemented Equations.

!fpga_din = !spi_q * !dummybits;
   fpga_din.OE  =  !ext_spi;	// GTS

dummybits := pres_state_FFD1 * !pres_state_FFD3
	# !pres_state_FFD3 * !pres_state_FFD2;
   dummybits.CLK  =  !fpga_cclk;	// GCK
    dummybits.AP = !fpga_init * !fpga_done;

pres_state_FFD1 := pres_state_FFD1 * !pres_state_FFD3
	# pres_state_FFD1 * pres_state_FFD2 * !fpga_done
	# !pres_state_FFD3 * !pres_state_FFD2 * !fpga_done;
   pres_state_FFD1.CLK  =  fpga_cclk;	// GCK
    pres_state_FFD1.AR = !fpga_init * !fpga_done;

pres_state_FFD3 := pres_state_FFD3 * pres_state_FFD2
	# pres_state_FFD1 * pres_state_FFD2 * s_count<0> * 
	s_count<1> * s_count<2> * !s_count<3> * !s_count<4> * 
	s_count<5>;
   pres_state_FFD3.CLK  =  fpga_cclk;	// GCK
    pres_state_FFD3.AR = !fpga_init * !fpga_done;

pres_state_FFD2.T := !pres_state_FFD1 * !pres_state_FFD3 * 
	pres_state_FFD2
	# pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2 * s_count<0> * s_count<1> * s_count<2> * 
	!s_count<3> * !s_count<4> * !s_count<5>;
   pres_state_FFD2.CLK  =  fpga_cclk;	// GCK
    pres_state_FFD2.AR = !fpga_init * !fpga_done;

s_count<0>.T := pres_state_FFD1 * !pres_state_FFD3;
   s_count<0>.CLK  =  fpga_cclk;	// GCK
    s_count<0>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

s_count<1>.T := pres_state_FFD1 * !pres_state_FFD3 * s_count<0>;
   s_count<1>.CLK  =  fpga_cclk;	// GCK
    s_count<1>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

s_count<2>.T := pres_state_FFD1 * !pres_state_FFD3 * s_count<0> * 
	s_count<1>;
   s_count<2>.CLK  =  fpga_cclk;	// GCK
    s_count<2>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

s_count<3>.T := pres_state_FFD1 * !pres_state_FFD3 * s_count<0> * 
	s_count<1> * s_count<2>;
   s_count<3>.CLK  =  fpga_cclk;	// GCK
    s_count<3>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

s_count<4>.T := pres_state_FFD1 * !pres_state_FFD3 * s_count<0> * 
	s_count<1> * s_count<2> * s_count<3>;
   s_count<4>.CLK  =  fpga_cclk;	// GCK
    s_count<4>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

s_count<5>.T := pres_state_FFD1 * !pres_state_FFD3 * s_count<0> * 
	s_count<1> * s_count<2> * s_count<3> * s_count<4>;
   s_count<5>.CLK  =  fpga_cclk;	// GCK
    s_count<5>.AR = !pres_state_FFD1 * !pres_state_FFD3 * 
	!pres_state_FFD2;

!spi_c = fpga_done * !fpga_io_clk
	# !fpga_done * !fpga_cclk;
   spi_c.OE  =  !ext_spi;	// GTS

!spi_d = !fpga_init * fpga_done
	# !fpga_done * !s_cmd_data;
   spi_d.OE  =  !ext_spi;	// GTS

s_cmd_data := !pres_state_FFD1 * fpga_init * s_cmd_data
	# !pres_state_FFD1 * fpga_done * s_cmd_data
	# pres_state_FFD3 * fpga_init * s_cmd_data
	# pres_state_FFD3 * fpga_done * s_cmd_data
	# !fpga_init * !fpga_done * s_instcode<7>
	# pres_state_FFD1 * !pres_state_FFD3 * 
