   s_cmd_data.CLK  =  !fpga_cclk;	// GCK
    s_cmd_data.AP = !fpga_init * !fpga_done * s_instcode<7>;
    s_cmd_data.AR = !fpga_init * !fpga_done * !s_instcode<7>;

