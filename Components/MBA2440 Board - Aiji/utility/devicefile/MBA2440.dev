//mba2440.dev
//Ver 1.0.0
//***********************************************************//
//This file is referenced by only GUI for debugging purpose. //
//Also, this file effects on all kinds of SFR view and       //
//SMU setting window at options menu in GUI.                 //
//So, the SMU and peripherals/special function register      //
//configuration of a specific device is described.	       //
//Even this file is released with default value, you can     //
//modify it's content for your purpose.                      //
//***********************************************************//	

//----------------------------------------------------------//
//This is the field for initialize system register          //
//First filed(ex SYSCFG)is Register name, second  is system //
//register address and third is initial value and fourth is //
//size of byte and the last is attribute.                   // 	 
//Keyword for Memory Access Attribute each system register  //
//R  <---- read only	                                    // 
//W  <---- write                                           //
//RW <---- read/write                                      //   
//----------------------------------------------------------//
SMU{
WTCON                                  0x53000000     0x0               0x4    W    
INTMSK                                  0x4a000008     0xffffffff        0x4    W    
INTSUBMSK                            0x4a00001c     0x7fff           0x4    W    
LOCKTIME                              0x4c000000     0xffffffff        0x4    W    
MPLLCON                               0x4c000004    0x610102       0x4    W    
CLKDIVN                                 0x4c000014    0x3               0x4    W    
BWSCON                                0x48000000     0x22111110    0x4    W    
BANKCON0                              0x48000004    0x7f0            0x4    W    
BANKCON1                              0x48000008    0x7f0            0x4    W    
BANKCON2                              0x4800000c    0x7f0            0x4    W    
BANKCON3                              0x48000010    0x7f0            0x4    W    
BANKCON4                              0x48000014    0x7f0            0x4    W    
BANKCON5                              0x48000018    0x7f0            0x4    W    
BANKCON6                              0x4800001c    0x18005        0x4    W    
BANKCON7                              0x48000020    0x18005        0x4    W    
REFRESH                                 0x48000024    0xac0492      0x4    W    
BANKSIZE                                0x48000028    0x32             0x4    W    
MRSRB6                                  0x4800002c     0x30             0x4    W    
MRSRB7                                  0x48000030     0x30             0x4    W    
}
//----------------------------------------------------------------//
//This is the field for special function and peripherals register //
//First filed(ex SYSCFG)is Register name, second  is system       //
//register address and third is initial value and fourth is       //
//size of byte and the last is attribute.                         // 	 
//Keyword for Memory Access Attribute each system register        //
//R   <---- read only	                                          // 
//W   <---- write                                                 //
//RW  <---- read/write                                            //   
//----------------------------------------------------------------//
PERIPHERALS{
	DISRC0					0x4b000000	0x00000000	0x4	R
	DISRC1					0x4b000040	0x00000000	0x4	R
	DISRC2					0x4b000080	0x00000000	0x4	R
	DISRC3					0x4b0000c0	0x00000000	0x4	R
	DISRCC0				0x4b000004	0x00000000	0x4	R
	DISRCC1				0x4b000044	0x00000000	0x4	R
	DISRCC2				0x4b000084	0x00000000	0x4	R
	DISRCC3				0x4b0000c4	0x00000000	0x4	R	
	LCDCON1			0x4d000000	0x00000000	0x4	R
	LCDCON2			0x4d000004	0x00000000	0x4	R
	LCDCON3			0x4d000008	0x00000000	0x4	R
	LCDCON4			0x4d00000c	0x00000000	0x4	R
	LCDCON5			0x4d000010	0x00000000	0x4	R
	LCDSADDR1			0x4d000014	0x00000000	0x4	RW
	LCDSASSR2			0x4d000018	0x00000000	0x4	RW
	LCDSASSR3			0x4d00001c	0x00000000	0x4	RW
	REDLUT				0x4d000020	0x00000000	0x4	W
	GREENLUT			0x4d000024	0x00000000	0x4	RW
	DITHMODE			0x4d00004c	0x00000		0x4	RW
	TPAL					0x4d000050	0x00000000	0x4	RW
	LCDINTPND			0x4d000054	0x00		0x4	RW
	LCDSRCPND		0x4d000058	0x00		0x4	RW
	LCDINTMSK			0x4d00005c	0x3		0x4	RW
	LPCSEL				0x4d000060	0x6		0x4	W
}