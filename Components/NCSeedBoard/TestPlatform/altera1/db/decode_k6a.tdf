	w_anode1404w[3..0]	: WIRE;
	w_anode1414w[3..0]	: WIRE;
	w_anode1424w[3..0]	: WIRE;
	w_anode1434w[3..0]	: WIRE;
	w_anode1444w[3..0]	: WIRE;
	w_anode1454w[3..0]	: WIRE;

BEGIN 
	data_wire[2..0] = data[2..0];
	enable_wire1 = (! data[3..3]);
	enable_wire2 = data[3..3];
	eq[] = eq_node[];
	eq_node[] = ( eq_wire2[7..0], eq_wire1[]);
	eq_wire1[] = ( w_anode1373w[3..3], w_anode1363w[3..3], w_anode1353w[3..3], w_anode1343w[3..3], w_anode1333w[3..3], w_anode1323w[3..3], w_anode1313w[3..3], w_anode1296w[3..3]);
	eq_wire2[] = ( w_anode1454w[3..3], w_anode1444w[3..3], w_anode1434w[3..3], w_anode1424w[3..3], w_anode1414w[3..3], w_anode1404w[3..3], w_anode1394w[3..3], w_anode1383w[3..3]);
	w_anode1296w[] = ( (w_anode1296w[2..2] & (! data_wire[2..2])), (w_anode1296w[1..1] & (! data_wire[1..1])), (w_anode1296w[0..0] & (! data_wire[0..0])), enable_wire1);
	w_anode1313w[] = ( (w_anode1313w[2..2] & (! data_wire[2..2])), (w_anode1313w[1..1] & (! data_wire[1..1])), (w_anode1313w[0..0] & data_wire[0..0]), enable_wire1);
	w_anode1323w[] = ( (w_anode1323w[2..2] & (! data_wire[2..2])), (w_anode1323w[1..1] & data_wire[1..1]), (w_anode1323w[0..0] & (! data_wire[0..0])), enable_wire1);
	w_anode1333w[] = ( (w_anode1333w[2..2] & (! data_wire[2..2])), (w_anode1333w[1..1] & data_wire[1..1]), (w_anode1333w[0..0] & data_wire[0..0]), enable_wire1);
	w_anode1343w[] = ( (w_anode1343w[2..2] & data_wire[2..2]), (w_anode1343w[1..1] & (! data_wire[1..1])), (w_anode1343w[0..0] & (! data_wire[0..0])), enable_wire1);
	w_anode1353w[] = ( (w_anode1353w[2..2] & data_wire[2..2]), (w_anode1353w[1..1] & (! data_wire[1..1])), (w_anode1353w[0..0] & data_wire[0..0]), enable_wire1);
	w_anode1363w[] = ( (w_anode1363w[2..2] & data_wire[2..2]), (w_anode1363w[1..1] & data_wire[1..1]), (w_anode1363w[0..0] & (! data_wire[0..0])), enable_wire1);
	w_anode1373w[] = ( (w_anode1373w[2..2] & data_wire[2..2]), (w_anode1373w[1..1] & data_wire[1..1]), (w_anode1373w[0..0] & data_wire[0..0]), enable_wire1);
	w_anode1383w[] = ( (w_anode1383w[2..2] & (! data_wire[2..2])), (w_anode1383w[1..1] & (! data_wire[1..1])), (w_anode1383w[0..0] & (! data_wire[0..0])), enable_wire2);
	w_anode1394w[] = ( (w_anode1394w[2..2] & (! data_wire[2..2])), (w_anode1394w[1..1] & (! data_wire[1..1])), (w_anode1394w[0..0] & data_wire[0..0]), enable_wire2);
	w_anode1404w[] = ( (w_anode1404w[2..2] & (! data_wire[2..2])), (w_anode1404w[1..1] & data_wire[1..1]), (w_anode1404w[0..0] & (! data_wire[0..0])), enable_wire2);
	w_anode1414w[] = ( (w_anode1414w[2..2] & (! data_wire[2..2])), (w_anode1414w[1..1] & data_wire[1..1]), (w_anode1414w[0..0] & data_wire[0..0]), enable_wire2);
	w_anode1424w[] = ( (w_anode1424w[2..2] & data_wire[2..2]), (w_anode1424w[1..1] & (! data_wire[1..1])), (w_anode1424w[0..0] & (! data_wire[0..0])), enable_wire2);
	w_anode1434w[] = ( (w_anode1434w[2..2] & data_wire[2..2]), (w_anode1434w[1..1] & (! data_wire[1..1])), (w_anode1434w[0..0] & data_wire[0..0]), enable_wire2);
	w_anode1444w[] = ( (w_anode1444w[2..2] & data_wire[2..2]), (w_anode1444w[1..1] & data_wire[1..1]), (w_anode1444w[0..0] & (! data_wire[0..0])), enable_wire2);
	w_anode1454w[] = ( (w_anode1454w[2..2] & data_wire[2..2]), (w_anode1454w[1..1] & data_wire[1..1]), (w_anode1454w[0..0] & data_wire[0..0]), enable_wire2);
