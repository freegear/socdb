# ------------------
# start CLOCK(DQSI0)

	# Timing Assignments
	# ==================
set_global_assignment -name FMAX_REQUIREMENT "50 MHz" -section_id DQSI0
set_global_assignment -name DUTY_CYCLE 50 -section_id DQSI0

# end CLOCK(DQSI0)
# ----------------

# ------------------
# start CLOCK(DQSI1)

	# Timing Assignments
	# ==================
set_global_assignment -name FMAX_REQUIREMENT "50 MHz" -section_id DQSI1
set_global_assignment -name DUTY_CYCLE 50 -section_id DQSI1

# end CLOCK(DQSI1)
# ----------------

# -------------------
# start CLOCK(busclk)

	# Timing Assignments
	# ==================
set_global_assignment -name DUTY_CYCLE 50 -section_id busclk
set_global_assignment -name INVERT_BASE_CLOCK OFF -section_id busclk
set_global_assignment -name MULTIPLY_BASE_CLOCK_PERIOD_BY 2 -section_id busclk
set_global_assignment -name DIVIDE_BASE_CLOCK_PERIOD_BY 1 -section_id busclk
set_global_assignment -name BASED_ON_CLOCK_SETTINGS mainclock -section_id busclk

# end CLOCK(busclk)
# -----------------

# ----------------------
# start CLOCK(mainclock)

	# Timing Assignments
	# ==================
set_global_assignment -name FMAX_REQUIREMENT "50 MHz" -section_id mainclock
set_global_assignment -name DUTY_CYCLE 50 -section_id mainclock

# end CLOCK(mainclock)
# --------------------

# ------------------------------
# start TIMEGROUP(mainclk_group)

	# Timing Group Assignments
	# ========================
	set_global_assignment -name TIMEGROUP_MEMBER Clock -section_id mainclk_group
	set_global_assignment -name TIMEGROUP_MEMBER "|TestPlatformCore:Core|ClockResetGen_1s_1s_0_500000_1s:ClockResetGen|SD_CLK_c_c" -section_id mainclk_group

# end TIMEGROUP(mainclk_group)
# ----------------------------

# ------------------------------
# start ENTITY(TestPlatformFPGA)

	# Timing Assignments
	# ==================
set_instance_assignment -name CLOCK_SETTINGS mainclock -to Clock
set_instance_assignment -name CLOCK_SETTINGS DQSI0 -to SD_DQS[0]
set_instance_assignment -name CLOCK_SETTINGS DQSI1 -to SD_DQS[1]

	# Fitter Assignments
	# ==================
set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[0] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgHi"
	set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[1] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgHi"
	set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[0] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgLo"
	set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[1] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgLo"
	set_instance_assignment -name PAD_TO_CORE_DELAY 0 -from SD_DQ[*] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgLo"
	set_instance_assignment -name PAD_TO_CORE_DELAY 0 -from SD_DQ[*] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData1stStgHi"

# end ENTITY(TestPlatformFPGA)
# ----------------------------

set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[0] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData2ndStg"
set_instance_assignment -name PAD_TO_CORE_DELAY 7 -from SD_DQS[1] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData2ndStg"
set_instance_assignment -name PAD_TO_CORE_DELAY 0 -from SD_DQ[*] -to "TestPlatformCore:Core|DDRTop:DDRCtrl|DDRAi:DDRAi|RData2ndStg"

set_global_assignment -name BASED_ON_CLOCK_SETTINGS mainclock -section_id MMC_CLK
set_global_assignment -name MULTIPLY_BASE_CLOCK_PERIOD_BY 16 -section_id MMC_CLK
set_instance_assignment -name CLOCK_SETTINGS MMC_CLK -to "TestPlatformCore:Core|MMCTop:MMCTop|mmc_Prescaler:Prescaler|MMC_CLKOUT_c"

set_instance_assignment -name CLOCK_SETTINGS busclk -to "TestPlatformCore:Core|ClockResetGen_2s_1s_0_500000_1s:ClockResetGen|SD_CLK_c"