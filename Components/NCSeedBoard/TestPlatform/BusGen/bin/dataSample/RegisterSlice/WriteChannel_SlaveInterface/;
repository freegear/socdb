        ProtectEnable = VAL_MASTER->ReadChPort.ProtectEnable;
        WstrbEnable = VAL_MASTER->ReadChPort.WstrbEnable;

        if(VAL_MASTER->modeSitoMi == 0)
            endj = 0;
        else
            endj = VAL_MASTER->RegisterSliceSitoMi;

        endk = (int)ValMAIN.SlaveNumber + 1;
