            Connect[i] = 1;

        //endk = (int)ValMAIN.MasterNumber;
        //getConnectMaster(VAL_SLAVE, Connect);
    }



    endi = 0;
    while(1)
    {
        fgets(buff, (sizeof(char)*120), Fp);

        //Lockport generation
        if(strcmp(buff,"//ENABLE_LOCK\n") == 0)
        {
            if(LockEnable == ENABLE)
            {
                fgets(buff, (sizeof(char)*120), Fp);
                strcpy(buffOut[endi], buff);
            }
            else
            {
                strcpy(buffOut[endi], "");
                fgets(buff, (sizeof(char)*120), Fp);
