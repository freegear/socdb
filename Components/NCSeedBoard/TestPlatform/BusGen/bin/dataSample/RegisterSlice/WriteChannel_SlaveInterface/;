            endj = 0;
        else
            endj = VAL_MASTER->RegisterSliceMtoSi;

        endk = 1; Connect[0] = 1;
    }
    else if (VAL_SLAVE == NULL && ReadWrite == 1)
    {
        LockEnable = VAL_MASTER->ReadChPort.LockEnable;
