#--------------------------------------------------------------
# Clock related
#--------------------------------------------------------------
NET "clk_i" TNM_NET = "clk_i";
TIMESPEC "TS_clk_i" = PERIOD "clk_i" 50 MHz HIGH 50 %;
NET "coreclk" TNM_NET = "coreclk";
TIMESPEC "TS_coreclk" = PERIOD "coreclk" 60 MHz HIGH 50 %;

