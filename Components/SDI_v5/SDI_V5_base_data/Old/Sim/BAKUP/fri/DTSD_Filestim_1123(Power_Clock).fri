  #W  01FF8D00 00000272 word single           # Power Manager:Syscon[3:1][SCLKIV:001 (HCLK/8)  ]
  #W  01FF8D00 00000474 word single           # Power Manager:Syscon[3:1][SCLKIV:001(HCLK/16)  ]
