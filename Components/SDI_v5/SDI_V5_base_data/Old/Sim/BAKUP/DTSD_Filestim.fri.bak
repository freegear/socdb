################################################################################
# Reset Test
################################################################################
# Use the watchdog to reset the system (doesn't reset the FileReader). 

   W  C1000F00 00000001 byte single          # Put Watchdog in test mode
   W  C1000F04 00000001 byte single          # Set WDOGRES high - system should reset

   P  C8000008 00000001 00000001 word single # check PoR bit in RemapPause ResetStatus
   W  C800000C 00000001 word single          # clear PoR bit
   P  C8000008 00000000 00000001 word single # check PoR bit in ResetStatus

   P  C8000004 00000000 00000001 word single # check Remap bit is clear

   W  C4000400 000000FF byte single # set GPIO data direction to output

