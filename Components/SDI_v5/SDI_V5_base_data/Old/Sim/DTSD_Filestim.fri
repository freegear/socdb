#------------------------------------------------------------------------------
# DTSDI002[ARM7] Address Map
#------------------------------------------------------------------------------
# Full Decoding of the Address Map is performed continuously as a function of
#  HADDR. All unused slots are connected to a Default Slave.

#(Boot mode LOW)
# 0x0000_0000 - 0x0010_0000  Internal FLASH               (HSELS0B    )(SMC alias/Internal Flash) 
# 0x0000_0000 - 0x0010_0000  External SRAM0               (HSELS0R    )

#(Boot mode High )
# 0x0010_0000 - 0x0020_0000  External SRAM0               (HSELS0EM   )
# 0x0010_0000 - 0x0020_0000  Internal Flash               (HSELS0IF   )          

# 0x0020_0000 - 0x0010_0000  External SRAM1               (HSELS0     )
# 0x0030_0000 - 0x0020_0000  External SRAM2               (HSELS1     )
# 0x0040_0000 - 0x0050_0000  External SRAM3               (HSELS2     ) 
# 0x01F0_0000 - 0x01F4_0000  Internal FLASH mirror        (HSELS3     ) 
# 0x01FF_0000 - 0x01FF_8000  Internal 24KB SRAM           (HSELS4     ) 
# 0x01FF_8000 - 0x01FF_8100  Internal FLASH Control       (HSELS5     ) 
# 0x01FF_8100 - 0x01FF_8200  External SRAM Bank Control   (HSELS6     ) 
# 0x01FF_8200 - 0x01FF_8E00  APB                          (HSELS7     ) 
# 0x0050_0000 - 0x1F00_0000  Reserve1                     (HSELS_Resv1) 
# 0x01F4_0000 - 0x01FF_0000  Reserve2                     (HSELS_Resv2) 
# 0x01FF_8E00 - 0x0200_0000  Reserve3                     (HSELS_Resv3) 
# 0x0200_0000 - 0xFFFF_FFFF  Abort                        (HSELS_Abort ) 

# APB address map is:
#
# 0x01FF_8200 - 0x01FF_8300 UART                          (PSELS2)  
# 0x01FF_8300 - 0x01FF_8400 I2C0~1                        (PSELS3)
# 0x01FF_8400 - 0x01FF_8500 Timer 0  ~ 7                  (PSELS4)
# 0x01FF_8500 - 0x01FF_8600 PWM   0  ~ 7                  (PSELS5)  
# 0x01FF_8600 - 0x01FF_8700 PWM   8  ~ 15                 (PSELS6)
# 0x01FF_8700 - 0x01FF_8800 PWM   16 ~ 23                 (PSELS7)  
# 0x01FF_8800 - 0x01FF_8900 PWM   24 ~ 31                 (PSELS8) 
# 0x01FF_8900 - 0x01FF_8A00 WDT                           (PSELS9)
# 0x01FF_8A00 - 0x01FF_8B00 GPIO                          (PSELS10)
# 0x01FF_8B00 - 0x01FF_8C00 VIV                           (PSELS11)
# 0x01FF_8C00 - 0x01FF_8D00 ADC IF                        (PSELS12)
# 0x01FF_8D00 - 0x01FF_8E00 Power manager                 (PSELS13)
################################################################################
# Check Peripheral IDs
################################################################################


#   R  01FF8400 00000004 000000FF word single # Timers ID bits 7:0    : Timers 0 data register
#   R  01FF8410 00000008 0000000F word single # Timers ID bits 11:8   : Timers PWM end register

#   R  01FF8900 00000005 000000FF word single # Watchdog load register[0xFFFFFFFF] : WDT Control [0x0030]
#   R  01FF8910 00000008 0000000F word single # Watchdog raw interrupt status[0x0] : WDT interrupt status[0x0000]

#   R  01FF8D00 00000009 000000FF word single # Power Manager:Syscon[0x1070]
#   R  01FF8D04 00000008 0000000F word single # Power Manager:PWMCON[0x0]

#   R  01FF8A00 00000061 000000FF word single # GPIO :Port Data   [0x00]
#   R  01FF8A10 00000000 0000000F word single # GPIO :Port Control[0x00] 

#   R  01FF840C 00000006 000000FF word single # PWM :TCNT0/CV[Current Timer value][0x0000]
#   R  01FF88F0 00000008 0000000F word single # PWM3-7:  PWM's end count value[0xFFFF]

#   R  01FF8B28 00000008 000000FF word single # VIC : I_CSLV0(current nIRQ priority of slave register0[0xFAC688]
#   R  01FF8B34 00000008 0000000F word single # VIC : I_CSLV3(current nIRQ priority of slave register3[0xFAC688]

# System Decoder Test
# Write test pass message to the Tube
#   W  02000000 000000FF word single # set GPIO data direction to output
#   W  01FF8E00 00000054 word single
#   W  01F40000 0000ffd4 word single # T
#   W  00200000 00000065 word single
#   W  00300000 0000ffe5 word single # e
#   W  00400000 00000073 word single
#   W  01F00000 0000fff3 word single # s
#   W  01FF0000 00000074 word single
#   W  01FF8000 0000fff4 word single # t
#   W  01FF8100 00000020 word single
#   W  01FF8200 0000ffa0 word single #
#   W  00500000 00000049 word single
   
#   W  02000004 0000ffc9 word single # I
#   W  01FF8E04 00000044 word single
#   W  01F40004 0000ffc4 word single # D
#   W  00200004 00000073 word single
#   W  00300004 0000fff3 word single # s
#   W  00400004 00000020 word single
#   W  01F00004 0000ffa0 word single #
#   W  01FF0004 0000002d word single
#   W  01FF8004 0000ffad word single # -
#   W  01FF8104 00000020 word single
#   W  01FF8204 0000ffa0 word single #
#   W  00500004 00000044 word single

#(Boot mode)
#   W  00000000 0000ffc4 word single # D
#   W  00000004 0000006f word single
#   W  00000008 0000ffef word single # o
#   W  0000000C 0000006e word single
#   W  00000010 0000ffee word single # n
#   W  00000014 00000065 word single
#   W  00000018 0000ffe5 word single # e
#   W  0000001C 0000000D word single
#   W  00000020 0000008D word single #
   
#   W  00100000 0000ffc4 word single
#   W  00100004 0000006f word single
#   W  00100008 0000ffef word single
#   W  0010000C 0000006e word single
#   W  00100010 0000ffee word single
#   W  00100014 00000065 word single
#   W  00100018 0000ffe5 word single
#   W  0010001C 0000000D word single
#   W  00100020 0000008D word single
   
#================================================================================
# Power Manager
#
#================================================================================
# SCLKDIV Test
# R  Address  Data     [Mask] [Size] [Burst]
# W  Address  Data     [Size] [Burst]

  R  01FF8D00 00001070 00000000 word single # Power Manager:Syscon[0x1070]       
  R  01FF8D04 00000000 00000000 word single # Power Manager:PWMCON[0x0]          
  W  01FF8D00 00001070 word single          # Power Manager:Syscon[3:1][SCLKIV:001(OSC_CLK/2)  ]
  
  R  01FF8D00 00001070 00000000 word single # Power Manager:Syscon[0x1070]       
  R  01FF8D04 00000000 00000000 word single # Power Manager:PWMCON[0x0]   
  
  I  
  L 3
  W  01FF8D04 00000001 word single            # Power Manager:PWMCON[0x1]  
   
  I
  L 3
  
  R  01FF8D00 00001072 00000000 word single # Power Manager:Syscon[0x1070]        
  R  01FF8D04 00000001 00000000 word single # Power Manager:PWMCON[0x0]           
  #W  01FF8D00 00001072 word single          # Power Manager:SYSCON[UCLKDIV:HCLK/2]
  R  01FF8D00 00001072 00000000 word single   # Power Manager:Syscon[0x1070] 


  R  01FF8D04 00000000 00000000 word single # Power Manager:SYSCON[UCLKDIV:HCLK/2] 
  I
  L 3
  #W  01FF8D00 00001070 word single           # Power Manager: START
  
  #R  01FF8D00 0000107E 00000000 word single   # Power Manager:Syscon[0x107E]         
  #R  01FF8D04 00000000 00000000 word single   # Power Manager:Syscon[3:1][SCLKIV:001(OSC_CLK/1024)]
  #W  01FF8D00 00001072 word single            # Power Manager:SYSCON(OSC_CLK/2)
  #W  01FF8D04 00000001 word single            # Power Manager:PWMCON[0x1]  
  
  
  #I
  #L 3 
  #W  01FF8D00  00001071 word single           # Power Manager: STOP 
  
   
   #(Power Manager: ACLKDIV)
  #R  01FF8D04 00000000 FFFFFFFF word single # Power Manager:SYSCON[UCLKDIV:HCLK/2] 
  #I
  #L 3
  W  01FF8D00 00001070 word single           # Power Manager: START
   

#============================================================================
# A/D -Converter Controller & A/D Converter Model Test
# You Should make A/D Factory Testing Logic.[Self Testing]Later
# [Test Purpose Register:Reserved[14:6]
#============================================================================
R  01FF8C00 00000004 00000000 word single
W  01FF8C00 00000002 word single           #Power Suppy ,READ_START : Interrupt Routine      
#R  01FF8C04 00000000 FFFFFFFF word single

#I
#L 1023   
W  01FF8C00 00000032 word single           #Power Suppy ,READ_START : Interrupt Routine,ASEL(AIN6)  
#R  01FF8C00 00000032 00000000 word single 
#R  01FF8C04 00000000 FFFFFFFF word single
#L 3
 
W  01FF8C00 00000011 word single          #Power Suppy ,ADEN:Pending,ASEL(AIN2)
I  
L  1023
P  01FF8C00 00000010 00000000 word single # check ADEN bit    
R  01FF8C00 00000010 00000000 word single # READ ADEN bit
I
L 1023
W  01FF8C00 00000004 word single          #Initial Value Return    

#============================================================================
# Timers Test
#============================================================================
#==================================================================================
#
# PWM Setting Value
#00000080  : Timer Enable
#00000090  : Timer Enable/PWM
#00000088  : Timer Enable/Match&Overflow
#000000A0  : Timer Enable/Capture Falling
#000000A8  : Timer Enable/Capture Rising
#000000B0  : Timer Enable/Capture Both Edge
#000000C0  : Timer Enable/Timer Counter CLR
#00000080  : Timer Enable/Timer Counter START
#00000094  : Timer Enable/External CLock PWM
#00000096  : Timer Enable/External Clock PWMn
#00000014  : Timer Disable/External Clock PWM
#00000090  : Timer Enable/PWM
#====================================================================================
#Timer0
#====================================================================================
R  01FF8408 00000000 00000000 word single #Timer ControlTEN[7]CL[6]OMS[5:3]ICS[2]IVS[1]
R  01FF8404 000000FF 00000000 word single #Timer Prescaler
R  01FF8400 0000FFFF 00000000 word single #Timer Data Register
R  01FF840C 00000000 FFFFFFFF word single #Timer Current Counter Value
R  01FF8410 000000FF FFFFFFFF word single #PWM End Counter Register 

W  01FF8400 00000008 word single          #Timer Data Register
W  01FF8408 00000080 word single          #Timer Control[7:0]=>^TEN[7]CL[6]OMS[5:3]ICS[2]IVS[1] 
W  01FF8404 00000005 word single          #Timer Prescaler => X8
#W  01FF8408 00000090 word single          #Timer Control[7:0]=>^TEN[7]CL[6]^OMS[5:3]ICS[2]IVS[1] => PWM
W  01FF8410 0000000F word single          #PWM End Counter Register => 15
I
L 1023
W  01FF8408 00000090 word single          #Timer Control[7:0]=>^TEN[7]CL[6]^OMS[5:3]^ICS[2]IVS[1] => PWM,Invert Phase
I
L 1023
#R  01FF8400 00000008 00000000 word single #Timer Data Register
#R  01FF8404 00000005 00000000 word single #Timer Prescaler
#R  01FF8408 00000090 00000000 word single #Timer ControlTEN[7]CL[6]OMS[5:3]ICS[2]IVS[1]
