  #I
  #L 3
  W  01FF8D00 00001070 word single           # Power Manager: START
   
#=======================================================================================
# Watchdog Test
#=======================================================================================
W  01FF8900 00000001 word single #WDTCR: ^DIV[5:4][00:16div],^CLKSEL[3]=>0,INTEN[2],^RSTEN[1],^WDTEN[0]=>1 
# WDTCR [5:0] 
#       000111
W  01FF8904 00000002 word single #WDTPSR:2
W  01FF8908 00000100 word single #WDTLDR:0x0100[256d]
R  01FF8900 00000030 00000000 word single #WDTCR: DIV[5:4],CLKSEL[3],INTEN[2],RSTEN[1],WDTEN[0] 
R  01FF8904 0000FFFF 00000000 word single #WDTPSR
R  01FF8908 0000FFFF 00000000 word single #WDTLDR
R  01FF890C 0000FFFF 00000000 word single #WDTVLR
R  01FF8910 00000000 00000000 word single #WDTISR

W  01FF8900 00000005 word single #WDTCR: ^DIV[5:4],^CLKSEL[3],^INTEN[2],RSTEN[1],^WDTEN[0] 
W  01FF8904 00000002 word single #WDTPSR
W  01FF8908 00000100 word single #WDTLDR
W  01FF890C 0000FFFF word single #WDTVLR


R 01FF8900 00000003 00000000 word single #WDTCR: ^DIV[5:4],^CLKSEL[3],INTEN[2],RSTEN[1],^WDTEN[0] 
R 01FF8904 00000002 00000000 word single #WDTPSR
R 01FF8908 00000100 00000000 word single #WDTLDR
R 01FF890C 0000FFFF 00000000 word single #WDTVLR
R 01FF8910 00000000 00000000 word single #WDTISR

P 01FF8910 00000001 00000001 word single #WDTISR Checking Interrupt 
R 01FF8910 00000001 00000000 word single #WDTISR
W 01FF8910 1A1A1A1A word single          #WDTISR Clear Interrupt
P 01FF8910 00000000 00000001 word single #WDTISR Checking Interrupt
R 01FF8910 00000000 00000000 word single #WDTISR

P 01FF8910 00000001 00000001 word single #WDTISR Checking Interrupt  
R 01FF8910 00000001 00000000 word single #WDTISR
I
L 3
W 01FF8900 00000007 word single #WDTCR: ^DIV[5:4],^CLKSEL[3],^INTEN[2],^RSTEN[1],^WDTEN[0]

#=======================================================================================
# Gpio
#=======================================================================================


R 01FF8A00 00000000 FFFFFFFF word single #Gpio0 Data
R 01FF8A04 000000BB FFFFFFFF word single #Gpio1 Data
R 01FF8A08 00000000 FFFFFFFF word single #Gpio2 Data
R 01FF8A0C 000000DD FFFFFFFF word single #Gpio3 Data

R 01FF8A10 00000000 FFFFFFFF word single #Gpio0 Control
R 01FF8A14 00000000 FFFFFFFF word single #Gpio1 Control
R 01FF8A18 00000000 FFFFFFFF word single #Gpio2 Control
R 01FF8A1C 00000000 FFFFFFFF word single #Gpio3 Control

I
L 3
W 01FF8A00 00000011 word single #Gpio0 Data
W 01FF8A04 00000022 word single #Gpio1 Data
W 01FF8A08 00000033 word single #Gpio2 Data
W 01FF8A0C 00000044 word single #Gpio3 Data
I
L 3
W 01FF8A10 00000000 word single #Gpio0 Control
W 01FF8A14 00000000 word single #Gpio1 Control
W 01FF8A18 00000000 word single #Gpio2 Control
W 01FF8A1C 00000000 word single #Gpio3 Control

R 01FF8A00 00000000 FFFFFFFF word single #Gpio0 Data
R 01FF8A04 000000BB FFFFFFFF word single #Gpio1 Data
R 01FF8A08 00000033 FFFFFFFF word single #Gpio2 Data
R 01FF8A0C 000000DD FFFFFFFF word single #Gpio3 Data

I
L 1023

W 01FF8A10 0000BBBB word single #Gpio0_Con0 :1011(Bh)=>Gpio Out & Tout

I
L 3

R 01FF8A10 0000BBBB FFFFFFFF word single #Gpio0 Control
#                                           7 6 5 4 3 2 1 0
W 01FF8A00 00000088 word single #Gpio0 Data[1_0_0_0_1_0_0_0]A

I
L 3

R 01FF8A00 00000088 FFFFFFFF word single #Gpio0 Data


W 01FF8A14 00001111 word single #Gpio0_Con1 :0001(1h)=>Gpio In  & Gpio Out 
I
L 3
#                                           7 6 5 4 3 2 1 0
W 01FF8A04 00000050 word single #Gpio0 Data[0_1_0_1_0_0_0_0]C
R 01FF8A14 00001111 FFFFFFFF word single 

I
L 21
R 01FF8A04 000000FA FFFFFFFF word single #Gpio1 Data

#terminate simulation
     

