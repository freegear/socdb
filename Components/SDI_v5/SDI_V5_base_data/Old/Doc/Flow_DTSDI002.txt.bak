  L 3 ==> IDLE 3번 
    
 always @ (posedge PCLK or negedge PRESETn)
    begin : UARCLKDIV
      if ((!PRESETn))  begin
         UARTDIV_Reg    <=  3'b000 ;
         UARTDIV2       <=  1'b0     ;
         UARTDIV4       <=  1'b0     ;
         UARTDIV8       <=  1'b0     ;
                        end
         else begin //(PRESETn)
         
         UARTDIV2       <=  UARTDIV_Reg[0] ;
         UARTDIV4       <=  UARTDIV_Reg[1] ;
         UARTDIV8       <=  UARTDIV_Reg[2] ;
              //end ??
               
