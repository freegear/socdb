gggg16cp_slow_syn.db \
gggg2c_fast_syn.db \
gggg2c_slow_syn.db \
gggg3c_fast_syn.db \
gggg3c_slow_syn.db \
gggg8c_fast_syn.db \
gggg8c_slow_syn.db \
line_mem850_10c_fast_syn.db \
line_mem850_10c_slow_syn.db \
ram1024x8c_fast_syn.db \
ram1024x8c_slow_syn.db \
spram_850c_fast_syn.db \
spram_850c_slow_syn.db \
sram_8_8ac_fast_syn.db \
sram_8_8ac_slow_syn.db \
sfd32kx8m64p4_010c.db \
phv018_010a.db \
]

set target_library [ list slow.db fast.db tpz973gwc.db tpz973gbc.db \
tpz973g_analogwc.db tpz973g_analogbc.db \
dpram1280cp_fast_syn.db \
dpram1280cp_slow_syn.db \
fiforam64c_fast_syn.db \
fiforam64c_slow_syn.db \
gamma_ramc_fast_syn.db \
gamma_ramc_slow_syn.db \
gggg16cp_fast_syn.db \
gggg16cp_slow_syn.db \
gggg2c_fast_syn.db \
gggg2c_slow_syn.db \
gggg3c_fast_syn.db \
gggg3c_slow_syn.db \
gggg8c_fast_syn.db \
gggg8c_slow_syn.db \
line_mem850_10c_fast_syn.db \
line_mem850_10c_slow_syn.db \
ram1024x8c_fast_syn.db \
ram1024x8c_slow_syn.db \
spram_850c_fast_syn.db \
spram_850c_slow_syn.db \
