# 2005.05.11
# [+] Flash IP & HV PAD
set designer {YS.Chang}
set company {SMT}
set user_home [getenv {HOME}]
set proj_home .
set corner {worst}
set sh_source_uses_search_path {true}
set search_path [list .]


# ---------------------------------------------
# TSMC 018g sc, mem, pad, symbols for TOP
# ---------------------------------------------
set search_path [concat $search_path  /Slibs/artisan/TSMC_0.18-micron-FB/G/aci/sc/synopsys]
set search_path [concat $search_path  /Slibs/artisan/TSMC_0.18-micron-FB/G/fb_TSMCHOME_tpz973g_240c/digital/Front_End/timing_power/tpz973g_240c]
set search_path [concat $search_path  /Slibs/artisan/TSMC_0.18-micron-FB/G/aci/sc/symbols/synopsys]
# set search_path [concat $search_path  /Slibs/artisan/018g/fb_tpz973g_230b/TSMCHOME/digital/synopsys/tpz973g_230a]
set search_path [concat $search_path  /Slibs/tsmc/TSMCHOME/digital/Front_End/timing_power/tpz973g_analog_240a]
set search_path [concat $search_path  /prj10/sm1807/LIB/DB]
# ---------------------------------------------
# TSMC 018 Embeded Flash IP & HV PAD
# ---------------------------------------------
set search_path [concat $search_path /Slibs/artisan/TSMC_0.18-micron-FB/G/flash/Front_End/timing_power/sfd32kx8m64p4_010c]
set search_path [concat $search_path /Slibs/artisan/TSMC_0.18-micron-FB/G/flash/synopsys/phv018_010a]
# ---------------------------------------------
# TSMC 015g mixed PLL
# ---------------------------------------------
