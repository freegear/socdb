-------------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           DBI block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints DBI block.
--
-- --======================================================================-- */

/******************************************************************************/
/* DBI BLOCK-SPECIFIC TIMING PARAMETERS                                       */
/******************************************************************************/

/******************************************************************************/
/* HCLK DEFINTION                                                             */
/******************************************************************************/
create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_skew -ideal -plus_uncertainty tpskew find(clock, HCLK)
/* set plus clock skew */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal clock net                                           */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/******************************************************************************/
/* RESET SIGNAL CONSTRAINTS                                                   */
/******************************************************************************/
set_input_delay -clock HCLK -max tidmaxresetn HRESETn
set_input_delay -clock HCLK -min tidminresetn HRESETn

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

set_load 0 HRESETn
/* Zero load reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal reset net                                           */

set_dont_touch_network find(port, HRESETn)
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* Input Delays from the SmcCore module. These outputs are registered and     */
/* will be valid very early in the clock cycle                                */
/******************************************************************************/
tidmaxsmbusreq  = tclk * 0.2         /* SMBUSREQ from SmcCore */
tidmaxsmcdata   = tclk * 0.2         /* SMCDATAOUT and SMCDATAEN input */
tidmaxsmcaddr   = tclk * 0.2         /* SMCADDR */

tidmaxsmbusgntebi  = tclk * 0.5      /* SMBUSGNTEBI from EbiSdram to SmcCore  */

/******************************************************************************/
/* Input Delays from the other Memory Controller                              */
/******************************************************************************/
/* The outputs from the Memory Controller are required to be registered or    */
/* should have small combinational input delay. If delay value greater than   */
/* need to be used, then the DBI output ports constraints need relevant       */
/* changes                                                                    */
tidmaxmcaddr    = tclk * 0.25        /* MCADDR input    */
tidmaxmcdata    = tclk * 0.25        /* MCDATAOUT input */
tidmaxmcdataen  = tclk * 0.25        /* MCDATAEN input  */
tidmaxmcbusreq  = tclk * 0.2         /* MCBUSREQ input  */

/******************************************************************************/
/* Input Delays from the TIC, the TICBUSREQ, TBUSOUT and TICREAD are          */
/* combinational                                                              */
/* The TIC will never be used at high speeds like 95MHz/100MHz, but the       */
/* inputs are constrained so that the TIC related paths in DBI are            */
/* synthesized properly                                                       */
/******************************************************************************/
tidmaxticbusreq = tclk * 0.20       /* TICBUSREQ input signal from TIC        */

tidmaxtbusout   = tclk * 0.2        /* TBUSOUT output data bus. This has a    */
                                    /* combinational delay path from HRDATA   */
                                    /* plus the internal logic                */

tidmaxticread   = tclk * 0.2        /* TICREAD output from TIC                */

tidmaxticbusgntebi  = tclk * 0.6    /* TICBUSGNTEBI from EbiSdram to TIC */

/******************************************************************************/
/* Output Delays                                                              */
/******************************************************************************/

/******************************************************************************/
/* Output Delays of the DBI to the SmcCore block. SMBUSREQ is valid very      */
/* early in the cycle (20%), then SMBUSGNT is routed back with some logic and */
/* it is constrained to be available within 40% of clock                      */
/******************************************************************************/
/* Outputs */
todmaxsmbusgnt  = tclk * 0.6       /* SMBUSGNT output from DBI */

todmaxsmbusreqebi  = tclk * 0.6    /* SMBUSREQEBI output from Smc to EbiSdram */

/******************************************************************************/
/* Output Delays of the DBI to the other Memory Controller. The MCBUSGNT is   */
/* also constrained to be available within 40% of clock                       */
/******************************************************************************/
todmaxmcbusgnt  = tclk * 0.6        /* MCBUSGNT output */

/******************************************************************************/
/* Output Delays of the DBI to the TIC. As TIC will always work at low        */
/* frequency, then at 95MHz/100Mhz the path from the TICBUSREQ through DBI to */
/* the TICBUSGNT is not a valid path and so there is no question of late      */
/* arrival of the TICBUSGNT. This path has relaxed constraints as compared to */
/* the other two Bus Grants as this path need not be optimised for timing     */
/******************************************************************************/
todmaxticbusgnt = tclk * 0.4        /* TICBUSGNT output */

todmaxticbusreqebi = tclk * 0.4     /* TICBUSREQEBI output to EbiSdram */
todmaxticreadebi   = tclk * 0.6     /* TICREADEBI output pad from TIC when    */
                                    /* interfacing with EbiSdram              */
todmaxtbusoutebi   = tclk * 0.6     /* TBUSOUTEBI data bus output from TIC    */
                                    /* when interfacing with EbiSdram         */

/******************************************************************************/
/* INPUT CONSTRAINTS FOR DBI specific input ports                             */
/******************************************************************************/
set_input_delay -clock HCLK -min tholdmax     MCADDR
set_input_delay -clock HCLK -max tidmaxmcaddr MCADDR

set_input_delay -clock HCLK -min tholdmax      SMCADDR
set_input_delay -clock HCLK -max tidmaxsmcaddr SMCADDR

set_input_delay -clock HCLK -min tholdmax     MCDATAOUT
set_input_delay -clock HCLK -max tidmaxmcdata MCDATAOUT

set_input_delay -clock HCLK -min tholdmax      SMCDATAOUT
set_input_delay -clock HCLK -max tidmaxsmcdata SMCDATAOUT

set_input_delay -clock HCLK -min tholdmax      TBUSOUT
set_input_delay -clock HCLK -max tidmaxtbusout TBUSOUT

set_input_delay -clock HCLK -min tholdmax       MCDATAEN
set_input_delay -clock HCLK -max tidmaxmcdataen MCDATAEN

set_input_delay -clock HCLK -min tholdmax      nSMCDATAEN
set_input_delay -clock HCLK -max tidmaxsmcdata nSMCDATAEN

set_input_delay -clock HCLK -min tholdmax      TICREAD
set_input_delay -clock HCLK -max tidmaxticread TICREAD

set_input_delay -clock HCLK -min tholdmax       MCBUSREQ
set_input_delay -clock HCLK -max tidmaxmcbusreq MCBUSREQ

set_input_delay -clock HCLK -min tholdmax        SMBUSREQ
set_input_delay -clock HCLK -max tidmaxsmbusreq  SMBUSREQ

set_input_delay -clock HCLK -min tholdmax        TICBUSREQ
set_input_delay -clock HCLK -max tidmaxticbusreq TICBUSREQ

set_input_delay -clock HCLK -min tholdmax          SMBUSGNTEBI
set_input_delay -clock HCLK -max tidmaxsmbusgntebi SMBUSGNTEBI

set_input_delay -clock HCLK -min tholdmax           TICBUSGNTEBI
set_input_delay -clock HCLK -max tidmaxticbusgntebi TICBUSGNTEBI


/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR DBI OUTPUT PORTS                                    */
/******************************************************************************/
set_output_delay -clock HCLK -min tholdmin     SMDATAOUT
set_output_delay -clock HCLK -max todmaxsmdata SMDATAOUT

set_output_delay -clock HCLK -min tholdmin     nSMDATAEN
set_output_delay -clock HCLK -max todmaxsmdata nSMDATAEN

set_output_delay -clock HCLK -min tholdmin     SMADDR
set_output_delay -clock HCLK -max todmaxsmaddr SMADDR

set_output_delay -clock HCLK -min tholdmin       MCBUSGNT
set_output_delay -clock HCLK -max todmaxmcbusgnt MCBUSGNT

set_output_delay -clock HCLK -min tholdmin       SMBUSGNT
set_output_delay -clock HCLK -max todmaxsmbusgnt SMBUSGNT

set_output_delay -clock HCLK -min tholdmin        TICBUSGNT
set_output_delay -clock HCLK -max todmaxticbusgnt TICBUSGNT

set_output_delay -clock HCLK -min tholdmin          SMBUSREQEBI
set_output_delay -clock HCLK -max todmaxsmbusreqebi SMBUSREQEBI

set_output_delay -clock HCLK -min tholdmin           TICBUSREQEBI
set_output_delay -clock HCLK -max todmaxticbusreqebi TICBUSREQEBI

set_output_delay -clock HCLK -min tholdmin         TICREADEBI
set_output_delay -clock HCLK -max todmaxticreadebi TICREADEBI

set_output_delay -clock HCLK -min tholdmin         TBUSOUTEBI
set_output_delay -clock HCLK -max todmaxtbusoutebi TBUSOUTEBI

/************************* End of DBI.scr *************************************/
