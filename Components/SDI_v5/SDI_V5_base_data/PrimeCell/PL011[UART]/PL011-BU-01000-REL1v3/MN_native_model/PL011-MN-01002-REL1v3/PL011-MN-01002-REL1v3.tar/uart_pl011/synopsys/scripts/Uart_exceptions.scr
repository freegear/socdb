--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing                            
--           constraint script for UART block             
--
--           Located in the synopsys/scripts directory.         
--
--           This file specifies the point-to-point exceptions
--           set for the UART block synthesis.
------------------------------------------------------------------------------*/

/* Set false path from UARTCLK to  PCLK */
set_false_path -from {PCLK} -to {UARTCLK}

/* Set false path from PCLK to  UARTCLK */
set_false_path -from {UARTCLK} -to {PCLK}


/* The UARTINTR and UARTEINTR interrupts outputs are fed by signals generated in */
/* both PCLK and UARTCLK domains. Hence, these outputs are effectively           */
/* asynchronous and will need to be synchronised externally before feeding the   */
/* Interrupt Controller. Any constraint on these asynchronous pins can never     */
/* be accurate; hence false paths are set on these outputs.                      */

/* set_false_path -to UARTINTR */
/* set_false_path -to UARTEINTR */




/*********************End of uart_exceptions.scr*********************************/
