#!/bin/csh

if ($#argv == 0) then
  echo "Need to specify the PERIPH varaiable to be used"
  echo
else

  # Enable required tools
  source /eda/tools/modeltech/5.3c/dotcshrc
  source /eda/tools/transeda/navigator/6.0_modelsim5.2d/dotcshrc
  source /eda/tools/synopsys/dotcshrc 
  source /eda/tools/chrysalis/dotcshrc
  source /eda/tools/transeda/vhdlcover/dotcshrc
  source /eda/tools/cadence/LDV/dotcshrc

  # Usefull alias
  alias run 'bsub -q interactive -Is -R solaris'

  # setenv PERIPH environment variable
  setenv PERIPH $1

  # clean up the existing logs
  make clean

  # compare the RTLs
  run make rtl_check

  # perform the block level validation and generate coverage analysis
  setenv SIMULATOR modelsim
  setenv HDL_SOURCE  vhdl
  run make default cover

  setenv SIMULATOR modelsim
  setenv HDL_SOURCE  verilog
  run make cover

  setenv SIMULATOR LDV
  setenv HDL_SOURCE  verilog
  run make rtl

  # do the synthesis, formal comparison and netlist simulation

  setenv HDL_SOURCE  vhdl
  setenv HDL_NETL    vhdl
  setenv TEST_METH   noscan
  run make netlist
  setenv SIMULATOR modelsim
  run make net_min

  setenv HDL_SOURCE  vhdl
  setenv HDL_NETL    verilog
  setenv TEST_METH   scanready
  run make netlist
  setenv SIMULATOR modelsim
  run make net_typ

  setenv HDL_SOURCE  verilog
  setenv HDL_NETL    verilog
  setenv TEST_METH   scaninsert
  run make netlist
  setenv SIMULATOR LDV
  run make net_max

endif


