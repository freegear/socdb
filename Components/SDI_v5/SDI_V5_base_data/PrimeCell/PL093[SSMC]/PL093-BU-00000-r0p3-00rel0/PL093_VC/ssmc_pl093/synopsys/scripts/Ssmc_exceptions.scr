--
-- -----------------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           Ssmc block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the top level Ssmc block synthesis. 
--
-- --=========================================================================*/
/* SMCLK is a false path */
set_false_path -to find(port, {"SMCLK*"})

/* uSsmcTIC/HRDATAIN to the SMDATAOUT path */
set_false_path -from find(port,HRDATATIC*) -to find(port,{"SMDATAOUT*"})

/******************************************************************************/
/* False paths set for the BIGENDIAN and SMMWCS7 pins which are tied off      */
/******************************************************************************/
set_false_path -setup -from find(port,{"SMBIGENDIAN"})
set_false_path -setup -from find(port,{"SMMWCS7"})
set_false_path -setup -from find(port,{"SMBLS7POL"})

/* False path is set for the EXTBUSMUX tied input which determines whether    */
/* the internal DBI is used or the external EbiSdram will be used             */
set_false_path -setup -from SMEXTBUSMUX

set_false_path -from {SMMEMCLK}        -to {v_SMMEMCLKDELAY}
set_false_path -from {nSMMEMCLK}       -to {SMMEMCLK}
set_false_path -from {HCLK}            -to {v_SMMEMCLKDELAY}
set_false_path -from {v_SMMEMCLKDELAY} -to {SMMEMCLK}
set_false_path -from {v_SMMEMCLKDELAY} -to {HCLK}
set_false_path -from {SMMEMCLKDELAY}   -to {SMMEMCLK}
set_false_path -from {SMMEMCLKDELAY}   -to {HCLK}

/* Set_false_path from all scan related inputs so that the tool should */
/* not try to optimize the scan paths */
set_false_path -from find(port,{"SCANENABLE"})
set_false_path -from find(port,{"SCANINHCLK"})
set_false_path -from find(port,{"SCANINSMMEMCLK"})
set_false_path -from find(port,{"SCANINnSMMEMCLK"})
set_false_path -from find(port,{"SCANINFBCLK*"})
set_false_path -from find(port,{"SCANINCLKDELAY*"})

/************************ End of Ssmc_exceptions.scr **************************/
