ScanStructures {
   ScanChain "c0" {
      ScanLength 903;
      ScanInversion 1; 
      ScanIn "SCANINHCLK";
      ScanOut "SCANOUTHCLK";
   } 
   ScanChain "c1" {
      ScanLength 253;
      ScanInversion 1; 
      ScanIn "SCANINSMMEMCLK";
      ScanOut "SCANOUTSMMEMCLK";
   } 
   ScanChain "c2" {
