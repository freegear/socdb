   } 
} 
Timing {
   WaveformTable "_default_WFT_" {
      Period '100ns';
      Waveforms {
         "all_inputs" { 0 { '5ns' D; } }
         "all_inputs" { 1 { '5ns' U; } }
         "all_inputs" { Z { '5ns' Z; } }
         "all_inputs" { N { '5ns' N; } }
         "all_outputs" { X { '0ns' X; } }
         "all_outputs" { H { '0ns' X; '95ns' H; } }
         "all_outputs" { T { '0ns' X; '95ns' T; } }
         "all_outputs" { L { '0ns' X; '95ns' L; } }
         "HCLK" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMMEMCLK" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "nSMMEMCLK" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMMEMCLKDELAY" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMFBCLK0" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMFBCLK1" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMFBCLK2" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "SMFBCLK3" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "HRESETn" { P { '0ns' U; '45ns' D; '55ns' U; } }
      }
   }
} 
PatternBurst "__burst__" {
   PatList {
      "__pattern__" {
      }
   }
} 
PatternExec {
   PatternBurst "__burst__";
} 
Procedures {
   "load_unload" {
      W "_default_WFT_";
      V {  "HCLK"=0; "HRESETn"=1; "SCANENABLE"=1; "SMFBCLK0"=0;
       "SMFBCLK1"=0; "SMFBCLK2"=0; "SMFBCLK3"=0; "SMMEMCLK"=0;
       "SMMEMCLKDELAY"=0; "nSMMEMCLK"=0; "_so"=########; } 
      Shift { 
         W "_default_WFT_";
         V {  "HCLK"=P; "HRESETn"=1; "SCANENABLE"=1; "SMFBCLK0"=P;
       "SMFBCLK1"=P; "SMFBCLK2"=P; "SMFBCLK3"=P; "SMMEMCLK"=P;
       "SMMEMCLKDELAY"=P; "nSMMEMCLK"=P; "_so"=########; "_si"=########; } 
   }
}
   "capture" {
      W "_default_WFT_";
      V { "_pi"=\r234 #; "_po"=\r250 #; }
   }
   "capture_HCLK" {
      W "_default_WFT_";
      "forcePI": V { "_pi"=\r234 #; }
      "measurePO": V { "_po"=\r250 #; }
      "pulse": V { "HCLK"=P; }
   }
