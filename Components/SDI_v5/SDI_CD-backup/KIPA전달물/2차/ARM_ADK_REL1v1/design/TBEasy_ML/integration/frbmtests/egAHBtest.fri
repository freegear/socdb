#--------------------------------------------------------------------#
#  Purpose             : Write a short message to the example slave
#                        so the example master can read it and write
#                        the text to the tube
#
#====================================================================#

# cmd address  data     mask     size  burst  prot lock   <reg name>
#---------------------------------------------------------------------
   W  D0000000 4D425246          word  INCR4  0000 nolock # "FRBM"
   S           45202620                                   # " & E"
   S           42484167                                   # "GAHB"
   S           0A4B4F20                                   # " OK " + carry-on
#  S           044B4F20                                   # " OK " + end

   R  D0000000  4D425246 FFFFFFFF  word  INCR4  0000 nolock #
   S            45202620 FFFFFFFF
   S            42484167 FFFFFFFF

   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023
   B
   L   1023

   S            044B4F20 FFFFFFFF

