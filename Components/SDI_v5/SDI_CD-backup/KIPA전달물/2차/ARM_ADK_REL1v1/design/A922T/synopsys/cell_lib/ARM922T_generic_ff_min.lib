cell (ARM922T) {
    interface_timing : TRUE;

 
    dont_touch : true;
    dont_use : true;
    area : 0.000; 
    cell_footprint : ARM922T;
 
 
    
    pin(DBGEN) {
        direction : input;
 
        capacitance : 0.053;
    } /* pin  */

    pin(ETMITBIT) {
        direction : output;
        timing() { 
            timing_type : rising_edge; 
            cell_rise (ARM922T_ff_delay_1_4) { 
                values ( \
                "1.85, 1.87, 1.88, 1.90, 1.93, 2.00, 2.04, 2.13, 2.23 ",\
                "1.86, 1.87, 1.88, 1.90, 1.94, 2.01, 2.05, 2.14, 2.23 ",\
                "1.87, 1.88, 1.89, 1.91, 1.95, 2.02, 2.06, 2.15, 2.24 ",\
                "1.87, 1.89, 1.90, 1.92, 1.95, 2.03, 2.06, 2.16, 2.25 ",\
                "1.88, 1.89, 1.90, 1.92, 1.96, 2.03, 2.07, 2.16, 2.25 ",\
                "1.87, 1.89, 1.90, 1.92, 1.95, 2.02, 2.06, 2.15, 2.25 "); 
            } /* path = 1390 */
            rise_transition (ARM922T_ff_transition_1_4) { 
                values ("0.06, 0.08, 0.10, 0.15, 0.25, 0.46, 0.57, 0.84, 1.11");
            }
