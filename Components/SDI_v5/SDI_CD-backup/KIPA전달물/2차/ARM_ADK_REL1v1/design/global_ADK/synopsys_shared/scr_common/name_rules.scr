--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis naming rules.
--
--           Naming rules and the change_names command are used to
--           change the names of cells, nets and ports in a design.
--           This is ensure SDF and netlist files are
--           written out with matching names and no invalid characters.
--           Length of names has been restricted to overcome problems that can
--           occur with some back-end (layout, place-and-route) tools.
--
--           Located in the synopsys/scr_common directory.
--           Called by master compile script.
--------------------------------------------------------------------------------
--
--  1. This script supports basic naming rules.  
--
--  2. 'define_name_rules' can't distinguish instance
--     names and cell names. If instance names have
--     "$" string in your design, Design Compiler
--     displays warning messages which can be ignored.
--     These naming rules permits
--     "$" string of instance names.
--
------------------------------------------------------------------------------*/

/*--------------------------------------------------------------------------*/
/* Naming Rules for VHDL */
/*--------------------------------------------------------------------------*/

/* Explicit rules */
define_name_rules "EASY_VHDL" -max_length "31"  -allowed "A-Z a-z _ 0-9" \
 -first_restricted "0-9 _()" -last_restricted "_" -case_insensitive \
 -type net
define_name_rules "EASY_VHDL" -max_length "31" -allowed "A-Z a-z _ 0-9" \
 -first_restricted "0-9 _()" -last_restricted "_" -case_insensitive \
 -type port
define_name_rules "EASY_VHDL" -max_length "31" -allowed "A-Z a-z _ 0-9" \
 -first_restricted "0-9 _()" -last_restricted "_"  -case_insensitive \
 -type cell
define_name_rules "EASY_VHDL" -reserved_words { \
 'abs', 'access', 'after', 'alias', 'all', 'and', 'architecture', 'array', \
 'assert', 'attribute', 'begin', 'block', 'body', 'buffer', 'bus', 'case', \
 'component', 'configuration', 'constant', 'disconnect', 'downto', 'else', \
 'elsif', 'end', 'entity', 'exit', 'file', 'for', 'function', 'generate', \
 'generic', 'guarded', 'if', 'in', 'inout', 'is', 'label', 'library', 'linkage', \
 'loop', 'map', 'mod', 'nand', 'new', 'next', 'nor', 'not', 'null', 'of', 'on', \
 'open', 'or', 'others', 'out', 'package', 'port', 'procedure', 'process', \
 'range', 'record', 'register', 'rem', 'report', 'return', 'select', 'severity', \
 'signal', 'subtype', 'then, to', 'transport', 'type', 'units', 'until', 'use', \
 'variable', 'wait', 'when', 'while', 'with', 'xor'}
define_name_rules "EASY_VHDL" -replacement_char "_"
define_name_rules "EASY_VHDL" -map {{"__","_"}} -type cell

/* Simplistic rules */
define_name_rules VHDL_simple_names -allowed "A-Za-z0-9_" \
  -last_restricted "_" -first_restricted "0-9_" \
  -map {{"\*cell\*","U"},{"*-return","RET"}};

/* Special vhdl rule to replace consecutive underscores which is invalid VHDL.*/
define_name_rules SPECIAL_VHDL -special vhdl


/*--------------------------------------------------------------------------*/
/* Naming Rules for Verilog */
/*--------------------------------------------------------------------------*/

/* Explicit rules */
define_name_rules "EASY_VLOG" -max_length "31"  -allowed "A-Z a-z _ 0-9[]" \
 -first_restricted "0-9 _()" -last_restricted "_" \
 -type net
define_name_rules "EASY_VLOG" -max_length "31" -allowed "A-Z a-z _ 0-9[]" \
 -first_restricted "0-9 _()" -last_restricted "_" \
 -type port
define_name_rules "EASY_VLOG" -max_length "31" -allowed "A-Z a-z _ 0-9" \
 -first_restricted "0-9 _()" -last_restricted "_" \
 -type cell
define_name_rules "EASY_VLOG" -reserved_words { \
 'always', 'and', 'assign', 'begin', 'buf', 'bufif0', 'bufif1', 'case', \
 'casex', 'casez', 'cmos', 'deassign', 'default', 'defparam', 'disable', \
 'edge', 'else', 'end', 'endattribute', 'endcase', 'endfunction', 'endmodule', \
 'endprimitive', 'endspecify', 'endtable', 'endtask', 'event', 'for', 'force', \
 'forever', 'fork', 'function', 'highz0', 'highz1', 'if', 'initial', 'inout', \
 'input', 'integer', 'join', 'large', 'macromodule', 'medium', 'module', 'nand', \
 'negedge', 'nmos', 'nor', 'not', 'notif0', 'notif1', 'or', 'output', \
 'parameter', 'pmos', 'posedge', 'primitive', 'pull0', 'pull1', 'pullup', \
 'pulldown', 'reg', 'rcmos', 'reg', 'release', 'repeat', 'rnmos', 'rpmos', \
 'rtran', 'rtranif0', 'rtranif1', 'scalared', 'small', 'specify', 'specparam', \
 'strength', 'strong0', 'strong1', 'supply0', 'supply1', 'table', 'task', \
 'time', 'tran', 'tranif0', 'tranif1', 'tri', 'tri0', 'tri1', 'trinand', \
 'trior', 'trireg', 'use', 'vectored', 'wait', 'wand', 'weak0', 'weak1', \
 'while', 'wire', 'wor', 'xor', 'xnor'}

/* Simplistic rules */
define_name_rules VLOG_simple_names -allowed "A-Za-z0-9_[]" \
  -last_restricted "_" -first_restricted "0-9_[]" \
  -map {{"\*cell\*","U"},{"*-return","RET"}};

define_name_rules COLLAPSE -collapse_name_space
/* See note SYNTH-486.html, use recommended to ensure unique/matching Verilog
   names in SDF and netlist. */

/*--------------------------------------------------------------------------*/
/* Prevent bus members from being re-numbered by change_names command
/*--------------------------------------------------------------------------*/
change_names_dont_change_bus_members = "true"


/************************************* End ************************************/
