--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis script
--           to define AMBA APB timing constraints.
--           Located in the synopsys/scr_common directory.
--           Called by master compile script.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* DEFINE PCLK                                                                */
/******************************************************************************/

create_clock -p tclk -w {0 tclkh} find(port, "PCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_uncertainty -hold tpskew find(clock, PCLK)
/* set clock skew for hold checks */

set_clock_uncertainty -setup tmskew find(clock, PCLK)
/* set clock skew for setup checks */

set_clock_transition 0 PCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 PCLK
/* Infinite drive strength clock signal */

set_load 0 PCLK
/* Zero load clock signal */

remove_driving_cell find(port, PCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, PCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, PCLK)
/* Preserve the clock net during optimisation */

/**********************************************************************/
/* RESET SIGNAL CONSTRAINTS                                           */
/**********************************************************************/
 
/* set_input_delay -clock HCLK -max tidmaxresetn HRESETn */
/* set_input_delay -clock HCLK -min tidminresetn HRESETn */

set_disable_timing find(port, PRESETn)
/* Do not check reset timing during synthesis */

set_load 0 PRESETn
/* Zero load reset signal */

set_resistance 0 find(net, PRESETn)
/* Zero resistance for zero net delay(interconnect delay) on ideal reset net */

set_drive 0 PRESETn
/* Infinite drive strength reset signal */

remove_driving_cell find(port, PRESETn)
/* Set no driving cell on reset */

set_ideal_net find(net, PRESETn)
/* Define an ideal net for the reset net */

/* 1999.10 onwards USE NEW METHOD ABOVE TO REPLACE OLD ONE BELOW */
/* USE set_ideal_net WITHOUT set_dont_touch_network */
/* OTHERWISE ideal non-clock nets become buffered. */

/* set_dont_touch_network find(port, PRESETn) */
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* HIGH FANOUT NETS                                                           */
/******************************************************************************/

set_max_fanout 1.0 PENABLE
set_max_fanout 1.0 PSEL*
set_max_fanout 1.0 PWRITE

/******************************************************************************/
/* INPUT CONSTRAINTS                                                          */
/******************************************************************************/

set_input_delay  -clock PCLK -min tholdmax      PENABLE
set_input_delay  -clock PCLK -max tidmaxpenable PENABLE

set_input_delay  -clock PCLK -min tholdmax      PSEL*
set_input_delay  -clock PCLK -max tidmaxpsel    PSEL*

set_input_delay  -clock PCLK -min tholdmax      PADDR
set_input_delay  -clock PCLK -max tidmaxpaddr   PADDR

set_input_delay  -clock PCLK -min tholdmax      PWRITE
set_input_delay  -clock PCLK -max tidmaxpwrite  PWRITE

set_input_delay  -clock PCLK -min tholdmax      PWDATA
set_input_delay  -clock PCLK -max tidmaxpwdata  PWDATA

/******************************************************************************/
/* OUTPUT CONSTRAINTS                                                         */
/******************************************************************************/

set_output_delay -clock PCLK -min tholdmin      PRDATA
set_output_delay -clock PCLK -max todmaxprdata  PRDATA

/************************************* End ************************************/
