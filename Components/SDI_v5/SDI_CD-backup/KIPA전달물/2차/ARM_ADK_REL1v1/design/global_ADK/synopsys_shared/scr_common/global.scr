-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis project/library-specific global script.
--
--           Located in the synopsys_shared/scr_common directory.
--           Called by the master compile script.
--
--           This file applies global defaults once the design   
--           has been read in. 
--
-- --=================================================================*/

set_max_transition 2.0 topname
/* set maximum transition for all nets in design */
 
set_max_area 0.0
/* set maximum area to zero so that design is optimised for minimum */
/* area                                                             */
 
/**********************************************************************/
/* Multibit settings file                                             */
/**********************************************************************/
 
hdlin_infer_multibit = default_all
/* This variable controls multibit inference for bused registers */
 
set_multibit_options -minimum_width 2
/* width=2 is default, multibit components >= width will be optimised */

set_fix_multiple_port_nets -all -buffer_constants
/* Prevent feedthroughs, multiple output ports from same net */
/* or constants driving more than one output port            */

/*********************** End of global.scr ****************************/
