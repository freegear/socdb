##
## Timing constraints for moon_top
##
# time_unit : "1ns"
# capacitive_load_unit 1pf

# 1, Input, MISC
set_input_transition 1 ext_utm
set_input_delay  -clock clk_usb -max 3 ext_utm
set_input_transition 1 dbus16
set_input_delay  -clock clk_usb -max 3 dbus16
set_input_transition 1 big_endian
set_input_delay  -clock clk_main -max 3 big_endian
set_input_transition 1 scan_test
set_input_delay  -clock clk_main -max 3 scan_test

# 2, Output, MISC
set_load 5 uclk_pre
set_output_delay  -clock clk_usb -max 3 uclk_pre
set_load 5 intr_usb
set_output_delay  -clock clk_main -max 3 intr_usb
set_load 5 intr_buffer
set_output_delay  -clock clk_main -max 3 intr_buffer

# 3, Input, AHB
set_input_transition 1 hready_in
set_input_delay  -clock clk_main -max 3 hready_in
set_input_transition 1 hwrite
set_input_delay  -clock clk_main -max 3 hwrite
set_input_transition 1 htrans[1]
set_input_delay  -clock clk_main -max 3 htrans[1]
set_input_transition 1 htrans[0]
set_input_delay  -clock clk_main -max 3 htrans[0]
