##
## mdma synthesis
##

## source synopsys_setup
source .synopsys_dc.setup

## Read db
read_db db/moon_top.db

## Check design
current_design mdma
check_design > Report/mdma.check_design

## GENERAL Constraint
set_fix_multiple_port_nets -all -buffer_constants
set auto_wire_load_selection true
set_max_fanout 16 $current_design
set_operating_conditions -library std110 -max V230WTP1250

## Constraint design
source Budget_Result/mdma.dctcl
set_max_area 0.0
#uniquify

## Compile
current_design mdma
compile -map_effort high

## Write DB
write -format db -hierarchy mdma -output db/mdma.db

change_names -rules BLOCK_LEVEL -h -verbose > Report/change_names.rpt
write -format verilog -hier mdma -output Netlist/mdma.gv

## Check Timing
check_timing > Report/mdma.check_timing

## Report
report_design > Report/mdma.design_rpt
report_area >> Report/mdma.design_rpt
report_cell >> Report/mdma.design_rpt
report_timing -path end > Report/mdma.timing_rpt
report_timing -max_path 100 >> Report/mdma.timing_rpt
report_clock > Clock/mdma.clock
report_port -verbose > Report/mdma.port
all_registers -level_sensitive
list dc_shell_status > Report/mdma.latch

# report_reference
# report_port -verbose
# report_net
# report_compile_options
# report_constraint -all_violators -verbose

## Budgeting
## Write_script

## Recompile

remove_design -all
#exit
