write ({`U_BLOCK_AREA_,24'h00_2208},32'h0100_0b2a,2'b10);
write ({`U_BLOCK_AREA_,24'h00_220c},32'h0000_0100,2'b10);
write ({`U_BLOCK_AREA_,24'h00_2210},32'h0000_0100,2'b10);
$display ("USB DEVICE DESCRIPTOR TABLE WRITE END");

$display ("USB CONFIG DESCRIPTOR TABLE WRITE");
write ({`U_BLOCK_AREA_,24'h00_2280},32'h0027_0209,2'b10);
write ({`U_BLOCK_AREA_,24'h00_2284},32'he000_0101,2'b10);
