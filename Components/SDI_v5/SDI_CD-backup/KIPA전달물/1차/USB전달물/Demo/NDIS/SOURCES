C_DEFINES=$(C_DEFINES) -DNDIS_MINIPORT_DRIVER=1 -DNDIS50_MINIPORT=1 -DIRDA -DDRIVER -DBINARY_COMPATIBLE=1 -DNDIS_WDM=1  -DUSE_KLOCKS=1

