-- Purpose : 
--           Synopsys synthesis script to define AMBA AHB 
--           timing constraints.
--           Located in the synopsys_shared/scr_common directory.
--           Called by master compile script.
--
-- --=================================================================*/

/**********************************************************************/
/* HCLK DEFINTION                                                     */
/**********************************************************************/

create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_skew -ideal -plus_uncertainty tpskew find(clock, HCLK)
/* set plus clock skew */

set_clock_skew -ideal -minus_uncertainty tmskew find(clock, HCLK)
/* set minus clock skew */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal clock net                                           */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/**********************************************************************/
/* RESET SIGNAL CONSTRAINTS                                           */
/**********************************************************************/
 
set_input_delay -clock HCLK -max tidmaxresetn HRESETn
set_input_delay -clock HCLK -min tidminresetn HRESETn

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

set_load 0 HRESETn
/* Zero load reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal reset net                                           */

set_dont_touch_network find(port, HRESETn)
/* Preserve the reset net during optimisation */

/**********************************************************************/
/* HIGH FANOUT NETS                                                   */
/**********************************************************************/

set_max_fanout 1.0 HREADYIN

/**********************************************************************/
/* INPUT CONSTRAINTS                                                  */
/**********************************************************************/
/* Not all AHB slaves have the standard inputs, so 'if' statements   */
/* are used to control the input port settings for specific modules. */

if ((topname != DefaultSlave)) {
set_input_delay -clock HCLK -min tholdmax     HADDR
set_input_delay -clock HCLK -max tidmaxhaddr  HADDR
}

set_input_delay -clock HCLK -min tholdmax     HTRANS*
set_input_delay -clock HCLK -max tidmaxhtrans HTRANS*

if ((topname != DefaultSlave)) {
set_input_delay -clock HCLK -min tholdmax     HWRITE
set_input_delay -clock HCLK -max tidmaxhwrite HWRITE
}

if ((topname != APBif) && (topname != DefaultSlave)) {
set_input_delay -clock HCLK -min tholdmax     HSIZE
set_input_delay -clock HCLK -max tidmaxhsize  HSIZE
}

if ((topname != APBif) && (topname != DefaultSlave) && \
    (topname != RetrySlave) && (topname != SMI) && \
    (topname != Vic)) {
set_input_delay -clock HCLK -min tholdmax     HBURST
set_input_delay -clock HCLK -max tidmaxhburst HBURST
}

if ((topname != APBif) && (topname != DefaultSlave) && \
    (topname != RetrySlave) && (topname != SMI)){
set_input_delay -clock HCLK -min tholdmax     HPROT*
set_input_delay -clock HCLK -max tidmaxhprot  HPROT*
}

if ((topname != DefaultSlave) && (topname != SMI)) {
set_input_delay -clock HCLK -min tholdmax     HWDATA
set_input_delay -clock HCLK -max tidmaxhwdata HWDATA
}

set_input_delay -clock HCLK -min tholdmax     HSEL*
set_input_delay -clock HCLK -max tidmaxhsel   HSEL*

set_input_delay -clock HCLK -min tholdmax     HREADYIN
set_input_delay -clock HCLK -max tidmaxhready HREADYIN


/**********************************************************************/
/* OUTPUT CONSTRAINTS                                                 */
/**********************************************************************/
/* Not all AHB slaves have the standard outputs, so 'if' statements   */
/* are used to control the output port settings for specific modules. */

if ((topname != DefaultSlave) && (topname != SMI)) {
set_output_delay -clock HCLK -min tholdmin     HRDATA
set_output_delay -clock HCLK -max todmaxhrdata HRDATA
}

set_output_delay -clock HCLK -min tholdmin     HREADYOUT
set_output_delay -clock HCLK -max todmaxhready HREADYOUT

set_output_delay -clock HCLK -min tholdmin     HRESP
set_output_delay -clock HCLK -max todmaxhresp  HRESP

/***************************** End ************************************/
