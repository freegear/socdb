--
-- -----------------------------------------------------------------------------
-- Purpose :
--          This file is used to set the value on the EXTBUSMUX input port so
--          that depending on the environment the appropriate internal DBI or
--          the external EbiSdram is used for bus arbitration
--          
--          This is a common script file which is included in DBI.cmd and
--          Smc.cmd scripts
--
-- --=========================================================================*/

/******************************************************************************/
/* EXTBUSMUX port tie off value                                               */
/* - when tied to logic '0' the internal DBI is used                          */
/*   otherwise the external EbiSdram is used and the synopsys compiler can    */
/*   optimised out the DBI block as it will be a redundant block              */
/******************************************************************************/
set_logic_zero EXTBUSMUX
/* set_logic_zero EXTBUSMUX */

/************************** End of Smc_BusMode.scr ****************************/
