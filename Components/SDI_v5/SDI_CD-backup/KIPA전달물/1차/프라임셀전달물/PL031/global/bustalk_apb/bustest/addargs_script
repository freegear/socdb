#- Purpose : Invoked by the makefile to pre-preprocess the C source.
#-           This script gives the default values for some arguments
#-           wherever they have been left out in the C source. When
#-           the tas not specified in any of the commands, the tag
#-           field is given a default value of "no_tag". In the RES
#-           command, if the delay value is left out, it is given the 
#-           default delay value. Similarly, the num_cycle field is 
#-           given the default value if it is left out. In the PO 
#-           command, if the value for limit is not specified, it is 
#-           given a default value of zero.
#-
#- --=================================================================--

BEGIN {
        def_delay = 0      # This line must be changed to agree with busheader.h
        v_ref = 0
        temp = 0
        in_comment = 0
}
{
split($0,a,"(")                        # $0 is the entire line  
if (a[1] ~ /\/\*/) {in_comment = 1}
{a[1] = a[1]"("}
if (in_comment == 0) {
if (a[1] ~ /#/) {
        print > (cat "temp." FILENAME )
        }
else if (a[1] ~ /RES\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
 	if (c[2] ~ /^ *$/) {c[2] = "def_delay"} # use default if c2 blank
        gsub(/ /,"",c[2])                       # strip out spaces
        if (c[3] ~ /^ *$/) {c[3] = "def_num_cyc"}
	print "RES("c[1]","c[2]","c[3]");" > (cat "temp." FILENAME )
	}
else if (a[1] ~ /PNW\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[3] ~ /^ *$/) {c[3] = "no_tag"}
	print "PNW("c[1]","c[2]",\""c[3]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /PO\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[4] ~ /^ *$/) {c[4] = 0x00000000}
  	if (c[5] ~ /^ *$/) {c[5] = "no_tag"}
	print "PO("c[1]","c[2]","c[3]","c[4]",\""c[5]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /PSW\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[3] ~ /^ *$/) {c[3] = "no_tag"}
	print "PSW("c[1]","c[2]",\""c[3]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /PNR\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[2] ~ /^ *$/) {c[2] = "no_tag"}
	print "PNR("c[1]",\""c[2]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /PSR\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[4] ~ /^ *$/) {c[4] = "no_tag"}
	print "PSR("c[1]","c[2]","c[3]",\""c[4]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /PI\(/) {
	split(a[2],b,")")
	split(b[1],c,",")
  	if (c[2] ~ /^ *$/) {c[2] = "no_tag"}
	print "PI("c[1]",\""c[2]"\");" > (cat "temp." FILENAME )
        }

else if (a[1] ~ /C\(/) {
         split($0,c,";")
         x = length(c[1])
         x = x - 1
         d = substr(c[1], 1, x) 
         split(d,b,"\",")
         if (b[2] ~ /^ *$/) {
         b[2] = "no_tag"
         print b[1]",\""b[2]"\");" > (cat "temp." FILENAME )
           }
         else 
           {
           split(b[2],c,")")
          print b[1]"\",\""c[1]"\");" > (cat "temp." FILENAME )
          } 
        }

else print > (cat "temp." FILENAME )
}
if ($0 ~ /\*\//) {in_comment = 0}
}

