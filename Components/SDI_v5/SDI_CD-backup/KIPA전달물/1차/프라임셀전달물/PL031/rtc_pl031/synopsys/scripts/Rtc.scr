--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing
--           constraint script for RTC block.
--
--           Located in the synopsys/scripts directory.
--           Called by master compile script.
--
--           This file specifies the input and output delay
--           constraints for the non-AMBA I/O in the RTC block.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* RTC BLOCK-SPECIFIC TIMING PARAMETERS                                       */
/******************************************************************************/

/* timing parameters for non-AMBA signals */
/* CLK1HZ clock parameters, set to the same frequency as PCLK */

tuclkh = tclkh             /* clock high phase */
tuclkl = tclkl             /* clock low phase  */
tuclk  = tuclkh + tuclkl   /* clock period     */

tumskew = 0.25
/* Minus skew set to 2.5% of clock - for setup checks */

tupskew = tumskew * 0.4
/* Plus skew set to 40% of minus skew - for setup checks */

/*  tupskew = tpskew  */
/*  tumskew = tmskew  */

/* Input setup and output valid are allocated as percentage of clock period,
   40% of clock period for Input setup time 
   20% of clock period for Output valid time */

/* Input setup and hold times */

tis = 0.7 * tuclk
tih = 0

/* Output valid and hold times */

tuov = 0.4 * tuclk   /* CLK1HZ clock domain */
tuoh = 0

tov = 0.4 * tclk   /* PCLK clock domain */
toh = 0

/* Convert the above into synthesis parameters */

tidmax = tuclk - tis
tidmin = tih

todmax = tuclk - tov
todmin = toh

/**********************************************************************/
/*                            Scan Inputs                             */
/**********************************************************************/

/* The input delay on the Scan related input signals has been set to  */
/* a small non-zero value to prevent addition of extra gates in these */
/* paths.                                                             */
tidscanmax = 0.0  
tidscanmin = 0.0 

/******************************************************************************/
/*                              Scan Outputs                                  */
/******************************************************************************/
/* The output delay on the Scan related output signals has been set           */
/* to a zero value to prevent addition of extra gates in these paths.         */
todscanmax = 0.0
todscanmin = 0.0

/******************************************************************************/
/* DEFINE CLOCK CLK1HZ                                                        */
/******************************************************************************/

/* Set CLK1HZ to the same frequency as PCLK, including clock skew */

create_clock -p tuclk -w {0 tuclkh} find(port, "CLK1HZ")
/* period tuclk, rise at 0, fall after tuclkh High phase */

set_clock_skew  -plus_uncertainty tupskew find(clock, CLK1HZ)
/* set plus clock skew */

set_clock_skew  -minus_uncertainty tumskew find(clock, CLK1HZ)
/* set minus clock skew */

set_clock_transition 0 CLK1HZ
/* Override transtion times as ideal clock */

set_drive 0 CLK1HZ
/* Infinite drive strength clock signal, for unbuffered net */

set_driving_cell -none find(port , CLK1HZ)
/* Set no driving cell on clock */

set_resistance 0 find(net , CLK1HZ)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, CLK1HZ)
/* Preserve the clock net during optimisation */

/******************************************************************************/
/* INPUT CONSTRAINTS FOR  NON-AMBA PORTS (SCANENABLE)                         */
/******************************************************************************/

/* The following input delay constraints are arbitrary since the      */
/* corresponding signals are asynchronous to the clock that samples   */
/* them. Ensure that they are synchronized internally before use.     */

/* set_input_delay -clock PCLK -min tumskew SCANENABLE    */
/* set_input_delay -clock PCLK -max tidmax SCANENABLE    */
 
/* set_max_fanout 1.0 SCANENABLE                          */
/* Maximum fanout of 1 for SCANENABLE, to buffer this net */

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/******************************************************************************/

/*  PCLK clock domain outputs */

set_output_delay -clock PCLK -min todmin RTCINTR
set_output_delay -clock PCLK -max todmax RTCINTR

/******************************************************/
/* Constraints for scan inputs and outputs added here */
/******************************************************/

/***************/
/* Scan Inputs */
/***************/
set_input_delay -clock PCLK -min tidscanmin SCANINPCLK
set_input_delay -clock PCLK -max tidscanmax SCANINPCLK

set_input_delay -clock PCLK -min tidscanmin SCANINCLK1HZ
set_input_delay -clock PCLK -max tidscanmax SCANINCLK1HZ

set_input_delay -clock PCLK -min tidscanmin SCANENABLE
set_input_delay -clock PCLK -max tidscanmax SCANENABLE

set_drive 0 SCANENABLE
/* Infinite drive strength Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/****************/
/* Scan Outputs */
/****************/
set_output_delay -clock PCLK -min todscanmin SCANOUTPCLK
set_output_delay -clock PCLK -max todscanmax SCANOUTPCLK

set_output_delay -clock PCLK -min todscanmin SCANOUTCLK1HZ
set_output_delay -clock PCLK -max todscanmax SCANOUTCLK1HZ

/********************************** End ***************************************/
