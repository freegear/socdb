-- -----------------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           Colour LCD Controller block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the CLCD block synthesis. 
--
-- --=========================================================================*/

/* Set false path from CLCDCLK to HCLK */
set_false_path -from {CLCDCLK} -to {HCLK}

/* Set false path from HCLK to CLCDCLK */
set_false_path -from {HCLK} -to {CLCDCLK}

/* Set false path from nCLCDCLK to HCLK */
set_false_path -from {nCLCDCLK} -to {HCLK}

/* Set false path from HCLK to nCLCDCLK */
set_false_path -from {HCLK} -to {nCLCDCLK}

/* Set false path from CLCDCLK to nCLCDCLK */
set_false_path -from {CLCDCLK} -to {nCLCDCLK}

/* Set false path from nCLCDCLK to CLCDCLK */
set_false_path -from {nCLCDCLK} -to {CLCDCLK}

/* Multicycle path for the HCLK read data from the palette RAM */
set_multicycle_path 2 -setup -from uLCDPalette/CE1 -to HRDATAS*
set_multicycle_path 1 -hold  -from uLCDPalette/CE1 -to HRDATAS*

/************************ End of Clcd_exceptions.scr **************************/
