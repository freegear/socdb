test_protocol() {
   period : 100.00 ;
   delay : 5.00 ;
   bidir_delay : 55.00 ;
   strobe : 95.00 ;
   strobe_width : 0.00 ;

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : nCLCDCLK ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : CLCDCLK ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : HCLK ;
   }
   protocol_start() {
      foreach_program() {
         vector() {
            set(all_ports,"0,[10]X,0,[78]X,0,X,[121]M");
         }
         vector() {
            set(all_ports,"0,[10]X,0,[35]X,1,[42]X,0,1,[121]M");
         }
         foreach_pattern() {
            stream(1405) {
               set(all_ports,"C,[10]U,C,[35]U,1,[38]U,1,[3]Si,C,1,[118]M,[3]So");
            }
            vector() {
               set(all_ports,"0,[10]Pi,0,[78]Pi,0,Pi,[121]Po");
            }
            vector() {
               set(all_ports,"Cp,[10]U,Cp,[78]U,Cp,U,[121]M");
            }
            vector() {
               set(all_ports,"0,[10]U,0,[35]U,1,[38]U,1,[3]U,0,1,[118]M,[3]So");
            }
         }
      }
   }

