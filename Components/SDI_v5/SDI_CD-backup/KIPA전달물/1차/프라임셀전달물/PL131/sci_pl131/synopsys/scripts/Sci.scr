------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           SCI block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the SCI block. 
--
-- --=================================================================*/



/**********************************************************************/
/* BLOCK-SPECIFIC TIMING PARAMETERS                                   */
/**********************************************************************/

/* Reference clock parameters (tr) */

trclkh = tclkh           /* Reference clock high phase                */
                         /* The reference clock frequency is set to   */
                         /* be the same as the PCLK frequency.        */

trclkh = trclkh - oc_margin /* set the tclk high phase after          */
                            /* subtracting the over-constraining      */
                            /* margin                                 */

trclkl = trclkh             /* Reference clock low phase              */

trclk  = trclkh + trclkl    /* Peference clock period                 */

trclkpskew = tpskew         /* Reference clock plus clock skew        */
trclkmskew = tmskew         /* Reference clock  minus clock skew      */

/**********************************************************************/
/* Define the reference clock,  including clock skew                  */
/**********************************************************************/

create_clock -p trclk -w {0 trclkh} find(port, "SCICLK")
/* period trclk, rise at 0, fall after trclkh High phase */

set_clock_skew -plus_uncertainty trclkpskew find(clock, SCICLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty trclkmskew find(clock, SCICLK)
/* set minus clock skew */

set_dont_touch_network find(clock, SCICLK)
/* Preserve the clock net during optimisation */

set_resistance 0 SCICLK

set_drive 0 SCICLK
/* Infinite drive strength clock signal */


/**********************************************************************/
/* Input setup and hold times for Non-AMBA inputs                     */
/**********************************************************************/

tisna = 0.3 * tclk        /* 30% of clock period */
tihna = 0.0

/**********************************************************************/
/* Output valid and hold times for Non-AMBA outputs                   */
/**********************************************************************/

tovna = 0.4 * tclk       /* 40% of clock period*/
tohna = 0



/**********************************************************************/
/* Convert the setup/hold values into input delay synthesis           */
/* parameters                                                         */
/**********************************************************************/

/********************/
/* Non Amba  Inputs */
/********************/

tidnamax = tclk - tisna
tidnamin = tihna

/***************/
/* Scan Inputs */
/***************/

/* The input delay on the Scan related input signals has been set to  */
/* a small non-zero value to prevent addition of extra gates in these */
/* paths.                                                             */

tidscanmax = 0.3  
tidscanmin = 0.3 


/**********************************************************************/
/* Convert the valid/hold values into output delay synthesis          */
/* parameters                                                         */
/**********************************************************************/

/*********************/
/* Non Amba Outputs  */
/*********************/

todnamax   = tclk - tovna
todnamin   = tohna

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */

todscanmax = 0.0
todscanmin = 0.0


/**********************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                               */
/**********************************************************************/

/********************/
/* Non Amba Inputs  */
/********************/

set_input_delay -clock SCICLK -min tidnamin SCIDATAIN
set_input_delay -clock SCICLK -max tidnamax SCIDATAIN
 
set_input_delay -clock SCICLK -min tidnamin SCICLKIN
set_input_delay -clock SCICLK -max tidnamax SCICLKIN

set_input_delay -clock SCICLK -min tidnamin SCIDETECT
set_input_delay -clock SCICLK -max tidnamax SCIDETECT

set_input_delay -clock SCICLK -min tidnamin SCIDEACREQ
set_input_delay -clock SCICLK -max tidnamax SCIDEACREQ

set_input_delay -clock PCLK   -min tidnamin SCITXDMACLR
set_input_delay -clock PCLK   -max tidnamax SCITXDMACLR

set_input_delay -clock PCLK   -min tidnamin SCIRXDMACLR
set_input_delay -clock PCLK   -max tidnamax SCIRXDMACLR


/***************/
/* Scan Inputs */
/***************/

set_input_delay -clock PCLK    -min tidscanmin SCANINPCLK
set_input_delay -clock PCLK    -max tidscanmax SCANINPCLK

set_input_delay -clock SCICLK  -min tidscanmin SCANINSCICLK
set_input_delay -clock SCICLK  -max tidscanmax SCANINSCICLK

set_input_delay -clock PCLK    -min tidscanmin SCANENABLE
set_input_delay -clock PCLK    -max tidscanmax SCANENABLE

set_drive 0 SCANENABLE 
/* Infinite drive strength Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/**********************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA OUTPUTS                            */
/**********************************************************************/

/*  SCICLK clock domain outputs */

set_output_delay -clock SCICLK -min todnamin nSCIDATAOUTEN
set_output_delay -clock SCICLK -max todnamax nSCIDATAOUTEN
 
set_output_delay -clock SCICLK -min todnamin nSCIDATAEN
set_output_delay -clock SCICLK -max todnamax nSCIDATAEN

set_output_delay -clock SCICLK -min todnamin SCICLKOUT
set_output_delay -clock SCICLK -max todnamax SCICLKOUT

set_output_delay -clock SCICLK -min todnamin nSCICLKOUTEN
set_output_delay -clock SCICLK -max todnamax nSCICLKOUTEN

set_output_delay -clock SCICLK -min todnamin nSCICLKEN
set_output_delay -clock SCICLK -max todnamax nSCICLKEN

set_output_delay -clock SCICLK -min todnamin nSCICARDRST
set_output_delay -clock SCICLK -max todnamax nSCICARDRST

set_output_delay -clock SCICLK -min todnamin SCIFCB
set_output_delay -clock SCICLK -max todnamax SCIFCB

set_output_delay -clock SCICLK -min todnamin SCIVCCEN
set_output_delay -clock SCICLK -max todnamax SCIVCCEN

set_output_delay -clock SCICLK -min todnamin SCIDEACACK
set_output_delay -clock SCICLK -max todnamax SCIDEACACK

/*  PCLK clock domain outputs */

set_output_delay -clock PCLK -min todnamin SCITXTIDEINTR
set_output_delay -clock PCLK -max todnamax SCITXTIDEINTR

set_output_delay -clock PCLK -min todnamin SCIRXTIDEINTR
set_output_delay -clock PCLK -max todnamax SCIRXTIDEINTR

set_output_delay -clock PCLK -min todnamin SCIRORINTR
set_output_delay -clock PCLK -max todnamax SCIRORINTR

set_output_delay -clock PCLK -min todnamin SCITXDMASREQ
set_output_delay -clock PCLK -max todnamax SCITXDMASREQ

set_output_delay -clock PCLK -min todnamin SCITXDMABREQ
set_output_delay -clock PCLK -max todnamax SCITXDMABREQ

set_output_delay -clock PCLK -min todnamin SCIRXDMASREQ
set_output_delay -clock PCLK -max todnamax SCIRXDMASREQ

set_output_delay -clock PCLK -min todnamin SCIRXDMABREQ
set_output_delay -clock PCLK -max todnamax SCIRXDMABREQ


/* The following outputs are asserted within the SCICLK      */
/* domain and deasserted within the PCLK domain.             */
/* These output delay settings will be overridden by false   */
/* path settings in the Sci_exceptions.scr file. If PCLK     */
/* and SCICLK are fed from the same source, the false path   */
/* settings should be removed and the following output delay */
/* settings will take effect.                                */

set_output_delay -clock SCICLK -min todnamin  SCICARDININTR
set_output_delay -clock SCICLK -max todnamax  SCICARDININTR
 
set_output_delay -clock SCICLK -min todnamin  SCICARDOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCICARDOUTINTR
 
set_output_delay -clock SCICLK -min todnamin  SCICARDUPINTR
set_output_delay -clock SCICLK -max todnamax  SCICARDUPINTR

set_output_delay -clock SCICLK -min todnamin  SCICARDDNINTR
set_output_delay -clock SCICLK -max todnamax  SCICARDDNINTR

set_output_delay -clock SCICLK -min todnamin  SCITXERRINTR
set_output_delay -clock SCICLK -max todnamax  SCITXERRINTR

set_output_delay -clock SCICLK -min todnamin  SCIATRSTOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCIATRSTOUTINTR

set_output_delay -clock SCICLK -min todnamin  SCIATRDTOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCIATRDTOUTINTR

set_output_delay -clock SCICLK -min todnamin  SCIBLKTOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCIBLKTOUTINTR 

set_output_delay -clock SCICLK -min todnamin  SCICHTOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCICHTOUTINTR

set_output_delay -clock SCICLK -min todnamin  SCIRTOUTINTR
set_output_delay -clock SCICLK -max todnamax  SCIRTOUTINTR

set_output_delay -clock SCICLK -min todnamin  SCICLKSTPINTR
set_output_delay -clock SCICLK -max todnamax  SCICLKSTPINTR

set_output_delay -clock SCICLK -min todnamin  SCICLKACTINTR
set_output_delay -clock SCICLK -max todnamax  SCICLKACTINTR

set_output_delay -clock SCICLK -min todnamin  SCIINTR
set_output_delay -clock SCICLK -max todnamax  SCIINTR


/****************************************/
/* OUTPUT CONSTRAINTS FOR SCAN OUTPUTS  */
/***************************************/

set_output_delay -clock PCLK   -min todscanmin SCANOUTPCLK 
set_output_delay -clock PCLK   -max todscanmax SCANOUTPCLK

set_output_delay -clock SCICLK -min todscanmin SCANOUTSCICLK
set_output_delay -clock SCICLK -max todscanmax SCANOUTSCICLK


/******************************************************/
/* CONSTRAINTS FOR REFERENCE CLOCK DOMAIN RESET INPUT */
/******************************************************/

/* These have been assigned the same input delay values */ 
/* as that of the AMBA BnRES reset signal.            */

set_input_delay -clock SCICLK -max tidmaxnres nSCIRST
set_input_delay -clock SCICLK -min tidminnres nSCIRST

set_drive 0 nSCIRST 
/* Infinite drive strength reset signal */

set_resistance 0 nSCIRST

/************************* End of Sci.scr *****************************/
