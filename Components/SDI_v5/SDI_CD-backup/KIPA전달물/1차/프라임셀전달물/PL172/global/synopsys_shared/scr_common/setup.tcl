#------------------------------------------------------------------------------
#-- Purpose : Synopsys synthesis setup script
#--
#------------------------------------------------------------------------------
#-- Information : 
#--
#--           This file ensures that appropriate variables are  
#--           set each time a Synopsys session is invoked.     
#--
#--           It includes library paths, Synopsys cache location, 
#--           and version-specific setup.                        
#--
#--
#------------------------------------------------------------------------------
#--   Order commands are executed:
#--
#--   1) Declare variables
#--   2) Define paths
#--   3) Check environment variables
#--   4) Define naming rules
#--   5) Synthesis setup
#--   6) Enable Presto
#--   7) Aliases
#--   8) Functions
#--   9) Set log file name
#--
#------------------------------------------------------------------------------
#-- Files :
#--
#-- setup.tcl
#--   |-GLOBAL/functions.tcl
#-------------------------------------------------------------------------------


#==============================================================================
#-- 1. Variable declaration section                                      
#==============================================================================

#-- Assign name of designer 
set Designer YourName

#-- Assign name of company 
set Company {ARM Limited}

#-- set default link library --
set link_library [list *]

#==============================================================================
#-- 2. Define paths
#==============================================================================

#------------------------------------
#-- Cell library path
#------------------------------------
set cell_lib_area [getenv LIB_SYNOP]

#------------------------------------
#-- Define search paths                                                
#------------------------------------

set search_path [concat  $search_path $cell_lib_area]

#------------------------------------
#-- Define location of intermediate files
#------------------------------------
#-- Define the directory containing intermediate files generated by
#-- Synopsys

define_design_lib work -path work

#------------------------------------
#-- Define location of synopsys cache
#------------------------------------
#-- DesignWare components that are inferred (or instantiated) from
#-- technology library cells are stored in the synthetic library
#-- cache.

set cache_read [format "%s%s" $synth_base_area /synopsys_shared/synopsys_cache]
set cache_write [format "%s%s" $synth_base_area /synopsys_shared/synopsys_cache]

#==============================================================================
#-- 3. Check environment variables
#==============================================================================

#------------------------------------
#-- Check PERIPH environment variable has been set
#------------------------------------
if { $topname == {}} {
  puts stdout "PERIPH environment variable not defined"
  quit
} 

#------------------------------------
#-- Check HDL_SOURCE environment variable has been set correctly
#------------------------------------
if {$hdl == {}} {
  puts stdout "HDL_SOURCE environment variable not defined"
  quit
}

if {$hdl != {verilog} && $hdl != {vhdl}} {
  puts stdout "HDL_SOURCE environment variable not verilog, or vhdl"
  quit   
} 

#------------------------------------
#-- Check TEST_METH environment variable has been set correctly
#------------------------------------
if {$test_req == {}} {
  puts stdout "TEST_METH environment variable not defined"
  quit
}

if {$test_req != {noscan} && $test_req != {scaninsert}} {
  puts stdout "TEST_METH environment variable not noscan, or scaninsert"
  quit
}

#------------------------------------
#-- Check CLOCK_GATING environment variable has been set correctly
#------------------------------------
if {$use_clock_gating == {}} {
  puts stdout "CLOCK_GATING environment variable not defined"
  quit
}
 
if {$use_clock_gating != {0} && $use_clock_gating != {1}} {
  puts stdout "CLOCK_GATING environment variable not 0, or 1"
  quit
}

if {$use_clock_gating == {0}} {
  set clock_gate notgated
}

if {$use_clock_gating == {1}} {
  set clock_gate gated
}

#------------------------------------
#-- Check TECHNOLOGY_FILE environment variable has been set 
#------------------------------------
if {$technology_file == {}} {
  puts stdout "TECHNOLOGY_FILE environment variable not defined"
  quit
}

#------------------------------------
#-- Check GLOBAL environment variable has been set 
#------------------------------------
if {$synth_base_area == {}} {
  puts stdout "GLOBAL environment variable not defined"
  quit
}

#==============================================================================
#-- 4. Define naming rules
#==============================================================================

#------------------------------------
#-- Define bus naming styles
#------------------------------------
set bus_naming_style {%s[%d]}

#==============================================================================
#-- 5. Synthesis setup
#==============================================================================

#------------------------------------
#-- Use asynchronous set/reset latches
#------------------------------------
#-- This variable forces Synopsys to use asynchronous set/reset  
#-- latches if they exist in the target library rather than      
#-- constructing them from synchronous latches and combinatorial 
#-- logic (This variable is set to true by default in the case   
#-- of dff's).                                                   
#-- The design doesn't contain latches.
#-- However if the RTL infers asynchronous latches this parameter must be set
#-- to 'true'
set hdlin_latch_always_async_set_reset false

#------------------------------------
#-- Generate a warning if any latches are inferred
#------------------------------------
set hdlin_check_no_latch true

#------------------------------------
#-- Synchronous resettable D-type flip-flops
#------------------------------------
#-- Set the parameter to true if RTL infers synchronous resettable D-type 
#-- flip-flops 

set hdlin_ff_always_sync_set_reset false


#------------------------------------
#-- Enable the compiler speed-up features                           
#------------------------------------
#-- Note: may need disabling on 97.08 if problems in design         
#-- elaboration are observed.                                       
#-- Note: may need disabling if the design is parameterised.        
set hdlin_turbo_sequential true
set hdlin_accelerate true

#------------------------------------
#-- Synopsys link
#------------------------------------
#-- The following two commands allows the Synopsys link command       
#-- to work correctly. Link will be automatically performed by any of 
#-- the following commands:                                           
#-- compile, create_schematic, group, check_design, report and        
#-- compare_design                                                    
#-- automatic linking is incremental and exisiting links are not      
#-- removed.                                                          

set auto_link_options -all
set auto_link_disable false

#------------------------------------
#-- Concatenation warning messages
#------------------------------------
#-- The following variable prevents VHDL-Compiler from flagging 
#-- warnings related to concatenation results. Refer STAR61128 

set hdlin_vhdl93_concat false

#------------------------------------
#-- VHDL netlist SDF generation
#------------------------------------
#-- The following variable prevents verilog-style SDF generation     
#-- for VHDL netlists.                                               
#-- By default clock to o/p delays are written out by Synopsys using 
#-- Verilog syntax.                                                  
#-- eg:                                                              
#--   IOPATH (posedge CP) Q                                          
#-- The above syntax is not acceptable for VITAL annotation.         
#-- Setting the sdfout_no_edge variable to true causes the SDF to be  
#-- generated with the correct syntax.                               
#--   IOPATH CP Q [as per VITAL requirements.]                       
#--                                                                 
#-- Note : This variable is a "hidden" [undocumented] variable. If  
#--        this variable is not accepted by a particular Synopsys    
#--        version, the Synopsys generated SDF file will have to be  
#--        post-processed to create a VITAL compliant SDF file.      
#--        The 'patch_sdf' script in the 'netlist' directory        
#--        contains a sample script which performs the necessary     
#--        tailoring. This section of the script is commented out by 
#--        default and will have to be enabled by the user on a need 
#--        basis.                                                   
  
set sdfout_no_edge true

#------------------------------------
#-- Echo the include command 
#------------------------------------
set echo_include_commands true

#------------------------------------
#-- Enable (true) or disable (false) paging of report output 
#------------------------------------
set sh_enable_page_mode false

#------------------------------------
#-- Change the background view to black
#------------------------------------
set view_background black

set enable_recovery_removal_arcs false

#------------------------------------
#-- Verilog output three-state nets
#------------------------------------
#-- Specify how Verilog is written out 
#-- When true, three-state nets are declared as Verilog wire instead 
#-- of tri.                                                          
#-- This variable eliminates assign primitives and tran gates in     
#-- Verilog output by connecting an output port directly to a        
#-- component instantiation, (default is false).
set verilogout_no_tri true

#------------------------------------
#-- Verilog output bussed ports
#------------------------------------
#-- When set to false, all ports are written out with their original  
#-- data types, so the netlist is written with vectored ports         
#-- maintained.                                                       
#-- When set to true, vectored ports (or ports that use record types) 
#-- are bit-blasted;
#-- if a port's bit vector is N bits wide, it is     
#-- written out to the Verilog file as N separate single-bit ports,   
#-- (default is true).                                                
set verilogout_single_bit false

#------------------------------------
#-- Verilog output show unconnected pins
#------------------------------------
#-- When set to true, all unconnected instance pins are written out in 
#-- the Verilog netlist. This is a requirement placed by certain layout tools
set verilogout_show_unconnected_pins true

#------------------------------------
#-- Verilog output higher modules first
#------------------------------------
#-- When true, Verilog modules are ordered so that higher-level       
#-- designs come before lower-level designs, as defined by the design 
#-- hierarchy, (default is false).                                    
set verilogout_higher_designs_first true

#==============================================================================
#-- 6. Enable Presto
#==============================================================================
#-- PRESTO enabled reading of verilog files.

set hdlin_enable_presto true

#==============================================================================
#-- 7. Create aliases                                                     
#==============================================================================

#------------------------------------
#-- History alias
#------------------------------------
alias h "history "

#------------------------------------
#-- Alias to remove all designs 
#------------------------------------
alias cls "remove_design -all "

#==============================================================================
#-- 8. Functions
#==============================================================================

source -echo -verbose [concat $scr_common_area/functions.tcl]

#==============================================================================
#-- 9. Set log file names
#==============================================================================

#-- Run time log
set run_time_log [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" log/ $topname] _] $test_req] _] $hdl] _src_] $clock_gate ] _synth.log]

#-- Report name base
set report_name_base [format "%s%s" [format "%s%s"  [format "%s%s"  \
  [format "%s%s" [format "%s%s" [format "%s%s" [format "%s%s" \
  report/ $topname] _] $test_req] _] $hdl] _src_ ] $clock_gate]

#------------------------------- End of setup.tcl ----------------------------
