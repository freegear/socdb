-------------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           MPMC TIC block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay
--           constraints for the non-AMBA intra-chip signals
--           and Primary I/O signals
--
-- --=========================================================================*/

/******************************************************************************/
/* MPMC TIC BLOCK-SPECIFIC TIMING PARAMETERS                                  */
/******************************************************************************/

/******************************************************************************/
/* Primary Input timing parameters.                                           */
/* Input Delays. Constraints used are the tighter than AHB Input signals.     */
/******************************************************************************/
/* The offchip primary inputs require a setup time which is 20% of clock      */
tisprimaryipmax  = 0.2 * tclk

/* Calculating the maximum allowable input delay on the inputs                */
tidprimaryipmax  = tclk - tisprimaryipmax

/* Minimum input delay on the tic inputs                                      */
tidprimaryipmin  = 0.0

/* The offchip primary input MPMCTESTIN requires a setup time which is 25% of */
/* clock. This input is used combinationally to generate TESTACK, which has a */
/* output-valid time of 80% of clock. Therefore the input delay on MPMCTESTIN */
/* is required to be less than 80% of the clock. 75% input delay is chosen    */
/* for this purpose                                                           */
tisprimaryiptestinmax  = 0.25 * tclk

/* Calculating the maximum allowable input delay on the inputs                */
tidprimaryiptestinmax  = tclk - tisprimaryiptestinmax

/******************************************************************************/
/* Primary Output timing parameters.                                          */
/* Output valid and hold times. Constraints used are tighter than AHB output  */
/* signals.                                                                   */
/******************************************************************************/
/* The output-valid time for primary output ports is 15% of tclk              */
tovprimaryopmax    = 0.15 * tclk

/* Calculating the maximum allowable output delay on primary outputs          */
todprimaryopmax    = tclk - tovprimaryopmax

/* Minimum output delay on the inputs                                         */
todprimaryopmin    = 0

/******************************************************************************/
/* Primary output port with a different output delay.                         */
/* The generation of certain TIC output signals (TBUS, TACK) is done by       */
/* directly routing AMBA input ports to these outputs. Since the AMBA input   */
/* ports are already delayed by 70% of clock, thus the output-valid time for  */
/* TBUSOUT, TESTACK is taken as 80% of clock.                                 */
/******************************************************************************/
tovmpmcticlogicopmax  = 0.8 * tclk
/* Calculating the maximum allowable output delay on the 'different' primary  */
/* outputs                                                                    */
todmpmcticlogicopmax  = tclk - tovmpmcticlogicopmax

/******************************************************************************/
/* Intrachip non AMBA input ports. Constraints used are similar to AHB input  */
/* signals.                                                                   */
/******************************************************************************/
/* The non AMBA intrachip inputs require a setup time which is 30% of clock   */
tisintrachipipmax  = 0.3 * tclk
/* Calculating the maximum allowable input delay on the inputs                */
tidintrachipipmax  = tclk - tisintrachipipmax

/* Minimum input delay on the intrachip tic inputs                            */
tidintrachipipmin  = 0.0

/******************************************************************************/
/* Intrachip non AMBA output ports. Constraints used are similar to AHB       */
/* output signals.                                                            */
/******************************************************************************/
/* The output valid time for non AMBA intrachip output ports is 40% of tclk.  */
tovintrachipopmax    = 0.4 * tclk
/* Calculating the maximum allowable output delay on non AMBA intrachip       */
/* output ports.                                                              */
todintrachipopmax    = tclk - tovintrachipopmax

/* Minimum output delay on the inputs                                         */
todintrachipopmin    = 0

/******************************************************************************/
/* INPUT CONSTRAINTS FOR PRIMARY TIC PORTS                                    */
/******************************************************************************/
set_input_delay -clock HCLK -min tidprimaryipmin TESTREQA
set_input_delay -clock HCLK -max tidprimaryipmax TESTREQA

set_input_delay -clock HCLK -min tidprimaryipmin TESTREQB
set_input_delay -clock HCLK -max tidprimaryipmax TESTREQB

set_input_delay -clock HCLK -min tidprimaryipmin TBUSIN
set_input_delay -clock HCLK -max tidprimaryipmax TBUSIN

set_input_delay -clock HCLK -min tidprimaryipmin MPMCTESTIN
set_input_delay -clock HCLK -max tidprimaryiptestinmax MPMCTESTIN

/******************************************************************************/
/* INPUT CONSTRAINTS FOR INTRACHIP NON AMBA INPUT TIC PORTS                   */
/******************************************************************************/
set_input_delay -clock HCLK -min tidintrachipipmin TICBUSGNT
set_input_delay -clock HCLK -max tidintrachipipmax TICBUSGNT

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR PRIMARY TIC PORTS (no AHB input is routed directly  */
/* for generating the following primary outputs).                             */
/******************************************************************************/
set_output_delay -clock HCLK -min todprimaryopmin nTicDataEn
set_output_delay -clock HCLK -max todprimaryopmax nTicDataEn

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR PRIMARY TIC PORTS (AHB inputs are routed directly   */
/* for generating the following primary outputs).                             */
/******************************************************************************/
set_output_delay -clock HCLK -min todprimaryopmin TESTACK
set_output_delay -clock HCLK -max todmpmcticlogicopmax TESTACK

set_output_delay -clock HCLK -min todprimaryopmin TBUSOUT
set_output_delay -clock HCLK -max todmpmcticlogicopmax TBUSOUT

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR INTRACHIP non amba OUTPUT TIC PORTS                 */
/******************************************************************************/
set_output_delay -clock HCLK -min todintrachipopmin TICBUSREQ
set_output_delay -clock HCLK -max todintrachipopmax TICBUSREQ

/*************************** End of MpmcTIC.scr *******************************/
