/************************************************************************/
/* INTRACHIP OUTPUT PORT CONSTRAINTS                                    */
/************************************************************************/
set_output_delay -clock HCLK    -min todmpmcintrachipopmin \
                                     find(port, "MPMCRPVHHOUT")
set_output_delay -clock HCLK    -max todmpmcintrachipopmax \
                                     find(port, "MPMCRPVHHOUT")

set_output_delay -clock HCLK    -min todmpmcintrachipopmin \
                                     find(port, "MPMCSREFACK")
set_output_delay -clock HCLK    -max todmpmcintrachipopmax \
                                     find(port, "MPMCSREFACK")

set_output_delay -clock MPMCCLK -max todmpmcintrachipopmax \
                                     find(port, "MPMCEBIREQ")
set_output_delay -clock HCLK    -max -add_delay todmpmcintrachipopmax \
                                                find(port, "MPMCEBIREQ")

set_output_delay -clock MPMCCLK -min -add_delay todmpmcintrachipopmin \
                                                find(port, "MPMCEBIREQ")
set_output_delay -clock HCLK    -min -add_delay todmpmcintrachipopmin \
                                                find(port, "MPMCEBIREQ")

/************************************************************************/
/* SCAN OUTPUT PORT CONSTRAINTS                                         */
/************************************************************************/
set_output_delay -clock HCLK -min todscanmin SCANOUTHCLK
set_output_delay -clock HCLK -max todscanmax SCANOUTHCLK

set_output_delay -clock MPMCCLK -min todscanmin SCANOUTMPMCCLK
set_output_delay -clock MPMCCLK -max todscanmax SCANOUTMPMCCLK

set_output_delay -clock MPMCFBCLKIN0 -min todscanmin SCANOUTFBCLKIN0
set_output_delay -clock MPMCFBCLKIN0 -max todscanmax SCANOUTFBCLKIN0

set_output_delay -clock MPMCFBCLKIN1 -min todscanmin SCANOUTFBCLKIN1
set_output_delay -clock MPMCFBCLKIN1 -max todscanmax SCANOUTFBCLKIN1

set_output_delay -clock MPMCFBCLKIN2 -min todscanmin SCANOUTFBCLKIN2
set_output_delay -clock MPMCFBCLKIN2 -max todscanmax SCANOUTFBCLKIN2

set_output_delay -clock MPMCFBCLKIN3 -min todscanmin SCANOUTFBCLKIN3
set_output_delay -clock MPMCFBCLKIN3 -max todscanmax SCANOUTFBCLKIN3

set_output_delay -clock MPMCCLKDELAY -min todscanmin SCANOUTCLKDELAY
set_output_delay -clock MPMCCLKDELAY -max todscanmax SCANOUTCLKDELAY

