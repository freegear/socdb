-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           DMAC block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the DMAC block synthesis. 
--
-- --=========================================================================*/

/* False paths between DMAC non-AMBA inputs and HRDATA are present as         */
/* these paths are used in Integration test mode only.                        */
/* The normal-mode paths from non-AMBA inputs to non-AMBA outputs             */
/* are still being constrained.                                               */

/******************************************************************************/
/* False path setting for DMACCLR Integration test read paths                 */
/******************************************************************************/
/* For verilog, HRDATA[*] has been replaced by HRDATA_                        */
if (hdl == vhdl) {
set_false_path -through find (pin, {"u*DmacChannel/*ClearReq*"}) \
               -through find (pin, {"uDmacRspRoute/DMACCLR*"}) \
               -to find (port, {"HRDATA_*"})
} else if (hdl == verilog) {
set_false_path -through find (pin, {"u*DmacChannel/*ClearReq*"}) \
               -through find (pin, {"uDmacRspRoute/DMACCLR*"}) \
               -to find (port, {"HRDATA[*]"})
}

/******************************************************************************/
/* False path setting for DMACINTERR Integration test read paths              */
/******************************************************************************/
/* For verilog, HRDATA[*] has been replaced by HRDATA_                        */
if (hdl == vhdl) {
set_false_path -through find (pin, "u*DmacChannel/*IntErrCh*") \
               -through find (pin, "uDmacRspRoute/DMACINTERR*") \
               -to find (port, {"HRDATA_*"})
} else if (hdl == verilog) {
set_false_path -through find (pin, "u*DmacChannel/*IntErrCh*") \
               -through find (pin, "uDmacRspRoute/DMACINTERR*") \
               -to find (port, {"HRDATA[*]"})
}

/******************************************************************************/
/* False path setting for DMACINTTC Integration test read paths               */
/******************************************************************************/
/* For verilog, HRDATA[*] has been replaced by HRDATA_                        */
if (hdl == vhdl) {
set_false_path -through find (pin, "u*DmacChannel/*IntTCCh*") \
               -through find (pin, "uDmacRspRoute/DMACINTTC*") \
               -to find (port, {"HRDATA_*"})
} else if (hdl == verilog) {
set_false_path -through find (pin, "u*DmacChannel/*IntTCCh*") \
               -through find (pin, "uDmacRspRoute/DMACINTTC*") \
               -to find (port, {"HRDATA[*]"})
}

/******************************************************************************/
/* False path setting for DMACTC Integration test read paths                  */
/******************************************************************************/
/* For verilog, HRDATA[*] has been replaced by HRDATA_                        */
if (hdl == vhdl) {
set_false_path -through find (pin, "u*DmacChannel/*SigTC*") \
               -through find (pin, "uDmacRspRoute/DMACTC*") \
               -to find (port, {"HRDATA_*"})
} else if (hdl == verilog) {
set_false_path -through find (pin, "u*DmacChannel/*SigTC*") \
               -through find (pin, "uDmacRspRoute/DMACTC*") \
               -to find (port, {"HRDATA[*]"})
}

/************************ End of Dmac_exceptions.scr **************************/
