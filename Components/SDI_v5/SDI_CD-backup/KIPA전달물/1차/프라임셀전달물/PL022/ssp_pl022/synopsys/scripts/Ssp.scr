------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           SSP block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the SSP block. 
--
-- --=================================================================*/



/**********************************************************************/
/* BLOCK-SPECIFIC TIMING PARAMETERS                                   */
/**********************************************************************/

/* Reference clock parameters (tr) */

trclkh = tclkh           /* Reference clock high phase                */
                         /* The reference clock frequency is set to   */
                         /* be the same as the PCLK frequency.        */

trclkh = trclkh - oc_margin /* set the tclk high phase after          */
                            /* subtracting the over-constraining      */
                            /* margin                                 */

trclkl = trclkh             /* Reference clock low phase              */

trclk  = trclkh + trclkl    /* Peference clock period                 */

trclkpskew = tpskew         /* Reference clock plus clock skew        */
trclkmskew = tmskew         /* Reference clock  minus clock skew      */


/**********************************************************************/
/* Define the reference clock,  including clock skew                  */
/**********************************************************************/

create_clock -p trclk -w {0 trclkh} find(port, "SSPCLK")
/* period trclk, rise at 0, fall after trclkh High phase */

set_clock_skew -plus_uncertainty trclkpskew find(clock, SSPCLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty trclkmskew find(clock, SSPCLK)
/* set minus clock skew */

set_dont_touch_network find(clock, SSPCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 SSPCLK

set_drive 0 SSPCLK
/* Infinite drive strength clock signal */


/**********************************************************************/
/* Input setup and hold times for Non-AMBA inputs                     */
/**********************************************************************/

tisna = 0.3 * tclk        /* 30% of clock period */
tihna = 0.0

/**********************************************************************/
/* Output valid and hold times for Non-AMBA outputs                   */
/**********************************************************************/

tovna = 0.4 * tclk       /* 40% of clock period*/
tohna = 0



/**********************************************************************/
/* Convert the setup/hold values into input delay synthesis           */
/* parameters                                                         */
/**********************************************************************/

/********************/
/* Non Amba  Inputs */
/********************/

tidnamax = tclk - tisna
tidnamin = tihna

/***************/
/* Scan Inputs */
/***************/

/* The input delay on the Scan related input signals has been set to  */
/* a small non-zero value to prevent addition of extra gates in these */
/* paths.                                                             */

tidscanmax = 0.3  
tidscanmin = 0.3 


/**********************************************************************/
/* Convert the valid/hold values into output delay synthesis          */
/* parameters                                                         */
/**********************************************************************/

/*********************/
/* Non Amba Outputs  */
/*********************/

todnamax   = tclk - tovna
todnamin   = tohna

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */

todscanmax = 0.0
todscanmin = 0.0


/**********************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                               */
/**********************************************************************/

/********************/
/* Non Amba Inputs  */
/********************/

set_input_delay -clock SSPCLK -min tidnamin SSPRXD
set_input_delay -clock SSPCLK -max tidnamax SSPRXD

set_input_delay -clock SSPCLK -min tidnamin SSPFSSIN
set_input_delay -clock SSPCLK -max tidnamax SSPFSSIN

set_input_delay -clock SSPCLK -min tidnamin SSPCLKIN
set_input_delay -clock SSPCLK -max tidnamax SSPCLKIN

set_input_delay -clock PCLK -min tidnamin SSPTXDMACLR
set_input_delay -clock PCLK -max tidnamax SSPTXDMACLR

set_input_delay -clock PCLK -min tidnamin SSPRXDMACLR
set_input_delay -clock PCLK -max tidnamax SSPRXDMACLR


/***************/
/* Scan Inputs */
/***************/

set_input_delay -clock PCLK -min tidscanmin SCANINPCLK
set_input_delay -clock PCLK -max tidscanmax SCANINPCLK

set_input_delay -clock PCLK -min tidscanmin SCANINSSPCLK
set_input_delay -clock PCLK -max tidscanmax SCANINSSPCLK

set_input_delay -clock PCLK -min tidscanmin SCANENABLE
set_input_delay -clock PCLK -max tidscanmax SCANENABLE

set_drive 0 SCANENABLE 
/* Infinite drive strength Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/**********************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA OUTPUTS                            */
/**********************************************************************/

set_output_delay -clock PCLK -min todnamin SSPTXINTR
set_output_delay -clock PCLK -max todnamax SSPTXINTR

set_output_delay -clock PCLK -min todnamin SSPRXINTR
set_output_delay -clock PCLK -max todnamax SSPRXINTR

set_output_delay -clock PCLK -min todnamin SSPRORINTR
set_output_delay -clock PCLK -max todnamax SSPRORINTR


/* These output delay settings will be overridden by false   */
/* path settings in the Ssp_exceptions.scr file. If PCLK    */
/* and SSPCLK are fed from the same source, the false path  */
/* settings should be removed and the following output delay */
/* settings will take effect. */

/* SSPRTINTR is asserted via SSPCLK, cleared via PCLK */
set_output_delay -clock SSPCLK -min todnamin SSPRTINTR
set_output_delay -clock SSPCLK -max todnamax SSPRTINTR

/* SSPINTR asserted via SSPCLK or PCLK, cleared via PCLK */
set_output_delay -clock SSPCLK -min todnamin SSPINTR
set_output_delay -clock SSPCLK -max todnamax SSPINTR

set_output_delay -clock PCLK -min todnamin SSPTXDMASREQ
set_output_delay -clock PCLK -max todnamax SSPTXDMASREQ

set_output_delay -clock PCLK -min todnamin SSPRXDMASREQ
set_output_delay -clock PCLK -max todnamax SSPRXDMASREQ

set_output_delay -clock PCLK -min todnamin SSPTXDMABREQ
set_output_delay -clock PCLK -max todnamax SSPTXDMABREQ

set_output_delay -clock PCLK -min todnamin SSPRXDMABREQ
set_output_delay -clock PCLK -max todnamax SSPRXDMABREQ

set_output_delay -clock SSPCLK -min todnamin SSPFSSOUT
set_output_delay -clock SSPCLK -max todnamax SSPFSSOUT

set_output_delay -clock SSPCLK -min todnamin SSPCLKOUT
set_output_delay -clock SSPCLK -max todnamax SSPCLKOUT

set_output_delay -clock SSPCLK -min todnamin SSPTXD
set_output_delay -clock SSPCLK -max todnamax SSPTXD

set_output_delay -clock SSPCLK -min todnamin nSSPCTLOE
set_output_delay -clock SSPCLK -max todnamax nSSPCTLOE

set_output_delay -clock SSPCLK -min todnamin nSSPOE
set_output_delay -clock SSPCLK -max todnamax nSSPOE


/****************************************/
/* OUTPUT CONSTRAINTS FOR SCAN OUTPUTS  */
/***************************************/

set_output_delay -clock PCLK -min todscanmin SCANOUTPCLK 
set_output_delay -clock PCLK -max todscanmax SCANOUTPCLK

set_output_delay -clock PCLK -min todscanmin SCANOUTSSPCLK
set_output_delay -clock PCLK -max todscanmax SCANOUTSSPCLK


/******************************************************/
/* CONSTRAINTS FOR REFERENCE CLOCK DOMAIN RESET INPUT */
/******************************************************/

/* These have been assigned the same input delay values */ 
/* as that of the AMBA PRESETn reset signal.            */

set_input_delay -clock SSPCLK -max tidmaxnres nSSPRST
set_input_delay -clock SSPCLK -min tidminnres nSSPRST

set_drive 0 nSSPRST 
/* Infinite drive strength reset signal */

set_resistance 0 nSSPRST

/************************* End of Ssp.scr *****************************/
