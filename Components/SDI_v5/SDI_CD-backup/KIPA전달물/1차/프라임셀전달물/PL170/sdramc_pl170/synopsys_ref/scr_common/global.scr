--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis project/library-specific global script.
--
--           Located in the synopsys_ref/scr_common directory.
--           Called by master compile script.
--
--           This file applies global defaults once the design   
--           has been read in. This file is to be used when 
--           synthesising the Verilog source. 
--
--           It includes library-specific setup such as        
--           worst/best case operating conditions and         
--           default cell load and drive strength.           
------------------------------------------------------------------------------*/

/* This script is based on use of the Avanti! Passport cb25 cell library.     */

/******************************************************************************/
/* SET OPERATING CONDITIONS                                                   */
/******************************************************************************/

set_min_library MAX_LIB_FILENAME -min_version MIN_LIB_FILENAME
/* Multiple libraries, declare max (not min) in setup.scr, set min as above */

set_operating_conditions \
  -min BC_NAME \
  -min_library MIN_LIB_FILENAME + ":" + MIN_TECH_LIB_NAME \
  -max WC_NAME \
  -max_library MAX_LIB_FILENAME + ":" + MAX_TECH_LIB_NAME

/* Define worst case and best case commercial operating conditions   */
/* Versions >=1998.02 allows min and max conditions to be specified together */

/******************************************************************************/
/* SET DEFAULT CELL LOAD                                                      */
/******************************************************************************/

set_load load_of( MAX_TECH_LIB_NAME + /inv0d0/I ) \
  * 5 all_outputs()

/******************************************************************************/
/* SET DEFAULT CELL DRIVE STRENGTH                                            */
/******************************************************************************/

set_driving_cell -library MAX_TECH_LIB_NAME \
  -cell dfnrb1 -pin Q all_inputs()

/*********************************** End **************************************/
