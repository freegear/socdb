  -y ../trickbox

/*** Note if the testbench does not instantiate a 64M_x16     ***
 *** device the following block needs to be commented out     ***/

/* START 64M_x16 */
  -y ../../../../MODELS/denali/sdram/Nec64Mx16/verilog_xl
/* END 64M_x16 */

/*** Note if the testbench does not instantiate a 64M_x8      ***
 *** device the following block needs to be commented out     ***/

/* START 64M_x8 */
  -y ../../../../MODELS/denali/sdram/Nec64Mx8/verilog_xl
/* END 64M_x8 */

/*** Note if the testbench does not instantiate a 16M_x16     ***
 *** device the following block needs to be commented out     ***/

/* START 16M_x16 */
  -y ../../../../MODELS/denali/sdram/Mt16Mx16/verilog_xl
/* END 16M_x16 */

/*** Note if the testbench does not instantiate a 16M_x8      ***
 *** device the following block needs to be commented out     ***/

/* START 16M_x8 */
  -y ../../../../MODELS/denali/sdram/Mt16Mx8/verilog_xl
/* END 16M_x8 */

