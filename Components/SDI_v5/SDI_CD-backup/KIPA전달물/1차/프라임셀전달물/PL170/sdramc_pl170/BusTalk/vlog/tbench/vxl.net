  +libext+.v

  +incdir+../reader
  +incdir+../trickbox

  -y /home/njameson/work/avanti/1999.1/cb25/v2.1/verilog/cb25os163/zero
  -v /home/njameson/work/avanti/1999.1/cb25/v2.1/verilog/cb25os163/zero/mtb_verilog.v

