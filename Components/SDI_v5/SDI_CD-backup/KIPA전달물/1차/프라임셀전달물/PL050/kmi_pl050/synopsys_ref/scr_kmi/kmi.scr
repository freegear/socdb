--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing
--           constraint script for KMI block.
--
--           Located in the synopsys_ref/scr_kmi directory.
--           Called by master compile script.
--
--           This file specifies the input and output delay
--           constraints for the non-AMBA I/O in the KMI block.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* KMI BLOCK-SPECIFIC TIMING PARAMETERS                                       */
/******************************************************************************/

/* timing parameters for non-AMBA signals */
/* KMIREFCLK clock parameters, set to the same frequency as PCLK */

tkclkh = tclkh             /* clock high phase */
tkclkl = tkclkh            /* clock low phase */
tkclk  = tkclkh + tkclkl   /* clock period */
tkpskew = tpskew           /* plus clock skew */
tkmskew = tmskew           /* minus clock skew */

/* Input setup and output valid are allocated as percentage of clock period,
   40% of clock period for Input setup time 
   20% of clock period for Output valid time */

/* Input setup and hold times */

tis = 0.4 * tkclk
tih = 0

/* Output valid and hold times */

tov = 0.2 * tkclk   /* KMIREFCLK clock domain */
toh = 0

tpov = 0.2 * tclk   /* PCLK clock domain */
tpoh = 0

/* Convert the above into synthesis parameters */

tidmax = tkclk - tis
tidmin = tih

todmax = tkclk - tov
todmin = toh

tpodmax = tclk - tpov
tpodmin = tpoh

/*****************************************************************************/
/* DEFINE CLOCK KMIREFCLK                                                       */
/*****************************************************************************/

/* Set KMICLK to the same frequency as PCLK, including clock skew */

create_clock -p tkclk -w {0 tkclkh} find(port, "KMIREFCLK")
/* period tkclk, rise at 0, fall after tkclkh High phase */

set_clock_skew -ideal -plus_uncertainty tkpskew find(clock, KMIREFCLK)
/* set plus clock skew */

set_clock_skew -ideal -minus_uncertainty tkmskew find(clock, KMIREFCLK)
/* set minus clock skew */

set_clock_transition 0 KMIREFCLK
/* Override transtion times as ideal clock */

set_drive 0 KMIREFCLK
/* Infinite drive strength clock signal */

set_driving_cell -none find(port , KMIREFCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net , KMIREFCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, KMIREFCLK)
/* Preserve the clock net during optimisation */

/*****************************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/*****************************************************************************/

/* The following input delay constraints are arbitrary since the      */
/* corresponding signals are asynchronous to the clock that samples   */
/* them. Ensure that they are synchronized internally before use.     */

set_input_delay -clock KMIREFCLK -min tkmskew KMICLKIN
set_input_delay -clock KMIREFCLK -max tidmax  KMICLKIN
 
set_input_delay -clock KMIREFCLK -min tkmskew KMIDATAIN
set_input_delay -clock KMIREFCLK -max tidmax  KMIDATAIN

set_input_delay -clock KMIREFCLK -min tkmskew nKMIRST
set_input_delay -clock KMIREFCLK -max tidmax  nKMIRST

set_drive 0 nKMIRST
/* Infinite drive strength reset signal, for unbuffered net */

set_driving_cell -none find(port , nKMIRST)
/* Set no driving cell on reset */

set_input_delay -clock PCLK -min tkmskew SCANMODE
set_input_delay -clock PCLK -max tidmax  SCANMODE

set_max_fanout 1.0 SCANMODE
/* Maximum fanout of 1 for SCANMODE, to buffer this net */

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/******************************************************************************/

/*  KMIREFCLK clock domain outputs */

set_output_delay -clock KMIREFCLK -min todmin  nKMIDATAEN
set_output_delay -clock KMIREFCLK -max todmax  nKMIDATAEN
 
set_output_delay -clock KMIREFCLK -min todmin  nKMICLKEN
set_output_delay -clock KMIREFCLK -max todmax  nKMICLKEN

/*  PCLK clock domain outputs */

set_output_delay -clock PCLK -min tpodmin  KMITXINTR
set_output_delay -clock PCLK -max tpodmax  KMITXINTR
 
set_output_delay -clock PCLK -min tpodmin  KMIRXINTR
set_output_delay -clock PCLK -max tpodmax  KMIRXINTR
 
set_output_delay -clock PCLK -min tpodmin  KMIINTR
set_output_delay -clock PCLK -max tpodmax  KMIINTR

/********************************** End ***************************************/
