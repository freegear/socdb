[library]

; BusTalk bus compliance testbench
common     = $PERIPH/BusTalk/vlog/common/work
reader     = $PERIPH/BusTalk/vlog/reader/work
bid        = $PERIPH/BusTalk/vlog/bid/work
buswatcher = $PERIPH/BusTalk/vlog/buswatcher/work
tbench     = $PERIPH/BusTalk/vlog/tbench/work
;vr         = $PERIPH/BusTalk/vlog/vr/work
trickbox   = $PERIPH/BusTalk/vlog/trickbox/work

; Select RTL (uut) or netlist (uutNetlist) block (uut = Unit Under Test)
; by commenting out all but one of the lines below
uut = $PERIPH/verilog/uut/work
;uut = $PERIPH/verilog/uutNetlist/work
;uut = $PERIPH/verilog/uutNetlist_scan/work

; Cell library simulation timing views
;libvhdl     = $LIB_VITAL/work
libverilog  = $LIB_VERILOG/work
UDP         = $LIB_UDP/work

; initialisation file for ModelSim
others     = $MODELTECH_ROOT/modelsim.ini

