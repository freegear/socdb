--------------------------------------------------------------------------------
-- Purpose : Multibit settings file
--           Located in the synopsys_ref/scr_common directory.
--           Called by master compile script.
--
-- Usage   : To use these settings in your synthesis environment
--           include the following in your Synopsys script
--           include multibit.scr       
------------------------------------------------------------------------------*/

hdlin_infer_multibit = default_all
/* This variable controls multibit inference for bused registers */

set_multibit_options -minimum_width 2
/* width=2 is default, multibit components >= width will be optimised */

/************************************* End ************************************/
