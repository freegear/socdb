-- -----------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           MMCI block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the MMCI block. 
--
-- --=========================================================================*/

/******************************************************************************/
/* MMCI BLOCK-SPECIFIC TIMING PARAMETERS                                      */
/******************************************************************************/

/* MCLK clock parameters */
tmclkh = 5.0             /* MCLK high phase                           */
                         /* The MCLK frequency is set to be the       */
                         /* same as the PCLK frequency. Note that the */
                         /* MMCI supports unequal frequencies as well */

tmclkh = tmclkh - oc_margin /* set the tclk high phase after     */
                            /* subtracting the over-constraining */
                            /* margin                            */

tmclkl = tmclkh          /* MCLK low phase */

tmclk  = tmclkh + tmclkl /* MCLK period -> 100 Mhz */

tmclkpskew = tpskew      /* MCLK plus clock skew  */
tmclkmskew = tmskew      /* MCLK minus clock skew */

/******************************************************************************/
/* Input setup and hold times                                                 */
/******************************************************************************/

/**********************/
/* MM-Card Bus Inputs */
/**********************/

/* MMCICMDIN constraints */
tismcicmdin = 5.0  /* The MM Card specification defines a setup        */
                   /* time of 5.0 ns at 20 Mhz. This translates to     */
                   /* 0.1 % of MMCICLK. However for the MMCI synthesis */ 
                   /* the absolute un-scaled value (5.0) is used.      */
                   /* Note that this is the more pessimistic value.    */
tihmcicmdin = 5.0  /* The MM Card specification defines a hold         */
                   /* time of 5.0 ns.                                  */

/* MMCIDATIN constraints */
tismcidatin = 5.0  /* The MM Card specification defines a setup        */
                   /* time of 5.0 ns at 20 Mhz. This translates to     */
                   /* 0.1 % of MMCICLK. However for the MMCI synthesis */ 
                   /* the absolute un-scaled value (5.0) is used.      */
                   /* Note that this is the more pessimistic value.    */
tihmcidatin = 5.0  /* The MM Card specification defines a hold         */
                   /* time of 5.0 ns.                                  */

/**************/
/* DMA Inputs */
/**************/

tismcidmaclr = 0.4 * tclk /* MMCIDMACLR setup time set to 40 % of PCLK */
tihmcidmaclr = 0.0             

/****************/
/* Reset Inputs */
/****************/

/* nMMCIRST constraints */
/* nMMCIRST constraints have been specified such that this signal       */
/* changes in the low phase of MCLK. A setup value of 40 % has been     */
/* specified. A small non-zero hold value has been specified instead    */
/* of a 0 ns value. This has been done to prevent any extra gates       */
/* from being added in the reset path to fix any hold "violations".     */
/* Note that the MMCI synthesis assumes that nMMCIRST will be           */
/* treated separately in layout.                                        */
/* Note : nMMCIRST is used as an asynchronous active low reset for the  */
/*        MCLK, nMCLK and the MMCIFBCLK domains. This places a          */
/*        restriction that the MMCICLKOUT to MMCIFBCLK delay should not */
/*        exceed an MCLK phase. If it does there is a possibility of    */
/*        metastability on those F/Fs clocked by MMCIFBCLK during the   */
/*        deactivation of nMMCIRST.                                     */

tisnmcirst = 0.4 * tmclk /* setup of 40 % of MCLK */
tihnmcirst = 0.3         

/******************************************************************************/
/* Output valid and hold times                                                */
/******************************************************************************/

/*********************/
/* Interrupt Outputs */
/*********************/

tovmciintr0 = 0.3 * tclk      /* MMCIINTR0    */
tohmciintr0 = 0

tovmciintr1 = 0.3 * tclk      /* MMCIINTR1    */
tohmciintr1 = 0

/***************/
/* DMA Outputs */
/***************/

tovmcidmasreq = 0.3 * tclk    /* MMCIDMASREQ  */
tohmcidmasreq = 0

tovmcidmabreq = 0.3 * tclk    /* MMCIDMABREQ  */
tohmcidmabreq = 0

tovmcidmalsreq = 0.3 * tclk   /* MMCIDMALSREQ */
tohmcidmalsreq = 0

tovmcidmalbreq = 0.3 * tclk   /* MMCIDMALBREQ */
tohmcidmalbreq = 0

/***********************/
/* MM Card Bus Outputs */ 
/***********************/

tovmcivdd = 0.2 * tclk        /* MMCIVDD      */
tohmcivdd = 0

/* MMCICMDOUT wrt vMMCICLKcard */

/* The MMCICMDOUT constraints wrt vMMCICLKcard are directly defined */
/* in terms of todmax and todmin parameters since absolute          */
/* values are used instead of a percentage of clock.                */ 

tpovmcicmdout = 0.3 * tclk    /* MMCICMDOUT wrt PCLK */ 
tpohmcicmdout = 0.0

/* nMMCICMDEN wrt vMMCICLKcard */

/* The nMMCICMDEN constraints wrt vMMCICLKcard are directly defined */
/* in terms of todmax and todmin parameters since absolute          */
/* values are used instead of a percentage of clock.                */ 

tpovnmcicmden = 0.3 * tclk    /* nMMCICMDEN wrt PCLK */ 
tpohnmcicmden = 0.0

/* MMCIDATOUT wrt vMMCICLKcard */

/* The MMCIDATOUT constraints wrt vMMCICLKcard are directly defined */
/* in terms of todmax and todmin parameters since absolute          */
/* values are used instead of a percentage of clock.                */ 

tpovmcidatout = 0.3 * tclk    /* MMCIDATOUT wrt PCLK */ 
tpohmcidatout = 0.0

/* nMMCIDATEN wrt vMMCICLKcard */

/* The nMMCIDATEN constraints wrt vMMCICLKcard are directly defined */
/* in terms of todmax and todmin parameters since absolute          */
/* values are used instead of a percentage of clock.                */ 

tpovnmcidaten = 0.3 * tclk    /* nMMCIDATEN wrt PCLK  */ 
tpohnmcidaten = 0.0

tovmcipwr = 0.2 * tmclk       /* MMCIPWR wrt MCLK */ 
tohmcipwr = 0.0

tpovmcipwr = 0.2 * tclk       /* MMCIPWR wrt PCLK */ 
tpohmcipwr = 0.0

tpovmcirod = 0.2 * tclk       /* MMCIROD wrt PCLK */ 
tpohmcirod = 0.0

/******************************************************************************/
/* Convert the setup/hold values into input delay synthesis                   */
/* parameters                                                                 */
/******************************************************************************/

/**********************/
/* MM Card Bus Inputs */
/**********************/

tidmcicmdinmax = tmclk - tismcicmdin  /* MMCICMDIN */
tidmcicmdinmin = tihmcicmdin

tidmcidatinmax = tmclk - tismcidatin  /* MMCIDATIN */
tidmcidatinmin = tihmcidatin

/***************/
/* Scan Inputs */
/***************/

/* The input delay on the Scan related input signals has been set to  */
/* a small non-zero value to prevent addition of extra gates in these */
/* paths.                                                             */
tidscanmax = 0.3  
tidscanmin = 0.3 

/**************/
/* DMA Inputs */
/**************/

tidmcidmaclrmax = tclk - tismcidmaclr  /* DMACLR */
tidmcidmaclrmin = tihmcidmaclr

/****************/
/* Reset Inputs */
/****************/

tidnmcirstmax = tmclk - tisnmcirst     /* nMMCIRST */
tidnmcirstmin = tihnmcirst

/******************************************************************************/
/* Convert the valid/hold values into output delay synthesis                  */
/* parameters                                                                 */
/******************************************************************************/

/***********************/
/* MM Card Bus Outputs */
/***********************/

/* MMCICMDOUT constraints */
todmcicmdoutmax = 3.0 /* MMCICMDOUT wrt vMMCICLKcard */
                   /* The MM Card specification defines a setup       */
                   /* time of 3.0 ns at 20 Mhz. This translates to    */
                   /* 0.06 % of MMCICLK. However for the MMCI         */
                   /* synthesis the absolute un-scaled value (3.0) is */
                   /* used.                                           */
                   /* Note that this is the more pessimistic value.   */
todmcicmdoutmin = - 3.0  
                   /* The MM Card specification defines a hold        */
                   /* time of 3.0 ns.                                 */

tpodmcicmdoutmax = tclk - tpovmcicmdout   /* MMCICMDOUT wrt PCLK */
tpodmcicmdoutmin = tpohmcicmdout

/* nMMCICMDEN constraints */
todnmcicmdenmax = 3.0 /* nMMCICMDEN wrt vMMCICLKcard */
                   /* The constraints set on MMCICMDOUT are set on */
                   /* the MMCICMDEN outputs as well.               */
todnmcicmdenmin = - 3.0  

tpodnmcicmdenmax = tclk - tpovnmcicmden   /* nMMCICMDEN wrt PCLK */
tpodnmcicmdenmin = tpohnmcicmden

/* MMCIDATOUT constraints */
todmcidatoutmax = 3.0 /* MMCIDATOUT wrt vMMCICLKcard */
                   /* The MM Card specification defines a setup       */
                   /* time of 3.0 ns at 20 Mhz. This translates to    */
                   /* 0.06 % of MMCICLK. However for the MMCI         */
                   /* synthesis the absolute un-scaled value (3.0) is */
                   /* used.                                           */
                   /* Note that this is the more pessimistic value.   */
todmcidatoutmin = - 3.0  
                   /* The MM Card specification defines a hold        */
                   /* time of 3.0 ns.                                 */

tpodmcidatoutmax = tclk - tpovmcidatout   /* MMCIDATOUT wrt PCLK */
tpodmcidatoutmin = tpohmcidatout

/* nMMCIDATEN constraints */
todnmcidatenmax = 3.0 /* nMMCIDATEN wrt vMMCICLKcard */
                   /* The constraints set on MMCIDATOUT are set on */
                   /* the nMMCIDATEN outputs as well.              */
todnmcidatenmin = - 3.0  

tpodnmcidatenmax = tclk - tpovnmcidaten   /* nMMCIDATEN wrt PCLK */
tpodnmcidatenmin = tpohnmcidaten

/* MMCIPWR constraints */
todmcipwrmax = tmclk - tovmcipwr    /* MMCIPWR wrt MCLK */
todmcipwrmin = tohmcipwr

tpodmcipwrmax = tclk - tpovmcipwr   /* MMCIPWR wrt PCLK */
tpodmcipwrmin = tpohmcipwr

tpodmcirodmax = tclk - tpovmcirod   /* MMCIROD wrt PCLK */
tpodmcirodmin = tpohmcirod

todmcivddmax = tclk - tovmcivdd     /* MMCIVDD */
todmcivddmin = tohmcivdd

/*********************/
/* Interrupt Outputs */
/*********************/

todmciintr0max = tclk - tovmciintr0      /* MMCIINTR0 */
todmciintr0min = tohmciintr0

todmciintr1max = tclk - tovmciintr1      /* MMCIINTR1 */
todmciintr1min = tohmciintr1

/***************/
/* DMA Outputs */
/***************/

todmcidmasreqmax = tclk - tovmcidmasreq   /* MMCIDMASREQ */
todmcidmasreqmin = tohmcidmasreq

todmcidmabreqmax = tclk - tovmcidmabreq   /* MMCIDMABREQ */
todmcidmabreqmin = tohmcidmabreq

todmcidmalsreqmax = tclk - tovmcidmalsreq /* MMCIDMALSREQ */
todmcidmalsreqmin = tohmcidmalsreq

todmcidmalbreqmax = tclk - tovmcidmalbreq /* MMCIDMALBREQ */
todmcidmalbreqmin = tohmcidmalbreq

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */
todscanmax = 0.0
todscanmin = 0.0

/******************************************************************************/
/* DEFINE MMCI reference clocks MCLK and nMCLK                                */
/*                                                                            */
/******************************************************************************/

/* Define MCLK */
create_clock -p tmclk -w {0 tmclkh} find(port, "MCLK")
/* period tmclk, rise at 0, fall after tmclkh */

set_clock_skew -plus_uncertainty tmclkpskew find(clock, MCLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty tmclkmskew find(clock, MCLK)
/* set minus clock skew */

set_dont_touch_network find(clock, MCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 MCLK

set_drive 0 MCLK
/* Infinite drive strength clock signal */

/* Define nMCLK */
create_clock -p tmclk -w {tmclkh tmclk} find(port, "nMCLK")
/* period tmclk, rise at tmclkh, fall after tmclk */

set_clock_skew -plus_uncertainty tmclkpskew find(clock, nMCLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty tmclkmskew find(clock, nMCLK)
/* set minus clock skew */

set_dont_touch_network find(clock, nMCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 nMCLK

set_drive 0 nMCLK
/* Infinite drive strength clock signal */

/******************************************************************************/
/* DEFINE MM Card bus clock - MMCICLK and its fedback version - MMCIFBCLK     */
/*                                                                            */
/* The following waveforms define the relationship between various            */
/* clocks:
/*
/*            ______________                ______________
/* MCLK      |              |______________|              |
/*            
/*              ______________                ______________
/* MMCICLKOUT   |              |______________|              |
/*      ---->| |<---   [ck-o/p delay of a F/F] in non-bypass mode 
/*                  OR [and gate + mux delay] in bypass mode
/*                     (this delay is internal to the MMCI)
/*
/* Synthesis Note: MMCICLKOUT will not be defined as a clock.
/*                 However an output delay constraint is placed on it
/*                 wrt MCLK. 
/*            
/*                ______________                ______________
/* MMCICLKpadOut  |              |______________|              |
/*        ---->| |<--- on-chip trace delay from MMCI to MMCICLK pad
/*                     + pad delay 
/*                     (this delay is external to the MMCI but internal 
/*                      to the chip containing the MMCI)
/*            
/*                  ______________                ______________
/* MMCICLKcard      |              |______________|              |
/*          ---->| |<--- off-chip track delay from chip to MMCICLK
/*                       pin of the MM/SC-Card  
/*                       (this delay is a board + contact delay) 
/*            
/* Synthesis Note: MMCICLKcard will be defined as a virtual clock.
/*                 Output delay constraints will be placed on the  
/*                 MC Card outputs wrt to this virtual clock.
/*                 Input delay constraints will be placed on the  
/*                 MC Card inputs wrt to this virtual clock.
/*                   ______________                ______________
/* MMCICLKpadIn      |              |______________|              |
/*          ---->|  |<--- MMCICLK pad input delay 
/*                       (this delay is external to the MMCI but 
/*                        internal to the chip containing the MMCI)
/*            
/*                    ______________                ______________
/* MMCIFBCLK          |              |______________|              |
/*             ---->||<--- on-chip trace delay from the input of the 
/*                         MMCICLK pad to the MMCIFBCLK port of the MMCI
/*                         (this delay is external to the MMCI but
/*                          internal to the chip containing the MMCI)
/*            
/* Layout Notes :
/*            ---->| |<--- This delay is critical. Board/chip layout
/*                         should ensure that the *minimum* delay 
/*                         between MMCICLKcard and the MMCIFBCLK is 3 ns  
/*
/******************************************************************************/

/* Define virtual clock vMMCICLKcard */
tmciclkcarddel = 2.0 /* define the delay from MCLK to MMCICLKcard    */
                     /* Note this is an abitrary number attempting   */
                     /* to primarily model the MMCICLK output pad    */
                     /* Note that the accuracy of this number is     */ 
                     /* not relevant to the accuracy of the          */
                     /* constraint settings.                         */
create_clock -p tmclk -w {tmciclkcarddel tmclkh + tmciclkcarddel} \
          -na vMMCICLKcard
/* period tmclk, rise after output pad delay, fall after tmclkh */
/* plus output pad delay.                                       */

tmciholddel = 3.0   /* define the delay from MMCICLKcard to MMCIFBCLK */ 
                    /* The value of 3 ns is a due to the MM Card   */
                    /* specification requirement that the hold time   */
                    /* on the data and command inputs be 3 ns.        */
                    /* Note that the accuracy of this number is       */ 
                    /* very relevant to the accuracy of the           */
                    /* constraint settings.                           */

tmcifbclkdel = tmciclkcarddel + tmciholddel 

/* Define MMCIFBCLK */
create_clock -p tmclk -w {tmcifbclkdel tmclkh + tmcifbclkdel} \
  find(port, "MMCIFBCLK")
/* period tmclk, rise after pad output + input delay, fall after */ 
/* tmclkh plus pad output + input delay                          */

tmcifbclkpskew = 0.2
set_clock_skew -plus_uncertainty tmcifbclkpskew find(clock, MMCIFBCLK)
/* set plus clock skew */

/* Synthesis Note : Minus uncertainty has not been specified on     */
/*                  MMCIFBCLK since the clock waveform of MMCIFBCLK */ 
/*                  incorporates the tmciholddel skew               */

set_dont_touch_network find(clock, MMCIFBCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 MMCIFBCLK

set_drive 0 MMCIFBCLK
/* Infinite drive strength clock signal */

/******************************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                                       */
/******************************************************************************/

/******************/
/* MM Card Inputs */
/******************/

/* MMCICMDIN */
set_input_delay -clock vMMCICLKcard -min tidmcicmdinmin MMCICMDIN
set_input_delay -clock vMMCICLKcard -max tidmcicmdinmax MMCICMDIN

/* MMCIDATIN */
set_input_delay -clock vMMCICLKcard -min tidmcidatinmin MMCIDATIN
set_input_delay -clock vMMCICLKcard -max tidmcidatinmax MMCIDATIN

/****************/
/* Reset Inputs */
/****************/

/* nMMCIRST */
set_input_delay -clock MCLK -min tidnmcirstmin nMMCIRST
set_input_delay -clock MCLK -max tidnmcirstmax nMMCIRST
/* nMMCIRST wrt MCLK */

set_input_delay -clock nMCLK -min tidnmcirstmin \
  -add_delay nMMCIRST
set_input_delay -clock nMCLK -max tidnmcirstmax \
  -add_delay nMMCIRST
/* nMMCIRST wrt nMCLK */

set_input_delay -clock MMCIFBCLK -min tidnmcirstmin \
  -add_delay nMMCIRST
set_input_delay -clock MMCIFBCLK -max tidnmcirstmax \
  -add_delay nMMCIRST
/* nMMCIRST wrt MMCIFBCLK */

set_resistance 0 nMMCIRST

set_drive 0 nMMCIRST
/* Infinite drive strength reset signal */

/***************/
/* Scan Inputs */
/***************/

set_input_delay -clock PCLK -min tidscanmin SCANINPCLK
set_input_delay -clock PCLK -max tidscanmax SCANINPCLK

set_input_delay -clock MMCIFBCLK -min tidscanmin SCANINMMCIFBCLK
set_input_delay -clock MMCIFBCLK -max tidscanmax SCANINMMCIFBCLK

set_input_delay -clock MCLK -min tidscanmin SCANINMCLK
set_input_delay -clock MCLK -max tidscanmax SCANINMCLK

set_input_delay -clock nMCLK -min tidscanmin SCANINnMCLK
set_input_delay -clock nMCLK -max tidscanmax SCANINnMCLK

set_input_delay -clock PCLK -min tidscanmin SCANENABLE
set_input_delay -clock PCLK -max tidscanmax SCANENABLE

set_input_delay -clock MMCIFBCLK -min tidscanmin -add_delay SCANENABLE
set_input_delay -clock MMCIFBCLK -max tidscanmax -add_delay SCANENABLE

set_input_delay -clock MCLK -min tidscanmin -add_delay SCANENABLE
set_input_delay -clock MCLK -max tidscanmax -add_delay SCANENABLE

set_input_delay -clock nMCLK -min tidscanmin -add_delay SCANENABLE
set_input_delay -clock nMCLK -max tidscanmax -add_delay SCANENABLE

set_drive 0 SCANENABLE
/* Infinite drive strength Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/**************/
/* DMA Inputs */
/**************/

set_input_delay -clock PCLK -min tidmcidmaclrmin MMCIDMACLR
set_input_delay -clock PCLK -max tidmcidmaclrmax MMCIDMACLR

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/******************************************************************************/

/*********************/
/* Interrupt Outputs */
/*********************/

/* These output delay settings will be overridden by false         */
/* path settings in the Mmci_exceptions.scr file. If PCLK and MCLK */ 
/* are fed from the same source, the false path settings should    */
/* be removed and the following output delay settings will take    */
/* effect.                                                         */

set_output_delay -clock PCLK -min todmciintr0min MMCIINTR0
set_output_delay -clock PCLK -max todmciintr0max MMCIINTR0

set_output_delay -clock PCLK -min todmciintr1min MMCIINTR1
set_output_delay -clock PCLK -max todmciintr1max MMCIINTR1

/***************/
/* DMA Outputs */
/***************/

set_output_delay -clock PCLK -min todmcidmasreqmin MMCIDMASREQ
set_output_delay -clock PCLK -max todmcidmasreqmax MMCIDMASREQ

set_output_delay -clock PCLK -min todmcidmabreqmin MMCIDMABREQ
set_output_delay -clock PCLK -max todmcidmabreqmax MMCIDMABREQ

set_output_delay -clock PCLK -min todmcidmalsreqmin MMCIDMALSREQ
set_output_delay -clock PCLK -max todmcidmalsreqmax MMCIDMALSREQ

set_output_delay -clock PCLK -min todmcidmalbreqmin MMCIDMALBREQ
set_output_delay -clock PCLK -max todmcidmalbreqmax MMCIDMALBREQ

/*******************/
/* MM Card Outputs */
/*******************/

/* MMCICLKOUT */
/******************************************************************************/
/*            ______________                ______________
/* MCLK      |              |______________|              |
/*            
/*              ______________                ______________
/* MMCICLKOUT   |              |______________|              |
/*      ---->| |<---   [ck-o/p delay of a F/F] in non-Bypass mode 
/*                  OR [and gate + mux delay] in Bypass mode
/*                     (this delay is internal to the MMCI)
/*
/******************************************************************************/
tovmciclkout = 2.0 /* MCLK to MMCICLKOUT valid delay */
                   /* refer waveform above          */

todmciclkoutmax = tmclkl - tovmciclkout
                              /* Note that the output delay setting   */
                              /* is for Bypass mode.                  */
                              /* In non-Bypass mode this would be     */
                              /* tmclk - tovmciclkout                 */
                              /* Note that the Bypass mode constraint */
                              /* is the more restrictive constraint.  */

/* Note : Only the MCLK to MMCICLKOUT *max* delay parameter is being */
/*        checked.                                                   */ 
set_output_delay -clock MCLK -max todmciclkoutmax MMCICLKOUT

set_output_delay -clock PCLK -min todmcivddmin MMCIVDD
set_output_delay -clock PCLK -max todmcivddmax MMCIVDD

/* MMCICMDOUT - vMMCICLKcard domain */
/* This path is relevant in normal operating mode */
set_output_delay -clock vMMCICLKcard -min todmcicmdoutmin MMCICMDOUT
set_output_delay -clock vMMCICLKcard -max todmcicmdoutmax MMCICMDOUT

/* MMCICMDOUT - PCLK domain */
/* During test mode, the MMCICMDOUT output is driven from a PCLK */
/* domain register bit. Hence an additional PCLK-referenced      */
/* constraint is placed on MMCICMDOUT.                           */
set_output_delay -clock PCLK -add_delay -min tpodmcicmdoutmin MMCICMDOUT
set_output_delay -clock PCLK -add_delay -max tpodmcicmdoutmax MMCICMDOUT

/* nMMCICMDEN - vMMCICLKcard domain */
/* This path is relevant in normal operating mode */
set_output_delay -clock vMMCICLKcard -min todnmcicmdenmin nMMCICMDEN
set_output_delay -clock vMMCICLKcard -max todnmcicmdenmax nMMCICMDEN

/* nMMCICMDEN - PCLK domain */
/* During test mode, the nMMCICMDEN output is driven from a PCLK */
/* domain register bit. Hence an additional PCLK-referenced      */
/* constraint is placed on nMMCICMDEN.                           */
set_output_delay -clock PCLK -add_delay -min tpodnmcicmdenmin nMMCICMDEN
set_output_delay -clock PCLK -add_delay -max tpodnmcicmdenmax nMMCICMDEN

/* MMCIDATOUT - vMMCICLKcard domain */
/* This path is relevant in normal operating mode */
set_output_delay -clock vMMCICLKcard -min todmcidatoutmin MMCIDATOUT
set_output_delay -clock vMMCICLKcard -max todmcidatoutmax MMCIDATOUT

/* MMCIDATOUT - PCLK domain */
/* During test mode, the MMCIDATOUT output is driven from a PCLK */
/* domain register bit. Hence an additional PCLK-referenced      */
/* constraint is placed on MMCIDATOUT.                           */
set_output_delay -clock PCLK -add_delay -min tpodmcidatoutmin MMCIDATOUT
set_output_delay -clock PCLK -add_delay -max tpodmcidatoutmax MMCIDATOUT

/* nMMCIDATEN - vMMCICLKcard domain */
/* This path is relevant in normal operating mode */
set_output_delay -clock vMMCICLKcard -min todnmcidatenmin nMMCIDATEN
set_output_delay -clock vMMCICLKcard -max todnmcidatenmax nMMCIDATEN

/* nMMCIDATEN - PCLK domain */
/* During test mode, the nMMCIDATEN output is driven from a PCLK */
/* domain register bit. Hence an additional PCLK-referenced      */
/* constraint is placed on nMMCIDATEN.                           */
set_output_delay -clock PCLK -add_delay -min tpodnmcidatenmin \
   nMMCIDATEN
set_output_delay -clock PCLK -add_delay -max tpodnmcidatenmax \
   nMMCIDATEN

/* MMCIPWR - MCLK domain */
/* This path is relevant in normal operating mode.               */
/* Note that MMCIPWR is not clocked off MMCIFBCLK; it is clocked */
/* off MCLK.                                                     */
set_output_delay -clock MCLK -min todmcipwrmin MMCIPWR
set_output_delay -clock MCLK -max todmcipwrmax MMCIPWR

/* MMCIPWR - PCLK domain */
/* During test mode, the MMCIPWR output is driven from a PCLK */
/* domain register bit. Hence an additional PCLK-referenced   */
/* constraint is placed on MMCIPWR.                           */
set_output_delay -clock PCLK -add_delay -min tpodmcipwrmin \
  MMCIPWR
set_output_delay -clock PCLK -add_delay -max tpodmcipwrmax \
  MMCIPWR

/* MMCIROD - PCLK domain */
/* The MMCIROD output is driven from a PCLK domain register */
/* bit. Hence a PCLK-referenced constraint is placed on     */
/* MMCIROD.                                                 */
set_output_delay -clock PCLK -min tpodmcirodmin MMCIROD
set_output_delay -clock PCLK -max tpodmcirodmax MMCIROD

/****************/
/* Scan Outputs */
/****************/

/* Scan Output - PCLK domain */
set_output_delay -clock PCLK -min todscanmin SCANOUTPCLK
set_output_delay -clock PCLK -max todscanmax SCANOUTPCLK

/* Scan Output - MCLK domain */
set_output_delay -clock MCLK -min todscanmin SCANOUTMCLK
set_output_delay -clock MCLK -max todscanmax SCANOUTMCLK

/* Scan Output - nMCLK domain */
set_output_delay -clock nMCLK -min todscanmin SCANOUTnMCLK
set_output_delay -clock nMCLK -max todscanmax SCANOUTnMCLK

/* Scan Output - MMCIFBCLK domain */
set_output_delay -clock MMCIFBCLK -min todscanmin SCANOUTMMCIFBCLK
set_output_delay -clock MMCIFBCLK -max todscanmax SCANOUTMMCIFBCLK

/***************************** End of Mmci.scr ********************************/
