cell (ARM922T) {
    interface_timing : TRUE;

 
    dont_touch : true;
    dont_use : true;
    area : 0.000; 
    cell_footprint : ARM922T;
 
 
    
    pin(DBGEN) {
        direction : input;
 
        capacitance : 0.054;
    } /* pin  */

    pin(ETMITBIT) {
        direction : output;
        timing() { 
            timing_type : rising_edge; 
            cell_rise (ARM922T_ss_delay_1_4) { 
                values ( \
                "3.60, 3.62, 3.65, 3.68, 3.75, 3.89, 3.96, 4.14, 4.32 ",\
                "3.61, 3.63, 3.65, 3.69, 3.76, 3.90, 3.97, 4.15, 4.32 ",\
                "3.62, 3.64, 3.67, 3.70, 3.77, 3.91, 3.98, 4.16, 4.34 ",\
                "3.64, 3.67, 3.69, 3.73, 3.80, 3.94, 4.01, 4.19, 4.36 ",\
                "3.67, 3.69, 3.72, 3.75, 3.82, 3.96, 4.03, 4.21, 4.39 ",\
                "3.68, 3.70, 3.72, 3.76, 3.83, 3.97, 4.04, 4.22, 4.40 "); 
            } /* path = 701 */
            rise_transition (ARM922T_ss_transition_1_4) { 
                values ("0.11, 0.15, 0.20, 0.29, 0.48, 0.88, 1.08, 1.59, 2.10");
            }
