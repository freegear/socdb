/******************************************************************************/
/* Purpose             : Synthesis constraints for the ARM922T wrapper        */
/*                       to ensure that SDF describes clock and reset         */
/*                       nets as ideal                                        */
/******************************************************************************/

set_resistance 0 HCLK
set_resistance 0 HRESETn
set_load 0 HCLK
set_load 0 HRESETn

nHCLKpins = find (pin nHCLKgen/*/*)
set_annotated_delay -cell 0  -from filter(nHCLKpins "@pin_direction == in") -to filter(nHCLKpins "@pin_direction == out")
