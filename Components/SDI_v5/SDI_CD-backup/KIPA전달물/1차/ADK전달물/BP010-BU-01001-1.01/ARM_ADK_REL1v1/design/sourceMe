######################################################################
# ADK Environment Variables
######################################################################

# ADK home directory
# Do not change the following three lines - they are used to set up
# the ADK environment variable which is used by almost all other
# scripts within ADK.
cd ..
setenv ADK `pwd`
cd design

# ADSCODE points to the location of the software
setenv ADSCODE $ADK/ADScode

# ADSUNIX indicates whether a UNIX version of ADS is available
# to build the EASY software. 
# Set to yes - compile EASY software under UNIX
# Set to no - EASY software compiled under Windows
setenv ADSUNIX yes
#setenv ADSUNIX no

# GLOBAL points towards the location of the global files used by ADK
setenv GLOBAL     $ADK/design/global_ADK

# Simulation of ADK is currently tested with ModelTech ModelSim (VHDL
# and Verilog), and Cadence LDV VerilogXL and ncSim (Verilog only)
# Note that if SIMULATOR is set to LDV, HDL_SOURCE and/or HDL_NETL
# must be set to verilog as appropriate (for HDL source or
# post-synthesis netlist simulations, respectively).
setenv SIMULATOR modelsim
#setenv SIMULATOR LDV

# If using Cadence LDV simulation tools, choose between VerilogXL
#("verilog") or ncSim ("ncverilog")
#setenv LDVSIMULATOR verilog
setenv LDVSIMULATOR ncverilog

# TEST_METH selects whether the synthesised netlist will be
# scan-enabled or not.  If set to "noscan" then no scan insertion or
# scan-related activities are performed.  If set to "scaninsert" then
# scan-enabled d-types are used in the design, a scan chain is
# inserted, and basic scan coverage is reported
#setenv TEST_METH scaninsert
setenv TEST_METH noscan

# HDL_SOURCE selects whether the source code is to be VHDL or Verilog
setenv HDL_SOURCE vhdl
#setenv HDL_SOURCE verilog

# HDL_NETL selects the HDL type for the synthesised netlists.
# Note that currently ADK only officially supports Verilog output from
# Synopsys.  Setting HDL_NETL to "vhdl" is not guaranteed to work.
#setenv HDL_NETL vhdl
setenv HDL_NETL verilog

######################################################################
# ADK System Variables
######################################################################

# The TEST_BENCH environment variable gives the name of the testbench
# used to simulate the chosen EASY system
# The PERIPH environment variable is used throughout the makefile
# system, and is over-ridden in the local makefiles.  It indicates the
# directory (under $ADK/design) in which the current component sits.
# Set the value here to indicate the directory within which the
# testbench to be simulated sits

setenv TEST_BENCH TBEasy_FRBM
setenv PERIPH TBEasy_FRBM

#setenv TEST_BENCH TBEasy_ML
#setenv TEST_BENCH TBEasy_ML_TIC
#setenv PERIPH TBEasy_ML

#setenv TEST_BENCH TBEasy_ARM7
#setenv TEST_BENCH TBEasy_ARM7_TIC
#setenv PERIPH TBEasy_ARM7

# The remainder of the testbench-specific settings are stored within
# sourceMe files in the testbench directories themselves.

source ${PERIPH}/sourceMe.${TEST_BENCH}

######################################################################
# Cell library Variables for synthesis
######################################################################

setenv LIB_SYNOP ${ADK}/avanti/2001.2/cb18/v1.0/synopsys/1999.05/models/generic/

######################################################################
# Cell library locations for simulation
######################################################################

setenv FILES_VERILOG ${ADK}/avanti/2001.2/cb18/v1.0/verilog/cb18os120/zero/mtb_verilog.v
setenv DIRS_VERILOG  ${ADK}/avanti/2001.2/cb18/v1.0/verilog/cb18os120/zero

setenv DIRS_VHDL ${ADK}/avanti/2001.2/cb18/v1.0/vital/cb18os120/zero/

setenv LIB_VHDL ${ADK}/avanti/2001.2/cb18/v1.0/vital/cb18os120/zero

