-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           RemapPause component.
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the component. 
--
-- --=================================================================*/

/********************************************************************/
/* OUTPUT CONSTRAINTS                                               */
/********************************************************************/

todmaxtim = tclk * 0.8
todmintim = 0

set_output_delay -clock PCLK -min todmintim Pause
set_output_delay -clock PCLK -max todmaxtim Pause

set_output_delay -clock PCLK -min todmintim Remap
set_output_delay -clock PCLK -max todmaxtim Remap

/************************* End of RemapPause.scr *************************/
