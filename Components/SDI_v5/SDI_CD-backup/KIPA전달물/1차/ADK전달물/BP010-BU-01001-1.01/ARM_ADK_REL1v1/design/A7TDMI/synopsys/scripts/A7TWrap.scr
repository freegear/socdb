--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing constraint script for the
--           ARM7TDMI AHB wrapper.
--
--           Located in the synopsys/scr_core directory.
--           Called by master compile script.
--
--           This file sets the module input and output delay constraints.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* TIMING PARAMETER RE-DEFINITIONS                                            */
/******************************************************************************/

/* Slow nMREQ/SEQ outputs cause extra delay on HTRANS so allow 50% of cycle */
/* rather than standard 40% */
todmaxhtrans    = tclk * 0.5

/******************************************************************************/
/* HCLK DEFINTION                                                             */
/******************************************************************************/

create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_skew -ideal -plus_uncertainty tpskew find(clock, HCLK)
/* set plus clock skew */

set_clock_skew -ideal -minus_uncertainty tmskew find(clock, HCLK)
/* set minus clock skew */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/******************************************************************************/
/* RESET SIGNAL CONSTRAINTS                                                   */
/******************************************************************************/
 
set_disable_timing find(port, HRESETn)
/* Do not check reset timing during synthesis */

set_load 0 HRESETn
/* Zero load reset signal */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on ideal reset net */

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_ideal_net find(net, HRESETn)
/* Define an ideal net for the reset net */

/* 1999.10 onwards USE NEW METHOD ABOVE TO REPLACE OLD ONE BELOW */
/* USE set_ideal_net WITHOUT set_dont_touch_network */
/* OTHERWISE ideal non-clock nets become buffered. */

/* set_dont_touch_network find(port, HRESETn) */
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* HIGH FANOUT NETS                                                           */
/******************************************************************************/

set_max_fanout 1.0 HREADYM

/******************************************************************************/
/* DIN HOLD DELAY SETTING                                                     */
/******************************************************************************/
/* The core DIN input is generated by the wrapper from either HRDATAM or */
/* HWDATAS according to the wrapper being in test mode. As these data buses */
/* pass through the AHB central multiplexers, it is expected that this will */
/* generate enough hold delay to satisfy the DIN requirement. /*

/* The following hold time value is used on the HRDATAM and HWDATAS */
/* buses to avoid synthesis inserting buffers on this path which has a large */
/* maximum delay value. */

tholddin = 0.05 * tclk

/******************************************************************************/
/* INPUT CONSTRAINTS                                                          */
/******************************************************************************/

/* AHB Master interface signals */

/* Uses DIN specific minimum hold delay value. */
set_input_delay -clock HCLK -min tholddin     HRDATAM
set_input_delay -clock HCLK -max tidmaxhrdata HRDATAM

set_input_delay -clock HCLK -min tholdmax     HREADYM
set_input_delay -clock HCLK -max tidmaxhready HREADYM

set_input_delay -clock HCLK -min tholdmax     HRESPM
set_input_delay -clock HCLK -max tidmaxhresp  HRESPM

set_input_delay -clock HCLK -min tholdmax     HGRANTM
set_input_delay -clock HCLK -max tidmaxhgrant HGRANTM

/* AHB Slave interface signals */

set_input_delay -clock HCLK -min tholdmax     HTRANS1S
set_input_delay -clock HCLK -max tidmaxhtrans HTRANS1S

set_input_delay -clock HCLK -min tholdmax     HWRITES
set_input_delay -clock HCLK -max tidmaxhwrite HWRITES

set_input_delay -clock HCLK -min tholdmax     HREADYS
set_input_delay -clock HCLK -max tidmaxhready HREADYS

/* Uses DIN specific minimum hold delay value. */
set_input_delay -clock HCLK -min tholddin     HWDATAS
set_input_delay -clock HCLK -max tidmaxhwdata HWDATAS

set_input_delay -clock HCLK -min tholdmax     HSELS
set_input_delay -clock HCLK -max tidmaxhsel   HSELS

/* Other signals */

tidmaxnfiq = tclk * 0.5

set_input_delay -clock HCLK -min tholdmax   ARMNFIQ
set_input_delay -clock HCLK -max tidmaxnfiq ARMNFIQ

tidmaxnirq = tclk * 0.7

set_input_delay -clock HCLK -min tholdmax   ARMNIRQ
set_input_delay -clock HCLK -max tidmaxnirq ARMNIRQ

/******************************************************************************/
/* OUTPUT CONSTRAINTS                                                         */
/******************************************************************************/

/* AHB Master interface signals */

set_output_delay -clock HCLK -min tholdmin      HADDRM
set_output_delay -clock HCLK -max todmaxhaddr   HADDRM

set_output_delay -clock HCLK -min tholdmin      HTRANSM
set_output_delay -clock HCLK -max todmaxhtrans  HTRANSM

set_output_delay -clock HCLK -min tholdmin      HWRITEM
set_output_delay -clock HCLK -max todmaxhwrite  HWRITEM

set_output_delay -clock HCLK -min tholdmin      HSIZEM
set_output_delay -clock HCLK -max todmaxhsize   HSIZEM

set_output_delay -clock HCLK -min tholdmin      HBURSTM
set_output_delay -clock HCLK -max todmaxhburst  HBURSTM

set_output_delay -clock HCLK -min tholdmin      HPROTM
set_output_delay -clock HCLK -max todmaxhprot   HPROTM

set_output_delay -clock HCLK -min tholdmin      HWDATAM
set_output_delay -clock HCLK -max todmaxhwdata  HWDATAM

set_output_delay -clock HCLK -min tholdmin      HBUSREQM
set_output_delay -clock HCLK -max todmaxhbusreq HBUSREQM

set_output_delay -clock HCLK -min tholdmin      HLOCKM
set_output_delay -clock HCLK -max todmaxhlock   HLOCKM

/* AHB Slave interface signals */

/* During slave testing of the ARM7TDMI the read data is comprised of many */
/* different core output ports. As the core outputs may become valid late in */
/* the cycle, then it may not be possible to perform slave testing at full */
/* system speed. */

/* To allow synthesis without false path settings, the output delay value for */
/* the read data has been set to zero, instead of the default 'todmaxhrdata'. */
/* As the HREADYOUTS and HRESPS outputs are tied to set levels, then they can use */
/* the default timing values. */

set_output_delay -clock HCLK -min tholdmin     HRDATAS
set_output_delay -clock HCLK -max 0            HRDATAS

set_output_delay -clock HCLK -min tholdmin     HREADYOUTS
set_output_delay -clock HCLK -max todmaxhready HREADYOUTS

set_output_delay -clock HCLK -min tholdmin     HRESPS
set_output_delay -clock HCLK -max todmaxhresp  HRESPS

/******************************************************************************/
/* TIMING PATHS                                                               */
/******************************************************************************/

/* False path settings to the JTAG core inputs, as the timing of the external */
/* JTAG ports is unknown, and JTAG testing will always be run at a low clock */
/* speed. */
set_false_path -to {uARM7TDMI/nTRST uARM7TDMI/TCK uARM7TDMI/TDI uARM7TDMI/TMS}

/* Test mode path is false for setup, but want hold fixed */
set_false_path -setup -to uA7TWrap/uA7TWrapTest/TestModeF_reg*

set_false_path -setup -from HREADYS
set_false_path -setup -from HTRANS1S
set_false_path -setup -from HWRITES
set_false_path -setup -from HWDATAS
set_false_path -setup -from HSELS

set_false_path -setup -to HRDATAS
set_false_path -setup -to HREADYOUTS
set_false_path -setup -to HRESPS

/********************************** End ***************************************/
