    (WIDTH (negedge CLK) (0.640:0.640:0.640))
    (WIDTH (posedge CLK) (0.390:0.390:0.390))
    (PERIOD UnGatedCLK ())
    (WIDTH (negedge UnGatedCLK) (0.640:0.640:0.640))
    (WIDTH (posedge UnGatedCLK) (0.390:0.390:0.390))
    )
  )

)
