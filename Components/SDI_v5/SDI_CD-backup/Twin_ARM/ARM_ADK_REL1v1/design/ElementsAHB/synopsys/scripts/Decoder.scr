-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           ElementsAHB component.
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the ElementsAHB 
--           component. 
--
-- --=================================================================*/

/********************************************************************/
/* VIRTUAL HCLK DEFINITION                                          */
/********************************************************************/

/* Define virtual HCLK, including no clock skew, as this is a purely */
/* combinational module */

create_clock -name VHCLK -p tclk -w {0 tclkh}
/* period tclk, rise at 0, fall after tclkh High phase */

/********************************************************************/
/* EXTRA INPUT CONSTRAINTS                                          */
/********************************************************************/

set_input_delay -clock VHCLK -min tholdmax       HADDR
set_input_delay -clock VHCLK -max tidmaxhaddrdec HADDR


/* Input constraint for Remap - point-to-point signal */
tidmaxremap    = tclk * 0.5

set_input_delay -clock VHCLK -min tholdmax    Remap
set_input_delay -clock VHCLK -max tidmaxremap Remap

/********************************************************************/
/* EXTRA OUTPUT CONSTRAINTS                                         */
/********************************************************************/

set_output_delay -clock VHCLK -min tholdmin   all_outputs()
set_output_delay -clock VHCLK -max todmaxhsel all_outputs()

/************************* End *************************/
