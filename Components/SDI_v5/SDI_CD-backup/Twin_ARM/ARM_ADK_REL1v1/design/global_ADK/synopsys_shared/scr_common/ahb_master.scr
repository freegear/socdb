--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis script
--           to define AMBA AHB timing constraints.
--           Located in the synopsys/scr_common directory.
--           Called by master compile script.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* DEFINE HCLK                                                                */
/******************************************************************************/

create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_uncertainty -hold tpskew find(clock, HCLK)
/* set clock skew for hold checks */

set_clock_uncertainty -setup tmskew find(clock, HCLK)
/* set clock skew for setup checks */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/**********************************************************************/
/* RESET SIGNAL CONSTRAINTS                                           */
/**********************************************************************/
 
/* set_input_delay -clock HCLK -max tidmaxresetn HRESETn */
/* set_input_delay -clock HCLK -min tidminresetn HRESETn */

set_disable_timing find(port, HRESETn)
/* Do not check reset timing during synthesis */

set_load 0 HRESETn
/* Zero load reset signal */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on ideal reset net */

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_ideal_net find(net, HRESETn)
/* Define an ideal net for the reset net */

/* 1999.10 onwards USE NEW METHOD ABOVE TO REPLACE OLD ONE BELOW */
/* USE set_ideal_net WITHOUT set_dont_touch_network */
/* OTHERWISE ideal non-clock nets become buffered. */

/* set_dont_touch_network find(port, HRESETn) */
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* HIGH FANOUT NETS                                                           */
/******************************************************************************/

/******************************************************************************/
/* INPUT CONSTRAINTS                                                          */
/******************************************************************************/
/* Not all AHB masters have the standard inputs, so 'if' statements are used */
/* to control the input port settings for specific modules. */

if (topname != TIC) {
set_input_delay -clock HCLK -min tholdmax     HRDATA
set_input_delay -clock HCLK -max tidmaxhrdata HRDATA
}

set_input_delay -clock HCLK -min tholdmax     HREADY
set_input_delay -clock HCLK -max tidmaxhready HREADY

set_input_delay -clock HCLK -min tholdmax     HRESP
set_input_delay -clock HCLK -max tidmaxhresp  HRESP

set_input_delay -clock HCLK -min tholdmax     HGRANT*
set_input_delay -clock HCLK -max tidmaxhgrant HGRANT*


/******************************************************************************/
/* OUTPUT CONSTRAINTS                                                         */
/******************************************************************************/

set_output_delay -clock HCLK -min tholdmin      HADDR
set_output_delay -clock HCLK -max todmaxhaddr   HADDR

set_output_delay -clock HCLK -min tholdmin      HTRANS
set_output_delay -clock HCLK -max todmaxhtrans  HTRANS

set_output_delay -clock HCLK -min tholdmin      HWRITE
set_output_delay -clock HCLK -max todmaxhwrite  HWRITE

set_output_delay -clock HCLK -min tholdmin      HSIZE
set_output_delay -clock HCLK -max todmaxhsize   HSIZE

set_output_delay -clock HCLK -min tholdmin      HBURST
set_output_delay -clock HCLK -max todmaxhburst  HBURST

set_output_delay -clock HCLK -min tholdmin      HPROT
set_output_delay -clock HCLK -max todmaxhprot   HPROT

set_output_delay -clock HCLK -min tholdmin      HWDATA
set_output_delay -clock HCLK -max todmaxhwdata  HWDATA

set_output_delay -clock HCLK -min tholdmin      HBUSREQ*
set_output_delay -clock HCLK -max todmaxhbusreq HBUSREQ*

set_output_delay -clock HCLK -min tholdmin      HLOCK*
set_output_delay -clock HCLK -max todmaxhlock   HLOCK*

/************************************* End ************************************/
