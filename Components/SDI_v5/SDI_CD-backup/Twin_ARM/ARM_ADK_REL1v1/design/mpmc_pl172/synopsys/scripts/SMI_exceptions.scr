--
--           This file specifies the point-to-point exceptions 
--           set for the SMI component synthesis. 
--
-- --=================================================================*/

/* The following signals are not used in the SMI, and are present only */
/*  to be pin-compatible with Primecell SMC PL092 */

set_disable_timing find(port,nHCLK)
set_disable_timing find(port,HBURST)
set_disable_timing find(port,HSELREG)
set_disable_timing find(port,BIGENDIAN)
set_disable_timing find(port,TICBUSGNTEBI)
set_disable_timing find(port,SMBUSGNTEBI)
set_disable_timing find(port,SCANINnHCLK)
set_disable_timing find(port,SMWAIT)
set_disable_timing find(port,CANCELSMWAIT)
set_disable_timing find(port,SMMWCS7)
set_disable_timing find(port,MCBUSREQ)
set_disable_timing find(port,MCADDR)
set_disable_timing find(port,MCDATAOUT)
set_disable_timing find(port,MCDATAEN)
set_disable_timing find(port,EXTBUSMUX)

/****************** End of SMI_exceptions.scr *********************/
