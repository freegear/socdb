--
-- File Name              : SMI.scr,v
-- File Revision          : 1.5
--
-- Release Information    : ADK_REL1v1
--
-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           SMI component.
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the SMI 
--           component. 
--
-- --=================================================================*/

/* Constraints for SMI external address/control signals */
tidmaxsmi = tclk * 0.7
todmaxsmi = tclk * 0.6

/* Constraints for SMI external data signals */
tidmaxsmid = tclk * 0.2
todmaxsmid = tclk * 0.1

/* Constraints for SMI external test signals */
tidmaxsmit = tclk * 0.2
todmaxsmit = tclk * 0.1

/******************************************************************************/
/* HCLK DEFINTION                                                             */
/******************************************************************************/

create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_uncertainty -hold tpskew find(clock, HCLK)
/* set clock skew for hold checks */

set_clock_uncertainty -setup tmskew find(clock, HCLK)
/* set clock skew for setup checks */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/**********************************************************************/
/* RESET SIGNAL CONSTRAINTS                                           */
/**********************************************************************/
 
/* set_input_delay -clock HCLK -max tidmaxresetn HRESETn */
/* set_input_delay -clock HCLK -min tidminresetn HRESETn */

set_disable_timing find(port, HRESETn)
/* Do not check reset timing during synthesis */

set_load 0 HRESETn
/* Zero load reset signal */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on ideal reset net */

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_ideal_net find(net, HRESETn)
/* Define an ideal net for the reset net */

/* 1999.10 onwards USE NEW METHOD ABOVE TO REPLACE OLD ONE BELOW */
/* USE set_ideal_net WITHOUT set_dont_touch_network */
/* OTHERWISE ideal non-clock nets become buffered. */

/* set_dont_touch_network find(port, HRESETn) */
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* HIGH FANOUT NETS                                                           */
/******************************************************************************/

set_max_fanout 1.0 HREADYIN
set_max_fanout 1.0 HREADYINTIC

/******************************************************************************/
/* INPUT CONSTRAINTS                                                          */
/******************************************************************************/

/* SMI AHB slave port */

set_input_delay -clock HCLK -min tholdmax     HADDR
set_input_delay -clock HCLK -max tidmaxhaddr  HADDR

set_input_delay -clock HCLK -min tholdmax     HTRANS
set_input_delay -clock HCLK -max tidmaxhtrans HTRANS

set_input_delay -clock HCLK -min tholdmax     HWRITE
set_input_delay -clock HCLK -max tidmaxhwrite HWRITE

set_input_delay -clock HCLK -min tholdmax     HSIZE
set_input_delay -clock HCLK -max tidmaxhsize  HSIZE

set_input_delay -clock HCLK -min tholdmax     HWDATA
set_input_delay -clock HCLK -max tidmaxhwdata HWDATA

set_input_delay -clock HCLK -min tholdmax     HSELSMC
set_input_delay -clock HCLK -max tidmaxhsel   HSELSMC

set_input_delay -clock HCLK -min tholdmax     HREADYIN
set_input_delay -clock HCLK -max tidmaxhready HREADYIN


/* TIC AHB master port */

set_input_delay -clock HCLK -min tholdmax     HRDATATIC
set_input_delay -clock HCLK -max tidmaxhrdata HRDATATIC

set_input_delay -clock HCLK -min tholdmax     HREADYINTIC
set_input_delay -clock HCLK -max tidmaxhready HREADYINTIC

set_input_delay -clock HCLK -min tholdmax     HRESPTIC
set_input_delay -clock HCLK -max tidmaxhresp  HRESPTIC

set_input_delay -clock HCLK -min tholdmax     HGRANTTIC
set_input_delay -clock HCLK -max tidmaxhgrant HGRANTTIC



/* Non-AMBA signals */

set_input_delay -clock HCLK -min tholdmax     REMAP
set_input_delay -clock HCLK -max tidmaxsmi    REMAP

set_input_delay -clock HCLK -min tholdmax     SMDATAIN
set_input_delay -clock HCLK -max tidmaxsmid   SMDATAIN

set_input_delay -clock HCLK -min tholdmax     TESTREQA
set_input_delay -clock HCLK -max tidmaxsmit   TESTREQA

set_input_delay -clock HCLK -min tholdmax     TESTREQB
set_input_delay -clock HCLK -max tidmaxsmit   TESTREQB



/******************************************************************************/
/* OUTPUT CONSTRAINTS                                                         */
/******************************************************************************/

/* SMI AHB slave port */

set_output_delay -clock HCLK -min tholdmin     HRDATA
set_output_delay -clock HCLK -max todmaxhrdata HRDATA

set_output_delay -clock HCLK -min tholdmin     HREADYOUT
set_output_delay -clock HCLK -max todmaxhready HREADYOUT

set_output_delay -clock HCLK -min tholdmin     HRESP
set_output_delay -clock HCLK -max todmaxhresp  HRESP


/* TIC AHB master port */

set_output_delay -clock HCLK -min tholdmin      HADDRTIC
set_output_delay -clock HCLK -max todmaxhaddr   HADDRTIC

set_output_delay -clock HCLK -min tholdmin      HTRANSTIC
set_output_delay -clock HCLK -max todmaxhtrans  HTRANSTIC

set_output_delay -clock HCLK -min tholdmin      HWRITETIC
set_output_delay -clock HCLK -max todmaxhwrite  HWRITETIC

set_output_delay -clock HCLK -min tholdmin      HSIZETIC
set_output_delay -clock HCLK -max todmaxhsize   HSIZETIC

set_output_delay -clock HCLK -min tholdmin      HBURSTTIC
set_output_delay -clock HCLK -max todmaxhburst  HBURSTTIC

set_output_delay -clock HCLK -min tholdmin      HPROTTIC
set_output_delay -clock HCLK -max todmaxhprot   HPROTTIC

set_output_delay -clock HCLK -min tholdmin      HWDATATIC
set_output_delay -clock HCLK -max todmaxhwdata  HWDATATIC

set_output_delay -clock HCLK -min tholdmin      HBUSREQTIC
set_output_delay -clock HCLK -max todmaxhbusreq HBUSREQTIC

set_output_delay -clock HCLK -min tholdmin      HLOCKTIC
set_output_delay -clock HCLK -max todmaxhlock   HLOCKTIC


/* Non-AMBA signals */

set_output_delay -clock HCLK -min tholdmin      SMDATAOUT
set_output_delay -clock HCLK -max todmaxsmid    SMDATAOUT

set_output_delay -clock HCLK -min tholdmin      nSMDATAEN
set_output_delay -clock HCLK -max todmaxsmi     nSMDATAEN

set_output_delay -clock HCLK -min tholdmin      SMADDR
set_output_delay -clock HCLK -max todmaxsmi     SMADDR

set_output_delay -clock HCLK -min tholdmin      SMCS
set_output_delay -clock HCLK -max todmaxsmi     SMCS

set_output_delay -clock HCLK -min tholdmin      nSMBLS
set_output_delay -clock HCLK -max todmaxsmi     nSMBLS

set_output_delay -clock HCLK -min tholdmin      nSMOEN
set_output_delay -clock HCLK -max todmaxsmi     nSMOEN

set_output_delay -clock HCLK -min tholdmin      TESTACK
set_output_delay -clock HCLK -max todmaxsmit    TESTACK

/************************* End of SMI.scr *************************/
