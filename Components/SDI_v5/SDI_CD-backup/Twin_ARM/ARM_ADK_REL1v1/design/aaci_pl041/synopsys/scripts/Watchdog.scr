----------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing constraint script for the 
--           Watchdog block
--
--           Located in the synopsys/scripts directory. 
--           Called by master compile script.
--
--           This file sets the module input and output delay constraints.
--------------------------------------------------------------------*/

/********************************************************************/
/* DEFINE WDOGCLK                                                   */
/********************************************************************/

create_generated_clock -source PCLK -divide_by 1 WDOGCLK
/* WDOGCLK is derived from PCLK (default is to follow PCLK) 
/* Note that it inherits all PCLK attributes */


/********************************************************************/
/* RESET SIGNAL CONSTRAINTS                                         */
/********************************************************************/
 
set_disable_timing WDOGRESn
/* Do not check reset timing during synthesis */

set_load 0 WDOGRESn
/* Zero load reset signal */

set_resistance 0 find(net, WDOGRESn)
/* Zero resistance for zero net delay(interconnect delay) on ideal reset net */

set_drive 0 WDOGRESn
/* Infinite drive strength reset signal */

remove_driving_cell WDOGRESn
/* Set no driving cell on reset */

set_ideal_net find(net, WDOGRESn)
/* Define an ideal net for the reset net */

/********************************************************************/
/* CLOCK ENABLE SIGNAL CONSTRAINTS                                  */
/********************************************************************/
 
tidmaxwcen = tclk * 0.7

set_input_delay -clock PCLK -min tholdmax   WDOGCLKEN
set_input_delay -clock PCLK -max tidmaxwcen WDOGCLKEN

/********************************************************************/
/* OUTPUT CONSTRAINTS                                               */
/********************************************************************/

todmaxwd = tclk * 0.8
todminwd = 0

/* Interrupt and reset outputs */

set_output_delay -clock PCLK -min todminwd WDOGRES
set_output_delay -clock PCLK -max todmaxwd WDOGRES

set_output_delay -clock PCLK -min todminwd WDOGINT
set_output_delay -clock PCLK -max todmaxwd WDOGINT

/********************************** End *****************************/
