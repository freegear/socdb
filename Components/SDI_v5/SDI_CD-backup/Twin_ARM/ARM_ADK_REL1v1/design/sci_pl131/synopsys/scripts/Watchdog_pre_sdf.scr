/********************************************************************/
/* Purpose             : Synthesis constraints for the Watchdog     */
/*                       to ensure that SDF describes clock and     */  
/*                       reset nets as ideal                        */
/********************************************************************/

set_resistance 0 find(net, PCLK)
set_resistance 0 find(net, WDOGCLK)
set_resistance 0 find(net, PRESETn)
set_resistance 0 find(net, WDOGRESn)

set_load 0 PCLK
set_load 0 WDOGCLK
set_load 0 PRESETn
set_load 0 WDOGRESn

