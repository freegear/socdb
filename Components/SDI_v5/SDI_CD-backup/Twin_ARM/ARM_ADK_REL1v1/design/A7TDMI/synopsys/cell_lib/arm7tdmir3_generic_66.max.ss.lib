      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

   cell (ARM7TDMI) {
      interface_timing : true;  /* Apply interface timing semantics */
      dont_touch : true;
      dont_use : true;
      area : 0.000; /* Unmodified area = 0.000 */ 
      cell_footprint : ARM7TDMI;

      /* clock pins */
      pin(MCLK) {
         direction   : input;
         capacitance : .358;
         clock : true;
         min_pulse_width_high  : 7.50;
         min_pulse_width_low  : 7.50;
      }
      pin(TCK) {
         direction   : input;
         capacitance : .041;
         clock : true;
         min_pulse_width_high  : 50.00;
         min_pulse_width_low  : 50.00;
      }
      /* input pins */
      pin(ABE) {
         direction   : input;
         capacitance : .024;
      }
      pin(ABORT) {
         direction   : input;
         capacitance : .024;
         timing() { /* Parameter Tabth */
            related_pin  : "MCLK";
            timing_type  : hold_falling;
            rise_constraint(scalar) {
               values("1.75");
            }
            fall_constraint(scalar) {
               values("1.75");
            }
         }
         timing() { /* Parameter Tabts */
            related_pin  : "MCLK";
            timing_type  : setup_falling;
            rise_constraint(scalar) {
               values("0.00");
            }
            fall_constraint(scalar) {
               values("0.00");
            }
         }
      }
