      bit_from  : 31;
      bit_to    : 0;
   }

   type (busDOUT) {
      base_type : array;
      data_type : bit;
      bit_width : 32;
      bit_from  : 31;
      bit_to    : 0;
   }

   type (busIR) {
      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

   type (busMAS) {
      base_type : array;
      data_type : bit;
      bit_width : 2;
      bit_from  : 1;
      bit_to    : 0;
   }

   type (busnM) {
      base_type : array;
      data_type : bit;
      bit_width : 5;
      bit_from  : 4;
      bit_to    : 0;
   }

   type (busSCREG) {
      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

