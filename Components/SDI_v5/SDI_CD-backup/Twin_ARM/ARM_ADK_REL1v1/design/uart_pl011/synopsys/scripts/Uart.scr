------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           PERIPH block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the PERIPH block. 
--
-- --=================================================================*/



/**********************************************************************/
/* BLOCK-SPECIFIC TIMING PARAMETERS                                   */
/**********************************************************************/

/* Reference clock parameters (tr) */

trclkh = tclkh           /* Reference clock high phase                */
                         /* The reference clock frequency is set to   */
                         /* be the same as the PCLK frequency.        */

trclkh = trclkh - oc_margin /* set the  high phase after              */
                            /* subtracting the over-constraining      */
                            /* margin                                 */

trclkl = trclkh             /* Reference clock low phase              */

trclk  = trclkh + trclkl    /* Reference clock period                 */

trclkpskew = tpskew         /* Reference clock plus clock skew        */
trclkmskew = tmskew         /* Reference clock minus clock skew       */


/**********************************************************************/
/* Define the reference clock, including clock skew                   */
/**********************************************************************/

create_clock -p trclk -w {0 trclkh} find(port, "UARTCLK")
/* period trclk, rise at 0, fall after trclkh High phase */

set_clock_skew -plus_uncertainty trclkpskew find(clock, UARTCLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty trclkmskew find(clock, UARTCLK)
/* set minus clock skew */

set_dont_touch_network find(clock, UARTCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 UARTCLK

set_drive 0 UARTCLK
/* Infinite drive strength clock signal */


/**********************************************************************/
/* Input setup and hold times for Non-AMBA inputs                     */
/**********************************************************************/

tisna = 0.3 * tclk        /* 30% of clock period */
tihna = 0.0

/**********************************************************************/
/* Output valid and hold times for Non-AMBA outputs                   */
/**********************************************************************/

tovna = 0.4 * tclk       /* 40% of clock period*/
tohna = 0

/**********************************************************************/
/* Convert the setup/hold values into input delay synthesis           */
/* parameters                                                         */
/**********************************************************************/

/********************/
/* Non Amba  Inputs */
/********************/

tidnamax = tclk - tisna
tidnamin = tihna

/***************/
/* Scan Inputs */
/***************/

/* The input delay on the Scan related input signals has been set to  */
/* a small non-zero value to prevent addition of extra gates in these */
/* paths.                                                             */

tidscanmax = 0.3  
tidscanmin = 0.3 


/**********************************************************************/
/* Convert the valid/hold values into output delay synthesis          */
/* parameters                                                         */
/**********************************************************************/

/*********************/
/* Non Amba Outputs  */
/*********************/

todnamax   = tclk - tovna
todnamin   = tohna

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */

todscanmax = 0.0
todscanmin = 0.0


/**********************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                               */
/**********************************************************************/

/********************/
/* Non Amba Inputs  */
/********************/

set_input_delay -clock UARTCLK -min tidnamin nUARTCTS
set_input_delay -clock UARTCLK -max tidnamax nUARTCTS

set_input_delay -clock UARTCLK -min tidnamin nUARTDCD
set_input_delay -clock UARTCLK -max tidnamax nUARTDCD

set_input_delay -clock UARTCLK -min tidnamin nUARTDSR
set_input_delay -clock UARTCLK -max tidnamax nUARTDSR

set_input_delay -clock UARTCLK -min tidnamin nUARTRI
set_input_delay -clock UARTCLK -max tidnamax nUARTRI

set_input_delay -clock UARTCLK -min tidnamin UARTRXD
set_input_delay -clock UARTCLK -max tidnamax UARTRXD

set_input_delay -clock UARTCLK -min tidnamin SIRIN
set_input_delay -clock UARTCLK -max tidnamax SIRIN

set_input_delay -clock PCLK -min tidnamin UARTTXDMACLR
set_input_delay -clock PCLK -max tidnamax UARTTXDMACLR

set_input_delay -clock PCLK -min tidnamin UARTRXDMACLR
set_input_delay -clock PCLK -max tidnamax UARTRXDMACLR


/***************/
/* Scan Inputs */
/***************/

set_input_delay -clock PCLK -min tidscanmin SCANINPCLK
set_input_delay -clock PCLK -max tidscanmax SCANINPCLK

set_input_delay -clock PCLK -min tidscanmin SCANINUCLK
set_input_delay -clock PCLK -max tidscanmax SCANINUCLK

set_input_delay -clock PCLK -min tidscanmin SCANENABLE
set_input_delay -clock PCLK -max tidscanmax SCANENABLE

set_drive 0 SCANENABLE  /* Infinite drive strength Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/**********************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA OUTPUTS                            */
/**********************************************************************/

set_output_delay -clock UARTCLK -min todnamin UARTTXD
set_output_delay -clock UARTCLK -max todnamax UARTTXD

set_output_delay -clock UARTCLK -min todnamin nSIROUT
set_output_delay -clock UARTCLK -max todnamax nSIROUT

set_output_delay -clock UARTCLK -min todnamin UARTMSINTR
set_output_delay -clock UARTCLK -max todnamax UARTMSINTR

set_output_delay -clock UARTCLK -min todnamin UARTRTINTR
set_output_delay -clock UARTCLK -max todnamax UARTRTINTR

set_output_delay -clock PCLK -min todnamin nUARTOut2
set_output_delay -clock PCLK -max todnamax nUARTOut2

set_output_delay -clock PCLK -min todnamin nUARTOut1
set_output_delay -clock PCLK -max todnamax nUARTOut1

set_output_delay -clock PCLK -min todnamin nUARTRTS
set_output_delay -clock PCLK -max todnamax nUARTRTS

set_output_delay -clock PCLK -min todnamin nUARTDTR
set_output_delay -clock PCLK -max todnamax nUARTDTR

set_output_delay -clock PCLK -min todnamin UARTRXINTR
set_output_delay -clock PCLK -max todnamax UARTRXINTR

set_output_delay -clock PCLK -min todnamin UARTTXINTR
set_output_delay -clock PCLK -max todnamax UARTTXINTR

set_output_delay -clock PCLK -min todnamin UARTTXDMASREQ
set_output_delay -clock PCLK -max todnamax UARTTXDMASREQ

set_output_delay -clock PCLK -min todnamin UARTRXDMASREQ
set_output_delay -clock PCLK -max todnamax UARTRXDMASREQ

set_output_delay -clock PCLK -min todnamin UARTTXDMABREQ
set_output_delay -clock PCLK -max todnamax UARTTXDMABREQ

set_output_delay -clock PCLK -min todnamin UARTRXDMABREQ
set_output_delay -clock PCLK -max todnamax UARTRXDMABREQ

/* These output delay settings will be overridden by false   */
/* path settings in the Uart_exceptions.scr file. If PCLK    */
/* and UARTCLK are fed from the same source, the false path  */
/* settings should be removed and the following output delay */
/* settings will take effect. */

set_output_delay -clock PCLK -min todnamin UARTINTR
set_output_delay -clock PCLK -max todnamax UARTINTR

set_output_delay -clock PCLK -min todnamin UARTEINTR
set_output_delay -clock PCLK -max todnamax UARTEINTR



/****************************************/
/* OUTPUT CONSTRAINTS FOR SCAN OUTPUTS  */
/***************************************/

set_output_delay -clock PCLK -min todscanmin SCANOUTPCLK 
set_output_delay -clock PCLK -max todscanmax SCANOUTPCLK

set_output_delay -clock PCLK -min todscanmin SCANOUTUCLK
set_output_delay -clock PCLK -max todscanmax SCANOUTUCLK


/******************************************************/
/* CONSTRAINTS FOR REFERENCE CLOCK DOMAIN RESET INPUT */
/*****************************************************/


/* These have been assigned the same input delay values */ 
/* as that of the AMBA PRESETn reset signal.            */

set_input_delay -clock UARTCLK -max tidmaxnres nUARTRST
set_input_delay -clock UARTCLK -min tidminnres nUARTRST

set_drive 0 nUARTRST
/* Infinite drive strength reset signal */

set_resistance 0 nUARTRST

/************************* End of Periph.scr *****************************/
