`define ZEROFILL         32'h00000000
// -----------------------------------------------------------------------------
// Arbiter Priority order definations
// -----------------------------------------------------------------------------
`define ARBORDER123      3'b000
// Priority order follows 1-2-3

`define ARBORDER231      3'b001
// Priority order follows 2-3-1

`define ARBORDER312      3'b010
// Priority order follows 3-1-2

`define ARBORDER132      3'b011
// Priority order follows 1-2-2

`define ARBORDER213      3'b100
// Priority order follows 2-1-3

`define ARBORDER321      3'b101
// Priority order follows 3-2-1

// -----------------------------------------------------------------------------
// Port number defination
// -----------------------------------------------------------------------------
`define PORT1            3'b001
// Indicates the port1

`define PORT2            3'b010
// Indicates the port1

`define PORT3            3'b100
// Indicates the port1

`define NOONE            3'b000
// Indicates the port1

