  |-/ARM7TDMI_serial/       ; ARM7TDMI model simulation environment using JTAG
  |   |
  |   |-/bin/
  |   |      compile_vxl                   ; test run script using verilog-xl
  |   |    ( compile_modelsim_vhd   )      ; test run script using modelsim(vhdl)
  |   |    ( compile_modelsim       )      ; test run script using modelsim(verilog)
  |   |    ( compile_ncsim          )      ; test run script using ncsim(verilog)
  |   |    ( compile_vcs            )      ; test run script using vcs(verilog)
  |   |      t_vxl                         ; all sim batch file using verilog-xl
  |   |    ( t_modelsim_vhd         )      ; all sim batch file using modelsim(vhdl)
  |   |    ( t_modelsim             )      ; all sim batch file using modelsim(verilog)
  |   |    ( t_ncsim                )      ; all sim batch file using ncsim(verilog)
  |   |    ( t_vcs                  )      ; all sim batch file using vcs(verilog)
  |   |                                      ex) >> compile_vxl arm7tdmi_ale_aler3_p0 max ctime
  |   |                                      ex) >> t_vxl typ sdf
