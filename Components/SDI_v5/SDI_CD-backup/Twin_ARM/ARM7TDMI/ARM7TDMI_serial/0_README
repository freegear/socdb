  |   |    |     ARM7TDMIr3.so[sl]         ;   ARM7TDMI object code
  |   |    |     ARM7TDMIr3.v              ;   ARM7TDMI verilog file for function call
  |   |    |     ARM7TDMIr3_sdf.v          ;   ARM7TDMI verilog file for function call
  |   |   (|-/cadence_nc_verilog/   )
  |   |   (|-/cadence_nc_vhdl/      )
