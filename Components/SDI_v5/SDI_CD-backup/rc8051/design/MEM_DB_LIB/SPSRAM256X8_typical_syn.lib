			  "0.853, 0.858, 0.867, 0.881, 0.929, 1.005, 1.088" \
			)
			}
			rise_transition(SPSRAM256X8_load_template) {
			index_1 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ("0.073, 0.083, 0.102, 0.132, 0.231, 0.389, 0.562")
			}
			cell_fall(SPSRAM256X8_delay_template) {
			index_1 ("0.010, 0.050, 0.100, 0.200, 0.400, 0.600, 0.800");
			index_2 ("0.000, 0.010, 0.030, 0.060, 0.160, 0.320, 0.495");
			values ( \
			  "0.858, 0.860, 0.864, 0.871, 0.893, 0.928, 0.966", \
			  "0.857, 0.859, 0.864, 0.870, 0.892, 0.927, 0.966", \
