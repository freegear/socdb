	pin(CLK) {
		direction : input;
		capacitance : 0.181
		clock	: true;
		min_pulse_width_low	: 0.103;
		min_pulse_width_high	: 0.083;
		min_period		: 0.694;
		max_transition		: 2.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(SPSRAM256X8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("88.259, 88.259")
        		}
        		fall_power(SPSRAM256X8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(SPSRAM256X8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("98.807, 98.807")
			}	
			fall_power(SPSRAM256X8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
	}

