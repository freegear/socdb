	pin(CLK) {
		direction : input;
		capacitance : 0.131
		clock	: true;
		min_pulse_width_low	: 0.260;
		min_pulse_width_high	: 0.183;
		min_period		: 1.631;
		max_transition		: 4.000;
		internal_power(){
			when : "!CEN & WEN";
        		rise_power(SPSRAM256X8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("52.840, 52.840")
        		}
        		fall_power(SPSRAM256X8_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CEN & !WEN";
			rise_power(SPSRAM256X8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("59.161, 59.161")
			}	
			fall_power(SPSRAM256X8_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
	}

