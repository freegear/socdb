[FSM_Dlg-Print]
Orientation = Landscape        
[Form]
version = 5.0.v13
sch/schTopWin.fm = 190,29,1268,929
schSelectFocus.fm = 105,128,232,320
[HB]
ViewSchematic = FALSE
windowLayout = 4 22 804 500 182 214 804 234
import_filter = *.v; *.vc; *.f
designTreeFont = -adobe-helvetica-medium-r-normal--14-*-75-75-*-*-iso8859-*
import_filter_vhdl = *.vhd; *.vhdl; *.f
import_default_language = Verilog
import_filter_verilog = *.v; *.vc; *.f
simulation_file_type = *.fsdb;*.ff;*.dump
[OtherEditor]
cmd1 = "xterm -font 9x15 -fg black -bg gray -e"
name = "vi"
options = "+${CurLine} ${CurFileName}"
[Print]
PrinterName = lp
FileName = test.ps
PaperSize = A4 - 210x297 (mm)
ColorPrint = FALSE
[Session Cache]
1 = string (session file name)
2 = string (session file name)
3 = string (session file name)
4 = string (session file name)
5 = string (session file name)
[Simulation]
xlPath = verilog
xlOption = 
ncPath = ncsim
ncOption = -f ncsim.args
vcsPath = simv
vcsOption = 
mtiPath = vsim
mtiOption = 
lfPath = sv
lfOption = 
vhncPath = ncsim
vhncOption = -log debussy.nc.log
speedsimPath = 
speedsimOption = 
interactiveDebugging = {True, False}
KeepBreakPoints = False
simType = {xl, nc, vcs, mti, lf}
thirdpartyIdx = -1
iscCmdSep = FALSE
