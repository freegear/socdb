/* FILE : SynTest SRAMBIST Synopsys Synthesis Script file */
/* NAME : SPSRAM256X8.scp                                 */
/* TOOL : srambist V1.2.0 r01 (05/30/01 09:35:47) */
/* TIME : Tue Jul  3 15:05:48 2001
 */

sh date

read -f verilog { \
               SPSRAM256X8_top.v \
               SPSRAM256X8_wrapper.v \
               SPSRAM256X8_rb.v \
              }

current_design Bisted_SPSRAM256X8

check_design  -summary

set_operating_conditions WCCOM

create_clock -name CLK -period 100 -waveform {0 50.000} find (port "CLK")

set_dont_touch_network CLK

uniquify

compile -map_effort high

report_area
report_timing

write -f verilog -h -o Bisted_SPSRAM256X8.vg

quit
