}
   "capture" {
      W "_default_WFT_";
      F {  "test_mode"=1; "BistMode"=0; } 
      V { "_pi"=\r34 #; "_po"=\r56 #; }
   }
   "capture_clk" {
      W "_default_WFT_";
      F {  "test_mode"=1; "BistMode"=0; } 
      "forcePI": V { "_pi"=\r34 #; }
      "measurePO": V { "_po"=\r56 #; }
      "pulse": V { "clk"=P; }
   }
   "capture_rst_p" {
      W "_default_WFT_";
      F {  "test_mode"=1; "BistMode"=0; } 
      "forcePI": V { "_pi"=\r34 #; }
      "measurePO": V { "_po"=\r56 #; }
      "pulse": V { "rst_p"=P; }
   }
} 
