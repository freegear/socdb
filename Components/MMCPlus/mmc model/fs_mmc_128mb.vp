`endprotected
module S3F49DAX (
		MCLK,		// input
		MCMD,		// inout
		MDAT,		// inout
		MCS		// input
		);

input		MCLK;
input		MCS;
inout		MCMD;
inout		MDAT;

reg		HCLK;
reg		HRESETn;

wire		MCMDin;
wire		MCMDout;
wire		MCMDouten;
wire		MDATin;
wire		MDATout;
wire		MDATouten;

assign		MCMD   = (MCMDouten)  ? MCMDout : 1'bz;
//assign		MCMDin = (!MCMDouten) ? MCMD    : 1'bz;
assign	#2	MCMDin = MCMD;

assign		MDAT   = (MDATouten)  ? MDATout : 1'bz;
//assign		MDATin = (!MDATouten) ? MDAT    : 1'bz;
assign	#2	MDATin = MDAT;

initial begin
	HCLK = 1'b0;
	HRESETn = 1'b0;
	#3000
	HRESETn = 1'b1;
end

always #25	HCLK = ~HCLK;

mmc	mmc (
	.HRESETn	(HRESETn),		// input
	.HCLK		(HCLK),			// input

	.MCLK		(MCLK),			// input
	.MCS		(MCS),			// input
	.MCMDIN		(MCMDin),		// input
	.MCMDOUT	(MCMDout),		// output
	.MCMDOUTEN	(MCMDouten),		// output
	.MDATIN		(MDATin),		// input
	.MDATOUT	(MDATout),		// output
	.MDATOUTEN	(MDATouten)		// output
);

endmodule
