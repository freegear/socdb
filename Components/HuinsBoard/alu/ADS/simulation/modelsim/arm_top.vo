`timescale 1 ps/ 1 ps

module 	arm_top (
	HCLOCK,
	HRESET,
	clk_ref,
	npor,
	ebiack,
	uartctsn,
	uartdsrn,
	uartrxd,
	intextpin,
	nreset,
	uartdcdn,
	uartrin,
	ebidq,
	uarttxd,
	uartrtsn,
	uartdtrn,
	ebiwen,
	ebioen,
	ebiclk,
	ebiaddr,
	ebibe,
	ebicsn);
input 	HCLOCK;
input 	HRESET;
input 	clk_ref;
input 	npor;
input 	ebiack;
input 	uartctsn;
input 	uartdsrn;
input 	uartrxd;
input 	intextpin;
inout 	nreset;
