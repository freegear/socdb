# LIB_TARGET = lib.a defined int the top directory makefile
lib: $(LIB_TARGET)
$(LIB_TARGET): $(LIB_SOURCES:.c=.o)
	$(AR) $(ARFLAGS) $(LIB_TARGET) $(LIB_COMMON_OBJS) $(LIB_DRIVERS_OBJS) $(LIB_API_OBJS)
	mv $(LIB_TARGET) $(LIB_BASE_DIR)


