 4000 ROMSIZE
 00 0BF RAMRANGE

\  -----------------------------
0D0 EQUATE T0CNT     0D1 EQUATE T0DATA    0D2 EQUATE T0CON     0D3 EQUATE BTCON
0D4 EQUATE CLKCON    0D5 EQUATE FLAGS     0D6 EQUATE RP0       0D7 EQUATE RP1
0D8 EQUATE SPH       0D9 EQUATE SPL       0DA EQUATE IPH       0DB EQUATE IPL
0DC EQUATE IRQ       0DD EQUATE IMR       0DE EQUATE SYM       0DF EQUATE PP
0E0 EQUATE P0        0E1 EQUATE P1        0E2 EQUATE P2        0E3 EQUATE P3
0E4 EQUATE P4        0E5 EQUATE P0CON
0E6 EQUATE P1CONH    0E7 EQUATE P1CONL    0E8 EQUATE P2CONH    
0E9 EQUATE P2CONL    0EA EQUATE P3CONH    0EB EQUATE P3CONL    0EC EQUATE P4CON
0ED EQUATE P2PUR     0EE EQUATE UARTCON   0EF EQUATE UARTPND
0F0 EQUATE UDATA     0F1 EQUATE BRDATA    0F2 EQUATE T1DATAH   0F3 EQUATE T1DATAL
0F4 EQUATE T1CNTH    0F5 EQUATE T1CNTL    0F6 EQUATE T1CON     0F7 EQUATE ADCON
0F8 EQUATE ADDATAH   0F9 EQUATE ADDATAL   0FA EQUATE BUZPS     
0FC EQUATE FTEST     0FD EQUATE BTCNT     0FE EQUATE EMT       0FF EQUATE IPR  
END-EQUATES

