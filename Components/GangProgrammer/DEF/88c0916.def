\               REGISTER ADD (0FCH STOPCON "R/W")
\               ADDRESS CHANGE (P1CONL <-> P1CONH)


4000 ROMSIZE
00 0BF RAMRANGE

\  SET 1 REGISTERS
\  E4    IS NOT MAPPED
\  FB~FC IS NOT MAPPED

0D0 EQUATE T0CNT   0D1 EQUATE T0DATA  0D2 EQUATE T0CON   0D3 EQUATE BTCON
0D4 EQUATE CLKCON  0D5 EQUATE FLAGS   0D6 EQUATE RP0     0D7 EQUATE RP1
0D8 EQUATE SPH     0D9 EQUATE SPL     0DA EQUATE IPH     0DB EQUATE IPL
0DC EQUATE IRQ     0DD EQUATE IMR     0DE EQUATE SYM     0DF EQUATE PP
0E0 EQUATE P0      0E1 EQUATE P1      0E2 EQUATE P2      0E3 EQUATE P3
0E5 EQUATE P2INT   0E6 EQUATE P2PND   0E7 EQUATE P0PUR
0E8 EQUATE P0CONH  0E9 EQUATE P0CONL  0EA EQUATE P1CONL  0EB EQUATE P1CONH
0EC EQUATE P1PUR   0ED EQUATE P2PUR   0EE EQUATE P2CONH  0EF EQUATE P2CONL
0F0 EQUATE P3CON   0F1 EQUATE P0INT   0F2 EQUATE P0PND   0F3 EQUATE CACON
0F4 EQUATE CADATAH 0F5 EQUATE CADATAL 0F6 EQUATE T1CNTH  0F7 EQUATE T1CNTL
0F8 EQUATE T1DATAH 0F9 EQUATE T1DATAL 0FA EQUATE T1CON   0FC EQUATE STOPCON
0FD EQUATE BTCNT   0FE EQUATE EMT     0FF EQUATE IPR

END-EQUATES \ 46 EQUATES
\ READ ONLY     5
\ WRITE ONLY    0
\ READ/WRITE    41
\ UNKNOWN       0

