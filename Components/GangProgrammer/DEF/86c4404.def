1000 ROMSIZE
00 0BF RAMRANGE


0D0 EQUATE T0CNT   0D1 EQUATE T0DATA 0D2 EQUATE T0CON   
0D4 EQUATE CLKCON  0D5 EQUATE FLAGS  
0D9 EQUATE SP      0DB EQUATE MDSREG
0DC EQUATE BTCON   0DD EQUATE BTCNT  0DE EQUATE FTSTCON 0DF EQUATE SYM
0E0 EQUATE P0      0E1 EQUATE P1     0E2 EQUATE P2
0E6 EQUATE P0CONH  0E7 EQUATE P0CONL
0E8 EQUATE P0PND   0E9 EQUATE P1CON  0EA EQUATE P2CONH  0EB EQUATE P2CONL
0F2 EQUATE PWMDATA 0F3 EQUATE PWMCON   
0F4 EQUATE STOPCON 0F7 EQUATE ADCON
0F8 EQUATE ADDATAH 0F9 EQUATE ADDATAL 

END-EQUATES \ 31 EQUATES
\ READ ONLY     4
\ WRITE ONLY    1
\ READ/WRITE    21

WORD-LIST SYSREG_R

        T0CNT   W,  T0DATA  W,  T0CON   W, 
        CLKCON  W,  FLAGS   W,
        SP      W,  MDSREG  W,  BTCON   W,  BTCNT   W,  SYM     W,  
