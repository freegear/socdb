2000 ROMSIZE
40 0BF RAMRANGE

\  -----------------------------
\  page 0 registers
\  00~40h is not mapped
\  set1 bank0
\  E5h,F6~FCH is not mapped
\  set1 bank1
\  C0~DFH is not mapped
\  T1CNT(R/W)---->T1CNT(R)(12/28/96)
\  -----------------------------
0D0 EQUATE T0CNT     0D1 EQUATE T0DATA    0D2 EQUATE T0CON     0D3 EQUATE BTCON
0D4 EQUATE CLKCON    0D5 EQUATE FLAGS     0D6 EQUATE RP0       0D7 EQUATE RP1
0D8 EQUATE SPH       0D9 EQUATE SPL       0DA EQUATE IPH       0DB EQUATE IPL
0DC EQUATE IRQ       0DD EQUATE IMR       0DE EQUATE SYM       0DF EQUATE PP
0E0 EQUATE P0        0E1 EQUATE P1        0E2 EQUATE P2        0E3 EQUATE P3
0E4 EQUATE P4        0E6 EQUATE P0CONH    0E7 EQUATE P0CONL
0E8 EQUATE P1CONH    0E9 EQUATE P1CONL    0EA EQUATE P2CON     0EB EQUATE P3CONH    
0EC EQUATE P3CONL    0ED EQUATE P4CONH    0EE EQUATE P4CONL    0EF EQUATE P0INT
0F0 EQUATE DDCCON    0F1 EQUATE SYNCON0   0F2 EQUATE SYNCON1   0F3 EQUATE SYNCON2
0F4 EQUATE T1CON     0F5 EQUATE T1CNT     0FD EQUATE BTCNT     0FE EQUATE EMT       
0FF EQUATE IPR       0E0 EQUATE PWM0      0E1 EQUATE PWM1      0E2 EQUATE PWM2      
0E3 EQUATE PWM3      0E4 EQUATE PWM4      0E5 EQUATE PWM5      0E6 EQUATE PWM6      
0E7 EQUATE PWM7      0E8 EQUATE PWM8      0E9 EQUATE PWM9      0EA EQUATE PWM10     
0EB EQUATE PWM11     0EC EQUATE PWM11EX   0ED EQUATE PWMCH     0EE EQUATE PWMCL     
0EF EQUATE PWMCON    0F0 EQUATE ICCR      0F1 EQUATE ICSR      0F2 EQUATE IAR       
0F3 EQUATE IDSR 

    END-EQUATES \ 60 equates
\ Read  only   5
\ Write only   0
\ Read/Write  55
\ Unknown      0

