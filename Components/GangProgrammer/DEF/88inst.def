I: RR
  { *1 0 0BF ==}        [ 0E0 10 ][ @1 0 ]
  { *1 SYSREG_RW }      [ 0E0 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 0E0 10 ][ 0C0 @1 + 0 ]
