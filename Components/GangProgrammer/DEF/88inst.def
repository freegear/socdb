  { *1 SYSREG_RW } , " #" { *2 0 0FF ==} [ 56 10 ][ @1 0 ][ @2 0 ]
3 I;

\ bit inst.s
I: BAND
  " R" { *1 0 0F ==} ,
  IF      -1 { *2 0 0BF ==} ., { *3 0 7 ==}
        [ 67 10 ][ @1 4 << @3 1 << + 0 ][ @2 0 ]
    " R" { *1 0 0F ==} , { *2 BIT_R } ., { *3 0 7 ==}
        [ 67 10 ][ @1 4 << @3 1 << + 0 ][ @2 0 ]
    " R" { *1 0 0F ==} ., { *2 0 7 ==} , " R" { *3 0 0F ==}
        [ 67 10 ][ @3 4 << @2 1 << + 1 + 0 ][ 0C0 @1 + 0 ]
    " R" { *1 0 0F ==} , " R" { *2 0 0F ==} ., { *3 0 7 ==}
        [ 67 10 ][ @1 4 << @3 1 << + 0 ][ 0C0 @2 + 0 ]
  ELSE 0 [ ] THEN
  { *1 0 0BF ==} ., { *2 0 7 ==} , " R" { *3 0 0F ==}
        [ 67 10 ][ @3 4 << @2 1 << + 1 + 0 ][ @1 0 ]
  { *1 BIT_RW } ., { *2 0 7 ==} , " R" { *3 0 0F ==}
        [ 67 10 ][ @3 4 << @2 1 << + 1 + 0 ][ @1 0 ]
3 I;

I: BCP
  " R" { *1 0 0F ==} , { *2 0 0BF ==} ., { *3 0 7 ==}
        [ 17 10 ][ @1 4 << @3 1 << + 0 ][ @2 0 ]
  " R" { *1 0 0F ==} , { *2 BIT_R } ., { *3 0 7 ==}
