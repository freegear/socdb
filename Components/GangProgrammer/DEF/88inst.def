  { *1  SYSREG_RW }     [ 0D0 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 0D0 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 0D1 10 ][ @1 0 ]
