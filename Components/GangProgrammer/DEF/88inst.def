I: SWAP
  { *1 0 0BF ==}        [ 0F0 10 ][ @1 0 ]
  { *1 SYSREG_RW }      [ 0F0 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 0F0 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 0F1 10 ][ @1 0 ]
  " @" { *1 SYSREG_R }  [ 0F1 10 ][ @1 0 ]
  " @R" { *1 0 0F ==}   [ 0F1 10 ][ 0C0 @1 + 0 ]
  2 I;
\
I: RDR
  { *1 0 0FF ==}      [ 0D5 10 ][ @1 0 ]
  " R" { *1 0 0F ==}  [ 0D5 10 ][ 0C0 @1 + 0 ]
2 I;
\ Two operands inst.s
\ 1. add type inst.s
\ adc add sub sbc or and tcm tm
\
I: ADC
  " R" { *1 0 0F ==} ,
  IF      -1      " R" { *2 0 0F ==} [ 12 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , " @R" { *2 0 0F ==}  [ 13 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , { *2 0 0BF ==}       [ 14 10 ][ @2 0 ][ 0C0 @1 + 0 ]
    " R" { *1 0 0F ==} , { *2 SYSREG_R }      [ 14 10 ][ @2 0 ][ 0C0 @1 + 0 ]
    " R" { *1 0 0F ==} , " @" { *2 0 0BF ==}  [ 15 10 ][ @2 0 ][ 0C0 @1 + 0 ]
    " R" { *1 0 0F ==} , " @" { *2 SYSREG_R } [ 15 10 ][ @2 0 ][ 0C0 @1 + 0 ]
    " R" { *1 0 0F ==} , " #" { *2 0 0FF ==}  [ 16 10 ][ 0C0 @1 + 0 ][ @2 0 ]
  ELSE 0 [ ] THEN
    { *1 0 0BF ==} ,
  IF   -1            { *2 0 0BF ==}      [ 14 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , { *2 SYSREG_R }     [ 14 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , " R" { *2 0 0F ==}  [ 14 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 0 0BF ==} , " @" { *2 0 0BF ==} [ 15 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , " @R" { *2 0 0F ==} [ 15 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 0 0BF ==} , " #" { *2 0 0FF ==} [ 16 10 ][ @1 0 ][ @2 0 ]
  ELSE 0 [ ] THEN
    { *1 SYSREG_RW } , { *2 0 0BF ==}       [ 14 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , { *2 SYSREG_R }      [ 14 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " R" { *2 0 0F ==}   [ 14 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " @" { *2 0 0BF ==}  [ 15 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " @" { *2 SYSREG_R } [ 15 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " @R" { *2 0 0F ==}  [ 15 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " #" { *2 0 0FF ==}  [ 16 10 ][ @1 0 ][ @2 0 ]
  3 I;
I: ADD
  " R" { *1 0 0F ==} ,
  IF      -1      " R" { *2 0 0F ==} [ 2 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , " @R" { *2 0 0F ==} [ 3 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , { *2 0 0BF ==} [ 4 10 ][ @2 0 ][ 0C0 @1 + 0 ]
