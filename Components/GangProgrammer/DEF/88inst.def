    { *1 0 0BF ==} , { *2 SYSREG_R } [ 4 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , " R" { *2 0 0F ==} [ 4 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 0 0BF ==} , " @" { *2 0 0BF ==} [ 5 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , " @" { *2 SYSREG_R } [ 5 10 ][ @2 0 ][ @1 0 ]
    { *1 0 0BF ==} , " @R" { *2 0 0F ==} [ 5 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 0 0BF ==} , " #" { *2 0 0FF ==} [ 6 10 ][ @1 0 ][ @2 0 ]
  ELSE 0 [ ] THEN
    { *1 SYSREG_RW } , { *2 0 0BF ==} [ 4 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , { *2 SYSREG_R } [ 4 10 ][ @2 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " R" { *2 0 0F ==} [ 4 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " @" { *2 0 0BF ==} [ 5 10 ][ @2 0 ][ @1 0 ]
