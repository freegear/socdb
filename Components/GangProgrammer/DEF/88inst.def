\ x88inst.def :
\ Common instruction definition file for 88Cxxxx
\ 
\ 03/03/1994 1st Revised : sjlee
\     add DL and DH
\ 04/15/1994 2st Revised : sjlee
\     Find a bug in SRP, SRP0 and SRP1 instructions. And fix it.
\
$ARRAY brcond
  00 ,$ F   01 ,$ LT  02 ,$ LE  03 ,$ ULE 04 ,$ OV  05 ,$ MI  06 ,$ EQ
  06 ,$ Z   07 ,$ C   07 ,$ ULT 08 ,$ T   09 ,$ GE  0A ,$ GT  0B ,$ UGT
  0C ,$ NOV 0D ,$ PL  0E ,$ NE  0E ,$ NZ  0F ,$ NC  0F ,$ UGE $;

TABLE EV  0 0 ,, 2 2 ,, 4 4 ,, 6 6 ,, 8 8 ,, 0A 0A ,, 0C 0C ,, 0E 0E ,, T;
TABLE EV2 2 2 ,, 4 4 ,, 6 6 ,, 8 8 ,, 0A 0A ,, 0C 0C ,, 0E 0E ,, T;

\ No operand inst.s
I: NEXT    [  0F 30 ] 1 I;
I: ENTER   [  1F 30 ] 1 I;
I: EXIT    [  2F 30 ] 1 I;
I: WFI     [  3F 30 ] 1 I;
I: SB0     [  4F 30 ] 1 I;
I: SB1     [  5F 30 ] 1 I;
I: IDLE    [  6F 30 ] 1 I;
I: STOP    [  7F 30 ] 1 I;
I: DI      [  8F 30 ] 1 I;
I: EI      [  9F 30 ] 1 I;
I: RET     [ 0AF 30 ] 1 I;
I: IRET    [ 0BF 30 ] 1 I;
I: RCF     [ 0CF 30 ] 1 I;
I: SCF     [ 0DF 30 ] 1 I;
I: CCF     [ 0EF 30 ] 1 I;
I: NOP     [ 0FF 30 ] 1 I;
\
\ one operand insts.s
\ 1. dec type insts.
\ dec rlc inc da pop com push decw rl incw clr rrc sra rr swap
I: DEC
  { *1 0 0BF ==}        [ 00 10 ][ @1 0 ]
  { *1 SYSREG_RW }      [ 00 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 00 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 01 10 ][ @1 0 ]
  " @" { *1 SYSREG_R }  [ 01 10 ][ @1 0 ]
  " @R" { *1 0 0F ==}   [ 01 10 ][ 0C0 @1 + 0 ]
  2 I;
I: RLC
  { *1 0 0BF ==}        [ 10 10 ][ @1 0 ]
