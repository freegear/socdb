      [ 7 10 ][ @3 4 << @2 1 << + 1 + 0 ][ @1 0 ]
  { *1 BIT_RW } ., { *2 0 7 ==} , " R" { *3 0 0F ==}
      [ 7 10 ][ @3 4 << @2 1 << + 1 + 0 ][ @1 0 ]
  3 I;

I: BTJRF
  { *1 *6 3 + - 80 + 0 FF ==|} , " R" { *2 0 0F ==|} ., { *3 0 7 ==|}
        [ 37 10 ][ @2 4 << @3 1 << + 0 ][ @1 @6 3 + - 0FF & 20 ]
  3 I;

I: BTJRT
  { *1 *6 3 + - 80 + 0 FF ==|} , " R" { *2 0 0F ==|} ., { *3 0 7 ==|}
        [ 37 10 ][ @2 4 << @3 1 << + 1 + 0 ][ @1 @6 3 + - 0FF & 20 ]
  3 I;

I: BXOR
