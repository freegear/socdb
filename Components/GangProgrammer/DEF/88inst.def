    { *1 SYSREG_RW } , " @R" { *2 0 0F ==} [ 5 10 ][ 0C0 @2 + 0 ][ @1 0 ]
    { *1 SYSREG_RW } , " #" { *2 0 0FF ==} [ 6 10 ][ @1 0 ][ @2 0 ]
3 I;
I: AND
  " R" { *1 0 0F ==} ,
  IF      -1      " R" { *2 0 0F ==} [ 52 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , " @R" { *2 0 0F ==} [ 53 10 ][ @1 4 << @2 + 0 ]
    " R" { *1 0 0F ==} , { *2 0 0BF ==} [ 54 10 ][ @2 0 ][ 0C0 @1 + 0 ]
