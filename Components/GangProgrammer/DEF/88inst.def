I: SRP   " #" { *1 0 0FF ==} [ 31 10 ][ @1 0F8 & 0 ] 2 I;
I: SRP0  " #" { *1 0 0FF ==} [ 31 10 ][ @1 0F8 & 2 + 0 ] 2 I;
I: SRP1  " #" { *1 0 0FF ==} [ 31 10 ][ @1 0F8 & 1 + 0 ] 2 I;
I: DA
  { *1 0 0BF ==}        [ 40 10 ][ @1 0 ]
  { *1 SYSREG_RW }      [ 40 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 40 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 41 10 ][ @1 0 ]
  " @" { *1 SYSREG_R }  [ 41 10 ][ @1 0 ]
