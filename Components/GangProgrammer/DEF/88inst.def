  { *1 SYSREG_W }       [ 0B0 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 0B0 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 0B1 10 ][ @1 0 ]
