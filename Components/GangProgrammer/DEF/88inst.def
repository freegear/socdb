  { *1 SYSREG_RW }      [ 90 10 ][ @1 0 ]
  " R" { *1 0 0F ==}    [ 90 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0BF ==}   [ 91 10 ][ @1 0 ]
