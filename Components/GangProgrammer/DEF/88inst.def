  IF      -1 { *2 0 0BF ==} ., { *3 0 7 ==}
      [ 27 10 ][ @1 4 << @3 1 << + 0 ][ @2 0 ]
      " R" { *1 0 0F ==} , { *2 BIT_R } ., { *3 0 7 ==}
