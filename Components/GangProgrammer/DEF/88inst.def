  { *1 BIT_RW } ., { *2 0 7 ==} , " R" { *3 0 0F ==}
      [ 27 10 ][ @3 4 << @2 1 << + 1 + 0 ][ @1 0 ]
  3 I;

I: CALL
  " #" { *1 0 0FF ==|}    [ 0D4 10 ][ @1 0 ]
  " @RR" { *1 EV ^ |}  [ 0F4 10 ][ 0C0 @1 + 0 ]
  " @" { *1 0 0FE ==|}   [ 0F4 10 ][ @1 0 ]
  { *1 0 @RS ==|}    [ 0F6 10 ][ @1 FF00 & 8 >> 0 ][ @1 0FF & 0 ]
  3 I;


I: CP
  " R" { *1 0 0F ==} ,
  IF      -1 " R" { *2 0 0F ==} [ 0A2 10 ][ @1 4 << @2 + 0 ]
      " R" { *1 0 0F ==} , " @R" { *2 0 0F ==} [ 0A3 10 ][ @1 4 << @2 + 0 ]
