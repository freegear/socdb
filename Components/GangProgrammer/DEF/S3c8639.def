0F4 EQUATE TM1DATAL  0F5 EQUATE TM1CON    0F6 EQUATE TM2CON    0F7 EQUATE ADCON
0F8 EQUATE ADDATA    0F9 EQUATE PHGEN     0FA EQUATE PVGEN     0FB EQUATE STOPCON 
0FD EQUATE BTCNT     0FE EQUATE EMT       
0FF EQUATE IPR       0E0 EQUATE PWM0      0E1 EQUATE PWM1      0E2 EQUATE PWM2      
0E3 EQUATE PWM3      0E4 EQUATE PWM4      0E5 EQUATE PWM5      0E6 EQUATE PWM6      
0E7 EQUATE PWMCON    0E8 EQUATE PWMCNT    0E9 EQUATE DCON      0EA EQUATE DAR0  
0EB EQUATE DCCR      0EC EQUATE DCSR0
0ED EQUATE DCSR1     0EE EQUATE DAR1      0EF EQUATE TBDR
0F0 EQUATE RBDR      0F1 EQUATE DDSR
0F2 EQUATE SICSR     0F3 EQUATE SIAR     
0F4 EQUATE SIDSR 

    END-EQUATES \ 68 equates

