0100H ROMSIZE
00 0BF RAMRANGE

\ SET1, BANK0
0D0 EQUATE T0CNT    
0D1 EQUATE T0DATA
0D2 EQUATE T0CON
0D3 EQUATE USXCON
0D4 EQUATE CLKCON
0D5 EQUATE FLAGS 
0D6 EQUATE SPICON
0D7 EQUATE SPIDATA
0D8 EQUATE SPISTA
0D9 EQUATE SP 

0DC EQUATE BTCON
0DD EQUATE BTCNT
0DF EQUATE SYM

0E0 EQUATE P0
0E1 EQUATE P1
0E2 EQUATE P2
0E3 EQUATE PDCON
0E4 EQUATE CCON
0E5 EQUATE CDATA
0E6 EQUATE P0CONL  
0E7 EQUATE P0CONH
0E8 EQUATE P1CONH
0E9 EQUATE P1CONL
0EA EQUATE P0INT
0EB EQUATE P0PND
0EC EQUATE P1INT
0ED EQUATE P1PND
0EE EQUATE P2CONINT
0EF EQUATE SUBCON
0F0 EQUATE FADDR
0F1 EQUATE EP0CSR   
0F2 EQUATE EP1CSR
0F3 EQUATE EP0BCNT
0F4 EQUATE EP0FIFO
0F5 EQUATE EP1FIFO
0F6 EQUATE USBPND
0F7 EQUATE USBINT
0F8 EQUATE PWRMGR
0F9 EQUATE EP2CSR
0FA EQUATE EP2FIFO
0FB EQUATE EPMODE
0FC EQUATE EP1BCNT
0FD EQUATE EP2BCNT   
0FE EQUATE USBCON
0FF EQUATE SNKCON  

END-EQUATES \ 45 EQUATES
\ READ ONLY    3
\ WRITE ONLY   3
\ READ/WRITE  39
\ UNKNOWN      0

