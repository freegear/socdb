4000 ROMSIZE

\ Various port addresses

0F80 EQUATE  SP                 0F85 EQUATE  BMOD
0F86 EQUATE  BCNT               0F88 EQUATE  WMOD
0F8C EQUATE  LMOD               0F8e EQUATE  LCON
0F90 EQUATE  TMOD0              0F92 EQUATE  XF92
0F94 EQUATE  TCNT0              0F96 EQUATE  TREF0
0F98 EQUATE  WDMOD              0F9A EQUATE  WDFLAG
0FFF EQUATE  @L

\ Mema ports:

0FB0 EQUATE  PSW                0FB2 EQUATE  IPR
0FB3 EQUATE  PCON               0FB4 EQUATE  IMOD0
0FB5 EQUATE  IMOD1              0FB7 EQUATE  SCMOD
0FB8 EQUATE  XFB8               0FBA EQUATE  XFBA
0FBB EQUATE  XFBB               0FBC EQUATE  XFBC
0FBE EQUATE  XFBE               0FBF EQUATE  XFBF

\ Memb ports:

0FCC EQUATE  IMODK              0FCF EQUATE  IMOD2
0FD0 EQUATE  CLMOD              0FDA EQUATE  PNE1
0FDC EQUATE  PUMOD0             0FE8 EQUATE  PMG1

\ mema or memb ports:

0FF0 EQUATE  P0                 0FF1 EQUATE  P1

\ BIT operands:

0F92 0 BIT-EQUATE  BUZB         0F92 2 BIT-EQUATE  TOE
0F92 3 BIT-EQUATE  TOEB         0F9A 3 BIT-EQUATE  WDTCF

\ Mema bit operands:

0FB0 0 BIT-EQUATE  ERB          0FB0 1 BIT-EQUATE  EMB
0FB0 2 BIT-EQUATE  IS0          0FB0 3 BIT-EQUATE  IS1
0FB2 3 BIT-EQUATE  IME          0FB8 0 BIT-EQUATE  IRQB
0FB8 1 BIT-EQUATE  IEB          0FB8 2 BIT-EQUATE  IRQ4
0FB8 3 BIT-EQUATE  IE4          0FBA 0 BIT-EQUATE  IRQW
0FBA 1 BIT-EQUATE  IEW          0FBB 2 BIT-EQUATE  IRQK
0FBB 3 BIT-EQUATE  IEK          0FBC 0 BIT-EQUATE  IRQT0
0FBC 1 BIT-EQUATE  IET0         0FBE 0 BIT-EQUATE  IRQ0
0FBE 1 BIT-EQUATE  IE0          0FBE 2 BIT-EQUATE  IRQ1
0FBE 3 BIT-EQUATE  IE1          0FBF 0 BIT-EQUATE  IRQ2
0FBF 1 BIT-EQUATE  IE2

END-EQUATES

$ARRAY R     0 ,$ A       1 ,$ E      2 ,$ L      3 ,$ H
             4 ,$ X       5 ,$ W      6 ,$ Z      7 ,$ Y   $;

$ARRAY RA    1 ,$ E       2 ,$ L      3 ,$ H      4 ,$ X
             5 ,$ W       6 ,$ Z      7 ,$ Y               $;

$ARRAY RR    0 ,$ EA      2 ,$ HL     4 ,$ WX     6 ,$ YZ  $;

$ARRAY RRA   5 ,$ HL      6 ,$ WX     7 ,$ WL     $;

$ARRAY RRB   2 ,$ HL      4 ,$ WX     6 ,$ YZ     $;

BIT-LIST IEX
            IEB   ,,  IE4  ,,  IEW ,,  IEK  ,,  IET0  ,,
            IE0   ,,  IE1  ,,  IE2 ,,  $;

WORD-LIST IO-8R
        BCNT   W,  PSW    W,  SP     W,  TCNT0   W,  $;

WORD-LIST IO-8W
        SP     W,  WMOD   W,  LMOD   W,  TMOD0  W,  TREF0  W,  WDMOD W,
        IMODK  W,  PNE1   W,  PUMOD0 W,  PMG1   W,  $;

WORD-LIST IO-8RW
        SP     W,  $;

WORD-LIST IO-4R
        XF92   W,  PSW    W,  XFB8   W,  XFBA   W,  XFBB   W,  XFBC   W,
        XFBE   W,  XFBF   W,  IMOD2  W,  CLMOD  W,  P0     W,  P1     W,
        $;

WORD-LIST IO-4W
        BMOD   W,  LCON   W,  XF92   W,  WDFLAG W,  PSW    W,  IPR    W,
        PCON   W,  IMOD0  W,  IMOD1  W,  XFB8   W,  XFBA   W,  XFBB   W,
        XFBC   W,  XFBE   W,  XFBF   W,  IMOD2  W,  CLMOD  W,  P0     W,
        P1     W,  $;

WORD-LIST IO-4RW
        XF92   W,  PSW    W,  XFB8   W,  XFBA   W,  XFBB   W,  XFBC   W,
        XFBE   W,  XFBF   W,  P0     W,  P1     W,  $;

WORD-LIST IO1R3
\ DA.b
        WMOD   W,  $;

WORD-LIST IO1W3
\ DA.b
        BMOD   W,  TMOD0  W,  WDFLAG W, IPR    W,  $;

WORD-LIST IO1W
\ DA.b
        XF92   W,  PSW    W,  SCMOD  W, XFB8   W,  XFBA    W,  XFBB   W,
        XFBC   W,  XFBE   W,  XFBF   W, P0     W,  P1      W,  $;

WORD-LIST IO1R
\ DA.b
        XF92   W,  PSW    W,  XFB8   W,  XFBA   W,  XFBB   W,  XFBC   W,
        XFBE   W,  XFBF   W,  P0     W,  P1     W,  $;

WORD-LIST IO1RW
\ DA.b
        XF92   W,  XFB8   W,  XFBA   W,  XFBB   W,  XFBC   W,
        XFBE   W,  XFBF   W,  P0     W,  P1     W,  $;

WORD-LIST IOX
        @L     W,  $;

WORD-LIST IO2W3
\ mema.b(0FB0 ~ 0FBF)
        IPR    W,  $;

WORD-LIST IO2W
\ mema.b(0FB0 ~ 0FBF)
        PSW    W,  IPR    W,  SCMOD  W,  XFB8   W,  XFBA   W,  XFBB   W,
        XFBC   W,  XFBE   W,  XFBF   W,  $;

WORD-LIST IO2RW
\ mema.b(0FB0 ~ 0FBF)
        PSW    W,  XFB8   W,  XFBA   W,  XFBB   W,  XFBC   W,  XFBE   W,
        XFBF   W,  $;

WORD-LIST IO3R
\ mema.b(0FF0 ~ 0FFF)
        P0     W,  P1     W,  $;

WORD-LIST IO3RW
\ mema.b(0FF0 ~ 0FFF)
        P0     W,  P1     W,  $;

WORD-LIST IO4R
\ memb.@L(0FC0 ~ 0FFF)
        P0     W,  P1     W,  $;

WORD-LIST IO4W
\ memb.@l(0FC0 ~ 0FFF)
        P0     W,  P1     W,  $;

WORD-LIST IO4RW
\ memb.@L(0FC0 ~ 0FFF)
        P0     W,  P1     W,  $;

BIT-LIST MEMA,B
        ERB    ,,   EMB    ,,   IS0    ,,   IS1   ,,
                                            IME   ,,
        IRQB   ,,   IEB    ,,   IRQ4   ,,   IE4   ,,
        IRQW   ,,   IEW    ,,
                                IRQK   ,,   IEK   ,,
        IRQT0  ,,   IET0   ,,
        IRQ0   ,,   IE0    ,,   IRQ1   ,,   IE1   ,,
        IRQ2   ,,   IE2    ,,   $;

\  DATA TRANSFER
I: LD
      " EA" , " @HL"                      [ 0DC 10 ][ 08 0 ]
      " @HL" , " A"                       [ 0C4 10 ]
      " @HL" , " EA"                      [ 0DC 10 ][ 00 0 ]
      " A" , " @" { RRA ^*1 }             [ 88 @1 + 10 ]
      " A" , { RA ^*1 }                   [ 0DD 10 ][ 08 @1 + 0 ]
      " A" , { *1 IO-4R }                 [ 8C 10 ][ @1 0 ]
      " A" , " #" 1 # { *1 0 0F ==}       [ 0B0 @1 + 10 ]
      " A" , { *1 0 0FF ==}               [ 8C 10 ][ @1 0 ]
\      " A" , { *1 0F80 0FFF ==}           [ 8C 10 ][ @1 0FF & 0 ]
      " EA" , { RRB ^*1 }                 [ 0DC 10 ][ 0F8 @1 + 0 ]
      " EA" , { *1 IO-8R }                [ 0CE 10 ][ @1 0 ]
      " EA" , { *1 0 0FF ==}              [ 0CE 10 ][ @1 0 ]
\      " EA" , { *1 0F80 0FFF ==}          [ 0CE 10 ][ @1 0FF & 0 ]
\      " EA" , " #" { *1 0 0FF ==}         [ 81 10 ][ @1 0FF & 0 ]
      " EA" , " #" { *1 0 3FFF ==}        [ 81 10 ][ @1 0FF & 0 ]
      { *1 IO-4W } , " A"                 [ 89 10 ][ @1 0 ]
      { *1 0 0FF ==} , " A"               [ 89 10 ][ @1 0 ]
\      { *1 0F80 0FFF ==} , " A"           [ 89 10 ][ @1 0FF & 0 ]
      { RRB ^*1 } , " EA"                 [ 0DC 10 ][ 0F0 @1 + 0 ]
      { *1 IO-8W } , " EA"                [ 0CD 10 ][ @1 0 ]
      { *1 0 0FF ==} , " EA"              [ 0CD 10 ][ @1 0 ]
\      { *1 0F80 0FFF ==} , " EA"         [ 0CD 10 ][ @1 0FF & 0 ]
\      { RR ^*1 } , " #" { *2 0 0FF ==}    [ @1 6 & 81 + 10 ][ @2 0FF & 0 ]
      { RR ^*1 } , " #" { *2 0 3FFF ==}   [ @1 6 & 81 + 10 ][ @2 0FF & 0 ]
      { RA ^*1 } , " A"                   [ 0DD 10 ][ 0 @1 + 0 ]
      { RA ^*1 } , " #" { *2 0 0F ==}     [ 0D9 10 ][ @2 4 << 8 + @1 + 0 ]
      2 I;

I: LDI
      " A" , " @HL"                       [ 8A 90 ]  1 I;

I: LDD
      " A" , " @HL"                       [ 8B 90 ]  1 I;

I: LDC
      " EA" , " @WX"                      [ 0CC 30 ]
      " EA" , " @EA"                      [ 0C8 30 ]  1 I;

I: JR
     " @EA"                               [ 0DD 10 ][ 60 80 ]
     " @WX"                               [ 0DD 10 ][ 64 80 ]
     " +" { *1 2 10 ==|}                  [ @1 1 - 10 + 90 ]
     " -" { *1 0 0F ==|}                  [ 0F @1 - 90 ]
     { *1 *6 - 1 10 ==|}                  [ @1 *6 - 1 - 10 + 90 ]
     { *6 *1 - 0 0F ==|}                  [ 0F *6 @1 - - 90 ]  1 I;

I: JP
     { *1 0 3FFF ==|}  [ 0DB 10 ][ @1 3F00 & 8 >> 0 ][ @1 00FF & 0 ]  3 I;

I: JPS
     { *1 0F000 & *6 2 + 0F000 & - 0 0 ==}
                          [ @1 0F00 & 8 >> 90 + 10 ][ @1 00FF & 0 ]  2 I;

\     SUBROUTINE HANDLING

I: CALLS
     { *1 0 07FF ==|}     [ @1 700 & 8 >> 0E8 + 30 ][ @1 0FF & 0 ]  2 I;

I: CALL
     { *1 0 3FFF ==|} [ 0DB 10 ][ @1 3F00 & 8 >> 40 + 0 ][ @1 00FF & 0 ]
     3 I;

I: RET                          [ 0C5 30 ] 1 I;

