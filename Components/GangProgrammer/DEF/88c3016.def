        IPH     W,  IPL     W,  IMR     W,  PP      W,  SYM     W,
        EMT     W,  IPR     W,  P0CON   W,  P3CON   W,  P1CON   W,
        P2CONH  W,  P2CONL  W,  P2INT   W,  BTCON   W,  P0      W,
        P1      W,  P2      W,  P3      W,  SIO     W,  T0CON   W,
        P2PND   W,  $;

WORD-LIST BIT_RW
        EMT     W,  FLAGS   W,  IMR     W,  IPL     W,
        IPH     W,  IPR     W,  P0CON   W,  P1CON   W,  P2CONH  W,
        P2CONL  W,  P2INT   W,  P3CON   W,  PP      W,  RP0     W,
        SPH     W,  SPL     W,  SYM     W,
        P0      W,  P1      W,  P2      W,  P3      W,  $;

WORD-LIST XBIT_RW
        BTCON   W,  EMT     W,  FLAGS   W,  IMR     W,  IPL     W,
        IPH     W,  IPR     W,  P0CON   W,  P1CON   W,  P2CONH  W,
        P2CONL  W,  P2INT   W,  P3CON   W,  PP      W,  RP0     W,
        SPH     W,  SPL     W,  SYM     W,  T0CON   W,  P2PND   W,
        P0      W,  P1      W,  P2      W,  P3      W,  $;

WORD-LIST BIT_R
        BTCON   W,  EMT     W,  FLAGS   W,  IMR     W,  IPL     W,
        IPH     W,  IPR     W,  P0CON   W,  P1CON   W,  P2CONH  W,
        P2CONL  W,  P2INT   W,  P3CON   W,  PP      W,  RP0     W,
        SPH     W,  SPL     W,  SYM     W,  IRQ     W,  P2PND   W,
        T0CON   W,  P0      W,  P1      W,  P2      W,  P3      W,  $;

WORD-LIST BIT_W
        BTCON   W,  EMT     W,  FLAGS   W,  IMR     W,  IPL     W,
        IPH     W,  IPR     W,  P0CON   W,  P1CON   W,  P2CONH  W,
        P2CONL  W,  P2INT   W,  P3CON   W,  PP      W,  RP0     W,
        SPH     W,  SPL     W,  SYM     W,  SIOCON  W,  SIOPS   W,
        TBINT   W,  T0CON   W,  P2PND   W,
        P0      W,  P1      W,  P2      W,  P3      W,  $;

INCLUDE 88INST.DEF
