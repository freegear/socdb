0F1 EQUATE P0CONH    0F2 EQUATE P1CONL    0F3 EQUATE P1CONH    0F4 EQUATE P2CONL
0F5 EQUATE P2CONH    0F6 EQUATE P4CONL    0F7 EQUATE P4CONH    0F8 EQUATE P5CON
0F9 EQUATE P1PND     0FA EQUATE P6CONL    0FB EQUATE P6CONH    0FC EQUATE P1PUR
0FD EQUATE P1INT     0FE EQUATE P8CON     0FF EQUATE P65CON    083 EQUATE MFPDATA
087 EQUATE VFDCON    08B EQUATE MFPCON    08F EQUATE CLKCON    093 EQUATE KEYSL
097 EQUATE KEYSH
