        T0DATA  W,  T0CON   W,  CLKCON  W,  FLAGS   W,  SP      W,
        BTCON   W,  SYM     W,  P0      W,  P1      W,  P2      W,
        P3      W,  P4      W,  P3CON   W,  P0CONH  W,  P0CONL  W,
        P1CONH  W,  P1CONL  W,  P2CONH  W,  P2CONL  W,  P2INT   W,
        P2PND   W,  P4CON   W,  P4INTPND W, $; \ 23 REGISTERS

WORD-LIST BIT_R

        T0CNT   W,  T0DATA  W,  T0CON   W,  CLKCON  W,  FLAGS   W,
        SP      W,  BTCON   W,  BTCNT   W,  SYM     W,  P0      W,
        P1      W,  P2      W,  P3      W,  P4      W,  P3CON   W,
        P0CONH  W,  P0CONL  W,  P1CONH  W,  P1CONL  W,  P2CONH  W,
        P2CONL  W,  P2INT   W,  P2PND   W,  P4CON   W,  P4INTPND W,
        $; \ 25 REGISTERS


WORD-LIST BIT_W

        T0DATA  W,  T0CON   W,  CLKCON  W,  FLAGS   W,  SP      W,
        BTCON   W,  SYM     W,  P0      W,  P1      W,  P2      W,
        P3      W,  P4      W,  P3CON   W,  P0CONH  W,  P0CONL  W,
        P1CONH  W,  P1CONL  W,  P2CONH  W,  P2CONL  W,  P2INT   W,
        P2PND   W,  P4CON   W,  P4INTPND W, $; \ 23 REGISTERS

