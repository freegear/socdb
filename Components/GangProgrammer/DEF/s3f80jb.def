10000 ROMSIZE
00 0BF RAMRANGE

\  SET 1 REGISTERS

0D0 EQUATE T0CNT   0D1 EQUATE T0DATA  0D2 EQUATE T0CON   0D3 EQUATE BTCON
0D4 EQUATE CLKCON  0D5 EQUATE FLAGS   0D6 EQUATE RP0     0D7 EQUATE RP1
0D9 EQUATE SPL     0DA EQUATE IPH     0DB EQUATE IPL
0DC EQUATE IRQ     0DD EQUATE IMR     0DE EQUATE SYM     0DF EQUATE PP
0E0 EQUATE P0      0E1 EQUATE P1      0E2 EQUATE P2      0E3 EQUATE P3 
0E4 EQUATE P4      0E5 EQUATE P2INT   0E6 EQUATE P2PND   0E7 EQUATE P0PUR
0E8 EQUATE P0CONH  0E9 EQUATE P0CONL  0EA EQUATE P1CONH  0EB EQUATE P1CONL
0EC EQUATE P2CONH  0ED EQUATE P2CONL  0EE EQUATE P2PUR   0EF EQUATE P3CON
0F0 EQUATE P4CON   0F1 EQUATE P0INT   0F2 EQUATE P0PND   0F3 EQUATE CACON
0F4 EQUATE CADATAH 0F5 EQUATE CADATAL 0F6 EQUATE T1CNTH  0F7 EQUATE T1CNTL
0F8 EQUATE T1DATAH 0F9 EQUATE T1DATAL 0FA EQUATE T1CON   0FB EQUATE STOPCON
0FD EQUATE BTCNT   0FE EQUATE EMT     0FF EQUATE IPR

\  SET 1 REGISTERS
0E0 EQUATE LVDCON  0E1 EQUATE P345CON 0E2 EQUATE P4CONH  0E3 EQUATE P4CONL
0E4 EQUATE T2CNTH  0E5 EQUATE T2CNTL  0E6 EQUATE T2DATAH 0E7 EQUATE T2DATAL
0E8 EQUATE T2CON   0E9 EQUATE CMOD    0EA EQUATE CMPREG  0EB EQUATE CMPSEL     
0EC EQUATE FMSECH  0ED EQUATE FMSECL  0EE EQUATE FMUSR   0EF EQUATE FMCON      


END-EQUATES \ 62 EQUATES
\ READ ONLY     8
\ WRITE ONLY    1
\ READ/WRITE    53

