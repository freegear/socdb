   " @H+" { *1 0 0FF ==} ., { *2 0 3 ==}  [ 0F8 10 ][ @2 4 << @1 0F & + 0 ]
   " @H+" { *1 IO1RW } ., { *2 0 3 ==}    [ 0F8 10 ][ @2 4 << @1 0F & + 0 ]
