   { *1 IO1W3 } ., { *2 3 3 ==}        [ @2 4 << 0C2 + 10 ][ @1 0FF & 0 ]
   { *1 0 0FF ==} ., { *2 0 3 ==}      [ @2 4 << 0C2 + 10 ][ @1 0FF & 0 ]
   2 I;

I: BTSTZ
\ @H+DA b
   " @H+" { *1 0 0FF ==} ., { *2 0 3 ==}  [ 0FD 10 ][ @2 4 << @1 0F & + 0 ]
   " @H+" { *1 IO1RW } ., { *2 0 3 ==}    [ 0FD 10 ][ @2 4 << @1 0F & + 0 ]
   " @H+" { *1 IO1W } ., { *2 0 3 ==}     [ 0FD 10 ][ @2 4 << @1 0F & + 0 ]
   " @H+" { *1 IO1W3 } ., { *2 3 3 ==}    [ 0FD 10 ][ @2 4 << @1 0F & + 0 ]
   " @H+" { *1 IO1R3 } ., { *2 3 3 ==}    [ 0FD 10 ][ @2 4 << @1 0F & + 0 ]

\ memb @L
   { *1 IO4RW } ., { *2 IOX }          [ 0FD 10 ][ @1 3C & 2 >> 40 + 0 ]

\ mema b
   { *1 IO2RW } ., { *2 0 3 ==}    [ 0FD 10 ][ @2 08 + 4 << @1 0F & + 0 ]
   { *1 IO2W3 } ., { *2 3 3 ==}    [ 0FD 10 ][ @2 08 + 4 << @1 0F & + 0 ]
   { *1 IO3RW } ., { *2 0 3 ==}    [ 0FD 10 ][ 0C @2 + 4 << @1 0F & + 0 ]
   { *1 } ., { @1 *2 MEMA,B |}    [ 0FD 10 ][ 08 @2 + 4 << @1 4F & + 0 ]
   2 I;

I: LDB
\ C @H+DA b
   " C" , " @H+" { *1 0 0FF ==} ., { *2 0 3 ==}
                                        [ 0F4 10 ][ @2 4 << @1 0F & + 0 ]
