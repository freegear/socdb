1000 ROMSIZE
00 0BF RAMRANGE

0D0 EQUATE T0CNT   0D1 EQUATE T0DATA 0D2 EQUATE T0CON   
0D4 EQUATE CLKCON  0D5 EQUATE FLAGS  0D8 EQUATE P0INT
0D9 EQUATE SP      0DA EQUATE P0PND
0DC EQUATE BTCON   0DD EQUATE BTCNT  0DF EQUATE SYM
0E0 EQUATE P0      0E1 EQUATE P1     0E2 EQUATE P2      0E3 EQUATE P3
0E4 EQUATE P4      0E5 EQUATE P3CON  0E6 EQUATE P0CONH  0E7 EQUATE P0CONL
0E8 EQUATE P1CONH  0E9 EQUATE P1CONL 0EA EQUATE P2CONH  0EB EQUATE P2CONL
0EC EQUATE P2INT   0ED EQUATE P2PND  0EE EQUATE P4CON   0EF EQUATE P4INTPND  
0F0 EQUATE FADDR   0F1 EQUATE EP0CSR 0F2 EQUATE EP1CSR  0F3 EQUATE EP0BCNT
0F4 EQUATE EP0FIFO 0F5 EQUATE EP1FIFO 0F6 EQUATE USBPND 0F7 EQUATE USBINT
0F8 EQUATE PWRMGR  0FF EQUATE USBRST

END-EQUATES \ 37 EQUATES
\ READ ONLY     2
\ WRITE ONLY    0
\ READ/WRITE    35
\ UNKNOWN       0

