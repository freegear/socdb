0C000H ROMSIZE
00 0BF RAMRANGE

\ SET1, BANK0
0D0 EQUATE INTPND  0D1 EQUATE STPCON    0D2 EQUATE OSCCON     0D3 EQUATE BTCON
0D4 EQUATE CLKCON  0D5 EQUATE FLAGS     0D6 EQUATE RP0        0D7 EQUATE RP1     
0D8 EQUATE SPH     0D9 EQUATE SPL       0DA EQUATE IPH        0DB EQUATE IPL     
0DC EQUATE IRQ     0DD EQUATE IMR       0DE EQUATE SYM        0DF EQUATE PP      
0E0 EQUATE SIOCON  0E1 EQUATE SIODATA   0E2 EQUATE SIOPS      0E3 EQUATE T0CNT   
0E4 EQUATE T0DATA  0E5 EQUATE T0CON     0E6 EQUATE TBCNT      0E7 EQUATE TACNT
0E8 EQUATE TBDATA  0E9 EQUATE TADATA    0EA EQUATE TBCON      0EB EQUATE TACON
0EC EQUATE T2CNT   0ED EQUATE T2DATA    0EE EQUATE T2CON      0EF EQUATE ADCON
0F0 EQUATE ADDATAH 0F1 EQUATE ADDATAL   0F2 EQUATE LCON       0F3 EQUATE LMOD
0F4 EQUATE T3CNTH  0F5 EQUATE T3CNTL    0F6 EQUATE T3DATAH    0F7 EQUATE T3DATAL 
0F8 EQUATE T3CON   0F9 EQUATE UDATA     0FA EQUATE UARTCON    0FB EQUATE BRDATA     
0FD EQUATE BTCNT   0FF EQUATE IPR  

\ SET1, BANK1
0E0 EQUATE P2CONH     0E1 EQUATE P2CONL     0E2 EQUATE P2PUR    0E3 EQUATE P2INT
0E4 EQUATE P3CONH     0E5 EQUATE P3CONL     0E6 EQUATE P3PUR    0E7 EQUATE P4EDGE    
0E8 EQUATE P4CONH     0E9 EQUATE P4CONL     0EA EQUATE P4INT    0EB EQUATE P4PND   
0EC EQUATE P5CONH     0ED EQUATE P5CONL     0EE EQUATE P5PUR    0EF EQUATE WTCON   
0F0 EQUATE P0         0F1 EQUATE P1         0F2 EQUATE P2       0F3 EQUATE P3       
0F4 EQUATE P4         0F5 EQUATE P5         0F6 EQUATE P6       0F7 EQUATE P7       
0F8 EQUATE P8         0F9 EQUATE PG0CON     0FA EQUATE PG1CON    

END-EQUATES \ 73 EQUATES
