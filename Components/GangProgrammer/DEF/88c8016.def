        T2M0PS  W,  T2M1PS  W,  T2M2PS  W,
        T2M0CON W,  T2M1CON W,  T2M2CON W,  T2M3CON W,  T2M3H   W,
        T2M3L   W,  T2M3TGL W,  T2M4CON W,  T2M4H   W,  T2M4L   W,
        T1M0PS  W,  ADCON   W,  PWM0    W,  PWM0EX  W,  PWM1    W,
        PWM1EX  W,  PWMCON  W,  $;

