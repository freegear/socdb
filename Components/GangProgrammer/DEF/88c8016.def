        FLAGS   W,  RP0     W,  RP1     W,  SPH     W,  SPL     W,
        IPH     W,  IPL     W,  IMR     W,  SYM     W,  PP      W,
        P0      W,  P1      W,  P2      W,  P0CON   W,  P1CON   W,
        P2CONH  W,  P2CONL  W,  P2INT   W,  SIO     W,  EMT     W,
        IPR     W,  P3      W,  P4      W,  P3CON   W,  P4CONH  W,
        P4CONL  W,  P4INT   W,  T1M0H   W,  T1M0L   W,  T2M3H   W,
        T2M3L   W,  T2M4H   W,  T2M4L   W,  ADCON   W,  $;


