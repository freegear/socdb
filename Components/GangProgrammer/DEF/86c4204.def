        P3CON   W,  SIODATA W,  SIOCON  W,  SIOPS   W,  ICCR    W,
        ICSR    W,  IAR     W,  IDSR    W,  BUZPS   W,  ADCON   W,  
        ADDATAH W,  ADDATAL W,  PWM0    W,  PWM0EX  W,  PWM1    W,  
        PWM1EX  W,  PWMCON  W,  ZCMOD   W,  
        $; \ 43 REGISTERS

