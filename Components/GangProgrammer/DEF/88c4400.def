        SPL     W,  SPH     W,  RP1     W,  RP0     W,  FLAGS   W,
        P4PND   W,  TDL     W,  TDH     W,  TCL     W,  TCH     W,
        PWMCAP  W,  PWM0    W,  PWM1    W,  PWMCON  W,  ADCON   W,
