        T1CON   W,  P4INT   W,  P5CON   W,  P4CONL  W,  P4CONH  W,
        P3CONL  W,  P3CONH  W,  P2CON   W,  PACON   W,  PADCON  W,
        TBCON   W,  T0CON   W,  TBDATA  W,  TADATA  W,  PCCON   W,
