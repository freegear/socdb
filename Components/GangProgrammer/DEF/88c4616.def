0FC EQUATE FTEST     0FD EQUATE BTCNT     0FE EQUATE EMT       0FF EQUATE IPR
0E0 EQUATE PWM0      0E1 EQUATE PWM0EX    0E2 EQUATE PWM1            
0E3 EQUATE PWM1EX    0E4 EQUATE PWMCON    0E5 EQUATE CAPA      0E6 EQUATE PWMPS
0E7 EQUATE T2CON     0E8 EQUATE T2CNT     0E9 EQUATE T2DATA    0EA EQUATE ZCMOD
0EB EQUATE BUZPS     0EE EQUATE P6CONH    0EF EQUATE P6CONL
0F0 EQUATE TCH       0F1 EQUATE TCL
0F2 EQUATE TDH       0F3 EQUATE TDL       0F5 EQUATE TBD       0F6 EQUATE RBD
0F7 EQUATE ADCON
0F8 EQUATE ADDATAH   0F9 EQUATE ADDATAL   0FA EQUATE UARTDATA  0FB EQUATE UARTCON
0FC EQUATE UARTPND   0FD EQUATE SIODATA   0FE EQUATE SIOCON    0FF EQUATE SIOPS  
