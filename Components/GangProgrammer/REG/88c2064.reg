	.list   off

;       88c2064 system register
;       97/05/29 by J.K.LEE Revision 0

	.romsize        10000h

	.ram_range      00h, 0C0h

;       System Registers
T0CNT:          .reg    0D0h,r
T0DATA:         .reg    0D1h
T0CON:          .reg    0D2h
BTCON:          .reg    0D3h
CLKCON:         .reg    0D4h
FLAGS:          .reg    0D5h
RP0:            .reg    0D6h
RP1:            .reg    0D7h
SPH:            .reg    0D8h
SPL:            .reg    0D9h
IPH:            .reg    0DAh
IPL:            .reg    0DBh
IRQ:            .reg    0DCh,r
IMR:            .reg    0DDh
SYM:            .reg    0DEh
PP:             .reg    0DFh
;
;       Set 1, Bank 0
P0:             .reg    0E0h
P1:             .reg    0E1h
P2:             .reg    0E2h
P3:             .reg    0E3h
P0CON:          .reg    0E5h
P1CON:          .reg    0E6h
P2CONH:         .reg    0E8h
P2CONL:         .reg    0E9h
P3CONH:         .reg    0EAh
P3CONL:         .reg    0EBh
P3INT:          .reg    0ECh
P3PND:          .reg    0EDh
P3STA:          .reg    0EEh
;
TACNT:          .reg    0F2h,r
TBCNT:          .reg    0F3h,r
TADATA:         .reg    0F4h
TBDATA:         .reg    0F5h
TACON:          .reg    0F6h
TBCON:          .reg    0F7h
WTCON:          .reg    0F8h
LCON:           .reg    0F9h
FDCON:          .reg    0FAh
CLKMOD:		.reg	0FBh
BTCNT:          .reg    0FDh,r
EMT:            .reg    0FEh
IPR:            .reg    0FFh
;

;       Bit equates
;       flags
;C:             .bit    FLAGS.7
;Z:             .bit    FLAGS.6
;S:             .bit    FLAGS.5
;V:             .bit    FLAGS.4
;D:             .bit    FLAGS.3
;H:             .bit    FLAGS.2
;FIS:           .bit    FLAGS.1
;BA:            .bit    FLAGS.0


;       system registers
t0cnt:          .reg    0d0h,r
t0data:         .reg    0d1h
t0con:          .reg    0d2h
btcon:          .reg    0d3h
clkcon:         .reg    0d4h
flags:          .reg    0d5h
rp0:            .reg    0d6h
rp1:            .reg    0d7h
sph:            .reg    0d8h
spl:            .reg    0d9h
iph:            .reg    0dah
ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh
;
;       set 1, bank 0
p0:             .reg    0e0h
p1:             .reg    0e1h
p2:             .reg    0e2h
p3:             .reg    0e3h
p0con:          .reg    0e5h
p1con:          .reg    0e6h
p2conh:         .reg    0e8h
p2conl:         .reg    0e9h
p3conh:         .reg    0eah
p3conl:         .reg    0ebh
p3int:          .reg    0ech
p3pnd:          .reg    0edh
p3sta:          .reg    0eeh
;
tacnt:          .reg    0f2h,r
tbcnt:          .reg    0f3h,r
tadata:         .reg    0f4h
tbdata:         .reg    0f5h
tacon:          .reg    0f6h
tbcon:          .reg    0f7h
wtcon:          .reg    0f8h
lcon:           .reg    0f9h
fdcon:          .reg    0fah
clkmod:		.reg	0fbh
btcnt:          .reg    0fdh,r
emt:            .reg    0feh
ipr:            .reg    0ffh

;       Bit equates
;       flags
;c:             .bit    flags.7
;z:             .bit    flags.6
;s:             .bit    flags.5
;v:             .bit    flags.4
;d:             .bit    flags.3
;h:             .bit    flags.2
;fis:           .bit    flags.1
;ba:            .bit    flags.0

;
; END OF 88C2064.REG
	.list   on
