	.romsize        1000h

	.ram_range      00h,C0h     ;    C0h -> 0C0h   2001/03/09 by S.W.ROH of AIJI System

;       System Register
T0CNT:          .REG    0D0H,r
T0DATA:         .REG    0D1H
T0CON:          .REG    0D2H
CLKCON:         .REG    0D4H
FLAGS:          .REG    0D5H
SP:             .REG    0D9H
