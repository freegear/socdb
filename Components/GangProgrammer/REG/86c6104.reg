BTCNT:          .REG    0DDH,r
SYM:            .REG    0DFH
P0:             .REG    0E0H
P1:             .REG    0E1H
CDATA:          .REG    0E5H,r
P0CON:          .REG    0E6H
CCON:           .REG    0E7H
P1CONH:         .REG    0E8H
P1CONL:         .REG    0E9H
P0INT:          .REG    0EAH
P0PND:          .REG    0EBH
P1INT:          .REG    0ECH
P1PND:          .REG    0EDH
FADDR:          .REG    0F0H
EP0CSR:         .REG    0F1H
EP1CSR:         .REG    0F2H
EP0BCNT:        .REG    0F3H
EP0FIFO:        .REG    0F4H
EP1FIFO:        .REG    0F5H
USBPND:         .REG    0F6H
USBINT:         .REG    0F7H
PWRMGR:         .REG    0F8H
USBRST:         .REG    0FFH

;       System Registers
t0cnt:          .reg    0d0h,r
