p0con:          .reg    0e6h
ccon:           .reg    0e7h
p1conh:         .reg    0e8h
p1conl:         .reg    0e9h
p0int:          .reg    0eah
p0pnd:          .reg    0ebh
p1int:          .reg    0ech
p1pnd:          .reg    0edh
faddr:          .reg    0f0h
