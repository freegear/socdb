	.list   off

;       88c8316 system register
;       98/01/05 by J.K.Lee Revision 0
;      1,st Revision : 09/28/98 J.K.Lee   -> 0FC EQUATE VSBCON added  

	.romsize        4000h

	.ram_range      00h, 0C0h

;       System Registers
T0CNT:          .reg    0D0h,r
T0DATA:         .reg    0D1h
T0CON:          .reg    0D2h
BTCON:          .reg    0D3h
CLKCON:         .reg    0D4h
FLAGS:          .reg    0D5h
RP0:            .reg    0D6h
RP1:            .reg    0D7h
SPH:            .reg    0D8h
SPL:            .reg    0D9h
IPH:            .reg    0DAh
IPL:            .reg    0DBh
IRQ:            .reg    0DCh,r
IMR:            .reg    0DDh
SYM:            .reg    0DEh
PP:             .reg    0DFh
;
;       Set 1, Bank 0
P0:             .reg    0E0h
P1:             .reg    0E1h
P2:             .reg    0E2h
P3:             .reg    0E3h
P0CONH:         .reg    0E4h
P0CONL:         .reg    0E5h
P1CONH:         .reg    0E6h
P1CONL:         .reg    0E7h
P2CONH:         .reg    0E8h
P2CONL:         .reg    0E9h
P3CONL:         .reg    0EBh
;
TADATA:         .reg    0F0h
TACON:          .reg    0F2h
PWM0:           .reg    0F4h
PWM0EX:         .reg    0F5h
PWMCON:         .reg    0F8h
CAPA:           .reg    0F9h,r
ADCON:          .reg    0FAh
BTCNT:          .reg    0FDh,r
EMT:            .reg    0FEh
IPR:            .reg    0FFh
;
;       Set 1, Bank 1
CHACON:         .reg    0F0h
FADECON:        .reg    0F1h
ROWCON:         .reg    0F2h
CLMCON:         .reg    0F3h
COLCON:         .reg    0F4h
DSPCON:         .reg    0F5h
HTCON:          .reg    0F6h
COLBUF:         .reg    0F7h
VSBCON:         .reg    0FCh

;       Bit equates
;       flags
;C:             .bit    FLAGS.7
;Z:             .bit    FLAGS.6
;S:             .bit    FLAGS.5
;V:             .bit    FLAGS.4
;D:             .bit    FLAGS.3
;H:             .bit    FLAGS.2
;FIS:           .bit    FLAGS.1
;BA:            .bit    FLAGS.0

;       System Registers
t0cnt:          .reg    0d0h,r
t0data:         .reg    0d1h
t0con:          .reg    0d2h
btcon:          .reg    0d3h
clkcon:         .reg    0d4h
flags:          .reg    0d5h
rp0:            .reg    0d6h
rp1:            .reg    0d7h
sph:            .reg    0d8h
spl:            .reg    0d9h
iph:            .reg    0dah
ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh
;
;       set 1, bank 0
p0:             .reg    0e0h
p1:             .reg    0e1h
p2:             .reg    0e2h
p3:             .reg    0e3h
p0conh:         .reg    0e4h
p0conl:         .reg    0e5h
p1conh:         .reg    0e6h
p1conl:         .reg    0e7h
p2conh:         .reg    0e8h
p2conl:         .reg    0e9h
p3conl:         .reg    0ebh
;
tadata:         .reg    0f0h
tacon:          .reg    0f2h
pwm0:           .reg    0f4h
pwm0ex:         .reg    0f5h
pwmcon:         .reg    0f8h
capa:           .reg    0f9h,r
adcon:          .reg    0fah
btcnt:          .reg    0fdh,r
emt:            .reg    0feh
ipr:            .reg    0ffh
;
;       set 1, bank 1
chacon:         .reg    0f0h
fadecon:        .reg    0f1h
rowcon:         .reg    0f2h
clmcon:         .reg    0f3h
colcon:         .reg    0f4h
dspcon:         .reg    0f5h
htcon:          .reg    0f6h
colbuf:         .reg    0f7h
vsbcon:         .reg    0fch

;       bit equates
;       flags
;c:             .bit    flags.7
;z:             .bit    flags.6
;s:             .bit    flags.5
;v:             .bit    flags.4
;d:             .bit    flags.3
;h:             .bit    flags.2
;fis:           .bit    flags.1
;ba:            .bit    flags.0


;
; END OF 88C8316.REG
	.list   on
