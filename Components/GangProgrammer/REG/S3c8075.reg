	.list   off

;       88c0716 system register
;       98/04/23 by j.k.Lee Revision 0

	.romsize        10000h
	.ram_range      00h, 0C0h

;       System Registers
TCH:            .reg    0D0h
TCL:            .reg    0D1h
BTCON:          .reg    0D3h
CLKCON:         .reg    0D4h
FLAGS:          .reg    0D5h
RP0:            .reg    0D6h
RP1:            .reg    0D7h
SPH:            .reg    0D8h
SPL:            .reg    0D9h
IPH:            .reg    0DAh
IPL:            .reg    0DBh
IRQ:            .reg    0DCh,r
IMR:            .reg    0DDh
SYM:            .reg    0DEh
PP:             .reg    0DFh
;
P0:             .reg    0E0h
P1:             .reg    0E1h
P2:             .reg    0E2h
P3:             .reg    0E3h
P4:             .reg    0E4h
P5:             .reg    0E5h
P6:             .reg    0E6h
P4PND:          .reg    0E7h
P4INT:          .reg    0E8h
SIO:            .reg    0E9h
SIOCON:         .reg    0EAh
SIOPND:         .reg    0EBh
TADATA:         .reg    0ECh
TBDATA:         .reg    0EDh
T0CON:          .reg    0EEh
TBINT:          .reg    0EFh,w
;
P0CON:          .reg    0F0h
P1CON:          .reg    0F1h
P2CONH:         .reg    0F2h
P2CONL:         .reg    0F3h
P3CONH:         .reg    0F4h
P3CONL:         .reg    0F5h
P4CONH:         .reg    0F6h
P4CONL:         .reg    0F7h
TDH:            .reg    0F8h
TDL:            .reg    0F9h
T1CON:          .reg    0FAh
T1MOD:          .reg    0FBh
FTEST:          .reg    0FCh
BTCNT:          .reg    0FDh,r
EMT:            .reg    0FEh
IPR:            .reg    0FFh
;
P5CON:          .reg    0F8h
P6CON:          .reg    0F9h

;       Bit equates
;       flags
C:              .bit    FLAGS.7
Z:              .bit    FLAGS.6
S:              .bit    FLAGS.5
V:              .bit    FLAGS.4
D:              .bit    FLAGS.3
H:              .bit    FLAGS.2
FIS:            .bit    FLAGS.1
BA:             .bit    FLAGS.0

;       system registers
tch:            .reg    0d0h
tcl:            .reg    0d1h
btcon:          .reg    0d3h
clkcon:         .reg    0d4h
flags:          .reg    0d5h
rp0:            .reg    0d6h
rp1:            .reg    0d7h
sph:            .reg    0d8h
spl:            .reg    0d9h
iph:            .reg    0dah
ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh
;
p0:             .reg    0e0h
p1:             .reg    0e1h
p2:             .reg    0e2h
p3:             .reg    0e3h
p4:             .reg    0e4h
p5:             .reg    0e5h
p6:             .reg    0e6h
p4pnd:          .reg    0e7h
p4int:          .reg    0e8h
sio:            .reg    0e9h
siocon:         .reg    0eah
siopnd:         .reg    0ebh
tadata:         .reg    0ech
tbdata:         .reg    0edh
t0con:          .reg    0eeh
tbint:          .reg    0efh,w
;
p0con:          .reg    0f0h
p1con:          .reg    0f1h
p2conh:         .reg    0f2h
p2conl:         .reg    0f3h
p3conh:         .reg    0f4h
p3conl:         .reg    0f5h
p4conh:         .reg    0f6h
p4conl:         .reg    0f7h
tdh:            .reg    0f8h
tdl:            .reg    0f9h
t1con:          .reg    0fah
t1mod:          .reg    0fbh
ftest:          .reg    0fch
btcnt:          .reg    0fdh,r
emt:            .reg    0feh
ipr:            .reg    0ffh
;
p5con:          .reg    0f8h
p6con:          .reg    0f9h
;       bit equates
;       flags
c:              .bit    flags.7
z:              .bit    flags.6
s:              .bit    flags.5
v:              .bit    flags.4
d:              .bit    flags.3
h:              .bit    flags.2
fis:            .bit    flags.1
