        .list   off

;       57c0504 system register
;	Test version :10/01/97 by K.M.Yi 
;       1'st revision:02/24/98 by K.M. Yi :WDFLAG ->WDTCF
;       98/06/05 by YKM Rev2 : ram_range 00h, 0ffh  --> 00h, 100h
;       3rd revision:07/14/98 by K.M. Yi :WDTCF ->WDFLAG
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Hyung Tae Kim 98.11.19
;;;				


		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        1000h

        .ram_range      00h, 100h

;       System Registers
SP:             .reg    0f80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
WMOD:		.reg    0f88h,w, _op8
TMOD0:		.reg    0f90h,w, _op18&_bit3

		.reg	0f92h, _op14&_bit2	; *** NEW: not defined in old reg file
TOE0:		.bit	0f92h.2

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:          .reg    0f98h,w, _op8

WDFLAG:         .reg    0f9ah,w, _op1&_bit3
WDTCF:          .bit    0f9ah.3,w

PSW:		.reg    0fb0h
IS1:		.bit    0fb0h.3
IS0:		.bit    0fb0h.2
EMB:		.bit    0fb0h.1
ERB:		.bit    0fb0h.0
C:		.bit    0fb1h.3

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:		.bit    0fb2h.3,w		; modified by Hyung Tae Kim 98.11.19

PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMODK:		.reg    0fb6h,w, _op4

		.reg	0fb8h, _op14&_bit01	; *** NEW: not defined in old reg file
IEB:		.bit    0fb8h.1
IRQB:		.bit    0fb8h.0

		.reg	0fbah, _op14&_bit01	; *** NEW: not defined in old reg file
IEW:		.bit    0fbah.1
IRQW:		.bit    0fbah.0

		.reg	0fbch, _op14&_bit01	; *** NEW: not defined in old reg file
IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

		.reg	0fbdh, _op14&_bit01	; *** NEW: not defined in old reg file
IES:		.bit    0fbdh.1
IRQS:		.bit    0fbdh.0

		.reg	0fbeh, _op14		; *** NEW: not defined in old reg file
IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0

		.reg	0fbfh, _op14&_bit01	; *** NEW: not defined in old reg file
IEK:		.bit    0fbfh.1
IRQK:		.bit    0fbfh.0

BSC0:		.reg    0fc0h
BSC1:		.reg    0fc1h
BSC2:		.reg    0fc2h
BSC3:		.reg    0fc3h

CLMOD:		.reg    0fd0h,w, _op4
CMPREG:		.reg    0fd4h,r, _op4
CMOD:		.reg    0fd6h, _op8
PNE:        	.reg    0fdah,w, _op8
PUMOD:		.reg    0fdch,w, _op8
SMOD:		.reg    0fe0h,w, _op18&_bit3
P2MOD:          .reg    0fe2h,w, _op4
SBUF:		.reg    0fe4h, _op8
PMG1:		.reg    0fe8h,w, _op8
PMG2:		.reg    0feah,w, _op8
PMG3:		.reg    0fech,w, _op8

P0:		.reg    0ff0h, _op14&_bit012
P1:		.reg    0ff1h,r, _op14&_bit01
P2:		.reg    0ff2h,r, _op14
P3:		.reg    0ff3h, _op14&_bit012
P4:		.reg    0ff4h
P5:		.reg    0ff5h
P6:		.reg    0ff6h, _op14

;       System Registers
sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
wmod:		.reg    0f88h,w, _op8
tmod0:		.reg    0f90h,w, _op18&_bit3

toe0:		.bit	0f92h.2
tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:          .reg    0f98h,w, _op8

wdflag:         .reg    0f9ah,w, _op1&_bit3
wdtcf:          .bit    0f9ah.3,w
psw:		.reg    0fb0h
is1:		.bit    0fb0h.3
is0:		.bit    0fb0h.2
emb:		.bit    0fb0h.1
erb:		.bit    0fb0h.0
c:		.bit    0fb1h.3

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:		.bit    0fb2h.3,w		; modified by Hyung Tae Kim 98.11.19
pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imodk:		.reg    0fb6h,w, _op4

ieb:		.bit    0fb8h.1
irqb:		.bit    0fb8h.0
iew:		.bit    0fbah.1
irqw:		.bit    0fbah.0
iet0:		.bit    0fbch.1
irqt0:		.bit    0fbch.0
ies:		.bit    0fbdh.1
irqs:		.bit    0fbdh.0
ie1:		.bit    0fbeh.3
irq1:		.bit    0fbeh.2
ie0:		.bit    0fbeh.1
irq0:		.bit    0fbeh.0
iek:		.bit    0fbfh.1
irqk:		.bit    0fbfh.0

bsc0:		.reg    0fc0h
bsc1:		.reg    0fc1h
bsc2:		.reg    0fc2h
bsc3:		.reg    0fc3h

clmod:		.reg    0fd0h,w, _op4
cmpreg:		.reg    0fd4h,r, _op4
cmod:		.reg    0fd6h, _op8
pne:        .reg    0fdah,w, _op8
pumod:		.reg    0fdch,w, _op8
smod:		.reg    0fe0h,w, _op18&_bit3
p2mod:          .reg    0fe2h,w, _op4
sbuf:		.reg    0fe4h, _op8
pmg1:		.reg    0fe8h,w, _op8
pmg2:		.reg    0feah,w, _op8
pmg3:		.reg    0fech,w, _op8

p0:		.reg    0ff0h, _op14&_bit012
p1:		.reg    0ff1h,r, _op14&_bit01
p2:		.reg    0ff2h,r, _op14
p3:		.reg    0ff3h, _op14&_bit012
p4:		.reg    0ff4h
p5:		.reg    0ff5h
p6:		.reg    0ff6h, _op14


;
; END OF 57C0504.REG
        .list   on


