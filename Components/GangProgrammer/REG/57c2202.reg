        .list   off

;       57c2202 system register
;	96/11/01 by h.j.cho Revision 0
;	97/09/20 by K.M.Yi Revision 1 : Edit address
;       98/06/05 by YKM Rev2 : ram_range 00h, 0ffh  --> 00h, 100h
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Hyung Tae Kim 98.11.19
;;;				


		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        800h

        .ram_range      00h, 100h

;       System Registers
SP:		.reg    0f80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
WMOD:		.reg    0f88h,w, _op8
LMOD:		.reg    0f8ch,w, _op18&_bit3
LCON:		.reg    0f8eh,w, _op4
TMOD0:		.reg    0f90h,w, _op18&_bit3

		.reg	0f92h, _op14&_bit2	; *** NEW: register 0f92h should be defined	 
TOE0:		.bit    0f92h.2

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8

PSW:		.reg    0fb0h
IS1:		.bit    0fb0h.3
IS0:		.bit    0fb0h.2
EMB:		.bit    0fb0h.1
ERB:		.bit    0fb0h.0
C:		.bit    0fb1h.3
;SC2:		.bit    0fb1h.2,r
;SC1:		.bit    0fb1h.1,r
;SC0:		.bit    0fb0h.0,r

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:            .bit    0fb2h.3,w

PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMODK:		.reg    0fb6h,w, _op4

IEB:            .bit    0fb8h.1
IRQB:           .bit    0fb8h.0

SPCON:		.reg    0fb9h, _op14
MCON:           .bit    0fb9h.2
SPC1:           .bit    0fb9h.1
SPC0:           .bit    0fb9h.0

		.reg	0fbah, _op14&_bit01	; ***NEW: not defined in old reg file
IEW:		.bit    0fbah.1
IRQW:		.bit    0fbah.0

		.reg	0fbbh, _op14		; ***NEW: not defined in old reg file
IEK:		.bit    0fbbh.3
IRQK:		.bit    0fbbh.2
IEM:		.bit    0fbbh.1
IRQM:		.bit    0fbbh.0

		.reg	0fbch, _op14&_bit01	; ***NEW: not defined in old reg file
IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

		.reg	0fbeh, _op14		; ***NEW: not defined in old reg file
IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0

BSC0:		.reg    0fc0h
BSC1:		.reg    0fc1h
BSC2:		.reg    0fc2h
BSC3:		.reg    0fc3h

CLMOD:		.reg    0fd0h,w, _op4
PNE:		.reg    0fd6h,w, _op8
MPNT:		.reg    0fd8h, _op8
TEMP:		.reg    0fdah,w, _op4
MOCON:		.reg    0fdbh, _op14
PUMOD:		.reg    0fdch,w, _op8
PMG1:		.reg    0fe8h,w, _op8
PMG2:		.reg    0fech,w, _op8

P1:		.reg    0ff1h,r, _op14
P3:		.reg    0ff3h, _op14
P4:		.reg    0ff4h
P5:		.reg    0ff5h
P6:		.reg    0ff6h, _op14

;       System Registers
sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
wmod:		.reg    0f88h,w, _op8
lmod:		.reg    0f8ch,w, _op18&_bit3
lcon:		.reg    0f8eh,w, _op4
tmod0:		.reg    0f90h,w, _op18&_bit3
toe0:		.bit    0f92h.2
tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
psw:		.reg    0fb0h
is1:		.bit    0fb0h.3
is0:		.bit    0fb0h.2
emb:		.bit    0fb0h.1
erb:		.bit    0fb0h.0
c:		.bit    0fb1h.3
;sc2:		.bit    0fb1h.2,r
;sc1:		.bit    0fb1h.1,r
;sc0:		.bit    0fb0h.0,r

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:            .bit    0fb2h.3,w

pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imodk:		.reg    0fb6h,w, _op4

ieb:            .bit    0fb8h.1
irqb:           .bit    0fb8h.0
						 
spcon:		.reg    0fb9h, _op14
mcon:           .bit    0fb9h.2
spc1:           .bit    0fb9h.1
spc0:           .bit    0fb9h.0

iew:		.bit    0fbah.1
irqw:		.bit    0fbah.0
iek:		.bit    0fbbh.3
irqk:		.bit    0fbbh.2
iem:		.bit    0fbbh.1
irqm:		.bit    0fbbh.0
iet0:		.bit    0fbch.1
irqt0:		.bit    0fbch.0
ie1:		.bit    0fbeh.3
irq1:		.bit    0fbeh.2
ie0:		.bit    0fbeh.1
irq0:		.bit    0fbeh.0
bsc0:		.reg    0fc0h
bsc1:		.reg    0fc1h
bsc2:		.reg    0fc2h
bsc3:		.reg    0fc3h

clmod:		.reg    0fd0h,w, _op4
pne:		.reg    0fd6h,w, _op8
mpnt:		.reg    0fd8h, _op8
temp:		.reg    0fdah,w, _op4
mocon:		.reg    0fdbh, _op14
pumod:		.reg    0fdch,w, _op8
pmg1:		.reg    0fe8h,w, _op8
pmg2:		.reg    0fech,w, _op8
p1:		.reg    0ff1h,r, _op14
p3:		.reg    0ff3h, _op14
p4:		.reg    0ff4h
p5:		.reg    0ff5h
p6:		.reg    0ff6h, _op14
;
; END OF 57C2202.REG
        .list   on


