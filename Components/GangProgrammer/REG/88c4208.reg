	.list   off

;       88c4208 system register
;       96/11/01 by h.j.cho Revision 0

	.romsize        2000h

	.ram_range      00h, 0C0h

;       System Registers
T0CNT:          .reg    0D0h,r
T0DATA:         .reg    0D1h
T0CON:          .reg    0D2h
BTCON:          .reg    0D3h
CLKCON:         .reg    0D4h
FLAGS:          .reg    0D5h
RP0:            .reg    0D6h
RP1:            .reg    0D7h
SPH:            .reg    0D8h
SPL:            .reg    0D9h
IPH:            .reg    0DAh
IPL:            .reg    0DBh
IRQ:            .reg    0DCh,r
IMR:            .reg    0DDh
SYM:            .reg    0DEh
PP:             .reg    0DFh
;
;       Set 1, Bank 0
P0:             .reg    0E0h
P1:             .reg    0E1h
P2:             .reg    0E2h
P3:             .reg    0E3h
P4:             .reg    0E4h
SIO:            .reg    0E9h
SIOCON:         .reg    0EAh
SIOPND:         .reg    0EBh
TCH:            .reg    0ECh
TCL:            .reg    0EDh
TDH:            .reg    0EEh
TDL:            .reg    0EFh
P0CON:          .reg    0F0h
P1CON:          .reg    0F1h
P2CONH:         .reg    0F2h
P2CONL:         .reg    0F3h
P3CONH:         .reg    0F4h
P3CONL:         .reg    0F5h
P4CON:          .reg    0F6h
T1CON:          .reg    0F8h
T1MOD:          .reg    0F9h
ADCON:          .reg    0FAh
ADOUT:          .reg    0FBh
BTCNT:          .reg    0FDh,r
EMT:            .reg    0FEh
IPR:            .reg    0FFh

;       Bit equates
;       flags
;C:             .bit    FLAGS.7
;Z:             .bit    FLAGS.6
;S:             .bit    FLAGS.5
;V:             .bit    FLAGS.4
;D:             .bit    FLAGS.3
;H:             .bit    FLAGS.2
;FIS:           .bit    FLAGS.1
;BA:            .bit    FLAGS.0
;
;       System Registers
t0cnt:          .reg    0d0h,r
t0data:         .reg    0d1h
t0con:          .reg    0d2h
btcon:          .reg    0d3h
clkcon:         .reg    0d4h
flags:          .reg    0d5h
rp0:            .reg    0d6h
rp1:            .reg    0d7h
sph:            .reg    0d8h
spl:            .reg    0d9h
iph:            .reg    0dah
ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh
;
;       Set 1, Bank 0
p0:             .reg    0e0h
p1:             .reg    0e1h
p2:             .reg    0e2h
p3:             .reg    0e3h
p4:             .reg    0e4h
sio:            .reg    0e9h
siocon:         .reg    0eah
siopnd:         .reg    0ebh
tch:            .reg    0ech
tcl:            .reg    0edh
tdh:            .reg    0eeh
tdl:            .reg    0efh
p0con:          .reg    0f0h
p1con:          .reg    0f1h
p2conh:         .reg    0f2h
p2conl:         .reg    0f3h
p3conh:         .reg    0f4h
p3conl:         .reg    0f5h
p4con:          .reg    0f6h
t1con:          .reg    0f8h
t1mod:          .reg    0f9h
adcon:          .reg    0fah
adout:          .reg    0fbh
btcnt:          .reg    0fdh,r
emt:            .reg    0feh
ipr:            .reg    0ffh

;       Bit equates
;       flags
;c:             .bit    flags.7
;z:             .bit    flags.6
;s:             .bit    flags.5
;v:             .bit    flags.4
;d:             .bit    flags.3
;h:             .bit    flags.2
;fis:           .bit    flags.1
;ba:            .bit    flags.0

;
; END OF 88C4208.REG
	.list   on
