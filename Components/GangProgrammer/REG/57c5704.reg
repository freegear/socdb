       .list       off

;       57c5704 system register
;	Test version : 06/17/2000 by J.K.Lee
;       
        .romsize        1000h

        .ram_range      00h, 100h

;       SYSTEM REGISTERS
SP:	.reg    0f80h
BMOD:	.reg    0f85h,w
BCNT:	.reg    0f86h,r
WMOD:	.reg    0f88h,w
LMOD:   .reg    0f8ch,w
LCON:   .reg    0f8eh,w

TMOD0:	.reg    0f90h,w

TOE0:	.bit    0f92h.2

TCNT0:	.reg    0f94h,r
TREF0:	.reg    0f96h,w
WDMOD:	.reg    0f98h,w
WDFLAG:	.reg    0f9ah,w
DTMR:   .reg    0fach,w

PSW:	.reg    0fb0h
IS1:	.bit    0fb0h.3
IS0:	.bit    0fb0h.2
EMB:	.bit    0fb0h.1
ERB:	.bit    0fb0h.0
C:	.bit    0fb1h.3

IPR:	.reg    0fb2h,w
IME:	.bit    0fb2h.3,w

PCON:	.reg    0fb3h,w
IMOD0:	.reg    0fb4h,w
IMOD1:	.reg    0fb5h,w
IMOD2:	.reg    0fb6h,w
SCMOD:  .reg    0fb7h,w

IEB:	.bit    0fb8h.1
IRQB:	.bit    0fb8h.0

IEW:	.bit    0fbah.1
IRQW:	.bit    0fbah.0

IET0:	.bit    0fbch.1
IRQT0:	.bit    0fbch.0

IE1:	.bit    0fbeh.3
IRQ1:	.bit    0fbeh.2
IE0:	.bit    0fbeh.1
IRQ0:	.bit    0fbeh.0

IE2:	.bit    0fbfh.1
IRQ2:	.bit    0fbfh.0

BSC0:	.reg    0fc0h
BSC1:	.reg    0fc1h
BSC2:	.reg    0fc2h
BSC3:	.reg    0fc3h

CLMOD:	.reg    0fd0h,w
PUMOD:	.reg    0fdch,w

PMG1:	.reg    0fe8h,w
PMG2:	.reg    0fech,w

P1:	.reg    0ff1h,r
P2:	.reg    0ff2h
P3:	.reg    0ff3h
P6:	.reg    0ff6h

;       system registers
sp:	.reg    0f80h
bmod:	.reg    0f85h,w
bcnt:	.reg    0f86h,r
wmod:	.reg    0f88h,w
lmod:   .reg    0f8ch,w
lcon:   .reg    0f8eh,w

tmod0:	.reg    0f90h,w

toe0:	.bit    0f92h.2

tcnt0:	.reg    0f94h,r
tref0:	.reg    0f96h,w
wdmod:	.reg    0f98h,w
wdflag:	.reg    0f9ah,w
dtmr:   .reg    0fach,w

psw:	.reg    0fb0h
is1:	.bit    0fb0h.3
is0:	.bit    0fb0h.2
emb:	.bit    0fb0h.1
erb:	.bit    0fb0h.0
c:	.bit    0fb1h.3

ipr:	.reg    0fb2h,w
ime:	.bit    0fb2h.3,w

pcon:	.reg    0fb3h,w
imod0:	.reg    0fb4h,w
imod1:	.reg    0fb5h,w
imod2:	.reg    0fb6h,w
scmod:  .reg    0fb7h,w

ieb:	.bit    0fb8h.1
irqb:	.bit    0fb8h.0

iew:	.bit    0fbah.1
irqw:	.bit    0fbah.0

iet0:	.bit    0fbch.1
irqt0:	.bit    0fbch.0

ie1:	.bit    0fbeh.3
irq1:	.bit    0fbeh.2
ie0:	.bit    0fbeh.1
irq0:	.bit    0fbeh.0

ie2:	.bit    0fbfh.1
irq2:	.bit    0fbfh.0

bsc0:	.reg    0fc0h
bsc1:	.reg    0fc1h
bsc2:	.reg    0fc2h
bsc3:	.reg    0fc3h

clmod:	.reg    0fd0h,w
pumod:	.reg    0fdch,w

pmg1:	.reg    0fe8h,w
pmg2:	.reg    0fech,w

p1:	.reg    0ff1h,r
p2:	.reg    0ff2h
p3:	.reg    0ff3h
p6:	.reg    0ff6h

;
; END OF 57C5704.REG
       .list       on


