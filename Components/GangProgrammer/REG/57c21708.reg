        .list   off

;       57c21708 system register
;	02/05/99 by LEE, C.J. Test version 0
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Chun-ja Lee 03.16.99
;;;				


		.include "sasmopd.prd"		        ; **** NEW: include bit operateion def

_op148	equ	_op1|_op4|_op8				; **** define this if op148 all allowed but some bit forbid accessing

        .romsize        2000h

        .ram_range      00h, 100h

;       System Registers
SP:         .reg    0f80h, _op8
BMOD:       .reg    0f85h,w, _op14&_bit3
BCNT:       .reg    0f86h,r, _op8
WMOD:       .reg    0f88h,w, _op8
LMOD:       .reg    0f8ch,w, _op18&_bit3
LCON:       .reg    0f8eh,w, _op4
TMOD0:      .reg    0f90h,w, _op18&_bit3

TOE:        .reg	0f92h, _op1&_bit12	    ; *** NEW: register 0f92h should be defined
BOE:        .bit    0f92h.1 
TOE0:       .bit    0f92h.2
TOL:		.reg	0f93h,r, _op1&_bit1
TOL0:       .bit    0f93h.1,r               ; *** NEW: bit 1 of TOL0 is readonly

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:      .reg    0f98h,w, _op8
WDFLAG:     .reg    0f9ah,w, _op14
WDTCF:		.bit	0f9ah.3,w
FCMOD:		.reg    0fa0h, _op148&_bit03

            .bit    0fa0h.0
            .bit    0fa0h.3
            .bit    0fa1h.0,r        
		.reg	0fa1h, _op14&_bit0
               
FCNTL:		.reg    0fa4h,r, _op8
FCNTH:		.reg    0fa6h,r, _op8

PSW:		.reg    0fb0h
ERB:		.bit    0fb0h.0
EMB:		.bit    0fb0h.1
IS0:		.bit    0fb0h.2
IS1:		.bit    0fb0h.3
C:          .bit    0fb1h.3,r

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:        .bit    0fb2h.3,w
PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMOD2:		.reg    0fb6h,w, _op4
SCMOD:		.reg    0fb7h,w, _op1

INTA:       .reg    0fb8h, _op14&_bit01		; ***NEW: not defined in old reg file
IRQB:		.bit    0fb8h.0
IEB:		.bit    0fb8h.1

INTB:		.reg	0fbah, _op14&_bit01 	; ***NEW: not defined in old reg file
IRQW:		.bit    0fbah.0
IEW:		.bit    0fbah.1

INTB1:		.reg	0fbbh, _op14&_bit01 	; ***NEW: not defined in old reg file
IRQ3:       .bit    0fbbh.0
IE3:        .bit    0fbbh.1

INTC:		.reg	0fbch, _op14&_bit01 	; ***NEW: not defined in old reg file
IRQT0:		.bit    0fbch.0
IET0:		.bit    0fbch.1

INTD:		.reg	0fbdh, _op14&_bit01   	; ***NEW: not defined in old reg file
IRQG:		.bit    0fbdh.0
IEG:		.bit    0fbdh.1

INTE:		.reg	0fbeh, _op14            ; ***NEW: not defined in old reg file
IRQ0:		.bit    0fbeh.0
IE0:		.bit    0fbeh.1
IRQ1:		.bit    0fbeh.2
IE1:		.bit    0fbeh.3

INTF:		.reg	0fbfh, _op14&_bit01	    ; ***NEW: not defined in old reg file
IRQ2:		.bit    0fbfh.0
IE2:		.bit    0fbfh.1

BSC0:		.reg    0fc0h, _op148
BSC1:		.reg    0fc1h, _op14
BSC2:		.reg    0fc2h, _op148
BSC3:		.reg    0fc3h, _op14
CLMOD:		.reg    0fd0h,w, _op4
PNE:        .reg    0fd6h,w, _op8
IMOD3:		.reg    0fd8h,w, _op8
PUMOD:		.reg    0fdch,w, _op8
CMOD:       .reg    0fe0h, _op4
CMPCON:     .reg    0fe1h, _op14
            .bit    0fe1h.1,r
            .bit    0fe1h.3,r            
VLDCON:     .reg    0fe2h, _op14
            .bit    0fe2h.3,r
PMG0:       .reg    0fe6h,w, _op8
PMG1:       .reg    0fe8h,w, _op8

P0:	    	.reg    0ff0h, _op14
P2:		    .reg    0ff2h, _op148
P3:         .reg    0ff3h, _op14
P4:	    	.reg    0ff4h, _op148
P5:         .reg    0ff5h, _op14
P6:	    	.reg    0ff6h, _op148

;       System Registers
sp:         .reg    0f80h, _op8
bmod:       .reg    0f85h,w, _op14&_bit3
bcnt:       .reg    0f86h,r, _op8
wmod:       .reg    0f88h,w, _op8
lmod:       .reg    0f8ch,w, _op18&_bit3
lcon:       .reg    0f8eh,w, _op4
tmod0:      .reg    0f90h,w, _op18&_bit3

toe:        .reg	0f92h, _op1&_bit12	  
boe:        .bit    0f92h.1 
toe0:       .bit    0f92h.2
tol:		.reg	0f93h,r, _op1&_bit1
tol0:       .bit    0f93h.1,r            

tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:      .reg    0f98h,w, _op8
wdflag:     .reg    0f9ah,w, _op14
wdtcf:		.bit	0f9ah.3,w
fcmod:		.reg    0fa0h, _op148&_bit03
           ; .bit    0fa0h.0
           ; .bit    0fa0h.3
           ; .bit    0fa1h.0,r                       
	   ; .reg    0fa1h, _op14&_bit0
fcntl:		.reg    0fa4h,r, _op8
fcnth:		.reg    0fa6h,r, _op8

psw:		.reg    0fb0h
erb:		.bit    0fb0h.0
emb:		.bit    0fb0h.1
is0:		.bit    0fb0h.2
is1:		.bit    0fb0h.3
c:          .bit    0fb1h.3,r

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:        .bit    0fb2h.3,w
pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imod2:		.reg    0fb6h,w, _op4
scmod:		.reg    0fb7h,w, _op1

inta:       .reg    0fb8h, _op14&_bit01		
irqb:		.bit    0fb8h.0
ieb:		.bit    0fb8h.1

intb:		.reg	0fbah, _op14&_bit01 
irqw:		.bit    0fbah.0
iew:		.bit    0fbah.1

intb1:		.reg	0fbbh, _op14&_bit01 
irq3:       .bit    0fbbh.0
ie3:        .bit    0fbbh.1

intc:		.reg	0fbch, _op14&_bit01 	
irqt0:		.bit    0fbch.0
iet0:		.bit    0fbch.1

intd:		.reg	0fbdh, _op14&_bit01   	
irqg:		.bit    0fbdh.0
ieg:		.bit    0fbdh.1

inte:		.reg	0fbeh, _op14          
irq0:		.bit    0fbeh.0
ie0:		.bit    0fbeh.1
irq1:		.bit    0fbeh.2
ie1:		.bit    0fbeh.3

intf:		.reg	0fbfh, _op14&_bit01	    
irq2:		.bit    0fbfh.0
ie2:		.bit    0fbfh.1

bsc0:		.reg    0fc0h, _op148
bsc1:		.reg    0fc1h, _op14
bsc2:		.reg    0fc2h, _op148
bsc3:		.reg    0fc3h, _op14
clmod:		.reg    0fd0h,w, _op4
pne:        .reg    0fd6h,w, _op8
imod3:		.reg    0fd8h,w, _op8
pumod:		.reg    0fdch,w, _op8
cmod:       .reg    0fe0h, _op4
cmpcon:     .reg    0fe1h, _op14
          ;  .bit    0fe1h.1,r
          ;  .bit    0fe1h.3,r            
vldcon:     .reg    0fe2h, _op4
          ;  .bit    0fe2h.3,r
pmg0:       .reg    0fe6h,w, _op8
pmg1:       .reg    0fe8h,w, _op8

p0:	    	.reg    0ff0h, _op14
p2:		    .reg    0ff2h, _op148
p3:         .reg    0ff3h, _op14
p4:	    	.reg    0ff4h, _op148
p5:         .reg    0ff5h, _op14
p6:	    	.reg    0ff6h, _op148				 

;
; END OF 57P21708.REG
        .list   on
