        .list   off

;       57c22416 system register
;	2000/06/26 by j.k.lee Revision 0


;;;				


		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        4000h

        .ram_range      00h, 100h

;       System Registers
SP:		.reg    0f80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
WMOD:		.reg    0f88h,w, _op18&_bit3
		.bit	0f88h.3, r		; *** NEW: bit 3 of WMOD is read-only
LCNST:          .reg    0f8ah,w, _op8
LMOD:		.reg    0f8ch,w, _op8
LCON0:		.reg    0f8eh,w, _op4
LCON1:		.reg    0f8fh,w, _op4
TMOD0:		.reg    0f90h,w, _op18&_bit3
		.bit	0f90h.3, w		; *** NEW: bit 3 of WMOD is write-only

		.reg	0f92h, _op14&_bit2	; *** NEW: register 0f92h should be defined	 
TOE0:		.bit    0f92h.2

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:          .reg    0f98h,w, _op8
WDFLAG:		.reg    0f9ah,w, _op14&_bit3
WDTCF:          .bit	0f9ah.3, w

PASR:		.reg    0fa0h,w, _op8
KSR0:		.reg    0fa2h,w, _op4
KSR1:		.reg    0fa3h,w, _op4
KSR2:		.reg    0fa4h,w, _op4
KSR3:		.reg    0fa5h,w, _op4
TMOD1:		.reg    0fa6h,w, _op18&_bit3
                .bit	0fa6h.3, w
TCNT1:		.reg    0fa8h,r, _op8                
TREF1:		.reg    0faah,w, _op8
PSW:		.reg    0fb0h
IS1:		.bit    0fb0h.3
IS0:		.bit    0fb0h.2
EMB:		.bit    0fb0h.1
ERB:		.bit    0fb0h.0
C: 	        .bit    0fb1h.3

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:            .bit    0fb2h.3,w
PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMOD2:		.reg    0fb6h,w, _op4
SCMOD:		.reg    0fb7h,w, _op1

		.reg	0fb8h, _op14		; ***NEW: not defined in old reg file
IEB:		.bit    0fb8h.1
IRQB:		.bit    0fb8h.0

		.reg	0fbah, _op14&_bit01	; ***NEW: not defined in old reg file
IEW:		.bit    0fbah.1
IRQW:		.bit    0fbah.0

		.reg	0fbbh, _op14&_bit01		; ***NEW: not defined in old reg file
IET1:		.bit    0fbbh.1
IRQT1:		.bit    0fbbh.0

		.reg	0fbch, _op14&_bit01	; ***NEW: not defined in old reg file
IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

		.reg	0fbdh, _op14&_bit01	; ***NEW: not defined in old reg file
IEP0:		.bit    0fbdh.1
IRQP0:		.bit    0fbdh.0

		.reg	0fbeh, _op14		; ***NEW: not defined in old reg file
IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0

		.reg	0fbfh, _op14&_bit01	; ***NEW: not defined in old reg file
IE2:		.bit    0fbfh.1
IRQ2:		.bit    0fbfh.0

BSC0:		.reg    0fc0h
BSC1:		.reg    0fc1h
BSC2:		.reg    0fc2h
BSC3:		.reg    0fc3h

EMAR0:		.reg    0fcah, _op8
EMAR1:		.reg    0fcch, _op8
EMAR2:		.reg    0fceh, _op4

CLMOD:		.reg    0fd0h,w, _op4
EMCON:		.reg    0fd2h,w, _op18&_bit0
                .bit    0fd2h.0,r
EMDR0:		.reg    0fd4h, _op8                
PNE0:		.reg    0fe6h,w, _op8
PUMOD0:		.reg    0fe8h,w, _op8
PMG0:		.reg    0feah,w, _op8
PMG1:		.reg    0fech,w, _op8
PMG2:		.reg    0feeh,w, _op8

P0:		.reg    0ff0h
P1:		.reg    0ff1h
P4:		.reg    0ff4h
P5:		.reg    0ff5h
P6:		.reg    0ff6h
P7:		.reg    0ff7h


;       System Registers

sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
wmod:		.reg    0f88h,w, _op18&_bit3
;;;		.bit	0f88h.3, r		; *** new: bit 3 of wmod is read-only
lcnst:          .reg    0f8ah,w, _op8
lmod:		.reg    0f8ch,w, _op8
lcon0:		.reg    0f8eh,w, _op4
lcon1:		.reg    0f8fh,w, _op4
tmod0:		.reg    0f90h,w, _op18&_bit3
;;;;		.bit	0f90h.3, w		; *** new: bit 3 of wmod is write-only

;;;;;		.reg	0f92h, _op14&_bit2	; *** new: register 0f92h should be defined	 
toe0:		.bit    0f92h.2

tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:          .reg    0f98h,w, _op8
wdflag:		.reg    0f9ah,w, _op14&_bit3
wdtcf:          .bit	0f9ah.3, w

pasr:		.reg    0fa0h,w, _op8
ksr0:		.reg    0fa2h,w, _op4
ksr1:		.reg    0fa3h,w, _op4
ksr2:		.reg    0fa4h,w, _op4
ksr3:		.reg    0fa5h,w, _op4
tmod1:		.reg    0fa6h,w, _op18&_bit3
;;;;;                .bit	0fa6h.3, w
tcnt1:		.reg    0fa8h,r, _op8                
tref1:		.reg    0faah,w, _op8
psw:		.reg    0fb0h
is1:		.bit    0fb0h.3
is0:		.bit    0fb0h.2
emb:		.bit    0fb0h.1
erb:		.bit    0fb0h.0
c: 	        .bit    0fb1h.3

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:            .bit    0fb2h.3,w
pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imod2:		.reg    0fb6h,w, _op4
scmod:		.reg    0fb7h,w, _op1

;;;		.reg	0fb8h, _op14		; ***new: not defined in old reg file
ieb:		.bit    0fb8h.1
irqb:		.bit    0fb8h.0

;;;		.reg	0fbah, _op14&_bit01	; ***new: not defined in old reg file
iew:		.bit    0fbah.1
irqw:		.bit    0fbah.0

;;;		.reg	0fbbh, _op14&_bit01		; ***new: not defined in old reg file
iet1:		.bit    0fbbh.1
irqt1:		.bit    0fbbh.0

;;;		.reg	0fbch, _op14&_bit01	; ***new: not defined in old reg file
iet0:		.bit    0fbch.1
irqt0:		.bit    0fbch.0

;;;		.reg	0fbdh, _op14&_bit01	; ***new: not defined in old reg file
iep0:		.bit    0fbdh.1
irqp0:		.bit    0fbdh.0

;;;		.reg	0fbeh, _op14		; ***new: not defined in old reg file
ie1:		.bit    0fbeh.3
irq1:		.bit    0fbeh.2
ie0:		.bit    0fbeh.1
irq0:		.bit    0fbeh.0

;;;		.reg	0fbfh, _op14&_bit01	; ***new: not defined in old reg file
ie2:		.bit    0fbfh.1
irq2:		.bit    0fbfh.0

bsc0:		.reg    0fc0h
bsc1:		.reg    0fc1h
bsc2:		.reg    0fc2h
bsc3:		.reg    0fc3h

emar0:		.reg    0fcah, _op8
emar1:		.reg    0fcch, _op8
emar2:		.reg    0fceh, _op4

clmod:		.reg    0fd0h,w, _op4
emcon:		.reg    0fd2h,w, _op18&_bit0
;;;;                .bit    0fd2h.0,r
emdr0:		.reg    0fd4h, _op8                
pne0:		.reg    0fe6h,w, _op8
pumod0:		.reg    0fe8h,w, _op8
pmg0:		.reg    0feah,w, _op8
pmg1:		.reg    0fech,w, _op8
pmg2:		.reg    0feeh,w, _op8

p0:		.reg    0ff0h
p1:		.reg    0ff1h
p4:		.reg    0ff4h
p5:		.reg    0ff5h
p6:		.reg    0ff6h
p7:		.reg    0ff7h
;
; END OF 57C22416.REG
        .list   on


