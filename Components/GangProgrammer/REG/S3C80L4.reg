  .romsize	1000h
	.ram_range	00h,0C0h

;	System Registers
T0CNT:     .REG    0D0H,r
T0DATA:    .REG    0D1H
T0CON:     .REG    0D2H
BTCON:     .REG    0D3H
CLKCON:    .REG    0D4H
FLAGS: 	   .REG	   0D5h
RP0:	     .REG	   0D6h
RP1:	     .REG	   0D7h
SPL:	     .REG	   0D9h
IPH:	     .REG	   0DAh
IPL:	     .REG	   0DBh
IRQ:	     .REG	   0DCh
IMR:	     .REG	   0DDh
SYM:	     .REG	   0DEh
PP:	       .REG	   0DFh

;     Set1, Bank0

P0:        .REG    0E0H
P1:        .REG    0E1H
P2:        .REG    0E2H
P3:        .REG    0E3H
P0CONH:    .REG    0E4H
P0CONL:    .REG    0E5H
P0PUR:     .REG    0E6H
P1CONH:    .REG    0E8H
P1CONL:    .REG    0E9H
P1PUR:     .REG    0EAH
EXTINT:    .REG    0EBH
EXTPND:    .REG    0ECH
P2CONH:    .REG    0EEH
P2CONL:    .REG    0EFH
P2PUR:     .REG    0F0H
P3CON:     .REG    0F2H
P3PUR:     .REG    0F3H
STOPCON:   .REG    0FBH
BTCNT:     .REG    0FDH
EMT:       .REG    0FEH
IPR:       .REG    0FFH


; system register

t0cnt      .reg    0d0h,r
t0data     .reg    0d1h
t0con      .reg    0d2h
btcon      .reg    0d3h
clkcon     .reg    0d4h
flags:	   .reg	   0d5h
rp0:	     .reg	   0d6h
rp1:	     .reg	   0d7h
spl:	     .reg	   0d9h
iph:	     .reg	   0dah
ipl:	     .reg	   0dbh
irq:	     .reg	   0dch
imr:	     .reg	   0ddh
sym:	     .reg	   0deh
pp:	       .reg	   0dfh

;     Set1, Bank0

p0:        .reg    0e0h
p1:        .reg    0e1h
p2:        .reg    0e2h
p3:        .reg    0e3h
p0conh:    .reg    0e4h
p0conl:    .reg    0e5h
p0pur:     .reg    0e6h
p1conh:    .reg    0e8h
p1conl:    .reg    0e9h
p1pur:     .reg    0eah
extint:    .reg    0ebh
extpnd:    .reg    0ech
p2conh:    .reg    0eeh
p2conl:    .reg    0efh
p2pur:     .reg    0f0h
p3con:     .reg    0f2h
p3pur:     .reg    0f3h
stopcon:   .reg    0fbh
btcnt:     .reg    0fdh
emt:       .reg    0feh
ipr:       .reg    0ffh


;
; END OF  S3F80L4.REG
	.list	on
