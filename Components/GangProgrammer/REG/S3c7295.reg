        .list   off

;       57c2916 system register
;       Distribution : 01/25/98 by Yi,kyung-mi Rev.0
;       98/06/05 by YKM Rev1 : ram_range 00h, 0ffh  --> 00h, 100h
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Hyung Tae Kim 98.11.19
;;;				


		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        4000h

        .ram_range      00h, 100h

;       SYSTEM REGISTERS
SP:		.reg    0F80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
WMOD:		.reg    0f88h,w, _op18&_bit3
		.bit	0f88h.3, r		; *** NEW: bit 3 of WMOD is read only
LMOD:		.reg    0f8ch,w, _op8
LCON:		.reg    0f8eh,w, _op4
TMOD0:		.reg    0f90h,w, _op18&_bit3
		.reg	0f92h, _op14&_bit023	; *** NEW: register 0f92h should be defined	 
TOEB:		.bit    0f92h.3
TOE:		.bit    0f92h.2
BUZB:		.bit	0f92h.0

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:		.reg	0f98h,w, _op8

WDFLAG:		.reg	0f9ah,w, _op14&_bit3
WDTCF:      	.bit    0f9ah.3,w

PSW:		.reg    0fb0h
IS1:		.bit    0fb0h.3
IS0:		.bit    0fb0h.2
EMB:		.bit    0fb0h.1
ERB:		.bit    0fb0h.0
C:		.bit    0fb1h.3
;SC2:		.bit    0fb1h.2,r
;SC1:		.bit    0fb1h.1,r
;SC0:		.bit    0fb1h.0,r

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:        	.bit    0fb2h.3,w

PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
SCMOD:		.reg    0fb7h,w, _op1&_bit023

		.reg	0fb8h, _op14		; ***NEW: not defined in old reg file
IE4:		.bit    0fb8h.3
IRQ4:		.bit    0fb8h.2
IEB:		.bit    0fb8h.1
IRQB:		.bit    0fb8h.0

		.reg	0fbah, _op14&_bit01	; ***NEW: not defined in old reg file
IEW:		.bit    0fbah.1
IRQW:		.bit    0fbah.0

		.reg	0fbbh, _op14&_bit23	; ***NEW: not defined in old reg file
IEK:		.bit    0fbbh.3
IRQK:		.bit    0fbbh.2

		.reg	0fbch, _op14&_bit01	; ***NEW: not defined in old reg file
IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

		.reg	0fbeh, _op14		; ***NEW: not defined in old reg file
IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0

		.reg	0fbfh, _op14&_bit01	; ***NEW: not defined in old reg file
IE2:		.bit    0fbfh.1
IRQ2:		.bit    0fbfh.0

IMODK:		.reg	0fcch,w, _op8
IMOD2:		.reg	0fcfh,w, _op4
CLMOD:		.reg    0fd0h,w, _op4
PNE1:		.reg    0fdah,w, _op8
PUMOD0:		.reg    0fdch,w, _op8
PMG1:		.reg    0fe8h,w, _op8

P0:		.reg    0ff0h, _op14
P1:		.reg    0ff1h, _op14


;       system registers
sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
wmod:		.reg    0f88h,w, _op18&_bit3
lmod:		.reg    0f8ch,w, _op8
lcon:		.reg    0f8eh,w, _op4
tmod0:		.reg    0f90h,w, _op18&_bit3
toeb:		.bit    0f92h.3
toe:		.bit    0f92h.2
buzb:		.bit	0f92h.0
tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:		.reg	0f98h,w, _op8

wdflag:		.reg	0f9ah,w, _op14&_bit3
wdtcf:    	.bit    0f9ah.3,w

psw:		.reg    0fb0h
is1:		.bit    0fb0h.3
is0:		.bit    0fb0h.2
emb:		.bit    0fb0h.1
erb:		.bit    0fb0h.0
c:			.bit    0fb1h.3
;sc2:		.bit    0fb1h.2,r
;sc1:		.bit    0fb1h.1,r
;sc0:		.bit    0fb1h.0,r

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:       	.bit    0fb2h.3,w

pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
scmod:		.reg    0fb7h,w, _op1&_bit023

ie4:		.bit    0fb8h.3
irq4:		.bit    0fb8h.2
ieb:		.bit    0fb8h.1
irqb:		.bit    0fb8h.0
iew:		.bit    0fbah.1
irqw:		.bit    0fbah.0
iek:		.bit    0fbbh.3
irqk:		.bit    0fbbh.2
iet0:		.bit    0fbch.1
irqt0:		.bit    0fbch.0
ie1:		.bit    0fbeh.3
irq1:		.bit    0fbeh.2
ie0:		.bit    0fbeh.1
irq0:		.bit    0fbeh.0
ie2:		.bit    0fbfh.1
irq2:		.bit    0fbfh.0

imodk:		.reg	0fcch,w, _op8
imod2:		.reg	0fcfh,w, _op4
clmod:		.reg    0fd0h,w, _op4
pne1:		.reg    0fdah,w, _op8
pumod0:		.reg    0fdch,w, _op8
pmg1:		.reg    0fe8h,w, _op8

p0:		.reg    0ff0h, _op14
p1:		.reg    0ff1h, _op14

;
; END OF 57C2916.REG
        .list   on


