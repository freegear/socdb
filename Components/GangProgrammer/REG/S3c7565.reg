        .list   off

;       57c5616 system register
;       98/06/15 by YKM : Rev0
;;;
;;;	SAMPLE FILE FOR BIT OPERATION DEFINITION
;;;				WangGe 98.9.12
;;;				
;;;	revision date:		1998.9.23

		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        4000h

        .ram_range      00h, 100h


;       System Registers
SP:		.reg    0f80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
WMOD:		.reg    0f88h,w, _op18&_bit3
		.bit	0f88h.3, r		; *** NEW: bit 3 of WMOD is readonly
PASR:		.reg	0f8ah, _op8
LMOD:		.reg    0f8ch,w, _op8
LCON:		.reg    0f8eh,w, _op8
TMOD0:		.reg    0f90h,w, _op18&_bit3
				
		.reg	0f92h, _op14&_bit023	; *** NEW: register 0f92h should be defined	 
TOL2:		.bit	0f92h.0, r
TOE0:           .bit    0f92h.2
TOE1		.bit	0f92h.3

TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:		.reg	0f98h,w, _op8
WDFLAG:		.reg	0f9ah,w, _op14&_bit3
WDTCF:		.bit	0f9ah.3, w
TMOD1A:		.reg	0fa0h,w, _op18&_bit3
TMOD1B:		.reg	0fa2h,w, _op18&_bit3
TCNT1A:		.reg	0fa4h,r, _op8
TCNT1B:		.reg	0fa6h,r, _op8
TREF1A:		.reg	0fa8h,w, _op8
TREF1B:		.reg	0faah,w, _op8
DTMR:		.reg	0fach,w, _op8

PSW:		.reg    0fb0h
ERB:		.bit    0fb0h.0
EMB:		.bit    0fb0h.1
IS0:		.bit    0fb0h.2
IS1:		.bit    0fb0h.3


C:              .bit    0fb1h.3

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:            .bit    0fb2h.3,w

PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMODK:		.reg    0fb6h,w, _op4
SCMOD:		.reg    0fb7h,w, _op1&_bit023

		.reg	0fb8h, _op14		; ***NEW: not defined in old reg file
IRQB:		.bit    0fb8h.0
IEB:		.bit    0fb8h.1
IRQ4:		.bit	0fb8h.2
IE4:		.bit	0fb8h.3

		.reg	0fbah, _op14&_bit01	; ***NEW: not defined in old reg file
IRQW:		.bit    0fbah.0
IEW:		.bit    0fbah.1

		.reg	0fbbh, _op14		; ***NEW: not defined in old reg file
IRQT1:		.bit	0fbbh.0
IET1:		.bit	0fbbh.1
IRQK:		.bit	0fbbh.2
IEK:		.bit	0fbbh.3

		.reg	0fbch, _op14		; ***NEW: not defined in old reg file
IRQT0:		.bit	0fbch.0
IET0:		.bit	0fbch.1
IRQT2:		.bit	0fbch.2
IET2:		.bit	0fbch.3

		.reg	0fbdh, _op14&_bit01	; ***NEW: not defined in old reg file
IRQS:		.bit    0fbdh.0
IES:		.bit	0fbdh.1

		.reg	0fbeh, _op14		; ***NEW: not defined in old reg file
IRQ0:		.bit    0fbeh.0
IE0:		.bit    0fbeh.1
IRQ1:		.bit	0fbeh.2
IE1:		.bit	0fbeh.3

		.reg	0fbfh, _op14&_bit01	; ***NEW: not defined in old reg file
IRQ2:		.bit    0fbfh.0
IE2:		.bit    0fbfh.1

BSC0:		.reg    0fc0h
BSC1:		.reg    0fc1h
BSC2:		.reg    0fc2h
BSC3:		.reg    0fc3h
P7MOD:		.reg	0fceh, w, _op4

CLMOD:		.reg    0fd0h, w, _op4
CMOD:		.reg	0fd2h, _op8
CMPREG:		.reg	0fd4h,r, _op4
PNE1:		.reg	0fd6h,w, _op8
PNE2:		.reg	0fd8h,w, _op4

VLC1R:		.reg	0fd9h, _op14&_bit0
VLC1F:		.bit	0fd9h.0

IMOD2:		.reg	0fdah,w, _op4
PUMOD1:		.reg    0fdch,w, _op8
PUMOD2:		.reg	0fdeh,w, _op4

SMOD:		.reg	0fe0h,w, _op18&_bit3
SBUF:		.reg	0fe4h, _op8
PMG1:		.reg	0fe6h,w, _op8
PMG2:		.reg	0fe8h,w, _op8
PMG3:		.reg    0feah,w, _op8
PMG4:		.reg    0fech,w, _op8
PMG5:		.reg	0feeh,w, _op8

P0:		.reg    0ff0h, _op14
P1:		.reg    0ff1h,r, _op14
P2:		.reg    0ff2h, _op14
P3:		.reg	0ff3h, _op14
P4:		.reg    0ff4h
P5:		.reg    0ff5h
P6:		.reg    0ff6h
P7:		.reg    0ff7h
P8:		.reg    0ff8h
P9:		.reg    0ff9h
P10:		.reg    0ffah, _op14


;       system registers
sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
wmod:		.reg    0f88h,w, _op18&_bit3
pasr:		.reg	0f8ah, _op8
lmod:		.reg    0f8ch,w, _op8
lcon:		.reg    0f8eh,w, _op8
tmod0:		.reg    0f90h,w, _op18&_bit3
					 
tol2:		.bit	0f92h.0, r
toe0:           .bit    0f92h.2
toe1		.bit	0f92h.3

tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:		.reg	0f98h,w, _op8
wdflag:		.reg	0f9ah,w, _op14&_bit3
wdtcf:		.bit	0f9ah.3, w
tmod1a:		.reg	0fa0h,w, _op18&_bit3
tmod1b:		.reg	0fa2h,w, _op18&_bit3
tcnt1a:		.reg	0fa4h,r, _op8
tcnt1b:		.reg	0fa6h,r, _op8
tref1a:		.reg	0fa8h,w, _op8
tref1b:		.reg	0faah,w, _op8
dtmr:		.reg	0fach,w, _op8

psw:		.reg    0fb0h
erb:		.bit    0fb0h.0
emb:		.bit    0fb0h.1
is0:		.bit    0fb0h.2
is1:		.bit    0fb0h.3

c:              .bit    0fb1h.3

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:            .bit    0fb2h.3,w

pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imodk:		.reg    0fb6h,w, _op4
scmod:		.reg    0fb7h,w, _op1&_bit023

irqb:		.bit    0fb8h.0
ieb:		.bit    0fb8h.1
irq4:		.bit	0fb8h.2
ie4:		.bit	0fb8h.3

irqw:		.bit    0fbah.0
iew:		.bit    0fbah.1

irqt1:		.bit	0fbbh.0
iet1:		.bit	0fbbh.1
irqk:		.bit	0fbbh.2
iek:		.bit	0fbbh.3

irqt0:		.bit	0fbch.0
iet0:		.bit	0fbch.1
irqt2:		.bit	0fbch.2
iet2:		.bit	0fbch.3

irqs:		.bit    0fbdh.0
ies:		.bit	0fbdh.1

irq0:		.bit    0fbeh.0
ie0:		.bit    0fbeh.1
irq1:		.bit	0fbeh.2
ie1:		.bit	0fbeh.3

irq2:		.bit    0fbfh.0
ie2:		.bit    0fbfh.1

bsc0:		.reg    0fc0h
bsc1:		.reg    0fc1h
bsc2:		.reg    0fc2h
bsc3:		.reg    0fc3h
p7mod:		.reg	0fceh, w, _op4

clmod:		.reg    0fd0h, w, _op4
cmod:		.reg	0fd2h, _op8
cmpreg:		.reg	0fd4h,r, _op4
pne1:		.reg	0fd6h,w, _op8
pne2:		.reg	0fd8h,w, _op4

vlc1r:		.reg	0fd9h, _op14&_bit0
vlc1f:		.bit	0fd9h.0

imod2:		.reg	0fdah,w, _op4
pumod1:		.reg    0fdch,w, _op8
pumod2:		.reg	0fdeh,w, _op4

smod:		.reg	0fe0h,w, _op18&_bit3
sbuf:		.reg	0fe4h, _op8
pmg1:		.reg	0fe6h,w, _op8
pmg2:		.reg	0fe8h,w, _op8
pmg3:		.reg    0feah,w, _op8
pmg4:		.reg    0fech,w, _op8
pmg5:		.reg	0feeh,w, _op8

p0:		.reg    0ff0h, _op14
p1:		.reg    0ff1h,r, _op14
p2:		.reg    0ff2h, _op14
p3:		.reg	0ff3h, _op14
p4:		.reg    0ff4h
p5:		.reg    0ff5h
p6:		.reg    0ff6h
p7:		.reg    0ff7h
p8:		.reg    0ff8h
p9:		.reg    0ff9h
p10:		.reg    0ffah, _op14

;
; END OF 57C5616.REG
        .list   on
