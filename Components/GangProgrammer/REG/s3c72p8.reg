IEB:		.bit    0fb8h.1
IRQB:		.bit    0fb8h.0

IEW:		.bit    0fbah.1
IRQW:		.bit    0fbah.0

IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

IES:		.bit	0fbdh.1
IRQS:		.bit	0fbdh.0

IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0

IE2:		.bit    0fbfh.1
IRQ2:		.bit    0fbfh.0

BSC0:	.reg    0fc0h
