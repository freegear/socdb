P4:		.reg    0ff4h
P5:		.reg    0ff5h
P6:		.reg    0ff6h
P7:		.reg    0ff7h

;       System Registers
sp:		.reg    0f80h
bmod:	.reg    0f85h,w
bcnt:	.reg    0f86h,r
wmod:	.reg    0f88h,w
