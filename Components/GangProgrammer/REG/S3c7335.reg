;       57C3316 system register
;	08/05/99 by Lee, Chun-ja for 16bit Test Version 0
;
;;;	1st Revision : 07/30/99  by S.L.Ch'oi
;;;			-> C read only -> R/W			
;;;	2nd Revision : 08/06/99 by S.L.Ch'oi
;;;		1) ERROR 1: DUPLICATED LABEL
;;;		2) PLMOD0 ->PLMOD
;
;	3th Revision : 02/22/2002 by S.P.Hong AIJIsystem Co.,
;		1) LCON : only write ==> r/w [add]
;		2) SC0/SC1/SC2 skip ==> .bit 0fb0h.0~2,r [add]
;		3) IE0(0fbdh.1) ==> IE0(0fbeh.1) [add]
;		4) IFCFG/CEFG/ULFG skip ==> .bit 0fcah.1~3,r [add]
;		5) PNE7~10 [skip] ==> .bit 0fd6h.0~3,w [add]
;		   PNE11~13 [skip] ==> .bit 0fd7h.0~2,w [add]
;		6) PUR0~3 [skip] ==> .bit 0fdch.0~3,w [add]
;		   PUR4~6 [skip] ==> .bit 0fddh.0~2,w [add]
;		7) PUM0.0~3 [skip] ==> .bit 0fe6h.0~3,w [add]


        .romsize        4000h

        .ram_range      00h, 100h

;       System Registers
SP:		.reg    0f80h
BMOD:		.reg    0f85h,w
BCNT:		.reg    0f86h,r
WMOD:		.reg    0f88h,w
                	.bit    0f88h.3,r
LPOT:		.reg    0f8ah
