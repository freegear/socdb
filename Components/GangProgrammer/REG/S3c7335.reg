;PUM0.0:			.bit	0fe6h.0,w
;PUM0.1:			.bit	0fe6h.1,w
;PUM0.2:			.bit	0fe6h.2,w
;PUM0.3:			.bit	0fe6h.3,w
PMG1:		.reg    0fe8h,w
;PM2.0:			.bit	0fe8h.0,w
;PM2.1:			.bit	0fe8h.1,w
;PM2.2:			.bit	0fe8h.2,w
;PM2.3:			.bit	0fe8h.3,w
;PM3.0:			.bit	0fe9h.0,w
;PM3.1:			.bit	0fe9h.1,w
;PM3.2:			.bit	0fe9h.2,w
;PM3.3:			.bit	0fe9h.3,w
PMG2:		.reg    0feah,w
;PM4.0:			.bit	0feah.0,w
;PM4.1:			.bit	0feah.1,w
;PM4.2:			.bit	0feah.2,w
;PM4.3:			.bit	0feah.3,w
;PM5.0:			.bit	0febh.0,w
;PM5.1:			.bit	0febh.1,w
;PM5.2:			.bit	0febh.2,w
;PM5.3:			.bit	0febh.3,w
PMG3:		.reg    0fech,w
;PM6.0:			.bit	0fech.0,w
;PM6.1:			.bit	0fech.1,w
;PM6.2:			.bit	0fech.2,w
;PM6.3:			.bit	0fech.3,w
P0:		.reg    0ff0h
