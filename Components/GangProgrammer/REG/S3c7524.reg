IET1:		.bit    0fbbh.1
IRQT1:		.bit    0fbbh.0
IET0:		.bit    0fbch.1
IRQT0:		.bit    0fbch.0

IE1:		.bit    0fbeh.3
IRQ1:		.bit    0fbeh.2
IE0:		.bit    0fbeh.1
IRQ0:		.bit    0fbeh.0
IE2:		.bit    0fbfh.1
IRQ2:		.bit    0fbfh.0

BSC0:		.reg    0fc0h
