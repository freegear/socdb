PNE1:		.reg    0fdah,w
PUMOD1:		.reg    0fdch,w
PUMOD2:		.reg    0fdeh,w

PMG1:		.reg    0fe8h,w
PMG2:		.reg    0feah,w
PMG3:		.reg    0fech,w
PMG4:		.reg    0feeh,w

P1:		.reg    0ff1h,r
