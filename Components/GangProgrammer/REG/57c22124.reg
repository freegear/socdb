;     57c21124 system register
;     Release 05/27/98 by kmyi
;     98/06/05 by YKM Rev1 : ram_range 00h, 0ffh  --> 00h, 100h
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Hyung Tae Kim 98.11.19
;;;				
 

		.include "sasmopd.prd"			; **** NEW: include bit operateion def

      .romsize     6000h
      .ram_range   00h, 100h

;     System Registers
SP:              .reg	     0f80h, _op8
BMOD:            .reg        0f85h,w, _op14&_bit3
BCNT:            .reg        0f86h,r, _op8
WMOD:            .reg        0f88h,w, _op18&_bit3
        	 .bit	     0f88h.3,r			; *** NEW: bit 3 of WMOD is readonly

LCNST:           .reg        0f8ah,w, _op8
LMOD:            .reg        0f8ch,w, _op8
LCON:            .reg        0f8eh,w, _op4
TMOD0:           .reg        0f90h,w, _op18&_bit3

		 .reg	     0f92h, _op14&_bit023	; *** NEW: register 0f92h should be defined	 
TOE1:            .bit        0f92h.3
TOE0:            .bit        0f92h.2
TOL2:            .bit        0f92h.0,r

TCNT0:           .reg        0f94h,r, _op8
TREF0:           .reg        0f96h,w, _op8
WDMOD:           .reg        0f98h,w, _op8
WDFLAG:		 .reg	     0f9ah,w, _op14&_bit3
WDTCF:           .bit        0f9ah.3,w

TMOD1A:          .reg        0fa0h,w, _op18&_bit3
TMOD1B:          .reg        0fa2h,w, _op18&_bit3
TCNT1A:          .reg        0fa4h,r, _op8
TCNT1B:          .reg        0fa6h,r, _op8
TREF1A:          .reg        0fa8h,w, _op8
TREF1B:          .reg        0faah,w, _op8

PSW:             .reg        0fb0h
IS1:             .bit        0fb0h.3
IS0:             .bit        0fb0h.2
EMB:             .bit        0fb0h.1
ERB:             .bit        0fb0h.0
C:               .bit        0fb1h.3
;SC2:             .bit        0fb1h.2,r
;SC1:             .bit        0fb1h.1,r
;SC0:             .bit        0fb1h.0,r
							  
IPR:             .reg        0fb2h,w, _op14&_bit3
IME:             .bit        0fb2h.3,w
PCON:            .reg        0fb3h,w, _op4
IMOD0:           .reg        0fb4h,w, _op4
IMOD1:           .reg        0fb5h,w, _op4
IMODK:           .reg        0fb6h,w, _op4
SCMOD:           .reg        0fb7h,w, _op1&_bit023
					
		 .reg	     0fb8h, _op14		; ***NEW: not defined in old reg file		  
IE4:             .bit        0fb8h.3
IRQ4:            .bit        0fb8h.2
IEB:             .bit        0fb8h.1
IRQB:            .bit        0fb8h.0

		 .reg	     0fbah, _op14&_bit01	; ***NEW: not defined in old reg file		  
IEW:             .bit        0fbah.1
IRQW:            .bit        0fbah.0

		 .reg	     0fbbh, _op14		; ***NEW: not defined in old reg file		  
IEK:             .bit        0fbbh.3
IRQK:            .bit        0fbbh.2
IET1:            .bit        0fbbh.1
IRQT1:           .bit        0fbbh.0

		 .reg	     0fbch, _op14		; ***NEW: not defined in old reg file		  
IET2:            .bit        0fbch.3
IRQT2:           .bit        0fbch.2
IET0:            .bit        0fbch.1
IRQT0:           .bit        0fbch.0

		 .reg	     0fbdh, _op14&_bit01	; ***NEW: not defined in old reg file		  
IES:             .bit        0fbdh.1
IRQS:            .bit        0fbdh.0

		 .reg	     0fbeh, _op14		; ***NEW: not defined in old reg file		  
IE1:             .bit        0fbeh.3
IRQ1:            .bit        0fbeh.2
IE0:             .bit        0fbeh.1
IRQ0:            .bit        0fbeh.0

		 .reg	     0fbfh, _op14&_bit01	; ***NEW: not defined in old reg file		  
IE2:             .bit        0fbfh.1
IRQ2:            .bit        0fbfh.0

BSC0:            .reg        0fc0h
BSC1:            .reg        0fc1h
BSC2:            .reg        0fc2h
BSC3:            .reg        0fc3h

P4MOD:           .reg        0fceh,w, _op4
IMOD2:           .reg        0fcfh,w, _op4
CLMOD1:          .reg        0fd0h,w, _op4
CLMOD2:          .reg        0fd1h,w, _op4
CMOD:            .reg        0fd2h, _op8
CMPREG:          .reg        0fd4h,r, _op4

PNE1:            .reg        0fd6h,w, _op8
PNE2:            .reg        0fd8h,w, _op8
PNE3:            .reg        0fdah,w, _op8
PUMOD1:          .reg        0fdch,w, _op8
PUMOD2:          .reg        0fdeh,w, _op8
SMOD:            .reg        0fe0h,w, _op18&_bit3
PMG1:            .reg        0fe2h,w, _op8
SBUF:            .reg        0fe4h, _op8
PMG2:            .reg        0fe6h,w, _op8
PMG3:            .reg        0fe8h,w, _op8
PMG4:            .reg        0feah,w, _op8
PMG5:            .reg        0fech,w, _op8
PMG6:            .reg        0feeh,w, _op8

P0:              .reg        0ff0h, _op14
P1:              .reg        0ff1h,r, _op14
P2:              .reg        0ff2h, _op14
P3:              .reg        0ff3h, _op14
P4:              .reg        0ff4h, _op14&_bit012

P6:              .reg        0ff6h
P7:              .reg        0ff7h
P8:              .reg        0ff8h
P9:              .reg        0ff9h
P10:             .reg        0ffah
P11:             .reg        0ffbh
P12:             .reg        0ffch
P13:             .reg        0ffdh

;     system registers
sp:              .reg	     0f80h, _op8
bmod:            .reg        0f85h,w, _op14&_bit3
bcnt:            .reg        0f86h,r, _op8
wmod:            .reg        0f88h,w, _op18&_bit3
lcnst:           .reg        0f8ah,w, _op8
lmod:            .reg        0f8ch,w, _op8
lcon:            .reg        0f8eh,w, _op4
tmod0:           .reg        0f90h,w, _op18&_bit3
							  
toe1:            .bit        0f92h.3
toe0:            .bit        0f92h.2
tol2:            .bit        0f92h.0,r

tcnt0:           .reg        0f94h,r, _op8
tref0:           .reg        0f96h,w, _op8
wdmod:           .reg        0f98h,w, _op8
wdflag:		 .reg	     0f9ah,w, _op14&_bit3
wdtcf:           .bit        0f9ah.3,w

tmod1a:          .reg        0fa0h,w, _op18&_bit3
tmod1b:          .reg        0fa2h,w, _op18&_bit3
tcnt1a:          .reg        0fa4h,r, _op8
tcnt1b:          .reg        0fa6h,r, _op8
tref1a:          .reg        0fa8h,w, _op8
tref1b:          .reg        0faah,w, _op8
							  
psw:             .reg        0fb0h
is1:             .bit        0fb0h.3
is0:             .bit        0fb0h.2
emb:             .bit        0fb0h.1
erb:             .bit        0fb0h.0
c:               .bit        0fb1h.3
;sc2:             .bit        0fb1h.2,r
;sc1:             .bit        0fb1h.1,r
;sc0:             .bit        0fb1h.0,r

ipr:             .reg        0fb2h,w, _op14&_bit3
ime:             .bit        0fb2h.3,w
pcon:            .reg        0fb3h,w, _op4
imod0:           .reg        0fb4h,w, _op4
imod1:           .reg        0fb5h,w, _op4
imodk:           .reg        0fb6h,w, _op4
scmod:           .reg        0fb7h,w, _op1&_bit023
							  
ie4:             .bit        0fb8h.3
irq4:            .bit        0fb8h.2
ieb:             .bit        0fb8h.1
irqb:            .bit        0fb8h.0

iew:             .bit        0fbah.1
irqw:            .bit        0fbah.0

iek:             .bit        0fbbh.3
irqk:            .bit        0fbbh.2
iet1:            .bit        0fbbh.1
irqt1:           .bit        0fbbh.0

iet2:            .bit        0fbch.3
irqt2:           .bit        0fbch.2
iet0:            .bit        0fbch.1
irqt0:           .bit        0fbch.0

ies:             .bit        0fbdh.1
irqs:            .bit        0fbdh.0

ie1:             .bit        0fbeh.3
irq1:            .bit        0fbeh.2
ie0:             .bit        0fbeh.1
irq0:            .bit        0fbeh.0
							  
ie2:             .bit        0fbfh.1
irq2:            .bit        0fbfh.0

bsc0:            .reg        0fc0h
bsc1:            .reg        0fc1h
bsc2:            .reg        0fc2h
bsc3:            .reg        0fc3h

p4mod:           .reg        0fceh,w, _op4
imod2:           .reg        0fcfh,w, _op4
clmod1:          .reg        0fd0h,w, _op4
clmod2:          .reg        0fd1h,w, _op4
cmod:            .reg        0fd2h, _op8
cmpreg:          .reg        0fd4h,r, _op4

pne1:            .reg        0fd6h,w, _op8
pne2:            .reg        0fd8h,w, _op8
pne3:            .reg        0fdah,w, _op8
pumod1:          .reg        0fdch,w, _op8
pumod2:          .reg        0fdeh,w, _op8
smod:            .reg        0fe0h,w, _op18&_bit3
pmg1:            .reg        0fe2h,w, _op8
sbuf:            .reg        0fe4h, _op8
pmg2:            .reg        0fe6h,w, _op8
pmg3:            .reg        0fe8h,w, _op8
pmg4:            .reg        0feah,w, _op8
pmg5:            .reg        0fech,w, _op8
pmg6:            .reg        0feeh,w, _op8

p0:              .reg        0ff0h, _op14
p1:              .reg        0ff1h,r, _op14
p2:              .reg        0ff2h, _op14
p3:              .reg        0ff3h, _op14
p4:              .reg        0ff4h, _op14&_bit012

p6:              .reg        0ff6h
p7:              .reg        0ff7h
p8:              .reg        0ff8h
p9:              .reg        0ff9h
p10:             .reg        0ffah
p11:             .reg        0ffbh
p12:             .reg        0ffch
p13:             .reg        0ffdh




;
; END OF 57C21124.REG
        .list       on
