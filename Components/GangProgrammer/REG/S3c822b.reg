ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh

;       set 1, bank 0
p0:             .reg    0e0h
p1:             .reg    0e1h
