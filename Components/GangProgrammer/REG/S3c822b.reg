STPCON:         .reg    0FBh
BTCNT:          .reg    0FDh,r
EMT:            .reg    0FEh
IPR:            .reg    0FFh

;	Set 1, Bank 1
TACNT:          .reg    0E0h,r
TBCNT:          .reg    0E1h,r
TADATA:         .reg    0E2h
TBDATA:         .reg    0E3h
