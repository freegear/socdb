UARTCON:        .reg    0EFh
UARTPND:        .reg    0F0h
BRDATA:         .reg    0F1h
ADDATAH:        .reg    0F2h,r
ADDATAL:        .reg    0F3h,r
ADCON:          .reg    0F4h
VLDCON:         .reg    0F5h




;       system registers
t0cnt:          .reg    0d0h,r
t0data:         .reg    0d1h
t0con:          .reg    0d2h
btcon:          .reg    0d3h
clkcon:         .reg    0d4h
