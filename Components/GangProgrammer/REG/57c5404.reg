        .list   off

;       57c5404 system register
;	Initial version 07/16/98   by K.M.Yi
;;;
;;;	THE REG FILE FOR BIT OPERATION DEFINITION
;;;				Hyung Tae Kim 98.11.19
;;;				


		.include "sasmopd.prd"		; **** NEW: include bit operateion def

        .romsize        1000h
 

        .ram_range      00h, 100h


;       System Registers

SP:		.reg    0f80h, _op8
BMOD:		.reg    0f85h,w, _op14&_bit3
BCNT:		.reg    0f86h,r, _op8
BUZMOD:		.reg    0f88h,w, _op4
TMOD0:		.reg    0f90h,w, _op18&_bit3

		.reg	0f92h, _op14&_bit2	; *** NEW: register 0f92h should be defined	 
TOE0:    	.bit    0f92h.2
TCNT0:		.reg    0f94h,r, _op8
TREF0:		.reg    0f96h,w, _op8
WDMOD:		.reg	0f98h,w, _op8
WDFLAG:		.reg	0f9ah,w, _op1&_bit3
WDTCF:		.bit	0f9ah.3,w

PSW:		.reg    0fb0h
ERB:		.bit    0fb0h.0
EMB:		.bit    0fb0h.1
IS0:		.bit    0fb0h.2
IS1:		.bit    0fb0h.3

C:        	.bit    0fb1h.3

IPR:		.reg    0fb2h,w, _op14&_bit3
IME:		.bit    0fb2h.3,w

PCON:		.reg    0fb3h,w, _op4
IMOD0:		.reg    0fb4h,w, _op4
IMOD1:		.reg    0fb5h,w, _op4
IMODK:		.reg    0fb6h,w, _op4

		.reg	0fb8h, _op14&_bit01	; ***NEW: not defined in old reg file
IRQB:		.bit    0fb8h.0
IEB:		.bit    0fb8h.1

		.reg	0fbch, _op14&_bit01	; ***NEW: not defined in old reg file
IRQT0:		.bit    0fbch.0
IET0:		.bit    0fbch.1

		.reg	0fbeh, _op14		; ***NEW: not defined in old reg file
IRQ0:		.bit    0fbeh.0
IE0:		.bit    0fbeh.1
IRQ1:		.bit    0fbeh.2
IE1:		.bit    0fbeh.3

		.reg	0fbfh, _op14&_bit01	; ***NEW: not defined in old reg file
IRQK:		.bit    0fbfh.0
IEK:		.bit    0fbfh.1

BSC0:		.reg    0fc0h
BSC1:		.reg    0fc1h
BSC2:		.reg    0fc2h
BSC3:		.reg    0fc3h

CLMOD:		.reg    0fd0h,w, _op4
DAMOD:		.reg	0fd5h,w, _op14&_bit0
DADATA:		.reg	0fd6h, _op8

PNE:		.reg	0fdah,w, _op8
PUMOD:		.reg	0fdch,w, _op8
PMG1:		.reg    0fe8h,w, _op8
PMG2:		.reg    0feah,w, _op8
PMG3:		.reg	0fech,w, _op8

P0:		.reg    0ff0h, _op14
P1:		.reg    0ff1h, _op14
P2:		.reg    0ff2h, _op14&_bit0
P4:		.reg    0ff4h
P5:		.reg    0ff5h
 

;       system registers

sp:		.reg    0f80h, _op8
bmod:		.reg    0f85h,w, _op14&_bit3
bcnt:		.reg    0f86h,r, _op8
buzmod:		.reg    0f88h,w, _op4
tmod0:		.reg    0f90h,w, _op18&_bit3
toe0:      	.bit    0f92h.2
tcnt0:		.reg    0f94h,r, _op8
tref0:		.reg    0f96h,w, _op8
wdmod:		.reg	0f98h,w, _op8
wdflag:		.reg	0f9ah,w, _op1&_bit3
wdtcf:		.bit	0f9ah.3,w

psw:		.reg    0fb0h
erb:		.bit    0fb0h.0
emb:		.bit    0fb0h.1
is0:		.bit    0fb0h.2
is1:		.bit    0fb0h.3

c:          .bit    0fb1h.3

ipr:		.reg    0fb2h,w, _op14&_bit3
ime:		.bit    ipr.3,w

pcon:		.reg    0fb3h,w, _op4
imod0:		.reg    0fb4h,w, _op4
imod1:		.reg    0fb5h,w, _op4
imodk:		.reg    0fb6h,w, _op4

irqb:		.bit    0fb8h.0
ieb:		.bit    0fb8h.1

irqt0:		.bit    0fbch.0
iet0:		.bit    0fbch.1

irq0:		.bit    0fbeh.0
ie0:		.bit    0fbeh.1
irq1:		.bit    0fbeh.2
ie1:		.bit    0fbeh.3

irqk:		.bit    0fbfh.0
iek:		.bit    0fbfh.1

bsc0:		.reg    0fc0h
bsc1:		.reg    0fc1h
bsc2:		.reg    0fc2h
bsc3:		.reg    0fc3h

clmod:		.reg    0fd0h,w, _op4
damod:		.reg	0fd5h,w, _op14&_bit0
dadata:		.reg	0fd6h, _op8

pne:		.reg	0fdah,w, _op8
pumod:		.reg	0fdch,w, _op8
pmg1:		.reg    0fe8h,w, _op8
pmg2:		.reg    0feah,w, _op8
pmg3:		.reg	0fech,w, _op8

p0:		.reg    0ff0h, _op14
p1:		.reg    0ff1h, _op14
p2:		.reg    0ff2h, _op14&_bit0
p4:		.reg    0ff4h
p5:		.reg    0ff5h


;
; END OF 57C5404.REG
        .list on

