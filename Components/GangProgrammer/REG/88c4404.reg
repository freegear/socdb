P4CONH:         .reg    0F6h
P4CONL:         .reg    0F7h
P5CON:          .reg    0F8h
P4INT:          .reg    0F9h
T1CON:          .reg    0FAh
T1MOD:          .reg    0FBh
P3INT:          .reg    0FCh
P3PND:          .reg    0FDh
EMT:            .reg    0FEh
IPR:            .reg    0FFh
;
;       Set 1, Bank 1
ADIN:           .reg    0F9h,r
ADOUT:          .reg    0FAh,r
ADCON:          .reg    0FBh
PWMCON:         .reg    0FCh
PWM1:           .reg    0FDh
PWM0:           .reg    0FEh
PWMCAP:         .reg    0FFh
;

;       System Registers
tch:            .reg    0d0h
tcl:            .reg    0d1h
tdh:            .reg    0d2h
tdl:            .reg    0d3h
p4pnd:          .reg    0d4h
flags:          .reg    0d5h
rp0:            .reg    0d6h
rp1:            .reg    0d7h
sph:            .reg    0d8h
spl:            .reg    0d9h
iph:            .reg    0dah
ipl:            .reg    0dbh
irq:            .reg    0dch,r
imr:            .reg    0ddh
sym:            .reg    0deh
pp:             .reg    0dfh
;
;       Set 1, Bank 0
p0:             .reg    0e0h
p1:             .reg    0e1h
p2:             .reg    0e2h
p3:             .reg    0e3h
p4:             .reg    0e4h
p5:             .reg    0e5h
p6:             .reg    0e6h
