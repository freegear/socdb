`timescale 1ns / 1ps

module  CI12338tl
                     ( vdda              ,
                       vssa              ,
                       vddp              ,
                       vssp              ,
                       vdds              ,
                       vsss              ,
                       dp                ,
                       dn                ,
                       sysclock          ,
                       sieclock          ,
                       databus16_8       ,
                       datain            ,
                       txvalid           ,
                       txvalidh          ,
                       txready           ,
                       dataout           ,
                       rxvalid           ,
                       rxvalidh          ,
                       rxactive          ,
                       rxerror           ,
                       reset             ,
                       suspend           ,
                       xcvrsel           ,
                       termsel           ,
                       opmode            ,
                       linestate         ,
                       rrefext           ,
                       vload             ,
                       vcontrol          ,
                       vstatus           ,
                       scanmode          ,
                       scanclk           ,
                       scanina           ,
                       scaninb           ,
                       scanen            ,
                       scanouta          ,
                       scanoutb          ,
                       hostdisconnect    ,
                       txsezero          ,
                       fslsserialmode    ,
                       txenablez         ,
                       txdata            ,
                       txbitstuffenable  ,
                       txbitstuffenableH ,
                       dnpulldown        ,
                       dppulldown        ,
                       rxdp              ,
                       rxdm              ,
                       rxrcv             ,
                       conf1             ,
                       onbist            ,
                       gpanaio           ,
                       vbg               ,
                       ibiascp           ,
                       setin12
                      );

inout         vdda              ;
inout         vssa              ;
inout         vddp              ;
inout         vssp              ;
inout         vdds              ;
inout         vsss              ;
inout         dp                ;
inout         dn                ;
input         sysclock          ;
output        sieclock          ;
input         databus16_8       ;
input  [15:0] datain            ;
input         txvalid           ;
input         txvalidh          ;
output        txready           ;
output [15:0] dataout           ;
output        rxvalid           ;
output        rxvalidh          ;
output        rxactive          ;
output        rxerror           ;
input         reset             ;
input         suspend           ;
input  [1:0]  xcvrsel           ;
input         termsel           ;
input  [1:0]  opmode            ;
output [1:0]  linestate         ;
inout         rrefext           ;
input         vload             ;
input  [3:0]  vcontrol          ;
output [7:0]  vstatus           ;
input         scanmode          ;
input         scanclk           ;
input         scanina           ;  // Scan input for scan-chain A
input         scaninb           ;  // Scan input for scan-chain B
input         scanen            ;
output        scanouta          ;  // Scan output for scan-chain A
output        scanoutb          ;  // Scan output for scan-chain B
output        hostdisconnect    ;
input         txsezero          ;
input         fslsserialmode    ;
input         txenablez         ;
input         txdata            ;
input         txbitstuffenable  ;
input         txbitstuffenableH ;
input         dnpulldown        ;
input         dppulldown        ;
output        rxdp              ;
output        rxdm              ;
output        rxrcv             ;
input         conf1             ;
input         onbist            ;
inout         gpanaio           ;
output        vbg               ;
output        ibiascp           ;
input         setin12           ;


wire [15:0]   dataout           ;
wire [1:0]    linestate         ;


