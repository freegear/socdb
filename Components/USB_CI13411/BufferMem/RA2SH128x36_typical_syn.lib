		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.171
		clock	: true;
		min_pulse_width_low	: 0.171;
		min_pulse_width_high	: 0.062;
		min_period		: 0.944;
		max_transition		: 1.000;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.612")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("44.755, 44.755")
        		}
        		fall_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("66.613, 66.613")
			}	
			fall_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH128x36_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.039, 0.039")
                 }
         }
	}

