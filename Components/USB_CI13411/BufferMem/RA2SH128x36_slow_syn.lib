		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.164
		clock	: true;
		min_pulse_width_low	: 0.284;
		min_pulse_width_high	: 0.104;
		min_period		: 1.581;
		max_transition		: 1.500;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("1.001")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("34.180, 34.180")
        		}
        		fall_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("52.808, 52.808")
			}	
			fall_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH128x36_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.029, 0.029")
                 }
         }
	}

