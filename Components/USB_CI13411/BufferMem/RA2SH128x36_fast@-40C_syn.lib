		}	}
        }

	pin(CLKA) {
		direction : input;
		capacitance : 0.180
		clock	: true;
		min_pulse_width_low	: 0.108;
		min_pulse_width_high	: 0.041;
		min_period		: 0.614;
		max_transition		: 0.750;
		timing() {
			related_pin	: "CLKB" ;
			timing_type	: setup_rising ;
			rise_constraint(scalar) {
				values ("0.406")
		}	}
		internal_power(){
			when : "!CENA & WENA";
        		rise_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("55.669, 55.669")
        		}
        		fall_power(RA2SH128x36_passive_energy_template_1x2) {
				index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
        		}
		}
		internal_power(){
			when : "!CENA & !WENA";
			rise_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
	    			values ("83.575, 83.575")
			}	
			fall_power(RA2SH128x36_passive_energy_template_1x2) {
	    			index_1 ("0.0 1.0");
            			values ("0.0, 0.0")
			}	
		}
         internal_power(){
                 when : "CENA";
                 power(RA2SH128x36_passive_energy_template_1x2) {
                         index_1 ("0.0 1.0");
                         values ("0.037, 0.037")
                 }
         }
	}

