///////////////////////////////////////////////////////////////////////////
// TASKS for ETHERNET model
// 
//  write_txdesc: Write TX descriptor
///////////////////////////////////////////////////////////////////////////

task write_txdesc;
input [19:0] base_addr;
input [7:0]  write_ptr;
input [31:0] start_ptr;
input [31:0] pac_length;
begin

  write ({base_addr,write_ptr,4'h0},start_ptr,2'b10);
  write ({base_addr,write_ptr,4'h4},pac_length,2'b10);
  write ({base_addr,write_ptr,4'h8},32'hffff_ffff,2'b10);

end
endtask
