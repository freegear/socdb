// --=========================================================================--
// Module Name : AHB Bus Decoder
// Date        : Jan 24, 2003
// Author      : Mark Ryoo
// --=========================================================================--
 
module Decoder (
  HRESETn, 
  HADDR, 
  HSELSDRAM,
  HSELRetry, 
  HSELLM,
  HSELDefault
);

 
  input         HRESETn;
  input [31:0]  HADDR;

  output        HSELSDRAM;   // SDRAM
  output        HSELRetry;   // External Memory
  output        HSELLM;      // LM
  output        HSELDefault; // Default Slave
 
//------------------------------------------------------------------------------
// AHB address decoding for slave selection and read data multiplexer control
//------------------------------------------------------------------------------
// Address decoding of HADDR is performed continuously.
// Address map is:
//
// 0x0000_0000 - 0xBFFF_FFFF                              : Default
// 0x8000_0000 - 0x9FFF_FFFF                              : SDRAM
// 0xC000_0000 - 0xCFFF_FFFF                              : LM
// 0xD000_0000 - 0xDFFF_FFFF                              : Retry Slave
// 0xE000_0000 - 0xFFFF_FFFF                              : Default
//

