
`timescale 1ns/1ps
 
module RetrySlave (HCLK, HRESETn, HADDR, HTRANS, HWRITE, HSIZE, HWDATA,
                   HSELRetry, HREADY, HRDATA, HREADYOUT, HRESP,
                   SCANENABLE, SCANINHCLK, SCANOUTHCLK);
 
  input         HCLK;
  input         HRESETn;
  input [31:0]  HADDR;
  input [1:0]   HTRANS;
  input         HWRITE;
  input [2:0]   HSIZE;
  input [31:0]  HWDATA;
  input         HSELRetry;
  input         HREADY;
  input         SCANENABLE;
  input         SCANINHCLK;

  output [31:0] HRDATA;
  output        HREADYOUT;
  output [1:0]  HRESP;
  output        SCANOUTHCLK;
  
`protected
