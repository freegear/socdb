--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis script for AMBA timing parameters.
--           Located in the synopsys/scr_common directory.
--           Called by master compile script.
------------------------------------------------------------------------------*/

/*** This file contains a generic set of parameters for synthesis of        ***/
/*** AHB/APB modules.                                                       ***/
/***                                                                        ***/
/*** A number of timing parameters are defined for each AMBA module and     ***/
/*** these use the following nomenclature:                                  ***/
/***                                                                        ***/
/***  Tis - Input setup time                                                ***/
/***  Tih - Input hold time                                                 ***/
/***  Tov - Output valid time                                               ***/
/***  Toh - Output hold time                                                ***/
/***                                                                        ***/
/*** For the purpose of synthesis this script takes a target set of         ***/
/*** parameters and converts them into those suitable to constrain the      ***/
/*** synthesis. For synthesis the following nomenclature is used:           ***/
/***                                                                        ***/
/***  Tidmax - Input delay maximum                                          ***/
/***  Tidmin - Input delay minimum                                          ***/
/***  Todmax - Output delay maximum                                         ***/
/***  Todmin - Output delay minimum                                         ***/
/***                                                                        ***/
/*** Conversion between the target module parameters and the synthesis      ***/
/*** constraints is done using the following equations:                     ***/
/***                                                                        ***/
/***  Tidmax = tclk * (1 - Tis)                                             ***/
/***  Tidmin = Tih                                                          ***/
/***  Todmax = tclk * (1 - Tov)                                             ***/
/***  Todmin = Toh                                                          ***/
/***                                                                        ***/
/*** The system timing budget is split as follows:                          ***/
/***                                                                        ***/
/*** Point to point signals:                                                ***/
/***  40% output valid   Todmax = 0.6                                       ***/
/***  50% input setup    Tidmax = 0.5                                       ***/
/***  10% spare slack                                                       ***/
/***                                                                        ***/
/*** Multiplexed signals:                                                   ***/
/***  40% output valid   Todmax = 0.6                                       ***/
/***  15% multiplexer                                                       ***/
/***  30% input setup    Tidmax = 0.7                                       ***/
/***  15% spare slack                                                       ***/
/***                                                                        ***/
/*** The timing parameters are only defined as Tidmax and Todmax, taking    ***/
/*** into account the multiplexer delays and 15% slack.                     ***/

/* Two signals paths do not use the default timings: */
/*  - HADDR to HSEL     */
/*  - PRDATA to HRDATA. */

/* As HSEL is generated from HADDR, which passes through the M2S */
/* multiplexer and the Decoder, it would be valid relatively late in the */
/* cycle. So to simplify the system timing, the default slack of 15% on */
/* all signals is used for the Decoder to slave path, so tidmaxhsel is
/* valid after 70% of the cycle, the same as all other AHB inputs. */
/* Similarly for the PRDATA to HRDATA path, the 15% signal slack is used */
/* by MuxP2B */

/* If extra time is required, the 15% slack included on the address timing */
/* may also be removed. */

/* The path from PRDATA on the APB to HRDATA on the AHB is long, including: */
/*  - output delay of APB slave          */
/*  - multiplexer delay of MuxP2B        */
/*  - bridge delay from PRDATA to HRDATA */
/*  - multiplexer delay of MuxS2M        */
/*  - slack on both multiplexer paths.   */
/* To reduce the input timing on HRDATA, the default slack of 15% on the two */
/* multiplexer paths is removed, and the delay through the APB bridge
/* set to 0 (since it is not required - PRDATA can be connected */
/* directly to MuxM2S instead) therefore allowing: */
/*  - 40% APB slave output delay */
/*  - 15% MuxP2B delay           */
/*  - 0%  bridge delay           */
/*  - 15% MuxS2M delay           */
/* giving a total HRDATA input delay of 70%. */

/******************************************************************************/
/* CLOCK PARAMETERS                                                           */
/******************************************************************************/

/*** tclk is the period of HCLK/PCLK and by default all other parameters    ***/
/*** are automatically defined from this parameter.                         ***/

tclk_period = get_unix_variable("SYNTH_TCLK_PERIOD")

if (tclk_period == "") {
  /* HIGH phase of clock */
  /*tclkh = 5.0   /* 5ns phase = 100MHz clock */
  tclkh = 3.75   /* 3.75ns phase = 133MHz clock */
  /*tclkh = 3.0   /* 3ns phase = 166MHz clock */
} else {
  tclkh = tclk_period / 2
}


/* Clock LOW phase equals clock HIGH phase */
tclkl = tclkh

/* Clock period of HCLK and PCLK */
/* tclk  = tclkl + tclkh */
tclk_full  = tclkl + tclkh
tclk  = tclk_full * 0.975 /* Period reduced by 2.5% instead of */
                          /* setting skew to 2.5% of cycle */

/* Clock skew */
tpskew = 0.01 * tclk_full /* plus  skew set to 1% of period - for hold checks  */
/* tmskew = 0.025 * tclk_full /* minus skew set to 2.5% of period - for setup checks */
tmskew = 0.0 /* minus skew set to 0 and period reduced - for setup checks */

/* Max and Min hold times applied to the input and output ports respectively */
/* These values should be changed if a default hold delay is required. */
tholdmax =  0.00 * tclk /* max  0% clock period set for input  hold */
tholdmin = -0.00 * tclk /* min -0% clock period set for output hold */

/******************************************************************************/
/* AHB PARAMETERS                                                             */
/******************************************************************************/
/* This section defines the timing parameters for all standard AHB signals. */

/* Only HADDR, HTRANS, HWRITE, HSIZE, HBURST, HPROT, HWDATA, HRDATA,
/* HRESP and HREADY pass through the central multiplexers */


/*** Input setup and hold times ***/

/* Slave inputs from Master */
tidmaxhaddr     = tclk * 0.7
tidmaxhtrans    = tclk * 0.7
tidmaxhwrite    = tclk * 0.7
tidmaxhsize     = tclk * 0.7
tidmaxhburst    = tclk * 0.7
tidmaxhprot     = tclk * 0.7
tidmaxhwdata    = tclk * 0.7

/* Decoder input from Master */
/* The HADDR path from the Master to the Decoder does not include the
/* usual 15% slack */
tidmaxhaddrdec     = tclk * 0.55

/* Arbiter inputs from Master - point-to-point */
tidmaxhbusreq   = tclk * 0.5
tidmaxhlock     = tclk * 0.5

/* Master inputs from Arbiter - point-to-point */
tidmaxhgrant    = tclk * 0.5
tidmaxhmaster   = tclk * 0.5

/* Slave input from Arbiter */
tidmaxhmastlock = tclk * 0.7

/* Slave input from Decoder */
tidmaxhsel      = tclk * 0.7 /* Address decode */

/* Master inputs from Slave */
tidmaxhrdata    = tclk * 0.7
tidmaxhready    = tclk * 0.7
tidmaxhresp     = tclk * 0.7

/* Arbiter input from Slave */
tidmaxhsplit    = tclk * 0.7


/*** Output valid and hold ***/

/* Master outputs */
todmaxhaddr     = tclk * 0.6
todmaxhtrans    = tclk * 0.6
todmaxhwrite    = tclk * 0.6
todmaxhsize     = tclk * 0.6
todmaxhburst    = tclk * 0.6
todmaxhprot     = tclk * 0.6
todmaxhwdata    = tclk * 0.6
todmaxhbusreq   = tclk * 0.6
todmaxhlock     = tclk * 0.6

/* Arbiter outputs */
todmaxhgrant    = tclk * 0.6
todmaxhmaster   = tclk * 0.6
todmaxhmastlock = tclk * 0.6

/* Decoder output */
todmaxhsel      = tclk * 0.3 /* Address decode */

/* Slave outputs */
todmaxhrdata    = tclk * 0.6
todmaxhready    = tclk * 0.6
todmaxhresp     = tclk * 0.6
todmaxhsplit    = tclk * 0.6


/******************************************************************************/
/* APB PARAMETERS                                                             */
/******************************************************************************/
/* This section defines the timing parameters for all standard APB signals. */

/* All APB output timing assumes registered outputs, so the default values */
/* must be changed if combinational APB outputs are used. */

/* Only PRDATA passes through the central P2B multiplexers. Due to the */
/* long path from PRDATA to HRDATA, the usual 15% slack on signals is not */
/* applied, either before or after the AHB Slave-to-Master mux.  The */
/* PRDATA input constraint (tidmaxprdata) is not used by the current APB */
/* Interface as the path from PRDATA to HRDATA is simply a pass-through, */
/* and is left unconstrained.  The constraint should be re-applied to */
/* APBif if registers are introduced on the data path*/

/* Input setup and hold times */

tidmaxpenable = tclk * 0.7
tidmaxpsel    = tclk * 0.7
tidmaxpaddr   = tclk * 0.7
tidmaxpwrite  = tclk * 0.7
tidmaxpwdata  = tclk * 0.7
tidmaxprdata  = tclk * 0.7

/* Output valid and hold */

todmaxpenable = tclk * 0.6
todmaxpsel    = tclk * 0.6
todmaxpaddr   = tclk * 0.6
todmaxpwrite  = tclk * 0.6
todmaxpwdata  = tclk * 0.6
todmaxprdata  = tclk * 0.6


/******************************************************************************/
/* MULTIPLEXER PARAMETERS                                                     */
/******************************************************************************/
/* Blocks which contain combinatorial paths from inputs to outputs,   */
/* either in addition to or entirely instead of sequential paths,     */
/* cannot adequately be constrained by the use of set_input_delay and */
/* set_output_delay.  Instead, set_max_delay is used to define the    */
/* following arcs separately:                                         */
/*    Tiscm - setup requirement from inputs to registers              */
/*    Tovcm - output valid requirement from registers to outputs      */
/*    Tcm   - max delay requirement through combinatorial paths       */
/* In addition, to allow checks for hold violations on sequential     */
/* paths, the following constraints are used with set_min_delay:      */
/*    Tihcm - hold value from inputs to registers                     */
/*    Tohcm - hold requirement from registers to outputs              */
/* Examples of blocks using these constraints are:                    */
/*    MuxM2S, MuxP2B    - purely combinatorial                        */
/*    MuxS2M, BusMatrix - mixture of combinatorial and sequential     */
/* A default value of 15% is used for combinatorial paths through     */
/* blocks, and 30% is used for input setup and output valid           */
/* requirements                                                       */

Tiscm = tclk * 0.30
Tovcm = tclk * 0.30
Tcm   = tclk * 0.15

Tihcm = tclk * 0.00
Tohcm = tclk * 0.00

/******************************************************************************/
/* RESET SIGNAL PARAMETERS                                                    */
/* THESE SHOULD BE CONFIRMED AGAINST THE RESET CONTROLLER SPECIFICATION       */
/******************************************************************************/

tidminresetn = tclk * 0.05 /* Defined output hold time of reset signal */
tidmaxresetn = tclk * 0.5 /* Registered de-assertion of reset */
todmaxresetn = tclk * 0.6

/************************************ End *************************************/
