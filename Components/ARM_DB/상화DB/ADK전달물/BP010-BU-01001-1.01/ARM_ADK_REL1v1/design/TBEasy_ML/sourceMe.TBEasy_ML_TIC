######################################################################
# ADK System Variables
######################################################################

# Primary AHB Master.  This indicates to the makefiles how to process
# the test source files
setenv TEST_ENV   TICTALK

# The name of the testbench used to simulate the chosen EASY system
setenv TEST_BENCH TBEasy_ML_TIC

# Type of EASY system
# Currently supported values are shown below - uncomment the relevant
# one for the system which is to be used
setenv EASY       EASY_ML

# The PERIPH environment variable is used throughout the makefile
# system, and is over-ridden in the local makefiles.  A dummy value is
# set here to aid de-bugging when adding new peripherals.
setenv PERIPH     TBEasy_ML

######################################################################
# TEST specific setup
#
# TEST_NAME     - Name of the test to be run on the system
#                 Set to blank if not required
#
# TEST_NAME_ROM -  not used for TIC testing, but still present in the
#                  generic scripts - used to form part of the name of
#                  the simulation transcript file
#
# Currently supported values are shown below - uncomment the relevant
# one for the test which is to be run
#
#                     ********************************
#               If TEST_NAME or TEST_NAME_ROM are changed
#           do 'make clean' from $ADK/design/<TBEasy_xxx>/integration
#                 prior to 'make rtl' for the new test
#                    ********************************
#           
#
# $(TEST_NAME)_$(TEST_NAME_ROM)_ is used as the root for the 
# simulation transcript file
#
######################################################################

