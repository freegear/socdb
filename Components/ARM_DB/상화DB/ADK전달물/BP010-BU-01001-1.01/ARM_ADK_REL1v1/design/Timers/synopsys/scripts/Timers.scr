--
-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           Timers component.
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the Timers 
--           component. 
--
-- --=================================================================*/

/********************************************************************/
/* DEFINE TIMCLK                                                   */
/********************************************************************/

create_generated_clock -source PCLK -divide_by 1 TIMCLK
/* TIMCLK is derived from PCLK (default is to follow PCLK) 
/* Note that it inherits all PCLK attributes */

/********************************************************************/
/* CLOCK ENABLE SIGNAL CONSTRAINTS                                  */
/********************************************************************/

tidmaxtcen = tclk * 0.7

set_input_delay -clock PCLK -min tholdmax   TIMCLKEN1
set_input_delay -clock PCLK -max tidmaxtcen TIMCLKEN1

set_input_delay -clock PCLK -min tholdmax   TIMCLKEN2
set_input_delay -clock PCLK -max tidmaxtcen TIMCLKEN2

/********************************************************************/
/* OUTPUT CONSTRAINTS                                               */
/********************************************************************/

todmaxtim = tclk * 0.8
todmintim = 0

/* Interrupt outputs */

set_output_delay -clock PCLK -min todmintim TIMINTC
set_output_delay -clock PCLK -max todmaxtim TIMINTC

set_output_delay -clock PCLK -min todmintim TIMINT1
set_output_delay -clock PCLK -max todmaxtim TIMINT1

set_output_delay -clock PCLK -min todmintim TIMINT2
set_output_delay -clock PCLK -max todmaxtim TIMINT2

/************************* End of Timers.scr *************************/
