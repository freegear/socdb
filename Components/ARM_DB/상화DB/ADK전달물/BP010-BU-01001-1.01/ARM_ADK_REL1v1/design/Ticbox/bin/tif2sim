# File Name           : tif2sim,v                                              
# File Revision       : 1.1
#
# Release Information : ADK_REL1v1
#
################################################################################
# Purpose             : This awk script converts a tif file for a VHDL
#                       simulation environment into a sim file format for the
#                       Verilog tb_tic test bench simulation.
#
#                       Usage:  tif2sim file.tif
#
################################################################################

#------------------------------------------------------------------------------
# Check for proper number of arguments for tif2sim script
#------------------------------------------------------------------------------
if ($#argv != 1) then
  echo "Usage: tif2sim file.tif"
  exit(1);
endif

#------------------------------------------------------------------------------
# Convert tif format to Verilog simulation format 
#------------------------------------------------------------------------------
awk -f tif2sim.awk $1
