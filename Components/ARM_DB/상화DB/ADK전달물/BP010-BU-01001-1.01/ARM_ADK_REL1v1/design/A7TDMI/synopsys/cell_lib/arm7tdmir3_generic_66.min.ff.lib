      bit_width : 32;
      bit_from  : 31;
      bit_to    : 0;
   }

   type (busDOUT) {
      base_type : array;
      data_type : bit;
      bit_width : 32;
      bit_from  : 31;
      bit_to    : 0;
   }

   type (busIR) {
      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

   type (busMAS) {
      base_type : array;
      data_type : bit;
      bit_width : 2;
      bit_from  : 1;
      bit_to    : 0;
   }

   type (busnM) {
      base_type : array;
      data_type : bit;
      bit_width : 5;
      bit_from  : 4;
      bit_to    : 0;
   }

   type (busSCREG) {
      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

   type (busTAPSM) {
      base_type : array;
      data_type : bit;
      bit_width : 4;
      bit_from  : 3;
      bit_to    : 0;
   }

   cell (ARM7TDMI) {
      interface_timing : true;  /* Apply interface timing semantics */
      dont_touch : true;
      dont_use : true;
      area : 0.000; /* Unmodified area = 0.000 */ 
      cell_footprint : ARM7TDMI;

      /* clock pins */
      pin(MCLK) {
         direction   : input;
         capacitance : .358;
         clock : true;
         min_pulse_width_high  : 2.62;
         min_pulse_width_low  : 2.62;
      }
      pin(TCK) {
         direction   : input;
         capacitance : .041;
         clock : true;
         min_pulse_width_high  : 50;
         min_pulse_width_low  : 50;
      }
      /* input pins */
      pin(ABE) {
         direction   : input;
         capacitance : .024;
      }
      pin(ABORT) {
         direction   : input;
         capacitance : .024;
         timing() { /* Parameter Tabth */
            related_pin  : "MCLK";
            timing_type  : hold_falling;
            rise_constraint(scalar) {
               values("0.74");
            }
            fall_constraint(scalar) {
               values("0.74");
            }
         }
         timing() { /* Parameter Tabts */
            related_pin  : "MCLK";
            timing_type  : setup_falling;
            rise_constraint(scalar) {
               values("0");
            }
            fall_constraint(scalar) {
               values("0");
            }
