-- -----------------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis script to define AMBA AHB Master timing
--           constraints.
--           Located in the synopsys_shared/scr_common directory.
--           Called by master compile script.
--
-- --=========================================================================*/

/* It is possible for a peripheral to have an AHB Master port as well         */
/* as an AHB slave port. In such cases, the same base name could              */
/* lead to two different port names - one of which could be an input          */
/* connecting to the AHB Slave interface, while the other could be an         */
/* output from the AHB Master interface. For example, HADDR[31:0] is          */
/* an input to the AHB Slave interface, whereas HADDRM[31:0] is an            */
/* output from the AHB Master interface. Since the base name of HADDR         */
/* is known, to set constraints on the Master interface port, the             */
/* port_direction attribute is checked.                                       */


/******************************************************************************/
/* HCLK DEFINTION                                                             */
/******************************************************************************/
create_clock -p tclk -w {0 tclkh} find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_skew -ideal -plus_uncertainty tpskew find(clock, HCLK)
/* set plus clock skew */

set_clock_skew -ideal -minus_uncertainty tmskew find(clock, HCLK)
/* set minus clock skew */

set_clock_transition 0 HCLK
/* ignore all transition times as it is an ideal clock */

set_drive 0 HCLK
/* Infinite drive strength clock signal */

set_load 0 HCLK
/* Zero load clock signal */

remove_driving_cell find(port, HCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net, HCLK)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal clock net                                           */

set_dont_touch_network find(clock, HCLK)
/* Preserve the clock net during optimisation */

/******************************************************************************/
/* RESET SIGNAL CONSTRAINTS                                                   */
/******************************************************************************/
 
set_input_delay -clock HCLK -max tidmaxresetn HRESETn
set_input_delay -clock HCLK -min tidminresetn HRESETn

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

set_load 0 HRESETn
/* Zero load reset signal */

remove_driving_cell find(port, HRESETn)
/* Set no driving cell on reset */

set_resistance 0 find(net, HRESETn)
/* Zero resistance for zero net delay(interconnect delay) on */
/* ideal reset net                                           */

set_dont_touch_network find(port, HRESETn)
/* Preserve the reset net during optimisation */

/******************************************************************************/
/* HIGH FANOUT NETS                                                           */
/******************************************************************************/

/* The peripheral should present only a single load to the AHB                */
/* For peripherals that have an AHB Slave interface as well, the command      */
/* below would include the HREADYIN port on the AHB Slave interface. This     */
/* would override any constraints previously set on this port in the          */
/* ahb_slave.scr script. This is not a problem since it is only the same      */
/* constraint that is being re-applied                                        */
set_max_fanout 1.0 HREADYIN*

/******************************************************************************/
/* INPUT CONSTRAINTS                                                          */
/******************************************************************************/
/* For peripherals that have an AHB Slave interface as well, the command      */
/* below would include the HREADYIN port on the AHB Slave interface. This     */
/* would override any constraints previously set on this port in the          */
/* ahb_slave.scr script. This is not a problem since it is only the same      */
/* constraint that is being re-applied                                        */
set_input_delay -clock HCLK -min tholdmax     HREADYIN*
set_input_delay -clock HCLK -max tidmaxhready HREADYIN*

input_port_list = filter(find (port, "HRESP*"), \
                    "@port_direction == in")
foreach (input_port_name, input_port_list) {
  set_input_delay -clock HCLK -min tholdmax     input_port_name
  set_input_delay -clock HCLK -max tidmaxhresp  input_port_name
}
remove_variable input_port_list

input_port_list = filter(find (port, "HRDATA*"), \
                    "@port_direction == in")
foreach (input_port_name, input_port_list) {
  set_input_delay -clock HCLK -min tholdmax     input_port_name
  set_input_delay -clock HCLK -max tidmaxhrdata input_port_name
}
remove_variable input_port_list

/* Since HGRANT port can exist only for an AHB Master interface               */
/* and not for an AHB Slave interface, there is no need to filter             */
set_input_delay -clock HCLK -min tholdmax     HGRANT*
set_input_delay -clock HCLK -max tidmaxhgrant HGRANT*

/******************************************************************************/
/* OUTPUT CONSTRAINTS                                                         */
/******************************************************************************/
/* Since HBUSREQ port can exist only for an AHB Master interface              */
/* and not for an AHB Slave interface, there is no need to filter             */
set_output_delay -clock HCLK -min tholdmin      HBUSREQ*
set_output_delay -clock HCLK -max todmaxhbusreq HBUSREQ*

/* Since HLOCK port can exist only for an AHB Master interface                */
/* and not for an AHB Slave interface, there is no need to filter             */
set_output_delay -clock HCLK -min tholdmin      HLOCK*
set_output_delay -clock HCLK -max todmaxhlock   HLOCK*

output_port_list = filter(find (port, "HPROT*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhprot   output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HBURST*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhburst  output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HTRANS*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhtrans  output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HADDR*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhaddr   output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HSIZE*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhsize   output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HWRITE*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhwrite  output_port_name
}
remove_variable output_port_list

output_port_list = filter(find (port, "HWDATA*"), \
                     "@port_direction == out")
foreach (output_port_name, output_port_list) {
  set_output_delay -clock HCLK -min tholdmin      output_port_name
  set_output_delay -clock HCLK -max todmaxhwdata  output_port_name
}
remove_variable output_port_list

/********************************* End ****************************************/
