-- ---------------------------------------------------------------------
-- Version and Release Control Information:
--
-- File Name              : setup.scr.rca
-- File Revision          : 1.3
--
-- Release Information    : PrimeCell(TM)-GLOBAL-REL1v6
--
-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis project-specific setup script.
--
--           Located in the synopsys_shared/scr_common directory.      
--
--           This file ensures that appropriate variables are  
--           set each time a Synopsys session is invoked.     
--
--           It includes library paths, Synopsys cache location, 
--           and version-specific setup.                        
--
--           Also included are library-specific setup such as  
--           cells not to be used in synthesis and naming rules. 
--
-- --=================================================================*/

/**********************************************************************/
/* VARIABLES DECLARATION SECTION                                      */
/**********************************************************************/

/* ASSIGN NAMES */

Designer = "YourName"
/* Assign name of designer */

Company = "ARM Limited"
/* Assign name of company */

link_library = {"*"}
/* set default link library */

/**********************************************************************/
/* SET CONFIGURABLE PATHS                                             */
/**********************************************************************/

cell_lib_area = get_unix_variable("LIB_SYNOP")

/**********************************************************************/
/* DEFINE SEARCH PATHS                                                */
/**********************************************************************/

search_path = search_path + cell_lib_area

/**********************************************************************/
/* SELECT SYNTHESIS WITH INPUT AND OUTPUT FORMATS IN VHDL OR VERILOG  */
/**********************************************************************/

/**********************************************************************/
/* set variable hdl to 'vhdl' for VHDL or 'verilog' for Verilog RTL   */
/* input                                                              */
/* set variable hdl_out to 'vhdl' for VHDL output format, 'verilog'   */
/* for Verilog, or 'both' for both VHDL and Verilog output formats    */

hdl     = get_unix_variable("HDL_SOURCE")
hdl_out = get_unix_variable("HDL_NETL")

test_req = get_unix_variable("TEST_METH")
if ((test_req != scaninsert) && (test_req != scanready)) {
    test_req = noscan
}

/**********************************************************************/
/* DEFINE LOCATION OF INTERMEDIATE FILES                              */
/**********************************************************************/

/* Define the directory containing intermediate files generated by */
/* Synopsys                                                        */
define_design_lib work -path work

/**********************************************************************/
/* DEFINE NAMING RULES                                                */
/**********************************************************************/
 
include scr_common_area + "/name_rules.scr"
/* Include the naming rules */
 
/* Define bus naming styles for VHDL/Verilog */
if (hdl == vhdl) {
  bus_naming_style = %s_%d
} else if (hdl == verilog) {
  bus_naming_style = %s[%d]
}

/**********************************************************************/
/* SPECIFY WHERE THE SYNOPSYS CACHE IS TO BE LOCATED                  */
/**********************************************************************/

/* DesignWare components that are inferred (or instantiated) from */
/* technology library cells are stored in the synthetic library   */
/* cache.                                                         */
/*
cache_read  = get_unix_variable("GLOBAL")
cache_write = get_unix_variable("GLOBAL")
*/

cache_read  = synth_base_area + "/synopsys_shared/synopsys_cache"
cache_write = synth_base_area + "/synopsys_shared/synopsys_cache"

/**********************************************************************/
/* SYNOPSYS VERSION-SPECIFIC SETUP                                    */
/**********************************************************************/


/* This variable forces Synopsys to use asynchronous set/reset  */
/* latches if they exist in the target library rather than      */
/* constructing them from synchronous latches and combinatorial */
/* logic (This variable is set to true by default in the case   */
/* of dff's).                                                   */

hdlin_latch_always_async_set_reset = false

/* set the above to 'true' if the RTL infers asynchronous latches,   */
/* therefore set it to 'false' since no latches should be present in */
/* this design.                                                      */

hdlin_check_no_latch = true

/* This will generate a warning if any latches are inferred. */

/**********************************************************************/

hdlin_ff_always_sync_set_reset = false

/* set the above true if RTL infers synchronous resettable D-type */
/* flip-flops                                                     */

/**********************************************************************/

hdlin_turbo_sequential = "true"
hdlin_accelerate = "true"
/* Enable the compiler speed-up features                           */
/* Note: may need disabling on 97.08 if problems in design         */
/* elaboration are observed.                                       */
/* Note: may need disabling if the design is parameterised.        */ 

/**********************************************************************/

/* The following two commands allows the Synopsys link command       */
/* to work correctly. Link will be automatically performed by any of */
/* the following commands:                                           */
/* compile, create_schematic, group, check_design, report and        */
/* compare_design                                                    */
/* automatic linking is incremental and exisiting links are not      */
/* removed.                                                          */

auto_link_options = "-all"
auto_link_disable = false

/**********************************************************************/

/* The following variable prevents VHDL-Compiler from flagging */
/* warnings related to concatenation results. Refer STAR61128  */
hdlin_vhdl93_concat = false

/**********************************************************************/

/* The following variable prevents verilog-style SDF generation     */ 
/* for VHDL netlists.                                               */
/* By default clock to o/p delays are written out by Synopsys using */
/* Verilog syntax.                                                  */
/* eg:                                                              */
/*   IOPATH (posedge CP) Q                                          */
/* The above syntax is not acceptable for VITAL annotation.         */
/* Setting the sdfout_no_edge variable to true causes the SDF to be */ 
/* generated with the correct syntax.                               */
/*   IOPATH CP Q [as per VITAL requirements.]                       */
/*                                                                  */
/* Note : this variable is a "hidden" [undocumented] variable. If   */
/*        this variable is not accepted by a particular Synopsys    */ 
/*        version, the Synopsys generated SDF file will have to be  */
/*        post-processed to create a VITAL compliant SDF file.      */
/*        The 'patch_sdf' script in the 'netlist' directory         */
/*        contains a sample script which performs the necessary     */
/*        tailoring. This section of the script is commented out by */
/*        default and will have to be enabled by the user on a need */
/*        basis.                                                    */ 
sdfout_no_edge = true

/**********************************************************************/

echo_include_commands = "true"
/* echo the include command */

enable_page_mode = "false" 
/* enable (true) or disable (false) paging of report output */

/**********************************************************************/

view_background = "black";
/* Change the background view to black. */

/**********************************************************************/

enable_recovery_removal_arcs = "false" 
/* Check the asynchronous reset recovery time. */

/**********************************************************************/
 
/* To prevent feedthroughs, multiple output ports from same net,    */
/* or constants driving more than one output port.                  */
/* 1998.02 onwards uses the following command                       */
/* set_fix_multiple_port_nets -all                                  */
/* It should be applied in the master compile script with current   */
/* design.                                                          */
/* Warning: Ignoring compile_fix_multiple_port_nets = FALSE.        */
/* (UIO-60), is displayed for backward compatibility reasons since  */
/* DC needs to change it to true.                                   */
 
/* 97.08 and previous versions used the command below.              */
/* compile_fix_multiple_port_nets = true                            */
 
/**********************************************************************/

/* verilogout variables, which affect how Verilog is written out */

verilogout_no_tri = true
/* When true, three-state nets are declared as Verilog wire instead */
/* of tri.                                                          */
/* This variable eliminates assign primitives and tran gates in     */
/* Verilog output by connecting an output port directly to a        */
/* component instantiation, (default is false).                     */

verilogout_single_bit = false
/* When set to false, all ports are written out with their original  */
/* data types, so the netlist is written with vectored ports         */
/* maintained.                                                       */
/* When set to true, vectored ports (or ports that use record types) */
/* are bit-blasted; if a port's bit vector is N bits wide, it is     */
/* written out to the Verilog file as N separate single-bit ports,   */
/* (default is true).                                                */

verilogout_show_unconnected_pins = true
/* When set to true, all unconnected instance pins are written out in */
/* the Verilog netlist. This is a requirement placed by certain       */
/* layout tools                                                       */

verilogout_higher_designs_first = true
/* When true, Verilog modules are ordered so that higher-level       */
/* designs come before lower-level designs, as defined by the design */
/* hierarchy, (default is false).                                    */

/**********************************************************************/

/* vhdlout variables, which affect how VHDL is written out */
 
vhdlout_bit_type = std_logic
/* std_logic is output,                             */
/* (default is std_logic, but was bit pre-1998.02). */
 
vhdlout_bit_vector_type = std_logic_vector
/* std_logic_vector is output,                                    */
/* (default is std_logic_vector, but pre-1998.02 was bit_vector). */
 
vhdlout_single_bit = user
/* Comment the above, uncomment the following, for easy EDIF out */
/* vhdlout_single_bit = false                                    */
/* When this variable is set to USER, all ports on the top-level */
/* design are written with their original data types.            */
/* Thus vectored ports are maintained,                           */
/* (default is USER).                                            */

vhdlout_bit_type_resolved = "TRUE";
 
vhdlout_use_packages = { "IEEE.std_logic_1164.all", \
  "IEEE.std_logic_arith.all; library libvhdl" }
/* Write out vhdl netlist with library and use clauses               */
/* SYNTH-482000.html application note describes the above workaround */
/* to create VHDL 'library libvhdl;' in netlist referencing the cell */
/* library.                                                          */

vhdlout_dont_write_types = "true";
vhdlout_preserve_hierarchical_types = "USER";
 
vhdlout_conversion_functions = {};
vhdlout_equations = "FALSE";
vhdlout_one_name = "'1'";
vhdlout_package_naming_style = "CONV_PACK_%d";
vhdlout_separate_scan_in = "FALSE";

vhdlout_target_simulator = "";
vhdlout_three_state_name = "'Z'";
vhdlout_three_state_res_func = "";
vhdlout_time_scale = 1.0;
vhdlout_top_configuration_arch_name = "A";
vhdlout_top_configuration_entity_name = "E";
vhdlout_top_configuration_name = "CFG_TB_E";
vhdlout_unknown_name = "'X'";
vhdlout_upcase = "FALSE";
vhdlout_wired_and_res_func = "";
vhdlout_wired_or_res_func = "";
vhdlout_write_architecture = "TRUE";
vhdlout_write_components = "TRUE";
vhdlout_write_entity = "TRUE";
vhdlout_write_top_configuration = "FALSE";
vhdlout_zero_name = "'0'";
vhdlout_levelize = "FALSE";
vhdlout_dont_create_dummy_nets = "FALSE";
vhdlout_follow_vector_direction = "FALSE";

/**********************************************************************/
/* CREATE ALIASES                                                     */
/**********************************************************************/

alias h history
/* alias for history */

alias cls remove_design -all
/* alias to remove all designs */

/************************* End of setup.scr ***************************/
