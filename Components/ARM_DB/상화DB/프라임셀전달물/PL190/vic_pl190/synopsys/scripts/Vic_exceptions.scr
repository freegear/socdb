-- ---------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           VIC block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the VIC block synthesis. 
--
-- --=================================================================*/

/* False paths between VIC non-AMBA inputs and HRDATA are present as */
/* these paths are used in Integration test mode only.               */
/* The normal-mode paths from non-AMBA inputs to non-AMBA outputs    */
/* are still being constrained.                                      */

/* VICINTSOURCE to HRDATA */
set_false_path -from find(port,{"VICINTSOURCE*"}) \
               -to find(port,{"HRDATA*"})

/* nVICFIQIN to HRDATA */ 
set_false_path -from find(port,{"nVICFIQIN"}) \
               -to find(port,{"HRDATA*"})

/* nVICIRQIN to HRDATA */ 
set_false_path -from find(port,{"nVICIRQIN"}) \
               -to find(port,{"HRDATA*"})

/* VICVECTADDRIN to HRDATA */ 
set_false_path -from find(port,{"VICVECTADDRIN*"}) \
               -to find(port,{"HRDATA*"})

/* VICITCR to nVICIRQ */ 
set_false_path -from find(pin,{"uVicAhbifReg/VICITCR*/*"}) \
               -to find(port,{"nVICIRQ"})

/* VICITCR to nVICFIQ */ 
set_false_path -from find(pin,{"uVicAhbifReg/VICITCR*/*"}) \
               -to find(port,{"nVICFIQ"})

/* All paths through VICIRQCo and termintaing at HRDATA              */ 
/* (Integration test paths)                                          */ 
set_false_path -to find(port,{"HRDATA*"}) \
               -through find(pin,{"uVicPriority/VICIRQCo"})

/******************** End of Vic_exceptions.scr **********************/
