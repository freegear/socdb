-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           VIC block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints for the non-AMBA I/O in the VIC block. 
--
-- --=================================================================*/

/**********************************************************************/
/* VIC BLOCK-SPECIFIC TIMING PARAMETERS                               */
/**********************************************************************/

/**********************************************************************/
/* Input Delays                                                       */
/**********************************************************************/

/***************************/
/* Interrupt Source Inputs */
/***************************/

/* The VICINTSOURCE input can be asynchronous and */
/* the path has been constrained nethertheless to */
/* optimise the path                              */

tidmaxvicintsource = 0.05 * tclk    /* VICINTSOURCE */
tidminvicintsource = 0.0

/********************************/
/* Daisy Chain Interrupt Inputs */
/********************************/

tidmaxnvicfiqin = 0.2 * tclk       /* nVICFIQIN */
tidminnvicfiqin = 0.0

tidmaxnvicirqin = 0.2 * tclk       /* nVICIRQIN */
tidminnvicirqin = 0.0

tidmaxvicvectaddrin = 0.7 * tclk   /* VICVECTADDRIN */
tidminvicvectaddrin = 0.0

/***************/
/* Scan Inputs */
/***************/

/* The input delay on the Scan related input signals has been set to  */
/* zero value to prevent addition of extra gates in these paths.      */
tidscanmax = 0.0  
tidscanmin = 0.0 

/**********************************************************************/
/* Output Delays                                                      */
/**********************************************************************/

/*********************/
/* Interrupt Outputs */
/*********************/
todmaxnvicfiq = 0.6 * tclk         /* nVICFIQ */
todminnvicfiq = 0

todmaxnvicirq = 0.6 * tclk         /* nVICIRQ */
todminnvicirq = 0

todmaxvicvectaddrout = 0.6 * tclk  /* VICVECTADDROUT */
todminvicvectaddrout = 0

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */
todscanmax = 0.0
todscanmin = 0.0

/**********************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                               */
/**********************************************************************/

/***************************/
/* Interrupt Source Inputs */
/***************************/

/* VICINTSOURCE */
set_input_delay -clock HCLK -min tidminvicintsource VICINTSOURCE
set_input_delay -clock HCLK -max tidmaxvicintsource VICINTSOURCE

/********************************/
/* Daisy Chain Interrupt Inputs */
/********************************/

/* nVICFIQIN */
set_input_delay -clock HCLK -min tidminnvicfiqin nVICFIQIN
set_input_delay -clock HCLK -max tidmaxnvicfiqin nVICFIQIN

/* nVICIRQIN */
set_input_delay -clock HCLK -min tidminnvicirqin nVICIRQIN
set_input_delay -clock HCLK -max tidmaxnvicirqin nVICIRQIN

/* VICVECTADDRIN */
set_input_delay -clock HCLK -min tidminvicvectaddrin VICVECTADDRIN
set_input_delay -clock HCLK -max tidmaxvicvectaddrin VICVECTADDRIN

/***************/
/* Scan Inputs */
/***************/

set_input_delay -clock HCLK -min tidscanmin SCANINHCLK
set_input_delay -clock HCLK -max tidscanmax SCANINHCLK

set_input_delay -clock HCLK -min tidscanmin SCANENABLE
set_input_delay -clock HCLK -max tidscanmax SCANENABLE

/**********************************************************************/
/* SCAN SIGNAL CONSTRAINTS                                           */
/**********************************************************************/

set_drive 0 SCANENABLE
/* Infinite drive strength Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

set_drive 0 SCANINHCLK
/* Infinite drive strength Scan input signal */

set_load 0 SCANINHCLK
/* Zero load Scan input signal */

remove_driving_cell find(port, SCANINHCLK)
/* Set no driving cell on Scan input */

set_dont_touch_network find(port, SCANINHCLK)
/* Preserve the Scan input net during optimisation */
/**********************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                              */
/**********************************************************************/

/*********************/
/* Interrupt Outputs */
/*********************/

set_output_delay -clock HCLK -min todminnvicfiq nVICFIQ
set_output_delay -clock HCLK -max todmaxnvicfiq nVICFIQ

set_output_delay -clock HCLK -min todminnvicirq nVICIRQ
set_output_delay -clock HCLK -max todmaxnvicirq nVICIRQ

set_output_delay -clock HCLK -min todminvicvectaddrout VICVECTADDROUT
set_output_delay -clock HCLK -max todmaxvicvectaddrout VICVECTADDROUT

/****************/
/* Scan Outputs */
/****************/

set_output_delay -clock HCLK -min todscanmin SCANOUTHCLK
set_output_delay -clock HCLK -max todscanmax SCANOUTHCLK

/************************* End of Vic.scr *****************************/
