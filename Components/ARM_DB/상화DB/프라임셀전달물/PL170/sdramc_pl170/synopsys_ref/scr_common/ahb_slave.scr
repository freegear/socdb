--------------------------------------------------------------------------------
--  Purpose         : Synopsys synthesis script
--                    to define AMBA AHB timing constraints.
--                    Located in the synopsys_ref/scr_common directory.
------------------------------------------------------------------------------*/

/*****************************************************************************/
/* Define HCLK, including clock skew                                         */
/*****************************************************************************/

create_clock -p tclk  -w {0 tclkh}  find(port, "HCLK")
/* period tclk, rise at 0, fall after tclkh High phase */

set_clock_skew -plus_uncertainty tpskew find(clock, HCLK)
/* set plus clock skew */

set_clock_skew -minus_uncertainty tmskew find(clock, HCLK)
/* set minus clock skew */

set_dont_touch_network find(clock , HCLK)
/* Preserve the clock net during optimisation */

set_resistance 0 find(net,"HCLK")

set_drive 0 HCLK
/* Infinite drive strength clock signal */

/*****************************************************************************/
/* Reset signal Constraints                                                  */
/*****************************************************************************/
 
set_input_delay -clock HCLK -max tismaxhres HRESETn 
set_input_delay -clock HCLK -min tisminhres HRESETn 

set_dont_touch_network HRESETn
/* Preserve the reset net during optimisation */

set_resistance 0 HRESETn 

set_drive 0 HRESETn
/* Infinite drive strength reset signal */

/*****************************************************************************/
/* Input Constraints                                                         */
/*****************************************************************************/

/* For a device that can be both an AHB Master or AHB Slave the distinction */ 
/* of the port-names is made based on their directions                      */

set_input_delay -clock HCLK -min tidminhadd \
                       filter(find(port, "HADDR*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhadd \
                       filter(find(port, "HADDR*"), "@port_direction == in")

set_input_delay -clock HCLK -min tidminhtran \
                       filter(find(port, "HTRANS*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhtran \
                       filter(find(port, "HTRANS*"), "@port_direction == in")

set_input_delay -clock HCLK -min tidminhs \
                       filter(find(port, "HSIZE*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhs \
                       filter(find(port, "HSIZE*"), "@port_direction == in")

set_input_delay -clock HCLK -min tidminhwr \
                       filter(find(port, "HWRITE*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhwr \
                       filter(find(port, "HWRITE*"), "@port_direction == in")

set_input_delay -clock HCLK -min tidminhb \
                       filter(find(port, "HBURST*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhb \
                       filter(find(port, "HBURST*"), "@port_direction == in")

set_input_delay -clock HCLK -min tidminhwd \
                       filter(find(port, "HWDATA*"), "@port_direction == in")
set_input_delay -clock HCLK -max tidmaxhwd \
                       filter(find(port, "HWDATA*"), "@port_direction == in")

/* This is common for a Slave or a Master or a design that has both the */
/* features                                                             */

set_input_delay -clock HCLK -min tidminhrdyin HREADYin*
set_input_delay -clock HCLK -max tidmaxhrdyin HREADYin*

/* A Master does not have these signals on its port list; hence no check is */
/* made on port direction                                                   */
set_input_delay -clock HCLK -min tidminhsel HSEL*
set_input_delay -clock HCLK -max tidmaxhsel HSEL*

/*****************************************************************************/
/* Output Constraints                                                        */
/*****************************************************************************/

/* For a device that can be both an AHB Master or AHB Slave the distinction */
/* of the port-names is made based on their directions                      */

set_output_delay -clock HCLK -min todminhrd \
                       filter(find(port, "HRDATA*"), "@port_direction == out")
set_output_delay -clock HCLK -max todmaxhrd \
                       filter(find(port, "HRDATA*"), "@port_direction == out")

set_output_delay -clock HCLK -min todminhresp \
                       filter(find(port, "HRESP*"), "@port_direction == out")
set_output_delay -clock HCLK -max todmaxhresp \
                       filter(find(port, "HRESP*"), "@port_direction == out")

/* A Master does not have these signals on its port list; hence no check is */
/* made on port direction                                                   */
set_output_delay -clock HCLK -min todminhrdyout HREADYout*
set_output_delay -clock HCLK -max todmaxhrdyout HREADYout*

/*************************** End of ahb_slave.scr ****************************/
