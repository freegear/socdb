--  Purpose         : Synopsys synthesis script for AMBA AHB parameters.
--                    Located in the synopsys_ref/scr_common directory.
------------------------------------------------------------------------------*/

/*****************************************************************************/
/*** This file contains a generic set of parameters for synthesis of       ***/
/*** AHB slaves.                                                           ***/
/***                                                                       ***/
/*** A number of timing parameters are defined for each AMBA slave         ***/
/*** and these use the following nomenclature:                             ***/
/***                                                                       ***/
/***  Tis - Input setup time                                               ***/
/***  Tih - Input hold time                                                ***/
/***  Tov - Output valid time                                              ***/
/***  Toh - Output hold time                                               ***/
/***                                                                       ***/
/*** For the purpose of synthesis this script takes a target set of        ***/
/*** parameters and converts them into those suitable to constrain         ***/
/*** the synthesis. For synthesis the following nomenclature is used:      ***/
/***                                                                       ***/
/***  Tidmin - Input delay minimum                                         ***/
/***  Tidmax - Input delay maximum                                         ***/
/***  Todmin - Output delay minimum                                        ***/
/***  Todmax - Output delay maximum                                        ***/
/***                                                                       ***/
/*** Conversion between the target module parameters and the               ***/
/*** synthesis constraints is done using the following equations:          ***/
/***                                                                       ***/
/***  Tidmax = Tclkh - Tis                                                 ***/
/***  Tidmin = Tih                                                         ***/
/***  Todmax = Tclkh - Tov                                                 ***/
/***  Todmin = Toh                                                         ***/
/***                                                                       ***/

/*****************************************************************************/
/* AHB clock parameters                                                      */
/*****************************************************************************/

/*** tclk is the period of HCLK and by default all other                   ***/
/*** parameters are automatically derived from                             ***/
/*** this parameter.                                                       ***/
/***                                                                       ***/

/* HIGH phase of clock */
tclkh = 5.0               /* phase = 5 ns at 100 Mhz */

tclkh = tclkh - oc_margin /* set the tclk high phase */
                          /* after subtracting the over-constraining margin */

/* Clock LOW phase equals clock HIGH phase */
tclkl = tclkh

/* Clock period of HCLK */
tclk  = tclkl + tclkh     /* period = 10 at 100 MHz */

/* Clock skew */
tpskew = 0.2              /* plus skew set to 0.2 ns  - for hold checks  */
tmskew = 0.5              /* minus skew set to 0.5 ns - for setup checks */

/*****************************************************************************/
/* AHB slave parameters                                                      */
/*****************************************************************************/

/* Input setup and hold times */
/* Input arrival time = 3 ns/4 ns */

tishres      = 0.60 * tclk      /* HRESETn */
tihhres      = 0

tishsel      = 0.70 * tclk      /* HSEL */
tihhsel      = 0

tishadd      = 0.70 * tclk      /* HADDR */
tihhadd      = 0

tishtran     = 0.70 * tclk      /* HTRAN */
tihhtran     = 0

tishs        = 0.70 * tclk      /* HSIZE */
tihhs        = 0

tishwr       = 0.70 * tclk      /* HWRITE */
tihhwr       = 0

tishb        = 0.70 * tclk      /* HBURST */
tihhb        = 0

tishpr       = 0.70 * tclk      /* HPROT */
tihhpr       = 0

tishrdyin    = 0.60 * tclk      /* HREADYin */
tihhrdyin    = 0

tishwd       = 0.60 * tclk      /* HWDATA */
tihhwd       = 0

/* Output valid and hold */
/* Output setup required = 3 ns */

tovhrd       = 0.70 * tclk      /* HRDATA */
tohhrd       = 0

tovhresp     = 0.70 * tclk      /* HRESP */
tohhresp     = 0

tovhrdyout   = 0.70 * tclk      /* HREADYout */
tohhrdyout   = 0

/* Convert the above into synthesis parameters */

tismaxhres       = tclk - tishres
tisminhres       = tihhres

tidmaxhsel       = tclk - tishsel
tidminhsel       = tihhsel

tidmaxhadd       = tclk - tishadd
tidminhadd       = tihhadd

tidmaxhtran      = tclk - tishtran  
tidminhtran      = tihhtran 

tidmaxhs         = tclk - tishs    
tidminhs         = tihhs    

tidmaxhwr        = tclk - tishwr 
tidminhwr        = tihhwr 

tidmaxhb         = tclk - tishb 
tidminhb         = tihhb 

tidmaxhpr        = tclk - tishpr 
tidminhpr        = tihhpr 

tidmaxhrdyin     = tclk - tishrdyin 
tidminhrdyin     = tihhrdyin 

tidmaxhwd        = tclk - tishwd 
tidminhwd        = tihhwd 

todmaxhrd        = tclk - tovhrd
todminhrd        = tohhrd

todmaxhresp      = tclk - tovhresp
todminhresp      = tohhresp

todmaxhrdyout    = tclk - tovhrdyout
todminhrdyout    = tohhrdyout


/*****************************************************************************/
/* AHB Master parameters                                                     */
/*****************************************************************************/

/* Input setup and hold times */
/* Input arrival time = 4 ns */

tishrd       = 0.60 * tclk      /* HRDATA */
tihhrd       = 0

/* HREADY to use same values as that for Slave HREADYin */

tishresp     = 0.60 * tclk      /* HRESP */
tihhresp     = 0

tishgr       = 0.60 * tclk      /* HGRANT */
tihhgr       = 0

/* Output valid and hold */
/* Output setup required = 4 ns */

tovhaddr     = 0.60 * tclk      /* HADDR  */
tohhaddr     = 0

tovhtrans    = 0.60 * tclk      /* HTRANS */
tohhtrans    = 0

tovhwrite    = 0.60 * tclk      /* HWRITE */
tohhwrite    = 0

tovhsize     = 0.60 * tclk      /* HSIZE */
tohhsize     = 0

tovhb        = 0.60 * tclk      /* HBURST */
tohhb        = 0

tovhprot     = 0.60 * tclk      /* HPROT */
tohhprot     = 0

tovhlock     = 0.60 * tclk      /* HLOCK */
tohhlock     = 0

tovhbreq     = 0.60 * tclk      /* HBUSREQ */
tohhbreq     = 0

tovhwd       = 0.60 * tclk      /* HWDATA */
tohhwd       = 0

/* Convert the above into synthesis parameters */

tidmaxhrd    = tclk - tishrd
tidminhrd    = tihhrd

tidmaxhresp  = tclk - tishresp
tidminhresp  = tihhresp

tidmaxhgr    = tclk - tishresp
tidminhgr    = tihhresp

todmaxhadd   = tclk - tovhaddr
todminhadd   = tohhaddr

todmaxhtran  = tclk - tovhtrans
todminhtran  = tohhtrans

todmaxhwr    = tclk - tovhwrite
todminhwr    = tohhwrite

todmaxhs     = tclk - tovhsize
todminhs     = tohhsize

todmaxhb     = tclk - tovhb
todminhb     = tohhb

todmaxhprot  = tclk - tovhprot
todminhprot  = tohhprot

todmaxhlock  = tclk - tovhlock
todminhlock  = tohhlock

todmaxhbreq  = tclk - tovhbreq
todminhbreq  = tohhbreq

todmaxhwd    = tclk - tovhwd
todminhwd    = tohhwd

/*************************** End of ahb_params.scr ***************************/
