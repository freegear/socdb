#-------------------------------------------------------------------------------
#-  Purpose  : This shell script tailors the SDF file written out by Synopsys
#-             to make it compatible with the netlist / cell models 
#-
#-------------------------------------------------------------------------------
echo Converting SDF file ...
echo please wait ....

###########################################################
# clock to o/p delays are written out by Synopsys using
# Verilog syntax. 
# eg:
#   IOPATH (posedge CP) Q
# The above syntax is not acceptable for VITAL annotation.
# It is replaced with  
#   IOPATH CP Q as per VITAL requirements.
###########################################################

# Change Synopsys SDF to VITAL compliant format for VHDL netlist simulations
if [ `echo $1 | grep -i vhdl` ]
then
 sed 's/IOPATH (posedge CP)/IOPATH CP/g' $1 > 1.tmp
 sed 's/IOPATH (negedge CP)/IOPATH CP/g' 1.tmp > 2.tmp
 sed 's/IOPATH (posedge SDN)/IOPATH SDN/g' 2.tmp > 1.tmp
 sed 's/IOPATH (negedge SDN)/IOPATH SDN/g' 1.tmp > 2.tmp
 sed 's/IOPATH (posedge CDN)/IOPATH CDN/g' 2.tmp > 1.tmp
 sed 's/IOPATH (negedge CDN)/IOPATH CDN/g' 1.tmp > 2.tmp
 sed 's/reg_\//reg\//g' 2.tmp > 1.tmp
 sed 's/reg_)/reg)/g' 1.tmp > $1.tmp
 rm 1.tmp 2.tmp
else
 # Make copy of SDF file
 cp $1 $1.tmp
fi

# Remove the large reset net delays
vi $1.tmp << vi_label >/dev/null
/CELL
:.,\$s/[1-9][0-9][0-9]*\./0\./g
:1
/CELL
:.,\$s/[2-9]\./0\./g
:wq!
vi_label

# Move the updated SDF file to the uutNetlist directory
if [ `echo $1.tmp | grep -i verilog` ]
then
  mv $1.tmp ../../verilog/uutNetlist/$1
elif [ `echo $1.tmp | grep -i vhdl` ]
then
  mv $1.tmp ../../vhdl/uutNetlist/$1
fi

echo Complete
