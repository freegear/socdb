--------------------------------------------------------------------------------
-- Purpose         : Synopsys synthesis timing                            
--                   constraint script for SDRAMC block             
--
--                   Located in the synopsys_ref/scr_sdram directory.         
--
--                   This file specifies the input and output delay     
--                   constraints for the non-AMBA I/O in the SDRAMC block. 
------------------------------------------------------------------------------*/

/*****************************************************************************/
/* SDRAMC BLOCK-SPECIFIC TIMING PARAMETERS                                   */
/*****************************************************************************/

/* Clock time */
fskew = 0.2

tclkinl = 0.3 * tclk
tclkinh = tclkh + tclkinl

/* input setup and hold times */
 
tih = 0.02 * tclk

tidmaxnpor = 0.5 * tclk
tidminnpor = tih

/* Timings taken from Hitachi and Micron -10 parts                 */
/* Note : All timings for Cas Latency of 3. At 90 Mhz, the devices */
/*        need to be run at Cas Latency of 3                       */

/* Read Data In min delay -> tOH  */
/* Hitachi = 3 ns ; Micron = 3 ns */
/* Read Data In max delay -> tAC  */
/* Hitachi = 8 ns , Micron = 7 ns */

tidmaxdatain     = 0.80 * tclk
tidmindatain     = 0.30 * tclk

tidmaxscanenable = 0.10 * tclk
tidminscanenable = tih

tidmaxscanin     = 0.10 * tclk
tidminscanin     = tih

tidmaxsrefreq    = 0.50 * tclk
tidminsrefreq    = tih

tidmaxextbusgnt  = 0.15 * tclk
tidminextbusgnt  = tih

tidmaxextctlgnt  = 0.15 * tclk
tidminextctlgnt  = tih

/* Output valid and hold times */
 
/* Hold time required on Address, Write Data and Control Signals  */
/* Hitachi = 1 ns ; Micron = 1 ns                                 */
/* Setup time required on Address, Write Data and Control Signals */
/* Hitachi = 2 ns ; Micron = 3 ns                                 */
/* Min Setup time on Address / Data Out and Control = 2 ns        */
/* All timings for -10 devices                                    */

toh    = - 1.00
tohreq = - 0.2
 
todmaxnrasout    = 0.30 * tclk
todminnrasout    = toh

todmaxncasout    = 0.30 * tclk
todminncasout    = toh

todmaxncsout     = 0.30 * tclk
todminncsout     = toh

todmaxnweout     = 0.30 * tclk
todminnweout     = toh

todmaxckeout     = 0.30 * tclk
todminckeout     = toh

todmaxaddrout    = 0.30 * tclk
todminaddrout    = toh

todmaxdqmout     = 0.30 * tclk
todmindqmout     = toh

todmaxdataout    = 0.30 * tclk
todmindataout    = toh

todmaxdataen     = 0.30 * tclk
todmindataen     = toh

todmaxsrefack    = 0.50 * tclk
todminsrefack    = tohreq

todmaxextbusreq  = 0.70 * tclk
todminextbusreq  = tohreq

todmaxextctlreq  = 0.70 * tclk
todminextctlreq  = tohreq

/*****************************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/*****************************************************************************/

/* CLKIn clock */

/*****************************************************************************/
/* Note that the CLKOut signal is not being constrained by this script       */
/* CLKOut is simply HCLK OR'ed with the output of a F/F clocked by the       */
/* rising edge of HCLK. No constraint has been placed on this output         */
/* since this signal is to be treated as a clock and we do not want          */
/* Synopsys to consider it as an normal net for buffering.                   */
 
/* CLKIn is a fed-back version of the CLKOut signal generated by the         */
/* controller. All SDRAM signals driven off-chip will be synchronized        */
/* to the rising edge of CLKIn to compensate for pad and track delays.       */
/* Similary all SDRAM input signals will be synchronized to the rising       */
/* edge of CLKIn before being used in the HCLK domain.                       */
/*                                                                           */
/* CLKIn must be controlled in chip/board layout such that it has a          */
/* MIN delay of about 2-3 ns from HCLK.                                      */
/*****************************************************************************/

create_clock -p tclk  -w {tclkinl  tclkinh} find(port, "CLKIn")
set_clock_skew -plus_uncertainty fskew find(clock, CLKIn)
set_clock_skew -minus_uncertainty fskew find(clock, CLKIn)

set_dont_touch_network find(clock, CLKIn) 
/* Preserve the clock net during optimisation */

set_drive 0 CLKIn 
/* Infinite drive strength clock signal */

/* nPOR signal */

set_input_delay -clock HCLK -min tidminnpor nPOR
set_input_delay -clock HCLK -max tidmaxnpor nPOR

set_dont_touch_network nPOR
/* Preserve the reset net during optimisation */

set_resistance 0 nPOR 

set_drive 0 nPOR
/* Infinite drive strength reset signal */

set_input_delay -clock CLKIn -min tidmindatain DataIn
set_input_delay -clock CLKIn -max tidmaxdatain DataIn

/* Scan related signals */
 
set_input_delay -clock HCLK -min tidminscanenable SCANENABLE
set_input_delay -clock HCLK -max tidmaxscanenable SCANENABLE
remove_driving_cell find(port, "SCANENABLE")

set_drive 0 find(port, SCANENABLE)
/* Infinite drive strength scan enable signal */
 
set_input_delay -clock HCLK -min tidminscanin SCANIN
set_input_delay -clock HCLK -max tidmaxscanin SCANIN

/* SREQ Input constraints */

set_input_delay -clock HCLK -min tidminsrefreq SREFReq
set_input_delay -clock HCLK -max tidmaxsrefreq SREFReq

/* EBI related signals */

set_input_delay -clock HCLK -min tidminextbusgnt ExtBusGnt
set_input_delay -clock HCLK -max tidmaxextbusgnt ExtBusGnt

/* ExtCtlGnt Input constraints */

set_input_delay -clock HCLK -min tidminextctlgnt ExtCtlGnt
set_input_delay -clock HCLK -max tidmaxextctlgnt ExtCtlGnt

/*****************************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                                     */
/*****************************************************************************/

/* Memory related signals */

set_output_delay -clock CLKIn -min todminnrasout nRASOut 
set_output_delay -clock CLKIn -max todmaxnrasout nRASOut

set_output_delay -clock CLKIn -min todminncasout nCASOut 
set_output_delay -clock CLKIn -max todmaxncasout nCASOut

set_output_delay -clock CLKIn -min todminncsout nCSOut* 
set_output_delay -clock CLKIn -max todmaxncsout nCSOut*

set_output_delay -clock CLKIn -min todminnweout nWEOut* 
set_output_delay -clock CLKIn -max todmaxnweout nWEOut*

set_output_delay -clock CLKIn -min todminckeout CKEOut*
set_output_delay -clock CLKIn -max todmaxckeout CKEOut*

set_output_delay -clock CLKIn -min todminaddrout AddrOut*
set_output_delay -clock CLKIn -max todmaxaddrout AddrOut*

set_output_delay -clock CLKIn -min todmindqmout DQMOut*
set_output_delay -clock CLKIn -max todmaxdqmout  DQMOut*

set_output_delay -clock CLKIn -min todmindataout DataOut*
set_output_delay -clock CLKIn -max todmaxdataout  DataOut*

set_output_delay -clock CLKIn -min todmindataen DataEn
set_output_delay -clock CLKIn -max todmaxdataen DataEn

set_output_delay -clock HCLK -min todminsrefack SREFAck 
set_output_delay -clock HCLK -max todmaxsrefack SREFAck 
 
/* EBI related signals */

set_output_delay -clock HCLK -min todminextbusreq ExtBusReq 
set_output_delay -clock HCLK -max todmaxextbusreq ExtBusReq 
 
set_output_delay -clock HCLK -min todminextctlreq ExtCtlReq 
set_output_delay -clock HCLK -max todmaxextctlreq ExtCtlReq 
 
/*********************** End of sdram.scr **********************************/
