[library]

;; BusTalk functional verification testbench
common      = $PERIPH/BusTalk/vlog/common/work
reader      = $PERIPH/BusTalk/vlog/reader/work
bid         = $PERIPH/BusTalk/vlog/bid/work
buswatcher  = $PERIPH/BusTalk/vlog/buswatcher/work
trickbox    = $PERIPH/BusTalk/vlog/trickbox/work 
tbench      = $PERIPH/BusTalk/vlog/tbench/work
vr          = $PERIPH/BusTalk/vlog/vr/work

;; Select RTL (uut) or netlist (uutNetlist or uutNetlist_scan) block
;; (uut = Unit Under Test)
;; by commenting out all but one of the lines below:
uut         = $PERIPH/verilog/uut/work
;uut         = $PERIPH/verilog/uutNetlist/work
;uut         = $PERIPH/verilog/uutNetlist_scan/work

;; Denali memory models
M16M_x8   = $MODELS/denali/sdram/Mt16Mx8/verilog_mti/Mt16Mx8Source
M16M_x16  = $MODELS/denali/sdram/Mt16Mx16/verilog_mti/Mt16Mx16Source
N64M_x8   = $MODELS/denali/sdram/Nec64Mx8/verilog_mti/Nec64Mx8Source
N64M_x16  = $MODELS/denali/sdram/Nec64Mx16/verilog_mti/Nec64Mx16Source
N256M_x8  = $MODELS/denali/sdram/Nec256Mx8/verilog_mti/Nec256Mx8Source
N256M_x16 = $MODELS/denali/sdram/Nec256Mx16/verilog_mti/Nec256Mx16Source

;; Cell library simulation timing views
libverilog  = $CB25VERILOG/zero/work

;; Initialisation file for ModelSim
others = $MODELTECH_ROOT/modelsim.ini

