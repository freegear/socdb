   "EBIEXTDATAOUT_22" + "EBIEXTDATAOUT_23" + "EBIEXTDATAOUT_24" + 
   "EBIEXTDATAOUT_25" + "EBIEXTDATAOUT_26" + "EBIEXTDATAOUT_27" + 
   "EBIEXTDATAOUT_28" + "EBIEXTDATAOUT_29" + "EBIEXTDATAOUT_30" + 
   "EBIEXTDATAOUT_31" + "EBIGNT1" + "EBIGNT2" + "EBIGNT3" + 
   "SCANOUTEBICLK" + "nEBIEXTDATAEN_0" + "nEBIEXTDATAEN_1" + 
   "nEBIEXTDATAEN_2" + "nEBIEXTDATAEN_3"'; // #signals=107
   "all_ports"   '"all_inputs" + "all_outputs"'; // #signals=380
   "_pi"   '"all_inputs"'; // #signals=273
   "_po"   '"all_outputs"'; // #signals=107
} 
ScanStructures {
   ScanChain "c0" {
      ScanLength 146;
      ScanIn "SCANINEBICLK";
      ScanOut "SCANOUTEBICLK";
   } 
} 
Timing {
   WaveformTable "_default_WFT_" {
      Period '100ns';
      Waveforms {
         "all_inputs" { 0 { '5ns' D; } }
         "all_inputs" { 1 { '5ns' U; } }
         "all_inputs" { Z { '5ns' Z; } }
         "all_outputs" { X { '0ns' X; } }
         "all_outputs" { H { '0ns' X; '95ns' H; } }
         "all_outputs" { T { '0ns' X; '95ns' T; } }
         "all_outputs" { L { '0ns' X; '95ns' L; } }
         "EBICLK" { P { '0ns' D; '45ns' U; '55ns' D; } }
         "nPOR" { P { '0ns' U; '45ns' D; '55ns' U; } }
      }
   }
} 
PatternBurst "__burst__" {
   "__pattern__" {
   }
} 
PatternExec {
   Timing "";
   PatternBurst "__burst__";
} 
Procedures {
   "load_unload" {
      W "_default_WFT_";
      V {  "EBICLK"=0; "SCANENABLE"=1; "nPOR"=1; "_so"=#; } 
      Shift { 
         W "_default_WFT_";
         V {  "EBICLK"=P; "SCANENABLE"=1; "nPOR"=1; "_so"=#; "_si"=#; } 
      }
   }
   "capture" {
      W "_default_WFT_";
      V { "_pi"=\r273 #; "_po"=\r107 #; }
   }
   "capture_EBICLK" {
      W "_default_WFT_";
      "forcePI": V { "_pi"=\r273 #; }
      "measurePO": V { "_po"=\r107 #; }
      "pulse": V { "EBICLK"=P; }
   }
   "capture_nPOR" {
      W "_default_WFT_";
      "forcePI": V { "_pi"=\r273 #; }
      "measurePO": V { "_po"=\r107 #; }
      "pulse": V { "nPOR"=P; }
   }
} 
MacroDefs {
   "test_setup" {
      W "_default_WFT_";
      V {  "EBICLK"=0; } 
      V {  "EBICLK"=0; "nPOR"=1; } 
   }
} 
