-------------------------------------------------------------------------------
-- Purpose :
--           Synopsys synthesis timing constraint script for the 
--           Ebi block.             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the input and output delay     
--           constraints Ebi block.
--
-- --======================================================================-- */

/******************************************************************************/
/* Ebi BLOCK-SPECIFIC TIMING PARAMETERS                                       */
/******************************************************************************/

/******************************************************************************/
/* Input Delays from the controller-1 module. These outputs are registered    */
/* and will be valid very early in the clock cycle                            */
/******************************************************************************/
tidmaxebiport1    = tclk * 0.3       /* The signals from controller-1         */

/******************************************************************************/
/* Input Delays from the controller-2                                         */
/******************************************************************************/
tidmaxebiport2  = tclk * 0.30       /* The signals from controller-2          */

/******************************************************************************/
/* Input Delays from the controller-3                                         */
/******************************************************************************/
tidmaxebiport3  = tclk * 0.30       /* The signals from controller-3          */

/******************************************************************************/
/* Input Delays from the Pads                                                 */
/******************************************************************************/
tidmaxebipad    = tclk * 0.6      /* The signals from pads                  */

/* Minimum input delay on the Ebi inputs */
tidebiipmin     = 0.0

/******************************************************************************/
/* Output Delays of the Ebi to the controller-1                               */
/******************************************************************************/
todmaxebiport1     = tclk * 0.30   /* The signals to the controller-1         */

/******************************************************************************/
/* Output Delays of the Ebi to the controller-2                               */
/******************************************************************************/
todmaxebiport2     = tclk * 0.30   /* The signals to the controller-2         */

/******************************************************************************/
/* Output Delays of the Ebi to the controller-3                               */
/******************************************************************************/
todmaxebiport3     = tclk * 0.30   /* The signals to the controller-3         */

/******************************************************************************/
/* Output Delays                                                              */
/******************************************************************************/
/* Minimum output delay on the Ebi outputs */
tovebiopmin     = 0

/******************************************************************************/
/* Delay for multiplexer path                                                 */
/******************************************************************************/
tmuxpathmax     = tclk * 0.6

/***************/
/* Scan Inputs */
/***************/
/* The input delay on the Scan related input signals has been set to  */
/* 0.3 to prevent addition of extra gates in these paths. */
tidscanmax = 0.3
tidscanmin = 0.3

/****************/
/* Scan Outputs */
/*****************/

/* The output delay on the Scan related output signals has been set   */
/* to a zero value to prevent addition of extra gates in these paths. */
todscanmax = 0.0
todscanmin = 0.0

/******************************************************************************/
/* INPUT CONSTRAINTS FOR Ebi specific input ports                         */
/******************************************************************************/
set_input_delay -clock EBICLK -min tidebiipmin      EBIREQ1
set_input_delay -clock EBICLK -max tidmaxebiport1   EBIREQ1

set_input_delay -clock EBICLK -min tidebiipmin      EBIADDR1*
set_input_delay -clock EBICLK -max tidmaxebiport1   EBIADDR1*

set_input_delay -clock EBICLK -min tidebiipmin      EBIDATA1*
set_input_delay -clock EBICLK -max tidmaxebiport1   EBIDATA1*

set_input_delay -clock EBICLK -min tidebiipmin      nEBIDATAEN1*
set_input_delay -clock EBICLK -max tidmaxebiport1   nEBIDATAEN1*

set_input_delay -clock EBICLK -min tidebiipmin      EBIREQ2
set_input_delay -clock EBICLK -max tidmaxebiport2   EBIREQ2

set_input_delay -clock EBICLK -min tidebiipmin      EBIADDR2*
set_input_delay -clock EBICLK -max tidmaxebiport2   EBIADDR2*

set_input_delay -clock EBICLK -min tidebiipmin      EBIDATA2*
set_input_delay -clock EBICLK -max tidmaxebiport2   EBIDATA2*

set_input_delay -clock EBICLK -min tidebiipmin      nEBIDATAEN2*
set_input_delay -clock EBICLK -max tidmaxebiport2   nEBIDATAEN2*

set_input_delay -clock EBICLK -min tidebiipmin      EBIREQ3
set_input_delay -clock EBICLK -max tidmaxebiport3   EBIREQ3

set_input_delay -clock EBICLK -min tidebiipmin      EBIADDR3*
set_input_delay -clock EBICLK -max tidmaxebiport3   EBIADDR3*

set_input_delay -clock EBICLK -min tidebiipmin      EBIDATA3*
set_input_delay -clock EBICLK -max tidmaxebiport3   EBIDATA3*

set_input_delay -clock EBICLK -min tidebiipmin      nEBIDATAEN3*
set_input_delay -clock EBICLK -max tidmaxebiport3   nEBIDATAEN3*

set_input_delay -clock EBICLK -min tidebiipmin      EBIEXTDATAIN*
set_input_delay -clock EBICLK -max tidmaxebipad     EBIEXTDATAIN*

set_input_delay -clock EBICLK -min tidebiipmin      EBITIMEOUTVALUE1*
set_input_delay -clock EBICLK -max tidmaxebipad     EBITIMEOUTVALUE1*

set_input_delay -clock EBICLK -min tidebiipmin      EBITIMEOUTVALUE2*
set_input_delay -clock EBICLK -max tidmaxebipad     EBITIMEOUTVALUE2*

set_input_delay -clock EBICLK -min tidebiipmin      EBITIMEOUTVALUE3*
set_input_delay -clock EBICLK -max tidmaxebipad     EBITIMEOUTVALUE3*

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR Ebi OUTPUT PORTS                                    */
/******************************************************************************/
set_output_delay -clock EBICLK -min tovebiopmin      EBIGNT1
set_output_delay -clock EBICLK -max todmaxebiport1   EBIGNT1

set_output_delay -clock EBICLK -min tovebiopmin      EBIBACKOFF1
set_output_delay -clock EBICLK -max todmaxebiport1   EBIBACKOFF1

set_output_delay -clock EBICLK -min tovebiopmin      EBIGNT2
set_output_delay -clock EBICLK -max todmaxebiport2   EBIGNT2

set_output_delay -clock EBICLK -min tovebiopmin      EBIBACKOFF2
set_output_delay -clock EBICLK -max todmaxebiport2   EBIBACKOFF2
 
set_output_delay -clock EBICLK -min tovebiopmin      EBIGNT3
set_output_delay -clock EBICLK -max todmaxebiport3   EBIGNT3

set_output_delay -clock EBICLK -min tovebiopmin      EBIBACKOFF3
set_output_delay -clock EBICLK -max todmaxebiport3   EBIBACKOFF3

set_output_delay -clock EBICLK -min tovebiopmin      EBIDATAIN*
set_output_delay -clock EBICLK -max todmaxebiport3   EBIDATAIN*

set_output_delay -clock EBICLK -min tovebiopmin      EBIEXTADDROUT*
set_output_delay -clock EBICLK -max tmuxpathmax      EBIEXTADDROUT*

set_output_delay -clock EBICLK -min tovebiopmin      EBIEXTDATAOUT*
set_output_delay -clock EBICLK -max tmuxpathmax      EBIEXTDATAOUT*

set_output_delay -clock EBICLK -min tovebiopmin      nEBIEXTDATAEN*
set_output_delay -clock EBICLK -max tmuxpathmax      nEBIEXTDATAEN*

/***************/
/* Scan Inputs */
/***************/
set_input_delay -clock EBICLK -min tidscanmin       SCANENABLE
set_input_delay -clock EBICLK -max tidscanmax       SCANENABLE

set_input_delay -clock EBICLK -min tidscanmin       SCANINEBICLK
set_input_delay -clock EBICLK -max tidscanmax       SCANINEBICLK

set_drive 0 SCANENABLE
/* Infinite drive strength Scan Enable signal */

remove_driving_cell find(port, SCANENABLE)
/* Set no driving cell on Scan Enable signal */

set_load 0 SCANENABLE
/* Zero load Scan Enable signal */

set_dont_touch_network find(port, SCANENABLE)
/* Preserve the Scan Enable net during optimisation */

/****************/
/* Scan Outputs */
/****************/
set_output_delay -clock EBICLK -min todscanmin       SCANOUTEBICLK
set_output_delay -clock EBICLK -max todscanmax       SCANOUTEBICLK

/************************* End of Ebi.scr *********************************/
