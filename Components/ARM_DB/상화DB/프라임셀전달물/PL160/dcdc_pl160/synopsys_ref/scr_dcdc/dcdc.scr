--------------------------------------------------------------------------------
-- Purpose : Synopsys synthesis timing
--           constraint script for DCDC block.
--
--           Located in the synopsys_ref/scr_dcdc directory.
--           Called by master compile script.
--
--           This file specifies the input and output delay
--           constraints for the non-AMBA I/O in the DCDC block.
------------------------------------------------------------------------------*/

/******************************************************************************/
/* DCDC BLOCK-SPECIFIC TIMING PARAMETERS                                      */
/******************************************************************************/

/* timing parameters for non-AMBA signals */
/* DCDCCLK clock parameters, set to the same frequency as PCLK */

tdclkh  = tclkh              /* clock high phase */
tdclkl  = tdclkh             /* clock low phase */
tdclk   = tdclkh + tdclkl    /* clock period */

/* plus uncertainty clock skew, for bestcase hold timing */
tdpskew = tpskew             /* plus clock skew */
/* minus uncertainty clock skew, for worstcase setup timing */
tdmskew = tmskew             /* minus clock skew */

/* Input setup and output valid are allocated as percentage of clock period,
   40% of clock period for Input setup time 
   20% of clock period for Output valid time */

/* Input setup and hold times */

tis = 0.4 * tdclk
tih = 0

/* Output valid and hold times */

tov = 0.2 * tdclk   /* DCDCCLK clock domain */
toh = 0

tpov = 0.2 * tclk   /* PCLK clock domain */
tpoh = 0

/* Convert the above into synthesis parameters */

tidmax = tdclk - tis
tidmin = tih

todmax = tdclk - tov
todmin = toh

tpodmax = tclk - tpov
tpodmin = tpoh


/******************************************************************************/
/* DEFINE CLOCK DCDCCLK                                                        */
/******************************************************************************/

/* Set DCDCCLK to the same frequency as PCLK, including clock skew */

create_clock -p tdclk -w {0 tdclkh} find(port, "DCDCCLK")
/* period tdclk, rise at 0, fall after tdclkh High phase */

set_clock_skew -ideal -plus_uncertainty tdpskew find(clock, DCDCCLK)
/* Set plus clock skew */

set_clock_skew -ideal -minus_uncertainty tdmskew find(clock, DCDCCLK)
/* Set minus clock skew */

set_clock_transition 0 DCDCCLK
/* Override transtion times as ideal clock */

set_drive 0 DCDCCLK
/* Infinite drive strength clock signal, for unbuffered net */

set_driving_cell -none find(port , DCDCCLK)
/* Set no driving cell on clock */

set_resistance 0 find(net , DCDCCLK)
/* Zero resistance for zero net delay(interconnect delay) on ideal clock net */

set_dont_touch_network find(clock, DCDCCLK)
/* Preserve the clock net during optimisation */

/******************************************************************************/
/* INPUT CONSTRAINTS FOR NON-AMBA PORTS                                       */
/******************************************************************************/

/* The following input delay constraints are arbitrary since the      */
/* corresponding signals are asynchronous to the clock that samples  */
/* them. Ensure that they are synchronized internally before use.     */

set_input_delay -clock DCDCCLK -min tdmskew DCDCDRIVE0IN
set_input_delay -clock DCDCCLK -max tidmax DCDCDRIVE0IN

set_input_delay -clock DCDCCLK -min tdmskew DCDCDRIVE1IN
set_input_delay -clock DCDCCLK -max tidmax DCDCDRIVE1IN

set_input_delay -clock DCDCCLK -min tdmskew DCDCFB0
set_input_delay -clock DCDCCLK -max tidmax DCDCFB0

set_input_delay -clock DCDCCLK -min tdmskew DCDCFB1
set_input_delay -clock DCDCCLK -max tidmax DCDCFB1

set_input_delay -clock DCDCCLK -min tdmskew DCDCDR0SEL
set_input_delay -clock DCDCCLK -max tidmax DCDCDR0SEL

set_input_delay -clock DCDCCLK -min tdmskew DCDCDR1SEL
set_input_delay -clock DCDCCLK -max tidmax DCDCDR1SEL

set_input_delay -clock DCDCCLK -min tdmskew nDCDCRST
set_input_delay -clock DCDCCLK -max tidmax nDCDCRST

set_drive 0 nDCDCRST
/* Infinite drive strength reset signal, for unbuffered net */

set_driving_cell -none find(port , nDCDCRST)
/* Set no driving cell on reset */

set_input_delay -clock PCLK -min tdmskew SCANMODE
set_input_delay -clock PCLK -max tidmax SCANMODE
    
set_max_fanout 1.0 SCANMODE
/* Maximum fanout of 1 for SCANMODE */

/******************************************************************************/
/* OUTPUT CONSTRAINTS FOR NON-AMBA PORTS                                      */
/******************************************************************************/

/*  DCDCCLK clock domain outputs */

set_output_delay -clock DCDCCLK -min todmin DCDCDRIVEOE
set_output_delay -clock DCDCCLK -max todmax DCDCDRIVEOE

set_output_delay -clock DCDCCLK -min todmin DCDCDRIVE0OUT
set_output_delay -clock DCDCCLK -max todmax DCDCDRIVE0OUT

set_output_delay -clock DCDCCLK -min todmin DCDCDRIVE1OUT
set_output_delay -clock DCDCCLK -max todmax DCDCDRIVE1OUT

/* There are no DCDC-specific PCLK clock domain outputs */

/************************************* End ************************************/
