-- -----------------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           MPMC Core block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the MpmcCore block synthesis. 
--
-- --=========================================================================*/
/**************************************************************************/
/* Set_false_path from the MPMCFBCLKIN domains to the HCLK domain as      */
/* these are read paths from the FIFO and the read data driven on the     */
/* rising edge of MPMCFBCLKIN is required to be captured on the rising    */
/* edge of HCLK after one clock period and not the immediate rising edge  */
/**************************************************************************/
set_false_path -from MPMCFBCLKIN* -to HCLK

/**************************************************************************/
/* Set_false_path from one clock domain to the other domain wherever      */
/* virtual clock has been used                                            */
/**************************************************************************/
set_false_path -from MPMCCLK -to v_MPMCCLKDELAY
set_false_path -from HCLK -to v_MPMCCLKDELAY
set_false_path -from v_MPMCCLKDELAY -to MPMCCLK
set_false_path -from v_MPMCCLKDELAY -to HCLK
set_false_path -from MPMCCLKDELAY -to MPMCCLK
set_false_path -from MPMCCLKDELAY -to HCLK

/**************************************************************************/
/* Set_false_path from MpmcCore inputs that are driven from MpmcTIC       */
/* since MpmcTIC is not required to function at 151 MHz                   */
/**************************************************************************/
set_false_path -from find(port, TBUSOUT)
set_false_path -from find(port, nTicDataEn)
set_false_path -from find(port, TESTACK)
set_false_path -from find(port, TICBUSREQ)

/************************ End of MpmcCore_exceptions.scr **********************/
