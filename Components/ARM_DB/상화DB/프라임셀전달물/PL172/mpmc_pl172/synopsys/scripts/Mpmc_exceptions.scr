--
-- -----------------------------------------------------------------------------
-- Purpose : 
--           Synopsys synthesis timing constraint script for the 
--           MPMC block             
--
--           Located in the synopsys/scripts directory.   
--
--           This file specifies the point-to-point exceptions 
--           set for the top level MPMC block synthesis. 
--
-- --=========================================================================*/
/******************************/
/* MPMCCLKOUT is a false path */
/******************************/
set_false_path -to find(port, "MPMCCLKOUT*")

/**************************************************************************/
/* False paths are being set for the MpmcTIC module which does not need   */
/* run at 156 MHz.                                                        */
/* All the normal-mode paths of the MpmcCore block are constrained.       */
/**************************************************************************/

/* uMpmcTIC/HRDATAIN to the MPMCDATAOUT path */
set_false_path -from find(port,"HRDATATIC*") \
               -to find(port,"MPMCDATAOUT*")

/* set_false_path from MPMCTESTIN and MPMCTESTREQA since these paths inside */
/* TIC do not need to run at 151 MHz */
set_false_path -from find(port,"MPMCTESTIN")
set_false_path -from find(port,"MPMCTESTREQB")
set_false_path -from find(port,"MPMCTESTREQA")

/* set_false_path from AHB inputs since TIC need not run at 151 MHz */
set_false_path -from find(port,"HREADYINTIC")
set_false_path -from find(port,"HRESPTIC*")
set_false_path -from find(port,"HGRANTTIC")

set_false_path -to find(pin,"uMpmcTIC/*HADDRTIC*/*")

set_false_path -to find(pin,"uMpmcTIC/*HPROT*/*")

set_false_path -to find(pin,"uMpmcTIC/*HSize*/*")

set_false_path -to find(pin,"uMpmcTIC/*HLOCK*/*")

set_false_path -to find(pin,"uMpmcTIC/*IncrmReg*/*")

/* set_false_path from TICBUSGNT within MpmcTIC since */
/* TIC does not need to run at 151 MHz */
set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(pin,"uMpmcTIC/*HADDRTIC*/*")

set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(pin,"uMpmcTIC/*HPROT*/*")

set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(pin,"uMpmcTIC/*HSize*/*")

set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(pin,"uMpmcTIC/*HLOCK*/*")

set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(pin,"uMpmcTIC/*IncrmReg*/*")

set_false_path -from find(pin,"uMpmcTIC/TICBUSGNT") \
               -to find(port,"MPMCDATAOUT")

/* set_false_path to all the registers within the MpmcTIC module */
set_false_path -to find(pin,"uMpmcTIC/*/*")

/* set_false_path on the combinational paths to the output ports arising */
/* from MpmcTIC since TIC does not need to run at 151 MHz */
set_false_path -from find(pin,"uMpmcCore/TBUSOUT*") \
               -to find(port,"MPMCDATAOUT*")

set_false_path -from find(pin,"uMpmcCore/nTicDataEn*") \
               -to find(port,"nMPMCDATAEN*")

set_false_path -from find(pin,"uMpmcCore/TICBUSREQ") \
               -to find(port,"MPMCEBIREQ")

set_false_path -from find(pin,"uMpmcCore/TESTACK") \
               -to find(port,"nMPMCWEOUT")

/**************************************************************************/
/* Set_false_path from all scan related inputs so that the tool should    */
/* not try to optimize the scan paths                                     */
/**************************************************************************/
set_false_path -from find(port,"SCANENABLE")
set_false_path -from find(port,"SCANINHCLK")
/* set_false_path on the combinational paths to the output ports arising */
/* from MpmcTIC since TIC does not need to run at 151 MHz */
set_false_path -from find(pin,"uMpmcCore/TBUSOUT*") \
               -to find(port,"MPMCDATAOUT*")

set_false_path -from find(pin,"uMpmcCore/nTicDataEn*") \
               -to find(port,"nMPMCDATAEN*")

set_false_path -from find(pin,"uMpmcCore/TICBUSREQ") \
               -to find(port,"MPMCEBIREQ")

set_false_path -from find(pin,"uMpmcCore/TESTACK") \
               -to find(port,"nMPMCWEOUT")

/**************************************************************************/
/* Set_false_path from all scan related inputs so that the tool should    */
/* not try to optimize the scan paths                                     */
/**************************************************************************/
set_false_path -from find(port,"SCANENABLE")
set_false_path -from find(port,"SCANINHCLK")
set_false_path -from find(port,"SCANINMPMCCLK")
set_false_path -from find(port,"SCANINFBCLKIN0")
set_false_path -from find(port,"SCANINFBCLKIN1")
set_false_path -from find(port,"SCANINFBCLKIN2")
set_false_path -from find(port,"SCANINFBCLKIN3")

/**************************************************************************/
/* Set_false_path from the MPMCFBCLKIN domains to the HCLK domain as      */
/* these are read paths from the FIFO and the read data driven on the     */
/* rising edge of MPMCFBCLKIN is required to be captured on the rising    */
/* edge of HCLK after one clock period and not the immediate rising edge  */
/**************************************************************************/
set_false_path -from find(clock,"MPMCFBCLKIN*") -to find(clock,"HCLK")

/**************************************************************************/
/* Set_false_path from one clock domain to the other domain wherever      */
/* virtual clock has been used                                            */
/**************************************************************************/
set_false_path -from find(clock,"MPMCCLK") -to find(clock,"v_MPMCCLKDELAY")
set_false_path -from find(clock,"HCLK") -to find(clock,"v_MPMCCLKDELAY")
set_false_path -from find(clock,"v_MPMCCLKDELAY") -to find(clock,"MPMCCLK")
set_false_path -from find(clock,"v_MPMCCLKDELAY") -to find(clock,"HCLK")
set_false_path -from find(clock,"MPMCCLKDELAY") -to find(clock,"MPMCCLK")
set_false_path -from find(clock,"MPMCCLKDELAY") -to find(clock,"HCLK")

/************************ End of Mpmc_exceptions.scr **************************/
