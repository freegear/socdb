test_protocol() {
   period : 100.00 ;
   delay : 5.00 ;
   bidir_delay : 55.00 ;
   strobe : 95.00 ;
   strobe_width : 0.00 ;

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : HCLK ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCCLK ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCFBCLKIN3 ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCFBCLKIN2 ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCCLKDELAY ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCFBCLKIN0 ;
   }

   clock() {
      period : 100.00 ;
      waveform : {45.00, 55.00} ;
      sources : MPMCFBCLKIN1 ;
   }
   protocol_start() {
      foreach_program() {
         vector() {
            set(all_ports,"[134]X,0,[259]X,[2]0,[34]X,[4]0,[21]X,[346]M");
         }
         vector() {
            set(all_ports,"[134]X,0,[43]X,1,[215]X,[2]0,[34]X,[4]0,[20]X,1,[346]M");
         }
         foreach_pattern() {
            stream(4688) {
               set(all_ports,"[134]U,C,[43]U,1,[215]U,[2]C,[34]U,[4]C,[12]U,1,[7]Si,1,[318]M,[7]So,[21]M");
            }
            vector() {
               set(all_ports,"[134]Pi,0,[259]Pi,[2]0,[34]Pi,[4]0,[21]Pi,[346]Po");
            }
            vector() {
               set(all_ports,"[134]U,Cp,[259]U,[2]Cp,[34]U,[4]Cp,[21]U,[346]M");
            }
            vector() {
               set(all_ports,"[134]U,0,[43]U,1,[215]U,[2]0,[34]U,[4]0,[12]U,1,[7]U,1,[318]M,[7]So,[21]M");
            }
         }
      }
   }

