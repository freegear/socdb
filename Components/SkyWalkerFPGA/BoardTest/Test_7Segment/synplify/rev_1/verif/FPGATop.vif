# Set logfile options
vif_set_result_file  FPGATop.vlf

# Set technology for TCL script
vif_set_technology -architecture FPGA -vendor Xilinx

# RTL and technology files
vif_add_library -original $XILINX/verilog/verification/unisims
vif_add_library -original $XILINX/verilog/verification/simprims
vif_add_file -original -verilog ../../rtl/SevenSegment.v
vif_add_file -original -verilog ../../rtl/FPGATop.v
vif_set_top_module -original -top FPGATop
 
vif_add_library -translated $XILINX/verilog/verification/unisims
vif_add_library -translated $XILINX/verilog/verification/simprims
vif_add_file -translated -verilog FPGATop.vm
vif_set_top_module -translated -top FPGATop 
# Read FSM encoding
vif_set_fsm -fsm fsm_0
vif_set_fsmreg -original -fsm fsm_0 SevenSegment/CommonOut[3:0]
vif_set_fsmreg -translated -fsm  fsm_0 SevenSegment/CommonOut_1[1:0]
vif_set_state_map -fsm fsm_0 -original "0001" -translated "00"
vif_set_state_map -fsm fsm_0 -original "0010" -translated "01"
vif_set_state_map -fsm fsm_0 -original "0100" -translated "10"
vif_set_state_map -fsm fsm_0 -original "1000" -translated "11"

