# Technology sequential redundancies
vif_set_equiv -translated counter_Z[0] counter_fast_Z[0]
vif_set_equiv -translated counter_Z[17] counter_iso_Z[17]

# Inversion map points
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[7] -translated SevenSegment/ControlOut_i_Z[7]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[6] -translated SevenSegment/ControlOut_i_Z[6]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[5] -translated SevenSegment/ControlOut_i_Z[5]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[4] -translated SevenSegment/ControlOut_i_Z[4]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[3] -translated SevenSegment/ControlOut_i_Z[3]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[2] -translated SevenSegment/ControlOut_i_Z[2]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[1] -translated SevenSegment/ControlOut_i_Z[1]
vif_set_map_point -register -inverted -original SevenSegment/ControlOut[0] -translated SevenSegment/ControlOut_i_Z[0]

