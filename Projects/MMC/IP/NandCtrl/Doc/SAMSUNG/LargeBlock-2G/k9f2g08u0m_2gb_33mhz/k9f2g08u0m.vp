//*****************************************************************************
//  K9F2G08U0M, 2Gbit(x8/3.3v) 1st Generation NAND FLASH TIMING VECTOR
//  Programmed By NAND Flash Memory Design Team, Samsung Semiconductor Co. LTD.
//  Rev. 0.0 -- JAN. 2002
//*****************************************************************************

`timescale    1ns / 1ns
 
// A.C spec

`define tCLS    10    	// CLE Setup Time
`define tCLH    5       // CLE Hold Time
`define tCS     15      // /CE Setup Time
`define tCH     5       // /CE Hold Time
`define tALS    10      // ALE Setup Time
`define tALH    5       // ALE Hold Time
`define tDS     10      // Data Setup Time
`define tDH     5       // Data Hold Time
`define tWP     15      // /WE Pulse Width
`define tWH     10      // /WE High Hold Time
`define tWC     30      // Write Cycle Time
`define tR  	25000  	// Data Transfer from Cell to Register
`define tAR1	10 	// ALE to /RE Delay(ID read)
`define tAR2	10	// ALE to /RE Delay(Read cycle)
`define tCLR	10	// CLE to /RE Delay
`define tRR 	20 	// Ready to /RE Low
`define tRP 	15 	// /RE Pulse Width 
`define tWB 	100	// /WE High to Busy(100)
`define tRC 	30	// Read Cycle Time 
`define tREA	18	// /RE Access Time
`define tCEA    23      // /CE Access Time
`define tRHZ	30	// /RE High to Output Hi-z
`define tCHZ	20	// /CE High to Output Hi-z
`define tREH	10	// /RE High Hold Time
`define tIR	0 	// Output Hi-Z to /RE Low
`define tWHR 	60 	// /WE High to /RE Low
`define tRST_R	5000	// Device Reset Time(Read) 
`define tRST_P	10000	// Device Reset Time(Program) 
`define tRST_E	500000	// Device Reset Time(Erase) 
`define tPROG	300000	// Program Time
`define tBERS	2000000	// Erase Time
`define tDBSY   3000    // Dummy Busy Time for Cache Program



module k9f2g08u0m(ceb, cle, ale, web, reb, io, wpb, rbb, pre, vdd);
inout	[7:0]	io; 
input		cle, ale, pre, vdd; 
input		ceb, web, reb, wpb;
output		rbb; 

