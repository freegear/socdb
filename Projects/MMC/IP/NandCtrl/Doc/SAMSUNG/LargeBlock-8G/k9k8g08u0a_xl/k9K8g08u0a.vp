//  Rev. 1.0 -- DEC. 2005 by Hyun
//*****************************************************************************

`timescale    1ns / 10ps
//`timescale    1ns / 1ps
 
 /*
// A.C spec
`define tCLS    10     	// CLE Setup Time
`define tCLH    5      // CLE Hold Time
`define tCS     15       // /CE Setup Time
`define tCH     5      // /CE Hold Time
`define tALS    10       // ALE Setup Time
`define tALH    5      // ALE Hold Time
`define tDS     10      // Data Setup Time
`define tDH     5      // Data Hold Time
`define tWP     12      // /WE Pulse Width
`define tWH     10      // /WE High Hold Time
`define tWC     25      // Write Cycle Time
`define tADL    50      // ALE to Data Loading Time
`define tR  	25000  	// Data Transfer from Cell to Register 20us -> 25us 06.02.23

`define tAR1	10 	// ALE to /RE Delay(ID read)
`define tAR2	50	// ALE to /RE Delay(Read cycle)

`define tCLR	10	// CLE to /RE Delay
`define tRR 	20 	// Ready to /RE Low
`define tRP 	12 	// /RE Pulse Width 
`define tWB 	100	// /WE High to Busy(100)
`define tRC 	25	// Read Cycle Time 
`define tREA	18	// /RE Access Time
`define tCEA    23      // /CE Access Time
`define tRHZ	60	// /RE High to Output Hi-z
`define tOH     30      // Data Hold Time
`define tCHZ	60	// /CE High to Output Hi-z
`define tREH	10	// /RE High Hold Time
`define tIR	0 	// Output Hi-Z to /RE Low
`define tWHR 	60 	// /WE High to /RE Low
`define tRST_R	5000	// Device Reset Time(Read) 
`define tRST_P	10000	// Device Reset Time(Program) 
`define tRST_E	500000	// Device Reset Time(Erase) 
`define tPROG	400000	// Program Time 400us -> 200us 05.12.09
`define tBERS	2000000	// Erase Time 2ms -> 1.5ms 05.12.09
*/


// chip interleave 05.12.14
`define tCLS    12     	// CLE Setup Time (10ns -> 12ns 05.12.09)
`define tCLH    5      // CLE Hold Time
`define tCS     20       // /CE Setup Time (15ns -> 20ns 05.12.09)
`define tCH     5      // /CE Hold Time
`define tALS    12       // ALE Setup Time (10ns -> 12ns 05.12.09)
`define tALH    5      // ALE Hold Time
`define tDS     12      // Data Setup Time (10ns -> 12ns 05.12.09)
`define tDH     5      // Data Hold Time
`define tWP     12      // /WE Pulse Width
`define tWH     10      // /WE High Hold Time
`define tWC     25      // Write Cycle Time
`define tADL    70      // ALE to Data Loading Time (50ns -> 70ns 05.12.09)
`define tR  	25000  	// Data Transfer from Cell to Register (20us -> 25us 06.02.23)

`define tAR1	10 	// ALE to /RE Delay(ID read)
`define tAR2	50	// ALE to /RE Delay(Read cycle)

`define tCLR	10	// CLE to /RE Delay
`define tRR 	20 	// Ready to /RE Low
`define tRP 	12 	// /RE Pulse Width 
`define tWB 	100	// /WE High to Busy(100)
`define tRC 	25	// Read Cycle Time 
`define tREA	20	// /RE Access Time (18ns -> 20ns 05.12.09)
`define tCEA    25      // /CE Access Time (23ns -> 25ns 05.12.09)
`define tRHZ	100	// /RE High to Output Hi-z (60ns -> 100ns 05.12.09)
`define tOH     30      // Data Hold Time
`define tCHZ	30	// /CE High to Output Hi-z (60ns -> 30ns 05.12.09)
`define tREH	10	// /RE High Hold Time
`define tIR	0 	// Output Hi-Z to /RE Low
`define tWHR 	60 	// /WE High to /RE Low
`define tRST_R	5000	// Device Reset Time(Read) 
`define tRST_P	10000	// Device Reset Time(Program) 
`define tRST_E	500000	// Device Reset Time(Erase) 
`define tPROG	200000	// Program Time (400us -> 200us 05.12.09)
`define tBERS	1500000	// Erase Time (2ms -> 1.5ms 05.12.09)
// end 05.12.13

module k9f4g08u0a(ceb, cle, ale, web, reb, io, wpb, rbb, vdd);
inout	[7:0]	io; 
input		cle, ale, vdd; 
input		ceb, web, reb, wpb;
wire		rbb_1, rbb_2; // chip interleave 05.12.08
output		rbb; 

assign		rbb = (rbb_1 && rbb_2) ; // chip interleave 05.12.08
supply0 gnd; // chip interleave 05.12.08
supply1 vcc; // chip interleave 05.12.08

