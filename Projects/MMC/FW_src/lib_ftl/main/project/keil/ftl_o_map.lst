 200   3                              )
 201   3                              {
 202   4                                      // Fatal
 203   4                                      return SMT_FALSE; 
 204   4                              }
 205   3      
 206   3                              // update last information of pba , ppo
 207   3                              // And seek to next ppo
 208   3                              map->LastPBA    = map->curPBA; 
 209   3                              map->LastPPO    = map->curPPO;  
 210   3                              map->curPPO++;                          
 211   3      
 212   3                              goto again;
