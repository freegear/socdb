 248   2                      {
 249   3                              // check if it is a map page
 250   3                              if (sptr->u.map.block_type & FTL_BTYPE_MAPPAGE) 
 251   3                              {
 252   4                                      pfragMap                = &gpMapDir[sptr->u.map.frag];
 253   4                                      pfragMap->PBA   = pba;                                  
 254   4                                      pfragMap->PPO   = ppo;                                  
 255   4                                      pfragMap->index = FTL_L_M0_0;                           
 256   4                                      
 257   4                                      mappage = 1;                                            
 258   4                              }
 259   3                      }
 260   2      
 261   2                      // go to next page 
