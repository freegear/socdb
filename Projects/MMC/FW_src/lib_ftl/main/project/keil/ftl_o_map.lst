 214   2              }
 215   1      
 216   1              //-------------------------------------------------------
 217   1              // remain mapPageBlk is not aligned
 218   1              //-------------------------------------------------------
 219   1              while(SMT_TRUE)
 220   1              {
 221   2                      //---------------------------------------------------
 222   2                      // Check next block (shadow)
 223   2                      //---------------------------------------------------
 224   2                      if(ppo == gDevInfo.pagePerBlks) 
