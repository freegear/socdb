 169   3                              pfragMap->index = FTL_L_M0_1;   
 170   3                              pfragMap++;                             
 171   3      
 172   3                              frag+=2;                                // go to next 2 fragment 
 173   3                              fragcou--;                              // decrementing pair counter 
 174   3      
 175   3                              // goto next page 
 176   3                              ppo++; 
 177   3                      }
 178   2                      else
C51 COMPILER V8.05a   FTL_O_MAP                                                            06/28/2007 17:29:24 PAGE 4   

 179   2                      {
 180   3                              // broken mapdir, so step back check if there was any step back 
