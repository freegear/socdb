 130   1              
 131   1      
 132   1              //-------------------------------------------------------
 133   1              // First mapPageBlk is aligned mappage + frags or frags
 134   1              //-------------------------------------------------------
 135   1              mappage         = 0;                                            // signal we didn't find any map page 
 136   1              idxcou          = 0;                                            // reset index counter 
 137   1              index           = map->mapPageBlk[idxcou];      // get its value 
 138   1              SMT_ASSERT(index != INDEX_NA);                  // 1st index cannot be not available
 139   1      
