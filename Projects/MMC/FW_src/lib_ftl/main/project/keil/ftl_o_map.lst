 263   2              }
 264   1              
 265   1      
 266   1              // check if any mappage found 
 267   1              if (!mappage)
 268   1              {
 269   2                      // no mappage found, eg. FLT missing after format 
 270   2                      return SMT_FALSE; 
 271   2              }
 272   1      
 273   1              // successfuly built 
 274   1              return SMT_TRUE; 
 275   1      }
