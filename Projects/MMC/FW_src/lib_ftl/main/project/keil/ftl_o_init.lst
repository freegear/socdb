  65          /*----------------------------------------------------------
  66                  Function name   : FTL_O_Init
  67                  Prototype               : 
  68                  Return                  : 
  69                  Argument                : 
  70                  Comments                : Initialize this layer, this function must
  71                                                    be called at the begining befores lowinit
  72          -----------------------------------------------------------*/
  73          smtBoolean              // SMT_TRUE/SMT_FALSE, success/any error
  74          FTL_O_Init(
  75          void
  76          )
  77          {
  78   1              smtUint32       wear_sum                = 0;    /* summary of wears */
  79   1              smtUint32       wear_count              = 0;    /* counting number of wears  */
  80   1              smtUint32       wear_average    = 0;
  81   1              smtBlkAddr      pba;
  82   1              ST_SPARE        *sptr;
  83   1      
  84   1              smtUint32       mapBlkIdx;
  85   1              smtUint32       refCnt;
  86   1              ST_MAPBLOCK     *map;
  87   1      
  88   1              printf("[FTL_O_Init]+\n");
  89   1      
  90   1              sptr = GET_SPARE_AREA(ml_buffer);
  91   1      
  92   1              //-------------------------------------------------------
  93   1              // search last map blk 
  94   1              //-------------------------------------------------------
  95   1              for (pba = 0; pba < gDevInfo.blks; pba++)
  96   1              {
  97   2              
  98   2                      //---------------------------------------------------
  99   2                      // (MAPBLOCK) Check map block ecc
 100   2                      //---------------------------------------------------
 101   2                      /*
 102   2                      {
 103   2                              smtUint32       block_type_ptr_pos;
 104   2      
 105   2                              block_type_ptr_pos 
 106   2                                      = (smtUint8)
 107   2                                      (
 108   2                                              (smtUint32)(&sptr->u.map.block_type)
 109   2                                              -(smtUint32)(sptr)
 110   2                                      );
 111   2      
 112   2                              if (FTL_L_ReadOne(
 113   2                                              pba,                                                            // block offset
 114   2                                              0,                                                                      // page offset
 115   2                                              (smtUint8)block_type_ptr_pos,           // block_type's position
 116   2                                              &block_type))                                           // destination buffer
C51 COMPILER V8.05a   FTL_O_INIT                                                           06/28/2007 17:29:23 PAGE 3   

 117   2                              {
 118   2                                      continue; // pre selecting blocks 
 119   2                              }
 120   2                              block_type &= FTL_BTYPE_MASK;           // block type check 
 121   2                              if ((block_type == BLK_TYPE_INV)        // check 2bit error
 122   2                               || (!block_type))                                      
 123   2                              {
 124   2                                      continue; // skip 2 bit errors, no map block 
 125   2                              }
 126   2                      }
 127   2                      */
 128   2      
 129   2                      //---------------------------------------------------
 130   2                      // (MAPBLOCK) Check mapblock type
 131   2                      //---------------------------------------------------
 132   2                      if (!FTL_L_ReadPart(
 133   2                                      pba,                                    // block offset
 134   2                                      0,                                              // first page
 135   2                                      (smtUint8*)sptr,                // spare area pointer
 136   2                                      FTL_L_S0)                               // spare area
 137   2                              )
 138   2                      {
 139   3      
 140   3                              // Make wear information sum
 141   3                              if (sptr->wear < WEAR_NA)
 142   3                              {
 143   4                                      wear_count++;                           
 144   4                                      wear_sum        += sptr->wear;                          
 145   4                              }
 146   3      
 147   3                              // remove MAPBLOCK & MAPPAGE flag
 148   3                              mapBlkIdx       =       sptr->u.map.block_type  & ~FTL_BTYPE_MAPBLK;    
 149   3                              mapBlkIdx       =       mapBlkIdx                               & ~FTL_BTYPE_MAPPAGE;
 150   3                              if ((mapBlkIdx >= 0) 
 151   3                              &&  (mapBlkIdx <  FTL_MAPBLOCK_NUM)) 
 152   3                              {
 153   4      
 154   4                                      map             = &gpMapBlocks->mapBlks[mapBlkIdx];
 155   4                                      refCnt  = sptr->u.map.ref_count;
 156   4      
 157   4                                      // Check max wear, don't use it
 158   4                                      if(map->curPBA != BLK_NA)
 159   4                                      {
 160   5                                              if(map->ref_count < refCnt)
 161   5                                              {
 162   6                                                      if(refCnt-map->ref_count > 64)
 163   6                                                      continue;
 164   6                                              }
 165   5                                              else
 166   5                                              {
 167   6                                                      if(map->ref_count - refCnt < 64)
 168   6                                                      continue;
 169   6                                              }
 170   5                                      }
 171   4      
 172   4                                      // Set ST_MAPBLOCK::curPBA, ST_MAPBLOCK::ref_count
 173   4                                      map->curPBA             = pba;
 174   4                                      map->ref_count  = refCnt;
 175   4      
 176   4                                      printf("[FTL_O_Init] ------------------------------\n");
 177   4                                      printf("[FTL_O_Init] Found mapblock %d \n", mapBlkIdx);
 178   4                                      printf("[FTL_O_Init] ------------------------------\n");
C51 COMPILER V8.05a   FTL_O_INIT                                                           06/28/2007 17:29:23 PAGE 4   

 179   4                                      printf("[FTL_O_Init] %30s : %d\n", "ST_MAPBLOCK::curPBA"        ,map->curPBA);
 180   4                                      printf("[FTL_O_Init] %30s : %d\n", "ST_MAPBLOCK::ref_count"     ,map->ref_count);
 181   4      
 182   4                              }
 183   3                      }
 184   2              }
 185   1      
 186   1      
 187   1              printf("[FTL_O_Init]-\n");
 188   1      
 189   1              return SMT_TRUE;
 190   1      }


