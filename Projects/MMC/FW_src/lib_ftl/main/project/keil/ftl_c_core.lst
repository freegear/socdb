 535   1              if(mapblock->curPPO == 0)
 536   1              {
 537   2                      // wear level and reference counter information 
 538   2                      sptr->wear                              = gpWearAllocData->free_wear;   
 539   2                      sptr->u.map.ref_count   = mapblock->ref_count;                          
 540   2              }
 541   1      
