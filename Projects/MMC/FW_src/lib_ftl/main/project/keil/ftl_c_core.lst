 187          /*----------------------------------------------------------
 188                  Function name   : FTL_C_GetFrag
 189                  Prototype               : 
 190                  Return                  : 
 191                  Argument                : 
 192                  Comments                : function copy the requested frag content 
 193                                                    to destionation buffer if its cached then 
 194                                                    it copies other case it reads
 195          -----------------------------------------------------------*/
 196          void                            // None
 197          FTL_C_GetFrag(
 198          smtFrag                 frag,   // Requested fragment number
 199          smtUint8        *dest   // Destination buffer
 200          ) 
 201          {
 202   1              FTL_C_LoadFrag(frag);
 203   1              
 204   1              // simple copy 
 205   1              memcpy(
 206   1                      dest,
 207   1                      gpFragCache->ppba,
 208   1                      512/2//(smtInt32)gDevInfo.pageSize/2
 209   1              ); 
 210   1              
 211   1              
 212   1      }
 213          /*----------------------------------------------------------
 214                  Function name   : FTL_C_CollectFrag
 215                  Prototype               : 
 216                  Return                  : 
 217                  Argument                : 
 218                  Comments                : function collects store or cached fragments
 219          -----------------------------------------------------------*/
 220          smtBoolean                              // SMT_TRUE/SMT_FALSE, success/other error
 221          FTL_C_CollectFrag(
 222          ST_MAPBLOCK     *mapblock       // mapblock which contains fragtments
 223          )
 224          {
 225   1              smtFrag         cou;            
 226   1              smtFrag         frag;                                   
 227   1              smtUint8        *dest;
 228   1      
 229   1      //      printf("[FTL_C_CollectFrag]+\n");
 230   1      
 231   1      
 232   1              cou             = (smtFrag)(gpMapBlocks->maxFragPerMapBlk/2);
 233   1              frag    = mapblock->startFragIdx;                                       
 234   1      
 235   1              //-------------------------------------------------------
 236   1              // collect all fragments 
 237   1              //-------------------------------------------------------
 238   1              while (cou--)                                   
 239   1              {
 240   2      
C51 COMPILER V8.05a   FTL_C_CORE                                                           06/28/2007 17:29:23 PAGE 5   

 241   2                      // collect 1st half is for even frags and get fragment
 242   2                      dest = ml_buffer;                                                       
 243   2                      FTL_C_GetFrag(frag, dest);                              
 244   2      
 245   2                      // collect 2nd half is for odd frags and get fragment
 246   2                      //dest += gDevInfo.pageSize/2;                                  
 247   2                      dest += 512/2;
 248   2                      FTL_C_GetFrag((smtFrag)(frag+1),dest);  
 249   2      
 250   2                      // simple writes them 
 251   2                      if (!FTL_C_WriteFrag(frag, ml_buffer)) 
 252   2                      {
 253   3                              SMT_ASSERT(0);
 254   3                              return SMT_FALSE;
 255   3                      }
 256   2      
 257   2                      // 2 fragment per page 
 258   2                      frag += 2;                                                              
 259   2              }
 260   1      //      printf("[FTL_C_CollectFrag]-\n");
 261   1      
 262   1              return SMT_TRUE;
 263   1      }
