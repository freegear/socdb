  55          /*----------------------------------------------------------
  56                  Function name   : FTL_C_LoadFrag
  57                  Prototype               : 
  58                  Return                  : 
  59                  Argument                : 
  60                  Comments                : load frag into RAM and set as current frag
  61          -----------------------------------------------------------*/
  62          smtBoolean                      // SMT_TRUE/SMT_FALSE, success/error
  63          FTL_C_LoadFrag(
  64          smtFrag num                     // fragment number to load
  65          )
  66          {
  67   1              ST_MAPDIR       *pfragMap;
  68   1              smtUint8        ret;
  69   1      
  70   1              // load if not cached 
  71   1              if(gpFragCache->num != num)
  72   1              {
  73   2                      FTL_C_SaveMap();
  74   2      
  75   2                      // get cache entry buffer's and current frag map pointer
  76   2                      pfragMap = &gpMapDir[num];                      
  77   2                      
  78   2                      // read that half part 
  79   2                      if (ret = FTL_L_ReadPart(
  80   2                              pfragMap->PBA,                          // Target fragment pba
  81   2                              pfragMap->PPO,                          // Target fragment ppo
  82   2                              (smtUint8*)gpFragCache->ppba,// Target buffer for pbas
  83   2                              pfragMap->index)                        // Nand region index
  84   2                      ) 
  85   2                      {
  86   3                              gpFragCache->num = FRAG_NA;
  87   3                              SMT_ASSERT(0);
  88   3                              return SMT_FALSE;
  89   3                      
  90   3                      }
  91   2      
  92   2                      // set cache field to current fragnumber and pointer
  93   2                      gpFragCache->num        = num;          
  94   2              }
  95   1      
  96   1              return SMT_TRUE;
  97   1      }
  98          /*----------------------------------------------------------
  99                  Function name   : FTL_C_WriteFrag
 100                  Prototype               : 
 101                  Return                  : 
 102                  Argument                : 
 103                  Comments                : subfunction for formatting to write current 
 104                                                    fragments in fragbuff
 105          -----------------------------------------------------------*/
 106          smtBoolean                      // SMT_TRUE/SMT_FALSE, success/other error
 107          FTL_C_WriteFrag(
 108          smtFrag         frag,   // current frag number
 109          smtUint8        *buff   // fragment cache buffer
 110          )
 111          {
 112   1              ST_MAPBLOCK             *mapblock       = FTL_C_GetfMapBlk(frag);
 113   1              ST_SPARE                *sptr;
 114   1              ST_MAPDIR               *mapdir;
 115   1      
 116   1      
C51 COMPILER V8.05a   FTL_C_CORE                                                           06/28/2007 17:29:23 PAGE 3   

 117   1              // FATAL, out of range 
 118   1              if (!mapblock) 
 119   1              {
 120   2                      return SMT_FALSE;       
 121   2              }
 122   1      
 123   1              // Check if there is any space 
 124   1              if (mapblock->curPPO == gDevInfo.pagePerBlks) 
 125   1              {
 126   2                      // allocate another block 
 127   2                      FTL_C_AllocMapBlk(mapblock);
 128   2              }
 129   1      
 130   1              // check if this is the 1st page of the mapblock 
 131   1              // here this is the 1st write of the block and
 132   1              // write reference counter 
 133   1              sptr = GET_SPARE_AREA(buff);
 134   1              if (mapblock->curPPO == 0) 
 135   1              {
 136   2                      sptr->wear                              = 1;                                    
 137   2                      sptr->u.map.ref_count   = mapblock->ref_count;  
 138   2              }
 139   1              // signal original fragments here, store the fragment number
 140   1              sptr->u.map.block_type  = mapblock->blockType;          
 141   1              sptr->u.map.frag                = frag;                                         
 142   1      
 143   1              if (FTL_L_Write(
 144   1                      mapblock->curPBA, 
 145   1                      mapblock->curPPO, 
 146   1                      buff) != FTL_L_OK) 
 147   1              {
 148   2                      SMT_ASSERT(0);
 149   2                      // Fatal 
 150   2                      return SMT_FALSE; 
 151   2              }
 152   1      
 153   1              // store mapdir info 2 frags are a pair in the fragment area 
 154   1              mapdir                  = &gpMapDir[frag];      
 155   1              mapdir->PBA             = mapblock->curPBA;
 156   1              mapdir->PPO             = mapblock->curPPO;
 157   1              mapdir->index   = FTL_L_M0_0;
 158   1      
 159   1              // goto the next mapdir (2nd frag) 
 160   1              mapdir++;                                       
 161   1              mapdir->PBA             = mapblock->curPBA;
 162   1              mapdir->PPO             = mapblock->curPPO;
 163   1              mapdir->index   = FTL_L_M0_1;
 164   1      
 165   1              // goto next available 
 166   1              mapblock->curPPO++;     
 167   1      
 168   1              /*
 169   1              printf("[FTL_C_WriteFrag] -----------------------------\n");
 170   1              printf("[FTL_C_WriteFrag] %15s %d(%5d~%5d) - %d(%5d~%5d)\n", 
 171   1                                                              "Write fragment"
 172   1                                                              ,frag 
 173   1                                                              ,FTL_FRAG_POOLPERNUM*frag 
 174   1                                                              ,FTL_FRAG_POOLPERNUM*frag + FTL_FRAG_POOLPERNUM-1
 175   1                                                              ,frag+1
