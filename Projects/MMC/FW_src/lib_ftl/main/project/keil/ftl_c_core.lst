 177   1                                                              ,FTL_FRAG_POOLPERNUM*(frag+1) + FTL_FRAG_POOLPERNUM-1
 178   1                                                              );
C51 COMPILER V8.05a   FTL_C_CORE                                                           06/28/2007 17:29:23 PAGE 4   

 179   1              printf("[FTL_C_WriteFrag] -----------------------------\n");
 180   1              printf("[FTL_C_WriteFrag] %30s : %d\n", "MAP block block address", mapblock->curPBA);
 181   1              printf("[FTL_C_WriteFrag] %30s : %d\n", "MAP block page address", (mapblock->curPPO-1));
 182   1              */
 183   1      
 184   1              return SMT_TRUE;
 185   1      }
