 555   1              gpFlush->mapInfo->mapCntL++;
 556   1              if(!gpFlush->mapInfo->mapCntL)
 557   1              {
 558   2                      gpFlush->mapInfo->mapCntH++;
 559   2              }
 560   1      
 561   1              
 562   1              // check if current fragment is cached (it has to be) 
 563   1              SMT_ASSERT(gpFragCache->num != FRAG_NA);
 564   1              
 565   1      
 566   1              return FTL_L_Write(
 567   1                              mapblock->curPBA,
 568   1                              mapblock->curPPO,
 569   1                              ml_basebuff);
 570   1      }
