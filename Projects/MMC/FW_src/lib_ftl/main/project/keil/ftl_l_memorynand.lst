 137          /*----------------------------------------------------------
 138                  Function name   : FTL_L_Write
 139                  Prototype               : 
 140                  Return                  : 
 141                  Argument                : 
 142                  Comments                : NAND write function
 143          ----------------------------------------------------------*/
 144          smtUint8                                // FTL_L_OK/FTL_L_ERROR
 145          FTL_L_Write(
 146          smtBlkAddr      pba,            // block address
 147          smtPageAddr ppo,                // page address
 148          smtUint8        *buffer         // source gbuffer
 149          ) 
 150          {
 151   1              smtUint32       page    = ppo;
 152   1              smtUint32       pos             = pba;
 153   1              smtUint8        *dest;
 154   1              smtUint32       a;
 155   1      
 156   1              dest = gl_data;
 157   1      
 158   1              if(pba >= gDevInfo.blks) 
 159   1              {
 160   2                      return FTL_L_ERROR;
 161   2              }
 162   1      
 163   1              if(ppo >= gDevInfo.pagePerBlks)
 164   1              {
 165   2                      return FTL_L_ERROR;
 166   2              }
 167   1      
 168   1              pos             *= MAX_BLOCK_SIZE;
 169   1              page    *= MAX_DLEN;
 170   1      
 171   1              dest+=(pos+page);
 172   1      
 173   1              if (!ppo) 
 174   1              {
 175   2                      smtUint32 newwear=GET_SPARE_AREA(buffer)->wear;
 176   2                      if(gl_wear[pba]+1 != newwear) 
 177   2                      {
 178   3                              a=10;
C51 COMPILER V8.05a   FTL_L_MEMORYNAND                                                     06/28/2007 17:29:24 PAGE 4   

 179   3                      }
 180   2                      gl_wear[pba]=newwear;
 181   2              }
 182   1      
 183   1              for (a = 0; a < MAX_DLEN; a++) 
 184   1              {
 185   2                      smtInt8 ch      =* dest;
 186   2                      smtInt8 ch2     =* buffer++;
 187   2                      *dest++=(smtUint8)(ch&ch2);
 188   2              }
 189   1      
 190   1              return FTL_L_OK;
 191   1      }
