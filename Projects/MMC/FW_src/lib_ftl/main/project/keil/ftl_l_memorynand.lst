 302   2                      smtUint8 ch     = *sou++;
C51 COMPILER V8.05a   FTL_L_MEMORYNAND                                                     06/28/2007 17:29:24 PAGE 6   

 303   2                      // simple erase chk 
 304   2                      if(ch != 0xFF) iserased=0; 
 305   2      
 306   2                      // if 1st half is requested 
 307   2                      if(index == FTL_L_M0_0) 
 308   2                      { 
 309   3                              if(a < 256) 
 310   3                              {
 311   4                                      *buffer++=ch;
 312   4                              }
 313   3                      }
 314   2                      else 
 315   2                      if(index == FTL_L_M0_1) 
