 193          /*----------------------------------------------------------
 194                  Function name   : FTL_L_Read
 195                  Prototype               : 
 196                  Return                  : 
 197                  Argument                : 
 198                  Comments                : NAND read operation by page unit
 199          ----------------------------------------------------------*/
 200          smtUint8                        // FTL_L_OK/FTL_L_ERASED/FTL_L_ERROR
 201          FTL_L_Read(
 202          smtBlkAddr      pba,    // block address
 203          smtPageAddr ppo,        // page address
 204          smtUint8        *buffer // target buffer
 205          ) 
 206          {
 207   1              smtUint8        *sou;
 208   1              smtUint32       a;
 209   1              smtUint32       page            = ppo;
 210   1              smtUint32       pos                     = pba;
 211   1              smtInt8         iserased        =       1;
 212   1      
 213   1              sou=gl_data;
 214   1      
 215   1      
 216   1              if(pba >= gDevInfo.blks) 
 217   1              {
 218   2                      return FTL_L_ERROR;
 219   2              }
 220   1      
 221   1              if(ppo >= gDevInfo.pagePerBlks)
 222   1              {
 223   2                      return FTL_L_ERROR;
 224   2              }
 225   1      
 226   1              pos             *= MAX_BLOCK_SIZE;
 227   1              page    *= MAX_DLEN;
 228   1              sou             += (pos+page);
 229   1      
 230   1      
 231   1      
 232   1              // we should go throught on all data+spare
 233   1              for(a = 0; a < MAX_DLEN; a++) 
 234   1              { 
 235   2                      smtUint8 ch=*sou++;
 236   2                      if(ch != 0xFF) 
 237   2                      {
 238   3                              // simple erase chk 
 239   3                              iserased = 0; 
 240   3                      }
C51 COMPILER V8.05a   FTL_L_MEMORYNAND                                                     06/28/2007 17:29:24 PAGE 5   

 241   2      
 242   2                      // if there is given buffer then store 
 243   2                      // the data into it 
 244   2                      if (buffer) 
 245   2                      {
 246   3                              *buffer++ = ch;
 247   3                      }
 248   2              }
 249   1      
 250   1              // if flasg is still set, returns with 
 251   1              // erased page 
 252   1              if(iserased) 
 253   1              {
 254   2                      return FTL_L_ERASED;     
 255   2              }
 256   1      
 257   1              return FTL_L_OK;
 258   1      }
