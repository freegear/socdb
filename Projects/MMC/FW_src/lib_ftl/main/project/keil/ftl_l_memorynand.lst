  68          /*----------------------------------------------------------
  69                  Function name   : FTL_L_Init
  70                  Prototype               : 
  71                  Return                  : 
  72                  Argument                : 
  73                  Comments                : Low level init function, this is called from
  74                                                    core FTL layer, only once
  75          ----------------------------------------------------------*/ 
  76          smtUint8        // FTL_L_OK/FTL_L_ERROR
  77          FTL_L_Init(
  78          void
  79          ) 
  80          {
  81   1              gDevInfo.blks                   = 8192;         
  82   1              gDevInfo.pagePerBlks    = 64;           
  83   1              gDevInfo.pageSize               = 2048;
  84   1      
  85   1      
  86   1              if (!allocated) 
  87   1              {
  88   2                      gl_data=malloc(MAX_SIZE);
  89   2                      allocated=1;
  90   2                      printf("data address: 0x%08x\n", gl_data);
  91   2              }
  92   1      
  93   1              if (!gl_wear) 
  94   1              {
  95   2                      gl_wear = malloc(sizeof(smtInt32)*gDevInfo.blks);
  96   2              }
  97   1      
  98   1              if ((!gl_data) || (!gl_wear)) 
  99   1              {
 100   2                      return FTL_L_ERROR;
 101   2              }
 102   1      
 103   1              if (!onceinit) 
 104   1              {
 105   2                      memset(gl_data, 0xFF, MAX_SIZE);
 106   2                      onceinit=1;
 107   2              }
 108   1      
 109   1              return FTL_L_OK;
 110   1      }
