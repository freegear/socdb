 119          smtUint8                                // FTL_L_OK/FTL_L_ERROR
 120          FTL_L_Erase(    
 121          smtBlkAddr pba
 122          ) 
 123          {
 124   1              smtUint32 pos = pba;
 125   1      
 126   1              if(pba >= gDevInfo.blks) 
 127   1              {
 128   2                      return FTL_L_ERROR;
 129   2              }
 130   1      
 131   1              pos     *= MAX_BLOCK_SIZE;
 132   1              memset((gl_data+pos),0xFF,MAX_BLOCK_SIZE);
 133   1      
 134   1              return FTL_L_OK;
 135   1      }
