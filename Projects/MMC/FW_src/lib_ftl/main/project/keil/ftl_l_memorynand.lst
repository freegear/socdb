 267          smtUint8                                // FTL_L_OK/FTL_L_ERASED/FTL_L_ERROR
 268          FTL_L_ReadPart(
 269          smtBlkAddr      pba,            // block address
 270          smtPageAddr ppo,                // page address
 271          smtUint8        *buffer,        // age data pointer where to store data (data+spare)
 272          smtUint8        index           // which part need to be stored (FTL_L_1ST/
 273                                                          // FTL_L_2ND/FTL_L_SP)
 274          ) 
 275          {
 276   1              
 277   1              smtUint32       a;
 278   1              smtInt8         iserased        = 1;
 279   1              smtUint32       page            = ppo;
