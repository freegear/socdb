 281   1              smtUint8        *sou            = gl_data;
 282   1      
 283   1      
 284   1              if (pba >= gDevInfo.blks) 
 285   1              {
 286   2                      return FTL_L_ERROR;
 287   2              }
 288   1      
 289   1              if(ppo >= gDevInfo.pagePerBlks) 
 290   1              {
