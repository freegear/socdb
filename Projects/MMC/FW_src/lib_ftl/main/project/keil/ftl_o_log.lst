  85   1              
  86   1              //-------------------------------------------------------
  87   1              // building log blocks 
  88   1              //-------------------------------------------------------
  89   1              gpLogCache->lockedCnt                   = 0;
  90   1              log                                                     = gpLogCache->logs;
  91   1              for(idx = 0; idx < gpFlush->freeBlkNum; idx++)
  92   1              {
  93   2      
  94   2                      if((gpFlush->freeBlks[idx]&(FTL_FBTYPE_MAP|FTL_FBTYPE_LOG))==FTL_FBTYPE_LOG)
  95   2                      {
  96   3                              pba                             = (smtBlkAddr)(gpFlush->freeBlks[idx]&FTL_BLKADDR_MASK);
  97   3                              log->lastppo    = gDevInfo.pagePerBlks;
  98   3                              log->pba                = pba;
  99   3                              log->switchable = 1;
 100   3                              log->index              = idx;
 101   3      
 102   3                              // searching the last page from top 
 103   3                              lastpo = gDevInfo.pagePerBlks;
 104   3                              for(po = 0;po < gDevInfo.pagePerBlks; po++)
 105   3                              { 
 106   4                                      int ret=FTL_L_Read(
 107   4                                                      pba,
 108   4                                                      (smtUint8)(gDevInfo.pagePerBlks-po-1),
 109   4                                                      ml_buffer
 110   4                                              );
 111   4                                      if (ret==FTL_L_ERASED) 
 112   4                                      {
 113   5                                              lastpo = (smtUint8)(gDevInfo.pagePerBlks-po-1);
 114   5                                      }
 115   4                                      else 
 116   4                                      {
C51 COMPILER V8.05a   FTL_O_LOG                                                            06/28/2007 17:29:22 PAGE 3   

 117   5                                              break;
 118   5                                      }
 119   4                              }
 120   3      
 121   3                              // building log blk 
 122   3                              log->lastppo = lastpo;
 123   3                              for(po = 0; po < lastpo; po++)
 124   3                              {               
 125   4                                      int ret = FTL_L_Read(pba,po,ml_buffer);
 126   4                                      if (ret == FTL_L_OK) 
 127   4                                      {
 128   5                                              log->ppo[sptr->u.log.lpo]       = po;
 129   5                                              log->lba                                        = sptr->u.log.lba;
 130   5                                              if (po != sptr->u.log.lpo) 
 131   5                                              {
 132   6                                                      log->switchable = 0;
 133   6                                              }
 134   5      
 135   5                                              if(!po)
 136   5                                              {
 137   6                                                      log->wear = sptr->wear;
 138   6                                              }
 139   5                                      }
 140   4                                      else 
 141   4                                      {
 142   5                                              // if error or hole in the log block 
 143   5                                              log->switchable = 0; 
 144   5                                      }
 145   4                              }
 146   3      
 147   3                              if (log->lastppo != 0)
 148   3                              {
 149   4                                      log++;
 150   4                                      gpLogCache->lockedCnt++;
 151   4                              }
 152   3                              else
 153   3                              {
 154   4                                      // nothing was written, so remove log block flag
 155   4                                      // reset data in not used log blk  
 156   4                                      gpFlush->freeBlks[idx]             &= (~FTL_FBTYPE_LOG);
 157   4                                      log->lastppo                                    = INDEX_NA;             
 158   4                                      log->pba                                                = BLK_NA;
 159   4                              }
 160   3                      }
 161   2              }
 162   1              
 163   1      }
