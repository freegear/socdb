 231   3                                                                                        
 232   3                              buffer  += 2048;
 233   3                      }
 234   2                      sso += ssn;
 235   2                      num -= ssn*SS_PER_SN;
 236   2              }
 237   1      
 238   1              // clip backward
 239   1              if(num%SS_PER_SN)
 240   1              {
