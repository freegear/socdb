 196   2                      
 197   2                      ret = FTL_O_Write(sso);
 198   2                      if(ret == 2) 
 199   2                      {
 200   3                              FTL_O_GCollect();
 201   3                              goto retry0;
 202   3                      }
 203   2                      if(ret == 1) return SMT_FALSE;          
 204   2      
 205   2      
 206   2                      buffer  += 512*sn;
 207   2                      sso             += 1;   
 208   2                      num             -= sn;
 209   2              }
 210   1              
 211   1              // center super sector
 212   1              if(num/SS_PER_SN)
 213   1              {
 214   2                      ssn = num/SS_PER_SN;
 215   2                      for(ssi = 0; ssi < ssn; ssi++)
 216   2                      {
 217   3      
 218   3      retry1:
