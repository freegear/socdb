 159          smtBoolean
 160          FTL_Write(
 161          smtUint32       sector, // sector address
 162          smtUint32       num,    // number of sector
 163          smtUint32       buffer  // source buffer
 164          )
 165          {
 166   1      
 167   1      #define SS_PER_SN       4       
 168   1      
 169   1              smtUint32       so, sn;
 170   1              smtUint32       sso, ssi, ssn;
 171   1              smtUint8        *pbufInternal;
 172   1              int     ret;
 173   1      
 174   1      
 175   1              
 176   1              // make super sector offset
 177   1              sso = sector/SS_PER_SN;
 178   1      
C51 COMPILER V8.05a   FTL                                                                  06/28/2007 17:29:22 PAGE 4   

 179   1              // clip forward
 180   1              if(sector%SS_PER_SN) 
 181   1              {
 182   2                      so      = sector%SS_PER_SN;
 183   2                      sn      = SS_PER_SN - sector%SS_PER_SN;
 184   2                      if(num < sn) sn = num;
 185   2                      
 186   2                              
 187   2      retry0: 
 188   2              
 189   2                      ret = FTL_O_Read(sso);
 190   2                      if(ret) return SMT_FALSE;
 191   2                              
 192   2                      pbufInternal = (smtUint8*)FTL_O_GetRWBuffer();
