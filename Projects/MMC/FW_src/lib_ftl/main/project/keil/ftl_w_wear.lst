 401          -----------------------------------------------------------*/
 402          void 
 403          FTL_W_UpdateDInfo(
 404          smtUint8        index,  // index of the block in free table entry
 405          smtUint32       wear    // wear info of given block
 406          ) 
 407          {
 408   1         if (index<gpFlush->freeBlkNum) 
 409   1         {
 410   2                      // Keep original data inside <e.g. for log,map blocks> 
 411   2                      if (wear<WEAR_NA)  
 412   2                      {
 413   3                              gl_dynamic_wear_info[index] = wear;
 414   3                      }
 415   2      
 416   2                      // optimalized! 
 417   2                      gl_dynamic_lock[index>>3] |= gl_lookup_mask[index&7]; 
 418   2              }
 419   1      }
