 143          /*----------------------------------------------------------
 144                  Function name   : FTL_W_CheckDPeak
 145                  Prototype               : 
 146                  Return                  : 0/other, Not found/ other found peek in dynamic area
 147                  Argument                : 
 148                  Comments                : searching in dynamic area if there is any 
 149                                                    wear which is bigger than the average
 150          -----------------------------------------------------------*/
 151          static 
 152          smtBoolean 
 153          FTL_W_CheckDPeak(
 154          void
 155          ) 
 156          {
 157   1              smtUint32       average = 0;
 158   1              smtUint32       avecou  = 0;
 159   1              smtUint8        idx;
 160   1              smtBlkAddr              *free_table;
 161   1      
 162   1              // get free table 
 163   1              free_table = gpFlush->freeBlks;
 164   1              for(idx = 0; idx < gpFlush->freeBlkNum; idx++,free_table++) 
 165   1              {
 166   2                      // check if block is not used (free) 
 167   2                      if (!((*free_table)&FTL_FBTYPE_BAD))      
 168   2                      {
 169   3                              // check if there is dynamic lock set 
 170   3                              if (!(gl_dynamic_lock[idx>>3]&gl_lookup_mask[idx&7]))  
 171   3                              {
 172   4                                      smtUint32 wear=gl_dynamic_wear_info[idx];
 173   4                                      if (wear!=WEAR_NA) 
 174   4                                      {
 175   5                                              average+=wear;
 176   5                                              avecou++;
 177   5                                      }
 178   4                              }
C51 COMPILER V8.05a   FTL_W_WEAR                                                           06/28/2007 17:29:24 PAGE 4   

 179   3                      }
 180   2              }
 181   1      
 182   1              // Check and caculate average 
 183   1              if (!avecou) return SMT_TRUE;
 184   1              average/=avecou;
 185   1      
 186   1              // get free table 
 187   1              free_table = gpFlush->freeBlks;
 188   1              for(idx = 0; idx < gpFlush->freeBlkNum; idx++, free_table++) 
 189   1              {
 190   2                      // check if block is not used (free) 
 191   2                      if(!((*free_table)&FTL_FBTYPE_BAD))       
 192   2                      {
 193   3                              // check if there is dynamic lock set 
 194   3                              if (!(gl_dynamic_lock[idx>>3]&gl_lookup_mask[idx&7]))  
 195   3                              {
 196   4                                      smtUint32 wear=gl_dynamic_wear_info[idx];
 197   4                                      if (wear!=WEAR_NA) 
 198   4                                      {
 199   5                                              // 75% of distance 
 200   5                                              if (wear>average+((3*WEAR_STATIC_LIMIT)/4))  
 201   5                                              {
 202   6                                                      return SMT_TRUE;
 203   6                                              }
 204   5                                      }
 205   4                              }
 206   3                      }
 207   2              }
 208   1      
 209   1              return SMT_FALSE;
 210   1      } 
 211          /*----------------------------------------------------------
 212                  Function name   : FTL_W_ChkStatic
 213                  Prototype               : 
 214                  Return                  : 0/1, If not needed/static wear necessary
 215                  Argument                : 
 216                  Comments                : checking if static wear is needed
 217          -----------------------------------------------------------*/
 218          smtBoolean 
 219          FTL_W_ChkStatic(
 220          void
 221          ) 
 222          {
 223   1              smtUint8        a;
 224   1              smtBlkAddr      static_lba      = BLK_NA;
 225   1              smtUint32       static_wear     = WEAR_NA;
 226   1      
 227   1              // search the lowest static 
 228   1              if ((!gl_static->cnt) || FTL_W_CheckDPeak())    
 229   1              {
 230   2                      for (a=0; a<MAXSTATICWEAR; a++) 
 231   2                      {
 232   3                              smtUint32 wear=gl_static->wear_info[a].wear;
 233   3                              smtBlkAddr lba=gl_static->wear_info[a].lba;
 234   3      
 235   3                              if ((wear!=WEAR_NA) && (lba!=BLK_NA)) 
 236   3                              {
 237   4                                      if (static_lba!=BLK_NA) 
 238   4                                      {
 239   5                                              // if its bigger continue 
 240   5                                              if (wear>=static_wear) 
C51 COMPILER V8.05a   FTL_W_WEAR                                                           06/28/2007 17:29:24 PAGE 5   

 241   5                                              {
 242   6                                                      continue;       
 243   6                                              }
 244   5                                      }
 245   4      
 246   4                                      static_lba=lba;
 247   4                                      static_wear=wear;
 248   4                              }
 249   3                      }
 250   2              }
 251   1      
 252   1          if(static_lba != BLK_NA)
 253   1              {
 254   2                      smtUint8                *lookup_mask    = (smtUint8 *)gl_lookup_mask;
 255   2                      smtUint8                *dynamic_lock   = gl_dynamic_lock;
 256   2                      smtBlkAddr              *free_table     = gpFlush->freeBlks;
 257   2                      smtUint8                find_index              = INDEX_NA;
 258   2                      smtUint32               find_wear               = WEAR_NA;
 259   2      
 260   2                      for (a=0; a < gpFlush->freeBlkNum; a++)
 261   2                      {
 262   3                              // search for the highest dynamic 
 263   3                              if (!( (*dynamic_lock) & (*lookup_mask) ) )
 264   3                              { // check if locked 
 265   4                                      
 266   4                                      if (!((*free_table) & FTL_FBTYPE_BAD))
 267   4                                      {       // if it is realy free 
 268   5                                              smtUint32 wear=gl_dynamic_wear_info[a];
 269   5      
 270   5                                              if (wear != WEAR_NA)
 271   5                                              {
 272   6                                                      if (find_index == INDEX_NA)
 273   6                                                      {
 274   7                                                              find_index      = a;
 275   7                                                              find_wear       = wear;
 276   7                                                      }
 277   6                                                      else if (wear>find_wear)
 278   6                                                      {       // if its bigger 
 279   7                                                              find_index      = a;
 280   7                                                              find_wear       = wear;
 281   7                                                      }
 282   6                                              }
 283   5                                      }
 284   4      
 285   4                                      free_table++;
 286   4                                      lookup_mask++;
 287   4      
 288   4                                      if ((a&7)==7)
 289   4                                      {
 290   5                                              // reset look up 
 291   5                                              lookup_mask=(smtUint8*)gl_lookup_mask; 
 292   5                                              // goto next bitfield; 
 293   5                                              dynamic_lock++;                         
 294   5                                      }
 295   4                              }
 296   3                      }
 297   2      
 298   2                      if (find_index!=INDEX_NA)
 299   2                      {
 300   3                              if (find_wear>static_wear+WEAR_STATIC_LIMIT)
 301   3                              {
 302   4                                      // incremented by 1! 
C51 COMPILER V8.05a   FTL_W_WEAR                                                           06/28/2007 17:29:24 PAGE 6   

 303   4                                      gpWearAllocData->free_index=find_index;
 304   4                                      gpWearAllocData->free_wear=find_wear+1; 
 305   4      
 306   4                                      gpWearAllocData->static_lba=static_lba;
 307   4                                      gpWearAllocData->static_wear=static_wear;
 308   4      
 309   4                                      gl_static->cnt=WEAR_STATIC_COUNT;
 310   4                                      // static wear successfully 
 311   4                                      return SMT_TRUE;         
 312   4                              }
 313   3                      }
 314   2              }
 315   1              else 
 316   1              {
 317   2                      gl_static->cnt--;
 318   2              }
 319   1      
 320   1              gpWearAllocData->free_index     = INDEX_NA;
 321   1              gpWearAllocData->static_lba     = BLK_NA;
 322   1              gpWearAllocData->static_wear    = WEAR_NA;
 323   1      
 324   1              // no static wear needed 
 325   1              return SMT_FALSE;
 326   1      }
 327          /*----------------------------------------------------------
 328                  Function name   : FTL_W_AllocWear
 329                  Prototype               : 
 330                  Return                  : none
 331                  Argument                : 
 332                  Comments                : 
 333                  
 334                          allocates a block from free table list according to theirs wear 
 335                          level info datas will be unchanged in all table (calling twice 
 336                          it returns with same values) if static_lba is not equal with 
 337                          BLK_NA then static wear heandler has to be called immediately. 
 338                          gl_wear_allocstruct holds all the information                                                           
             -       
 339                  
 340          -----------------------------------------------------------*/
 341          void 
 342          FTL_W_AllocWear(
 343          void
 344          )
 345          {
 346   1              smtUint8        index;
 347   1              smtUint8        num;
 348   1              smtBlkAddr      *free_table;
 349   1              
 350   1              
 351   1              // Initialize all varaible(last counter, maxium cycle, free table)
 352   1              index           = gl_static->dynamic_index;
 353   1              num                     = (smtUint8)gpFlush->freeBlkNum;
 354   1              free_table      = &gpFlush->freeBlks[index];
 355   1      
 356   1              while (num--)
 357   1              {       
 358   2                      // cycle for all entries and goto next entry
 359   2                      free_table++;
 360   2                  index++;            
 361   2                      if (index >= gpFlush->freeBlkNum)
 362   2                      {
 363   3                              // Reset
C51 COMPILER V8.05a   FTL_W_WEAR                                                           06/28/2007 17:29:24 PAGE 7   

 364   3                              index           = 0;                            
 365   3                              free_table      = gpFlush->freeBlks;    
 366   3                      }
 367   2      
 368   2                      // Check if block is not used (free) 
 369   2                      if (!((*free_table)&FTL_FBTYPE_BAD))
 370   2                      {       
 371   3                              // Check if block is not used (free) 
 372   3                              if (!(gl_dynamic_lock[index>>3]&gl_lookup_mask[index&7]))
 373   3                              { 
 374   4                                      
 375   4                                      gl_static->dynamic_index                = index;        
 376   4                                      gpWearAllocData->free_index     = index; 
 377   4                                      gpWearAllocData->free_wear      = gl_dynamic_wear_info[index]+1; 
 378   4                                      // Allocation is success 
 379   4                                      return;  
 380   4                              }
 381   3                      }
 382   2              }
 383   1      
 384   1              // Restore index 
 385   1              gl_static->dynamic_index                = index;                
 386   1              gpWearAllocData->free_index     = INDEX_NA;
 387   1              gpWearAllocData->free_wear      = WEAR_NA;              
 388   1              
 389   1              // Fatal error! no free block in the table 
 390   1      }
