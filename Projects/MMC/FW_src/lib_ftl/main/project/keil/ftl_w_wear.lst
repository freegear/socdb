  73          /*----------------------------------------------------------
  74                  Function name   : FTL_W_Init
  75                  Prototype               : 
  76                  Return                  : none
  77                  Argument                : 
  78                  Comments                : initiate wear leveling, this function 
  79                                                    must be called at power on
  80          -----------------------------------------------------------*/
  81          void 
  82          FTL_W_Init(
  83          ST_STATIC *ptr  // Static info for wear contoller
  84          ) 
  85          {
  86   1              smtUint8 idx;
  87   1              
  88   1              // Initialize static data pointer
  89   1              gl_static = ptr;
  90   1      
  91   1              // Reset dynamic wear info
  92   1              for (idx = 0; idx < gpFlush->freeBlkNum; idx++) 
  93   1              {
  94   2                      gl_dynamic_wear_info[idx] = WEAR_NA;
  95   2              }
  96   1                      
  97   1              // Reset dynamic wear lock info
  98   1              for(idx = 0; idx < sizeof(gl_dynamic_lock); idx++)
  99   1              {
 100   2                      gl_dynamic_lock[idx] = 0x0;
 101   2              }
 102   1              
 103   1              // Reset static block information
 104   1              for (idx =0; idx<MAXSTATICWEAR; idx++) 
 105   1              {
 106   2                      gl_static->wear_info[idx].lba   = BLK_NA;
 107   2              gl_static->wear_info[idx].wear  = WEAR_NA;
 108   2              }
 109   1      
 110   1              // Reset static LBA, Count, Current dynamic index
 111   1              gl_static->lba                          = 0;    
 112   1          gl_static->cnt                              = 2;    
 113   1              gl_static->dynamic_index        = 0;    
 114   1      }
