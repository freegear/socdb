#-------------------------------------------------------------------------------
# building
#-------------------------------------------------------------------------------
# LIB_TARGET = lib.a defined int the top directory makefile


lib: $(LIB_TARGET)
$(LIB_TARGET): $(LIB_OBJS)
	$(AR) $(ARFLAGS) $(LIB_TARGET) $(LIB_OBJS) 
	mv $(LIB_TARGET) $(LIB_BASE_DIR)

$(LIB_DRIVERS_MP3ENC_OBJS):$(LIB_DRIVERS_MP3ENC_SOURCES)
	@echo "Building mp3 encoder lib >"
	$(CC) -march=armv4 -c \
	$(COMPILER_FLAGS) \
	$(CONFIG_FLAGS) \
	-DHAVE_CONFIG_H \
	$(OPTIMIZATIONS) \
	$(LIB_INCLUDES) -I ./$(LIB_DRIVER_MEDIA_DIR)/sw_audio_driver/mp3/encoder \
	$< -o $@ 2>>error.log
	
$(LIB_DRIVERS_MP3DEC_OBJS):$(LIB_DRIVERS_MP3DEC_SOURCES)
	@echo "Building mp3 decoder lib >"
	$(CC) -march=armv4 -c \
	$(COMPILER_FLAGS) \
	$(CONFIG_FLAGS) \
	-DFPM_DEFAULT,-D_LIB,HAVE_CONFIG_H,-DASO_ZEROCHECK\
	$(OPTIMIZATIONS) \
	$(LIB_INCLUDES) -I ./$(LIB_DRIVER_MEDIA_DIR)/sw_audio_driver/mp3/decoder \
	$< -o $@ 2>>error.log
	
$(LIB_DRIVERS_OGG_OBJS):$(LIB_DRIVERS_MP3DEC_SOURCES)
	@echo "Building mp3 decoder lib >"
	$(CC) -march=armv4 -c \
	$(COMPILER_FLAGS) \
	$(CONFIG_FLAGS) \
	$(OPTIMIZATIONS) \
	$(LIB_INCLUDES) -I ./$(LIB_DRIVER_MEDIA_DIR)/sw_audio_driver/mp3/decoder \
	$< -o $@ 2>>error.log
	
$(LIB_DRIVERS_VORBIS_OBJS):$(LIB_DRIVERS_MP3DEC_SOURCES)
	@echo "Building mp3 decoder lib >"
	$(CC) -march=armv4 -c \
	$(COMPILER_FLAGS) \
	$(CONFIG_FLAGS) \
	$(OPTIMIZATIONS) \
	$(LIB_INCLUDES) -I ./$(LIB_DRIVER_MEDIA_DIR)/sw_audio_driver/mp3/decoder \
	$< -o $@ 2>>error.log		
	
$(LIB_DRIVERS_FS_OBJS):$(LIB_DRIVERS_FS_SOURCES)
	@echo "Building Filesystem lib >"
	$(CC) -march=armv4 -c $(COMPILER_FLAGS) $(CONFIG_FLAGS) $(OPTIMIZATIONS) $(LIB_INCLUDES)  $< -o $@ 2>>error.log
	
lib_dep:

	@echo "#test library dependency" > lib_make_rules.dep
	
	@for i in $(LIB_OBJS:.o=); do 						\
		echo "#$$i ##################" >> lib_make_rules.dep;	\
		$(CC) -M $(LIB_INCLUDE)							\
		-DFPM_DEFAULT,-D_LIB,HAVE_CONFIG_H,-DASO_ZEROCHECK	\
		 $$i.c | sed "s!\([^.]*\)\.o[ :]*!$$i.o: !g" >> lib_make_rules.dep;	\
        done;

