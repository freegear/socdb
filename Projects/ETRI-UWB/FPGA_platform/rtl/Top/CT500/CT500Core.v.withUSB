// APB0 Slave0 : SMC
// already connected
assign PREADY0_0 = 1;

// APB0 Slave1 : DDR Controller
// already connected
assign PREADY0_1 = 1;

// APB0 Slave2 : NAND Flash Ctrl
assign PREADY0_2 = 1;
wire NFInt;
NFTop NFCtrl
(
		.PCLK(ACLK_BUS),
		.PRESETn(ARESETn),
		.PADDR(PADDR0[6:2]),
		.PSEL(PSEL0_2),
		.PENABLE(PENABLE0),
		.PWRITE(PWRITE0),
		.PWDATA(PWDATA0),
		.PRDATA(PRDATA0_2),

		.NFDMAReqOut(NFDMAReq),
		.NFINTOut(NFInt),

		.nNFBootPinIn(NF_nBoot),
		.IOWidthPinIn(NF_IOWidth),
		.NandWidthPinIn(NF_Width),
		.BootCfgPinIn(NF_BootCfg),
		.OutDtmnPinIn(NF_OutDtmn),

		.NFDataIn(NF_DI),
		.NFDataOut(NF_DO),
		.NFDataOutEn(NF_DOE),
		.CLE(NF_CLE),
		.ALE(NF_ALE),
		.nNFCE1(NF_nCE1),
		.nNFCE0(NF_nCE0),
		.nNFRE(NF_nRE),
		.nNFWE(NF_nWE),
		.RnB1(NF_RnB1),
		.RnB0(NF_RnB0)
);

// APB0 Slave3 : DMA Controllere
// already connected
assign PREADY0_3 = 1;

// APB0 Slave4 : 2D DMA Controller
// already connected
assign PREADY0_4 = 1;

// APB0 Slave5 : VIC(Vectored Interrupt Controller)
assign PREADY0_5 = 1;
wire [2:0] UartInt;
wire [31:0] IntSrc;
wire MMCInt;
wire       I2CInt;
wire [3:0] TimerMatchInt;
wire WDTInt;
wire I2SInt;
wire       SEIPInt;
wire [1:0] GPIOInt;
wire       SPIInt;
`ifndef INCLUDE_MMC
assign MMCInt = 0;
`endif
assign IntSrc = { MMCInt, 3'd0, USBInt, SPIInt, SEIPInt, GPIOInt, NFInt, I2SInt, I2CInt, VifInt, DmInt, DMA2DInt, WDTInt, TimerMatchInt, 1'b0, UartInt, DMAInterrupt[7:0]};

VIC VIC (
		.PCLK(ACLK_BUS),
		.PRESETn(ARESETn),
		.PENABLE(PENABLE0),
		.PSEL(PSEL0_5),
		.PWRITE(PWRITE0),
		.PADDR(PADDR0[6:2]),
		.PWDATA(PWDATA0),
		.PRDATA(PRDATA0_5),

		.INTERRUPT_SRC(IntSrc),

		.nFIQ(ARMnFIQ),
		.nIRQ(ARMnIRQ),

		.LEVEL_PM(),
		.POLARITY_PM(),
		.INTMSK_PM()
);

// APB0 Slave6 : Sound Engine(Located at FPGA0)
wire  [7:0] SEIP_WEMDO;
wire  [7:0] SEIP_WEMDI;
wire [23:0] SEIP_WEMA;
wire        SEIP_EXMBIH;
wire        SEIP_XWEMOC;
wire        SEIP_XWEMWE;

SEIPTop SEIP (
		.MCK(CLK100M),
		.XRST(ARESETn),
		.TE(1'b0),
		.TI0(1'b0),
		.TI1(1'b0),
		.TI2(1'b0),
		.TI3(1'b0),
		.TI4(1'b0),
		.TO0(),
		.TO1(),
		.TO2(),
		.TO3(),
		.TO4(),

		.PSEL(PSEL0_6), 
    	.PENABLE(PENABLE0),
    	.PADDR(PADDR0[13:1]),
    	.PWRITE(PWRITE0),
    	.PWDATA(PWDATA0),
		.PRDATA(PRDATA0_6),
		.PREADY(PREADY0_6),
				
		.EEMA_M(SEIP_EEMA),
		.EEMDI_M(SEIP_EEMDI),
		.EEMDO_M(SEIP_EEMDO),
		.XEEMWE_M(SEIP_XEEMWE),

		.RxDmaRequest(SEIPRxDMAReq),
		.TxDmaRequest(SEIPTxDMAReq),
		.SEIPInt(SEIPInt),

		.EXMBIH(SEIP_EXMBIH),
		.WEMDI(SEIP_WEMDI),
		.WEMDO(SEIP_WEMDO),
		.WEMA(SEIP_WEMA),
		.XWEMOC(SEIP_XWEMOC),
		.XWEMWE(SEIP_XWEMWE),

		.SCKO(SEIP_SCKO),
		.LRCKO(SEIP_LRCKO),
    	.SDI1(SEIP_SDI1),
		.SDI2(SEIP_SDI2),
		.ADMCK(SEIP_ADMCK),
    	.SD2O(SEIP_SD2O),
		.SD1O(SEIP_SD1O),
		.MLRCK(SEIP_MLRCK),
		.MSCK(SEIP_MSCK)
);

wire [2:0] WaveROMHAddr;
assign WAVE_DOUT_SEIP = SEIP_WEMDI;
assign WAVE_nDEN_SEIP = SEIP_XWEMOC;
assign SEIP_WEMDO = WAVE_DIN_SEIP;
assign WAVE_ADDR_SEIP = {WaveROMHAddr[2:0], SEIP_WEMA};
assign WAVE_nWE_SEIP = SEIP_XWEMWE;
assign WAVE_nOE_SEIP = ~SEIP_XWEMWE;
assign WAVE_nCE_SEIP = 1'b0;	// always low after reset

// APB0 Slave7 : USB 
// already connected
//assign PREADY0_7 = 1;

