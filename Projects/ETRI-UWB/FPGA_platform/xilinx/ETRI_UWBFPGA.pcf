        "DDR_DQSI_1_" 7.143 ns;
TS_UART_RXD_0__CLK50M = MAXDELAY FROM TIMEGRP "UART_RXD_0_" TO TIMEGRP
        "CLK50M" 28.571 ns;
TS_CLK = PERIOD TIMEGRP "CLK" 19 ns HIGH 50%;
TS_CLK200M = PERIOD TIMEGRP "CLK200M" TS_CLK * 0.5 HIGH 50%;
TS_CLK50M = PERIOD TIMEGRP "CLK50M" TS_CLK * 2 HIGH 50%;
TS_DDR_CLK_c = PERIOD TIMEGRP "DDR_CLK_c" TS_CLK HIGH 50%;
TS_CLK33M = PERIOD TIMEGRP "CLK33M" 30.303 ns HIGH 50%;
TS_DDR_DQSI_1_ = PERIOD TIMEGRP "DDR_DQSI_1_" 9.5 ns HIGH 50%;
TS_DDR_DQSI_0_ = PERIOD TIMEGRP "DDR_DQSI_0_" TS_DDR_DQSI_1_ HIGH 50%;
TS_DDR_DQ_0__CLK200M = MAXDELAY FROM TIMEGRP "CLK200M" TO TIMEGRP "DDR_DQ_0_"
        9.5 ns;
TS_PLL_CLK2X_BUF = PERIOD TIMEGRP "PLL_CLK2X_BUF" TS_CLK / 2 HIGH 50%;
TS_PLL_CLK0_BUF = PERIOD TIMEGRP "PLL_CLK0_BUF" TS_CLK HIGH 50%;
TS_PLL_CLKDV_BUF = PERIOD TIMEGRP "PLL_CLKDV_BUF" TS_CLK * 2 HIGH 50%;
OFFSET = OUT 30.303 ns AFTER COMP "CLK33M";
OFFSET = OUT 14.286 ns AFTER COMP "CLK";
OFFSET = IN 14.286 ns BEFORE COMP "CLK";
OFFSET = IN 30.303 ns BEFORE COMP "CLK33M";
SCHEMATIC END;
