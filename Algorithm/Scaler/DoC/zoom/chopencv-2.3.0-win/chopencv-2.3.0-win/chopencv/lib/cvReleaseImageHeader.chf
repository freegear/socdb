void cvReleaseImageHeader(IplImage** image) {
    void *fptr;

    fptr = dlsym(_Chcv_handle, "cvReleaseImageHeader_chdl");
    if(fptr == NULL) {
        fprintf(_stderr, "Error: %s(): dlsym(): %s\n", __func__,  dlerror());
        return;
    }
    dlrunfun(fptr, NULL, cvReleaseImageHeader, image);
}
