CvCapture* cvCaptureFromFile(char* filename) {
    void *fptr;
    CvCapture*retval;

    fptr = dlsym(_Chhighgui_handle, "cvCaptureFromFile_chdl");
    if(fptr == NULL) {
        fprintf(_stderr, "Error: %s(): dlsym(): %s\n", __func__,  dlerror());
        return NULL;
    }
    dlrunfun(fptr, &retval, cvCaptureFromFile, filename);
    return retval;
}
