@ECHO OFF
IF "%1"=="1" GOTO ATA1
IF "%1"=="2" GOTO ATA2
IF "%1"=="1I" GOTO ATA1I
IF "%1"=="2I" GOTO ATA2I
IF "%1"=="PCI" GOTO PCI
IF "%1"=="PCII" GOTO PCII
ECHO IDEポートを指定してください。
ECHO   MKATAR 1[リターン] .... プライマリ用(割り込み未使用版)
ECHO   MKATAR 2[リターン] .... セカンダリ用(割り込み未使用版)
ECHO   MKATAR 1I[リターン] ... プライマリ用(割り込み使用版)
ECHO   MKATAR 2I[リターン] ... セカンダリ用(割り込み使用版)
ECHO   MKATAR PCI[リターン] .. PCI ATA用(割り込み未使用版)
ECHO   MKATAR PCII[リターン] . PCI ATA用(割り込み使用版)
GOTO QUIT

:ATA1
REM プライマリ用(割り込み未使用版)
LCC -m -DIDE1 -o ATAR1.EXE AT_IO.C IDE_BIOS.C IDEPRINT.C ATARx.C
GOTO DELL

:ATA2
REM セカンダリ用(割り込み未使用版)
LCC -m -DIDE2 -o ATAR2.EXE AT_IO.C IDE_BIOS.C IDEPRINT.C ATARx.C
GOTO DELL

:ATA1I
REM プライマリ用(割り込み使用版)
LCC -m -DIDE1 -DUSE_INTERRUPT -o ATAR1i.EXE -O -lIRQFUNC.OBJ AT_IO.C IDE_BIOS.C IDEPRINT.C ATARx.C
GOTO DELL

:ATA2I
REM プライマリ用(割り込み使用版)
LCC -m -DIDE2 -DUSE_INTERRUPT -o ATAR2i.EXE -O -lIRQFUNC.OBJ AT_IO.C IDE_BIOS.C IDEPRINT.C ATARx.C
GOTO DELL

:PCI
REM PCI ATA用(割り込み未使用版)
LCC -m -DPCI -o PCIATAR.EXE -lPCIFUNC.OBJ AT_IO.C IDE_BIOS.C IDEPRINT.C PCIATAR.C
GOTO DELL

:PCII
REM PCI ATA用(割り込み使用版)
LCC -m -DPCI -DUSE_INTERRUPT -o PCIATARi.EXE -lIRQFUNC.OBJ -lPCIFUNC.OBJ AT_IO.C IDE_BIOS.C IDEPRINT.C PCIATAR.C

:DELL
del *.map

:QUIT
